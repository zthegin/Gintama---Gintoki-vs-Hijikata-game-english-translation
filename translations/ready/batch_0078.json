      "source_words_sha256": "4f313740978d8a3bb941c5f63d24c164694ec428fe603f41bea43a8e75d1a708",
      "english": "Hijikata was looking too.",
      "translator_note": null
    },
    {
      "id": "msb_0007751C",
      "source_words_sha256": "0a01fdfdd8a80d63e2ca5a098db0931aeeb29a2e0852517b762b412dd08288fe",
      "english": "He'll look for my\nattacker while\nhe's working.",
      "translator_note": null
    },
    {
      "id": "msb_000776F8",
      "source_words_sha256": "893a65f907e0b9755ab72eac461e662b4d6fb81ca45171e36a326cc95bd91068",
      "english": "...",
      "translator_note": null
    },
    {
      "id": "msb_00077968",
      "source_words_sha256": "893a65f907e0b9755ab72eac461e662b4d6fb81ca45171e36a326cc95bd91068",
      "english": "...",
      "translator_note": null
    },
    {
      "id": "msb_00077CC0",
      "source_words_sha256": "5f7ee9dbc8f0305e85fe7329a2b9d8c322c45e81bc7e376905f3876a24867d5c",
      "english": "Gin!",
      "translator_note": null
    },
    {
      "id": "msb_00077E70",
      "source_words_sha256": "c0fd93f9863ec5ef60bf074128789bf0bdff839b378379557d25647c23520b7e",
      "english": "Oh, Hedoro collects\nGin Tama too, right?",
      "translator_note": null
    },
    {
      "id": "msb_00078270",
      "source_words_sha256": "530662195ef8173c0ecad8a733e979379f9005f58a8f655cd5556d5a00559c48",
      "english": "Oh, Katsura!\nWe've been looking for you!!",
      "translator_note": null
    },
    {
      "id": "msb_000785B8",
      "source_words_sha256": "4991409719a1174b6c8613a8713ca580d6862919083b2948e76ddcd51c3764b1",
      "english": "Just go back inside\nand rest. Got it?",
      "translator_note": null
    },
    {
      "id": "msb_00078B04",
      "source_words_sha256": "893a65f907e0b9755ab72eac461e662b4d6fb81ca45171e36a326cc95bd91068",
      "english": "...",
      "translator_note": null
    },
    {
      "id": "msb_00078BF8",
      "source_words_sha256": "893a65f907e0b9755ab72eac461e662b4d6fb81ca45171e36a326cc95bd91068",
      "english": "...",
      "translator_note": null
    },
    {
      "id": "msb_00078C4C",
      "source_words_sha256": "c8177ed3437c4bd23371ceac8bba4b6a8a90e913283676f83cd32e4521188c79",
      "english": "...",
      "translator_note": null
    },
    {
      "id": "msb_00078C74",
      "source_words_sha256": "e82c39cd22bf17c1cf3290c9468651cbd8fd756c19bfae2025e6ba54a095501c",
      "english": "That Earthling-hating\nfrog came to [blue]HQ[/color]?\nSomething's off...",
      "translator_note": null
    },
    {
      "id": "msb_00078CF4",
      "source_words_sha256": "02e2b82b900d9166ef25956d02bbefa23faffe3bfd8c318269931d458ef23239",
      "english": "Tch...!\nDon't like this...\fShould've caught\nKatsura at [blue]Nabeya[/color].\fBastard looked\nlike he knew something.",
      "translator_note": null
    },
    {
      "id": "msb_0007900C",
      "source_words_sha256": "e723eb7d69e2a19c974202361b6d2991b08d9d7440e5b9012bb151b9f0fc3fed",
      "english": "An [red]Amanto envoy[/color].",
      "translator_note": null
    },
    {
      "id": "msb_00079058",
      "source_words_sha256": "37f48c9ddd28718073468fd0a8fed92ccd587c45ca647397510696cf3670c347",
      "english": "Ah... [red]Kinya[/color]?!\nWhat brings you here?",
      "translator_note": null
    },
    {
      "id": "msb_00079130",
      "source_words_sha256": "49161c970de4f0c9b06101fd7471f506c4e700256844ba1d5eb6c25115ee7af9",
      "english": "Right. I'll head\ntoward [blue]Denii's[/color].",
      "translator_note": null
    },
    {
      "id": "msb_000791B8",
      "source_words_sha256": "bc06e85269c0bedfa3457ade53de65de73b046eafa18c6909544ed78028a491c",
      "english": "And he made damn sure\nwe wouldn't\ninvestigate Gin Tama.",
      "translator_note": null
    },
    {
      "id": "msb_00079338",
      "source_words_sha256": "820ed44d9d5b6f2fba17540f6bb1ba79e41cf868840f748e3c3beae4cdeb2e68",
      "english": "Foreigner,\n[blue]Nabeya[/color].",
      "translator_note": null
    },
    {
      "id": "msb_00079398",
      "source_words_sha256": "dffb272a86fe74ced5c6fec2a2a1ea8c4a87fe8fcaff94745a60b7f681c6602c",
      "english": "Hear any Joi ronin\ntalking at [blue]Nabeya[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_000793F4",
      "source_words_sha256": "84063bf4405258cd9b66ea56f152c4c2ea1d26e0d9f249124e9d0326b2f352bc",
      "english": "I see...",
      "translator_note": null
    },
    {
      "id": "msb_00079730",
      "source_words_sha256": "3c5e32ad8a94c3b3a9d97b3e02f01197e5a311bcf0e2709b9dffe275afe1c708",
      "english": "At [blue]Nabeya[/color]?\nNo idea.",
      "translator_note": null
    },
    {
      "id": "msb_000799B4",
      "source_words_sha256": "c245bb086250f835238b9edc9194694ba8a9a6bd1c1c30bac4c7d021c6a376b6",
      "english": "Huh?",
      "translator_note": null
    },
    {
      "id": "msb_00079B64",
      "source_words_sha256": "aae5286d4a439a7fd50c7cfaa8806ed9c731e99faed0dd48bf9751ddce25fda7",
      "english": "I said that\nfrom the start!\fJust eating ramen\non my way back from\nthe [blue]Amusement Park[/color].",
      "translator_note": null
    },
    {
      "id": "msb_00079BC8",
      "source_words_sha256": "cfc05d4bf79ef1ca2fe44c90de8509b26da7e4100ea58e0f7fd10e0d1ebdc4b7",
      "english": "Event outside\n[blue]Amusement Park[/color].",
      "translator_note": null
    },
    {
      "id": "msb_00079DDC",
      "source_words_sha256": "c8177ed3437c4bd23371ceac8bba4b6a8a90e913283676f83cd32e4521188c79",
      "english": "...",
      "translator_note": null
    },
    {
      "id": "msb_00079F24",
      "source_words_sha256": "fca6dfaf83a5bc8612b0d8fc2f5b58d0f33f65111774a61da7500df2f12d8e2f",
      "english": "Where next...?\nOh, there's a\n[blue]Kunoichi Cafe[/color] nearby...",
      "translator_note": null
    },
    {
      "id": "msb_0007A100",
      "source_words_sha256": "644e55bd5ad75458dce2f1777b814e31821e1c2ad60fc076a13fa0672a8eb551",
      "english": "Enjoy the [blue]Amusement Park[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_0007A2F0",
      "source_words_sha256": "20810f53dc2e13bff3b20ed91d894bbb6846552d1cafdcb2a09b0c21b189330c",
      "english": "A whole load of\n[red]Justaways[/color]\nwas brought into Edo.",
      "translator_note": null
    },
    {
      "id": "msb_0007A6E0",
      "source_words_sha256": "6d32bdbe6dfc44ce83d9197ecbe0924be947d9f3ca54c02dd65896846d143490",
      "english": "Looking for Katsura.\nKnow anything?",
      "translator_note": null
    },
    {
      "id": "msb_0007A740",
      "source_words_sha256": "cf3bc7797f778d412d9c3fa5e442bb4ef85d57be08923ec91a3fd1b37ab715d2",
      "english": "Really?",
      "translator_note": null
    },
    {
      "id": "msb_0007A76C",
      "source_words_sha256": "88d62668b25a11a8930be53712a7a3a1746d4d3aafc7732639effe2abce70321",
      "english": "Really?!",
      "translator_note": null
    },
    {
      "id": "msb_0007A7E8",
      "source_words_sha256": "c2528ff53e202dfbfec5986ff3a161414e68259e4265834224f55f691142eec3",
      "english": "Huh...?",
      "translator_note": null
    },
    {
      "id": "msb_0007AAD0",
      "source_words_sha256": "d2b765ace29d8a3d6c14852b492a6c52b3417fc93b379fa3238d6cb6e5ee5493",
      "english": "Still at [blue]Hokuto[/color], I hope.",
      "translator_note": null
    },
    {
      "id": "msb_0007B018",
      "source_words_sha256": "a580c16850fcaf80e62a7534884dd9bb2f432a618e222aa8ea25a61820a0fae1",
      "english": "Went toward [blue]Denii's[/color].",
      "translator_note": null
    },
    {
      "id": "msb_0007B230",
      "source_words_sha256": "16f7d164744239c6a1be604d6dba9f01cd1941e531f2f70acf79690c92fa9a6c",
      "english": "Outside the\n[blue]Oedo Amusement Park[/color].\nMet him to give him his flowers.",
      "translator_note": null
    },
    {
      "id": "msb_0007B3A4",
      "source_words_sha256": "aa2bf1fe2e50ed109f98b61de15fef16498d8d14e719ac88888ff1f9ba5e8ae0",
      "english": "At the [blue]Park[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_0007B3C4",
      "source_words_sha256": "09e96dca200f6fd32b88906ecbd3fffd47159b64a54ece4b2cab17e72d7190cc",
      "english": "Then their hideout\ncould be near\nthe [blue]Amusement Park[/color].",
      "translator_note": null
    },
    {
      "id": "msb_0007B86C",
      "source_words_sha256": "6d05d11663d713b64982b5468e5b3fc20363d8564bcb190804ac442527da1c78",
      "english": "[red]Their hideout[/color]\nshould be nearby.",
      "translator_note": null
    },
    {
      "id": "msb_0007BA44",
      "source_words_sha256": "0038d198ac6a2d2f60587430e98f6a937e2bcd80fdfe8d5842b4df491176c4b9",
      "english": "Odd people use that\n[blue]Abandoned Building[/color]\nthese days...",
      "translator_note": null
    },
    {
      "id": "msb_0007BAEC",
      "source_words_sha256": "cda63381a9a1197790dbbf1257e49ec26c580995be83d5f55ae897801de2b0bc",
      "english": "Justaway?",
      "translator_note": null
    },
    {
      "id": "msb_0007BB00",
      "source_words_sha256": "25ad9adbbd31d0451e4f4f84e069abfd6c7cfe99b270da391557e7c4a357bce9",
      "english": "Huh?!",
      "translator_note": null
    },
    {
      "id": "msb_0007BB28",
      "source_words_sha256": "b9c00fed0ae9f9915826677718061005696d9085d1ee56012ed65b03d2f0e1e4",
      "english": "Yes...",
      "translator_note": null
    },
    {
      "id": "msb_0007BB3C",
      "source_words_sha256": "2197f155cd1f52477d4b184719a91855abdf632f36734753c7e6ebfeeb99cd75",
      "english": "Yes, deep in\n[blue]Abandoned Building St.[/color]",
      "translator_note": null
    },
    {
      "id": "msb_0007BC3C",
      "source_words_sha256": "1b9562f7a21d6568ac1e2405e0a3347b81bfb740203dfecaebd6399bca92b712",
      "english": "Ask someone?",
      "translator_note": null
    },
    {
      "id": "msb_0007BDB4",
      "source_words_sha256": "03d77ae2b0b5f5ba73d4864567d6e3ed609922061c5a2a5945256651688e3d2d",
      "english": "What?!",
      "translator_note": null
    },
    {
      "id": "msb_0007BE2C",
      "source_words_sha256": "48a06c16b1aed5897225148aa658242dfb180a7f36374e78d748e1e4bded31d7",
      "english": "Seriously...?",
      "translator_note": null
    },
    {
      "id": "msb_0007BF08",
      "source_words_sha256": "c4ff30953463a2370db59feda0c7d2c7f4832d24be3e690cb8efb551de497aaf",
      "english": "Tch...!",
      "translator_note": null
    },
    {
      "id": "msb_0007C180",
      "source_words_sha256": "5c07a9590dbc7330bfebe6cb4fdb5b16121249358c9c75ba9ce4d71f06df40ed",
      "english": "Are we doing this or not?",
      "translator_note": null
    },
    {
      "id": "msb_0007C330",
      "source_words_sha256": "79271368179ff3314b2dd6a01ac0f70de2ce1ec885f743ee2ba15166bea1ef59",
      "english": "They're probably\nin [blue]Abandoned Back St.[/color]\nup ahead. Hurry, Sogo!",
      "translator_note": null
    },
    {
      "id": "msb_0007C408",
      "source_words_sha256": "2350da1680f06165dd727258cfb15f4288f867b6d48c9627bdf8e78507b8e32f",
      "english": "OK.",
      "translator_note": null
    },
    {
      "id": "msb_0007C660",
      "source_words_sha256": "038febc4f0570d88c1e3422a161da1cbfa82d09e9480b733f65d23995ebf3e7d",
      "english": "Tch!",
      "translator_note": null
    },
    {
      "id": "msb_0007C8EC",
      "source_words_sha256": "a57eccabed174487e51de913ce8557deb5766b24ece9499ab0a117f74dca3617",
      "english": "What?",
      "translator_note": null
    },
    {
      "id": "msb_0007C9B0",
      "source_words_sha256": "5ae70717ca24ee3e013ade8a9cf69e246f9395c03f13eb9f19195b23e33ee195",
      "english": "Idiot!!\nIt's obviously\na [red]Getaway[/color]!",
      "translator_note": null
    },
    {
      "id": "msb_0007CB60",
      "source_words_sha256": "829e0d1f2e4410f4fd0b3819d5a70e068e2f68a8238ac0e0c944622ad93ea450",
      "english": "So what?",
      "translator_note": null
    },
    {
      "id": "msb_0007CD00",
      "source_words_sha256": "ced13630a7f784a0ff09c3b073d9f0b8fee1ca0be5840a041f71bc1d8094c8cc",
      "english": "Hey, [red]Viper Banzo[/color].\nStill alive?",
      "translator_note": null
    },
    {
      "id": "msb_0007CE70",
      "source_words_sha256": "7284936c1794bce7b4c2b6a0c2120f17dcf6888341b8afe5d0da587cd12cddbf",
      "english": "I promised to\ninvestigate too.\fSo I'll battle you\nat Gin Tama!",
      "translator_note": null
    },
    {
      "id": "msb_0007D4B4",
      "source_words_sha256": "6ef114943ac2e8d1ec6adfa3720d25dda5afc3d2299875cb0188b9b7a680bb1d",
      "english": "What?\nNo time for that nonsense.",
      "translator_note": null
    },
    {
      "id": "msb_0007D518",
      "source_words_sha256": "0929b4ea8eee7a2ecd8e0e4fcbec877cb652ddcbba3dcd0d9b9fbfa15706896b",
      "english": "What, bastard?!",
      "translator_note": null
    },
    {
      "id": "msb_0007D6DC",
      "source_words_sha256": "b05d78e2fa62e121c5cdcb1b397fb45f299f8ead77b56b17c643d8f3ec10a4b3",
      "english": "What do you mean?",
      "translator_note": null
    },
    {
      "id": "msb_0007D718",
      "source_words_sha256": "f4a2d11b81f3a4b23abe20b0f852163c3f81e8329b196c0eeedaba7f0eb4d26e",
      "english": "Ngh...!",
      "translator_note": null
    },
    {
      "id": "msb_0007D778",
      "source_words_sha256": "253fcc6999e24974edba4344cb808b06c22fb265d1191bcb0b2dc9ce325baa8d",
      "english": "What?",
      "translator_note": null
    },
    {
      "id": "msb_0007D910",
      "source_words_sha256": "0076a2529dc1f4f96192c8707f64d00bd34118110040d123e34b05a83526f37c",
      "english": "Right. Let's go.",
      "translator_note": null
    },
    {
      "id": "msb_0007D954",
      "source_words_sha256": "3276aa7bc3f00902ac55339dc054957a3c861bdd0da40fa7e395be07d32b6e03",
      "english": "But shogunate orders\nforbid investigating\nGin Tama.",
      "translator_note": null
    },
    {
      "id": "msb_0007D98C",
      "source_words_sha256": "36732fcc7b9b3f5315ce44be2c003f4d4d90c7550d8fce7c2ebd25f1d51d1e9a",
      "english": "[red]Banbanji[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_0007D9B8",
      "source_words_sha256": "b05d78e2fa62e121c5cdcb1b397fb45f299f8ead77b56b17c643d8f3ec10a4b3",
      "english": "What do you mean?",
      "translator_note": null
    },
    {
      "id": "msb_0007D9FC",
      "source_words_sha256": "c1819409d4c6b21461022d0eb360157fb15fc70e9c2a3616e3a4889ad4ad9c54",
      "english": "What?!",
      "translator_note": null
    },
    {
      "id": "msb_0007DD30",
      "source_words_sha256": "2d0fae6f68dec261a352a2c4add8e9d96950130067a006a0ddb65bfeb975e377",
      "english": "Called by radio, huh?\nHow thoughtful.",
      "translator_note": null
    },
    {
      "id": "msb_0007DDD4",
      "source_words_sha256": "5492c40adc960a2faa897b4d247e274a0cea02bd555768199fcd39691d7ad774",
      "english": "Wait. Let me\nput it another way.\f[red]The secret of Gin Tama.[/color]",
      "translator_note": null
    },
    {
      "id": "msb_0007DE40",
      "source_words_sha256": "56b59a609eb93655092435b113b4f39de998f11366470859e02b1fba4572db3b",
      "english": "Do you know\n[red]what Gin Tama really are[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_0007DFE4",
      "source_words_sha256": "a5524c91148f996dc71759c0b7848cf7b9eac9bdb9a317cf9d2bc8ef73aa259a",
      "english": "Heard of space pirate\n[red]Banbanji[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_0007E2A0",
      "source_words_sha256": "bfbb968b0283222d7c60d48f19f7d9f3d03aaf95090730f00515b7dccf06e1a1",
      "english": "That's the danger\nof Gin Tama.\fEvery invaded planet\nhad a craze for\n[red]toy balls[/color].",
      "translator_note": null
    },
    {
      "id": "msb_0007E64C",
      "source_words_sha256": "b6e83b781d703863c0670e697805c0d6948849d07cf5f2f0cc86a3bc0ff275f3",
      "english": "Waiting outside [blue]HQ[/color].",
      "translator_note": null
    },
    {
      "id": "msb_0007E818",
      "source_words_sha256": "e642cadb8c504ad6d63ddb500a1b2d761a15972ead46a928b5743dfa96b021c6",
      "english": "They pressured you\nto ban Gin Tama\ninvestigations?",
      "translator_note": null
    },
    {
      "id": "msb_0007E868",
      "source_words_sha256": "d0fc3c9564e077229c8ba46f5435d166b84ee726bc7db54899540d43ddc33192",
      "english": "What's he like?",
      "translator_note": null
    },
    {
      "id": "msb_0007E8BC",
      "source_words_sha256": "c4ff30953463a2370db59feda0c7d2c7f4832d24be3e690cb8efb551de497aaf",
      "english": "Tch...!",
      "translator_note": null
    },
    {
      "id": "msb_0007E9A4",
      "source_words_sha256": "5b1bcd0833864f877301bb406e3caea7bf5c7625b8c709b1f9280f995a1e8feb",
      "english": "Urgh...!",
      "translator_note": null
    },
    {
      "id": "msb_0007EADC",
      "source_words_sha256": "bbf75639f0684c339079e88cc19bec2eee65842c9bbba181d56836ca0297952d",
      "english": "Urgh...",
      "translator_note": null
    },
    {
      "id": "msb_0007EBF0",
      "source_words_sha256": "6a3fcc79cd8a156285259f1aacb42b9250b439a831686c13c2861f690b801c0d",
      "english": "[red]A man in a mask.[/color]\nDon't know his name!",
      "translator_note": null
    },
    {
      "id": "msb_0007F148",
      "source_words_sha256": "533ab9534c4202040c3e896ee4e987caa594c1fdc24e07328ed7f8783d5ed854",
      "english": "What is it?",
      "translator_note": null
    },
    {
      "id": "msb_0007F17C",
      "source_words_sha256": "1590678497af9587546607c45d8190e89ddec12647d154a7cbbf8283a86f30a8",
      "english": "Hmph... You two\nhead back to [blue]HQ[/color]\nfirst.",
      "translator_note": null
    },
    {
      "id": "msb_0007F4CC",
      "source_words_sha256": "0cd3a4b1dab9465f14da5a8e77b84c63925ce147df295a5b5f7c47555ede16b2",
      "english": "Vice-Chief! Captain! Big trouble!",
      "translator_note": null
    },
    {
      "id": "msb_0007F4EC",
      "source_words_sha256": "36bf488639a61916c0155831a8489626862dbf45782619daf7dc3a67009c5b2a",
      "english": "Word from [blue]Oedo Police[/color].\nDaraku's escaped!",
      "translator_note": null
    },
    {
      "id": "msb_0007F638",
      "source_words_sha256": "d5395bf49995c2924e24bc2f4dd14b7f3f57e39fae0ad73adef7a48cf08c040f",
      "english": "Understood.",
      "translator_note": null
    },
    {
      "id": "msb_0007F648",
      "source_words_sha256": "86a3495d80f355455385b5b91b1e80051ec4516f4086649fcae1581e0c442e9f",
      "english": "Katsura showed up\nat [blue]Nabeya[/color].\nHe's up to something.\fHe must know something\nimportant about\nBanbanji's invasion plan.",
      "translator_note": null
    },
    {
      "id": "msb_0007F92C",
      "source_words_sha256": "16d853aaf7a74d26b9d6e62216cdb0ca81f8e8bc946140e1fe3a1a9ef5f039f4",
      "english": "I'll check inside [blue]HQ[/color].\nYou lot look around\nthe area.",
      "translator_note": null
    },
    {
      "id": "msb_0007FAC4",
      "source_words_sha256": "2cbd04b0a785520f229cb9e0a589bd2077491679ee409dc859c4e478fd40736d",
      "english": "I'm going to bed...",
      "translator_note": null
    },
    {
      "id": "msb_0007FC70",
      "source_words_sha256": "4f7ab0c03fc94de0c4b9f79d1c8dda5ff2b280df3d0d14dadafa158594230ddc",
      "english": "What's going on?",
      "translator_note": null
    },
    {
      "id": "msb_0007FCA4",
      "source_words_sha256": "76ada6fab1d5e3cfadad590ddbb3b191afdbca1956ffea5cc4eeff8ef9232b36",
      "english": "Who knows...",
      "translator_note": null
    },
    {
      "id": "msb_0007FCBC",
      "source_words_sha256": "ddd673b061edfbf24cb67cf0194c65eb428389dd11745208e4f81f256f23f5cd",
      "english": "Hey... Could this be\n[red]Banbanji's invasion[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_0007FF0C",
      "source_words_sha256": "58ef5490da299b257651f18b967dacdc571da2fde3f0eef0a1c7cf6213086d72",
      "english": "The ground shook...\nLightning!\nUgh. Too lazy to explain.",
      "translator_note": null
    },
    {
      "id": "msb_0007FFA0",
      "source_words_sha256": "f3b6e4289d84d0f6ae49d27e7e73962a9c5b1226e0ae8132a298a89cd0d0686a",
      "english": "Ugh... What a pain...\nThat's my explanation.\nSkip training. Go to bed...",
      "translator_note": null
    },
    {
      "id": "msb_000801A8",
      "source_words_sha256": "63447302f8a15f91afe9d7e26342db7be3606e1b92df8df8a7e89599169d55b7",
      "english": "What do you mean?",
      "translator_note": null
    },
    {
      "id": "msb_00080288",
      "source_words_sha256": "a57eccabed174487e51de913ce8557deb5766b24ece9499ab0a117f74dca3617",
      "english": "What?",
      "translator_note": null
    },
    {
      "id": "msb_00080408",
      "source_words_sha256": "c8177ed3437c4bd23371ceac8bba4b6a8a90e913283676f83cd32e4521188c79",
      "english": "...",
      "translator_note": null
    },
    {
      "id": "msb_00080478",
      "source_words_sha256": "a57eccabed174487e51de913ce8557deb5766b24ece9499ab0a117f74dca3617",
      "english": "What?",
      "translator_note": null
    },
    {
      "id": "msb_00080484",
      "source_words_sha256": "c8177ed3437c4bd23371ceac8bba4b6a8a90e913283676f83cd32e4521188c79",
      "english": "...",
      "translator_note": null
    },
    {
      "id": "msb_000804CC",
      "source_words_sha256": "78aaba4ffc20d292aedad9c7043c8322f4521f4ab3f78a00e18b9c3c043d3d07",
      "english": "[blue]Yorozuya[/color]!",
      "translator_note": null
    },
    {
      "id": "msb_000804E0",
      "source_words_sha256": "770290eb86cfa10c7060cf3e0e5cbbb1ad5d90500d92eb713d10d5b2cde5927d",
      "english": "Disaster! Everyone\ninside [blue]HQ[/color]\nhas turned useless!",
      "translator_note": null
    },
    {
      "id": "msb_00080570",
      "source_words_sha256": "fd0e0ecbc09268dd943ab741b7340d1f3667dedff1186a6e20aeca1d92c6cc9b",
      "english": "Well?",
      "translator_note": null
    },
    {
      "id": "msb_00080730",
      "source_words_sha256": "2e3c42c6d1b9c578afae2f36ded2dafd29c6ea7a7ec6f7a686fbfff8ee34e00a",
      "english": "So they say...\nBut no one knows\nwhat it's really for.",
      "translator_note": null
    },
    {
      "id": "msb_00080A98",
      "source_words_sha256": "762ffa98a439cefbf612d968acf3a0d07765dac679e70e80145cc84d078dad26",
      "english": "Got it.",
      "translator_note": null
    },
    {
      "id": "msb_00080C3C",
      "source_words_sha256": "7b43a36e04da3774e7793cb104b78061f63520d0b0bf886fbae8e4e0a1d17ab8",
      "english": "It's true!\nA suspicious guy\nat [blue]Hokuto Shinken[/color]!",
      "translator_note": null
    },
    {
      "id": "msb_00080C70",
      "source_words_sha256": "8e13f74cd34c4258b67d6cc90c22125311e770a5dccd3ad1a847dd694a3537c3",
      "english": "Confirmed it already?",
      "translator_note": null
    },
    {
      "id": "msb_00080C88",
      "source_words_sha256": "6d7437f095ecfb60655d36fe811cb4ab5267072db9d54a19e62eadb320506f72",
      "english": "Off we go, then.",
      "translator_note": null
    },
    {
      "id": "msb_00080D18",
      "source_words_sha256": "0c942b63dbca132e01075a0b5a8d8c23b8d34ab0d7eba8a10138ba616c723403",
      "english": "Be careful.",
      "translator_note": null
    },
    {
      "id": "msb_00080D28",
      "source_words_sha256": "2d0fae6f68dec261a352a2c4add8e9d96950130067a006a0ddb65bfeb975e377",
      "english": "Called by radio, huh?\nHow thoughtful.",
      "translator_note": null
    },
    {
      "id": "msb_00080DAC",
      "source_words_sha256": "99eb6f47b4df43eae0cd55c806e4c349fa6549e1d311c3512a84dbab355fe57d",
      "english": "Saw a handsome guy\nwith long hair\nnear [blue]Saguri Bridge[/color].",
      "translator_note": null
    },
    {
      "id": "msb_00080DE8",
      "source_words_sha256": "68c068d7a3862830086df3d7d93a1e9452953b0154dd748a3af616f121a5ef80",
      "english": "Looking for Katsura...\nKnow him?",
      "translator_note": null
    },
    {
      "id": "msb_00080E74",
      "source_words_sha256": "7813e208b5bf7fc6f499e831435a75d1ab5cfc39c54dd307094b151c59aa8352",
      "english": "[blue]Saguri Bridge[/color]...\nLet's go...",
      "translator_note": null
    },
    {
      "id": "msb_00080EAC",
      "source_words_sha256": "82f45a1ac8e9cb62d6c0c9eaf1afe3fd79e28395dd0a05e41baec94eb70d7e47",
      "english": "Looking for a long-haired\nman called Katsura...\nKnow him?",
      "translator_note": null
    },
    {
      "id": "msb_00080F14",
      "source_words_sha256": "b202532cfb6493d04fcfe030066e4ac97fc96d8d0bb3dba776017ed0bccde7fb",
      "english": "[blue]Saguri Bridge[/color]",
      "translator_note": null
    },
    {
      "id": "msb_00080F54",
      "source_words_sha256": "6464ff77e38fc7baa7216faea6c031d0417f95768aac29f57a1dbda060ebe61b",
      "english": "Not sure it's Katsura.\nA long-haired hottie\nnear [blue]Saguri Bridge[/color], though.",
      "translator_note": null
    },
    {
      "id": "msb_00080FF8",
      "source_words_sha256": "25cf5c85ff87b4665db4f5d2fabaf3a4843bed538aeb4e7dae5556426b16f598",
      "english": "Don't tell Kagura\nor Shinpachi. Heh...\nGoing to the [blue]Dango Shop[/color] alone!",
      "translator_note": null
    },
    {
      "id": "msb_00081374",
      "source_words_sha256": "e6629bc2088f9d94fd57b78b1e15ecd6144687a7826377cc8de4ed6d405f592e",
      "english": "Why?",
      "translator_note": null
    },
    {
      "id": "msb_000813F8",
      "source_words_sha256": "7f9e212b12c423417180597ce8becb0498e24a56ec1b60f3611f1e76c2c8c0f6",
      "english": "Long shot, but\nI'll try [blue]Oedo Mart[/color]\nlater.",
      "translator_note": null
    },
    {
      "id": "msb_00081568",
      "source_words_sha256": "2f50733db40b73c7b53f7baa4ba47c09e8a9ffdf88abfadb6a336c1dc3cc09bf",
      "english": "Take that ticket stub\nto [blue]Oedo Mart[/color]\nfor strawberry milk.",
      "translator_note": null
    },
    {
      "id": "msb_0008186C",
      "source_words_sha256": "3c47dd2ad5c2551b54b6a04a384c1046da43d13cde9b0c472c3704ed9a02b04e",
      "english": "Got it?\nNear the [blue]TV Station[/color].",
      "translator_note": null
    },
    {
      "id": "msb_000818F8",
      "source_words_sha256": "4de241a15f718dd3182105704a5efb4195778209255a8badc709dd8231a1a482",
      "english": "So this works\nat [blue]Oedo Mart[/color], right?",
      "translator_note": null
    },
    {
      "id": "msb_00081988",
      "source_words_sha256": "36a0291e070aca0bf8a0150910a9648658bc767c3abd92aed3100e0e0bc76d6a",
      "english": "Yeah. Strawberry milk\nat [blue]Oedo Mart[/color].\nI said you can't have it!",
      "translator_note": null
    },
    {
      "id": "msb_00081A48",
      "source_words_sha256": "d52433d177201a9cee18080dc4675e021d9caf651392509f2531c3ec81f41421",
      "english": "Oh, that ticket stub...\nGot it at the [blue]Dango Shop[/color]?",
      "translator_note": null
    }
  ]
}
