    {
      "id": "msb_000FB6B0",
      "source_words_sha256": "b16f912462a6a375d75d33017949aead81eb66044ac4b10e5e3abae501979aa2",
      "english": "...Hey, Sougo.\fLooks like a giant\nseahorse floating\nin the sky to me...",
      "translator_note": null
    },
    {
      "id": "msb_000FB78C",
      "source_words_sha256": "5558014f690f5c955b38470e2b44227c39219008f88ee600f778903bc7bb32e0",
      "english": "With this atmosphere,\nSOMETHING's coming out.",
      "translator_note": null
    },
    {
      "id": "msb_000FB7C0",
      "source_words_sha256": "615ead9fb018807ebac18ced743809db2dea00327c260dcdeb6a79e30e1d21bc",
      "english": "No, Toshi. Think calmly!\fA dragon appears\nright in front of you!\nWhat would you do?!",
      "translator_note": null
    },
    {
      "id": "msb_000FB8BC",
      "source_words_sha256": "8dd4b4f4c31a3795503a64a40d0500c9bb24ad78ab1ed13d3038788f73c93e74",
      "english": "Somehow...\nIt's getting dark...",
      "translator_note": null
    },
    {
      "id": "msb_000FB918",
      "source_words_sha256": "42ab151e7f4f7aed97d48c7a0ee36512653fb06aad90a9c6c8cbd0848c100b1d",
      "english": "A flash.",
      "translator_note": null
    },
    {
      "id": "msb_000FB934",
      "source_words_sha256": "4e94abffe008bf381e4b3687199a198a6931bdccfab8866e736618e0caa79250",
      "english": "Don't worry.\nLooks that way to me too.\fA dragon, technically...",
      "translator_note": null
    },
    {
      "id": "msb_000FB990",
      "source_words_sha256": "0692a7224df6afb2e351dd0f430a2de8b537cf54363bf08bfec85735fee82418",
      "english": "Still nervous\nevery time...",
      "translator_note": null
    },
    {
      "id": "msb_000FB9E4",
      "source_words_sha256": "42ab151e7f4f7aed97d48c7a0ee36512653fb06aad90a9c6c8cbd0848c100b1d",
      "english": "A flash.",
      "translator_note": null
    },
    {
      "id": "msb_000FBA58",
      "source_words_sha256": "7ca93e229047ff164cd6d9cb649522e0aa1c5f3e70d3c5d42fce9cafc6959727",
      "english": "I am Shienryu...\fFor your courage\nin gathering Dragon Tama,\nI shall aid you.\fSpeak your wish...\nWhat do you desire?",
      "translator_note": null
    },
    {
      "id": "msb_000FBADC",
      "source_words_sha256": "0625fd9d94f92f65a47e57a4de60cea3fe51d091e9dad987e888b59ac96205d1",
      "english": "Your wish...\fCharacter Select\nBattle mode...\fUnderstood.\nIt shall be granted...",
      "translator_note": null
    },
    {
      "id": "msb_000FBB38",
      "source_words_sha256": "c1dbd94fc1a00958f9ede436973899d5fba537bddb55e0bff500f19acef8d6e2",
      "english": "For Character Select\nBattles, speak to the one\nin [blue]Shinsengumi HQ[/color]'s corner.",
      "translator_note": null
    },
    {
      "id": "msb_000FBC10",
      "source_words_sha256": "eb5278a36627b6bf37a9ac9547de2361b4894125b13e9e401a72546d7e8eb6fb",
      "english": "Huh? Shienryu's gone?\nI haven't even\nmade my wish yet...",
      "translator_note": null
    },
    {
      "id": "msb_000FBDA4",
      "source_words_sha256": "62785c2e7419098040fcaa22c17745a5c5dcb6d7b24039b147ce8763a81e92b5",
      "english": "Dodged it...",
      "translator_note": null
