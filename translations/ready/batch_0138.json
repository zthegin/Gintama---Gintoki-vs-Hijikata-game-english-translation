      "source_words_sha256": "677f3a8d23991d2e34bd71adaf91a5127995d4286f74c76d33a5eba13eab3fee",
      "english": "Now...\nAll your wishes\nhave been granted...\fI enter eternal sleep\nwith the Dragon Tama...\fWe shall not meet again...\fFarewell...",
      "translator_note": null
