      "translator_note": null
    },
    {
      "id": "msb_0005253C",
      "source_words_sha256": "74f8c5e65b72cf666b7198051a7d19cf72520086a90c9ef7a60c27fb67b74765",
      "english": "[ctrl:FFA2]What's with you people?!",
      "translator_note": null
    },
    {
