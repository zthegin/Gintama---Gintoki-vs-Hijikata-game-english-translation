    },
    {
      "id": "msb_00052600",
      "source_words_sha256": "1d9e273f903d5acb0fcf5942411b938eb77868201a922509b645b414ab642900",
      "english": "[ctrl:FFA2]Come on, Gin. No time\nfor someone with\na suspicious nose!",
      "translator_note": null
    },
    {
      "id": "msb_00052658",
      "source_words_sha256": "5936bacf5b7911c9a53f37ae67989e0864c26ae24d14bb8c600d7ec3c533c6e1",
      "english": "[ctrl:FFA3]Um, excuse me...",
      "translator_note": null
    },
    {
      "id": "msb_00052670",
      "source_words_sha256": "0e77bfb30ee9c042dc961c60aa315f582033c82fc89462a034615ef8f2ddca18",
      "english": "[ctrl:FFA3]Kagura, restrain Shinpachi.\n...So, what are you\ndoing here tonight?",
      "translator_note": null
    },
    {
      "id": "msb_000526B8",
      "source_words_sha256": "ce1cb81f29cbc3948a1288b52db0679aa281e0e03e30ae884d8bb42c37c0e906",
      "english": "[ctrl:FFA3]Who with? Not just\nmother and daughter\ndining here, surely?",
      "translator_note": null
    },
    {
      "id": "msb_000526F4",
      "source_words_sha256": "7a9fca587a7d6945d928ea299d9c4256746ba1d0f3f0f365af93e0fec328e3c7",
      "english": "[ctrl:FFA3]Work?",
      "translator_note": null
    },
    {
      "id": "msb_00052700",
      "source_words_sha256": "f5c08a64114938e0540328832dd6c3f3df06fc199e2b457d11806bdd7aea1bf2",
      "english": "[ctrl:FFA3]Restrain him, Kagura!\n...Um...\nSorry to bother you.",
      "translator_note": null
    },
    {
      "id": "msb_00052754",
      "source_words_sha256": "e58ebe7f7c9f77f021428b7b9cc362f4cc067fded8d24bc009c46145079258bc",
      "english": "[ctrl:FFA3]Shinpachi. Shut up\nor get punched.\nYour choice.",
      "translator_note": null
    },
    {
      "id": "msb_00052798",
      "source_words_sha256": "e6f20ec3618f2855808a2cb1bb0d2c6c0551485158340a933a25eec8b12bdcc5",
      "english": "[ctrl:FFA3]Right, next room...",
      "translator_note": null
    },
    {
      "id": "msb_000527BC",
      "source_words_sha256": "6c123f346824cef91efc8076915e04bb182946405ae5d0c4e35df4b87413c78f",
      "english": "[ctrl:FFA3]Hm? Nose's voice...",
      "translator_note": null
    },
    {
      "id": "msb_000527F8",
      "source_words_sha256": "53c7a356178f25f10208b630f92f76ffb74cd21b046bd0340ee059b2bd4facbb",
      "english": "[ctrl:FFA2]Calm down, Shinpachi.\nYour words are remixed!",
      "translator_note": null
    },
    {
      "id": "msb_00052834",
      "source_words_sha256": "847823791c24443cd539bb7318332b0930bb0487ed0efe95ed80adbd6137396b",
      "english": "[ctrl:FFA2]Shinpachi!\nCome on! March!",
      "translator_note": null
    },
    {
      "id": "msb_00052860",
      "source_words_sha256": "6c14b539655650ea148ac007e3d4a9f349a17251c6f7a12cd99cbe5a2bc6aa6e",
      "english": "[ctrl:FFA2]So it WAS the nose\nthat was suspicious.",
      "translator_note": null
    },
    {
      "id": "msb_0005289C",
      "source_words_sha256": "a00d9ae1e815247a4f79dd8de3b92dc8b591f9f32384685d3d60510f4e0d53d6",
      "english": "[ctrl:FFA2]I said ONLY my nose\nhad plastic surgery!",
      "translator_note": null
    },
    {
      "id": "msb_000528D8",
      "source_words_sha256": "cfa323809fc7ca25ce566f6fa3fa93e22ce7b994489a4147006a15158a8e0927",
      "english": "[ctrl:FFA2]Barging in like that!\nWhat do you want?\nEating, obviously!",
      "translator_note": null
    },
    {
      "id": "msb_00052928",
      "source_words_sha256": "1f6b1491d84d2b5212fb819c1181422da6dc8b03299de65a000c09c70de45491",
      "english": "[ctrl:FFA2]Work. Entertaining\nclients tonight.",
      "translator_note": null
    },
    {
      "id": "msb_00052954",
      "source_words_sha256": "78d4029e3aac79451bbc3ce5a92fa560b492156a4ea69ebf8bdbd15950dc8339",
      "english": "[ctrl:FFA3]Popularity's your business.\nHave to keep\nyour connections alive.",
      "translator_note": null
    },
    {
      "id": "msb_000529A0",
      "source_words_sha256": "7234ce870253759fbedbaf0044cd6c02196fb36ed1f11293f484432778bacfac",
      "english": "[ctrl:FFA2]How rude! I'd never\ndo such a thing!",
      "translator_note": null
    },
    {
      "id": "msb_00052A0C",
      "source_words_sha256": "9b1bcd3206b766e979f64ae3aee34ee0fc4a6338a1b81889a6e1c9abbd11b6d3",
      "english": "[ctrl:FFA2]What is it, Rumble Roses?",
      "translator_note": null
    },
    {
      "id": "msb_00052A30",
      "source_words_sha256": "c782caa429d8e91182aef811f5c208598bffac8906d7a870bfb8d11e915313af",
      "english": "[ctrl:FFA2]Oh? Aren't you...\n[ctrl:FFB1]Otsu Fan Club Captain,\ncome to Santa Monica...!",
      "translator_note": null
    },
    {
      "id": "msb_00052A94",
      "source_words_sha256": "6694639ccfaaddaf0ac034dd3efb4e1a588c1ebd40b31016dc5f1b261c3dc21c",
      "english": "[ctrl:FFA3]A wig? [ctrl:FFA1]How rude!\n[ctrl:FFA2]My hair's real,\nYorkshire terrier!",
      "translator_note": null
    },
    {
      "id": "msb_00052ADC",
      "source_words_sha256": "8270be5d77646538f2eb96031c81c5ac512c80f1160064773562da57258c4aee",
      "english": "[ctrl:FFA2]Eek! What's got into\nyou, Northern Lights?!",
      "translator_note": null
    },
    {
      "id": "msb_00052B70",
      "source_words_sha256": "e44cb730e4f41802fa4bc12e10486f94a8dcf60fe16ee71af2c111423788667e",
      "english": "[ctrl:FFA1]W[ctrl:FFB1]-[ctrl:FFA2]Whoa![ctrl:FFB1]\nO[ctrl:FFB2]-O[ctrl:FFB2]-O[ctrl:FFB2]-Otsu?!",
      "translator_note": null
    },
    {
      "id": "msb_00052BAC",
      "source_words_sha256": "725ab87d54195ddef60caaf51ed3cced62a041c3d77da9ce4e492b325f152611",
      "english": "[ctrl:FFA2]Otsu?! What's wrong?!\nRonin Tama deals,\nrebels and Katsura?!",
      "translator_note": null
    },
    {
      "id": "msb_00052C0C",
      "source_words_sha256": "fe67e9cad89700c7226acddeaf50131c25735f76f5d5589ede4efc72fa41a0d7",
      "english": "[ctrl:FFA2]C[ctrl:FFB2]-c[ctrl:FFB2]-clients?!",
      "translator_note": null
    },
    {
      "id": "msb_00052C30",
      "source_words_sha256": "12dfad6e4ec09a9b4f9f75787b99b6eab58e637d2ac7ce19e8b0a7ee8b7b524f",
      "english": "[ctrl:FFA3]Surely not...\nDoing this and that\nwith dirty old men...?!",
      "translator_note": null
    },
    {
      "id": "msb_00052C80",
      "source_words_sha256": "a1f2745275ba5f110abdcced82ba59c7390321c8f56e1ff418d87abce42d6639",
      "english": "[ctrl:FFA3]Mmph... Mmmph...\n...Otsu...\n...!",
      "translator_note": null
    },
    {
      "id": "msb_00052CD4",
      "source_words_sha256": "e0c1a760f969b47152ff396a8b540f6f698e90980ee8673722d7ea1c52c39ebd",
      "english": "[ctrl:FFA2]M[ctrl:FFB1]-my Otsu...!!",
      "translator_note": null
    },
    {
      "id": "msb_00052CFC",
      "source_words_sha256": "3661bdb2fc0c37c895a1a73846da14377201510d2ac514c3fe5720241a77c313",
      "english": "[ctrl:FFA3]...I'll shut up.",
      "translator_note": null
    },
    {
      "id": "msb_00052D4C",
      "source_words_sha256": "27f538766a0b42c1df361e9823d2787566a7c338cb30ba4dea6bb9a4ae6d8878",
      "english": "[ctrl:FFA2]Yes, yes![ctrl:FFB1]\nImportant clients\nbooked us tonight!",
      "translator_note": null
    },
    {
      "id": "msb_00052D98",
      "source_words_sha256": "5592c57d699e401c9087b1cc68debff08f554d9a9bc955735c895cd341c87b7d",
      "english": "[ctrl:FFA3]Come to think of it...\nOdd. She was just with me.",
      "translator_note": null
    },
    {
      "id": "msb_00052DD8",
      "source_words_sha256": "751d30aeeb61e96e9277c0dca64cd97846ee54cb0d1b17c9c1242fc691826001",
      "english": "[ctrl:FFA3]Excuse us...\nHm? ...",
      "translator_note": null
    },
    {
      "id": "msb_00052E10",
      "source_words_sha256": "5d472c63e7ff5d65c469810ee612abf6128a50f0216db9a8a21b8d5edd60e8cf",
      "english": "[ctrl:FFA1]Gah?!",
      "translator_note": null
    },
    {
      "id": "msb_00052E20",
      "source_words_sha256": "31f0e3e7004cf7d358a045f370622a8daeeb1b4e3442580036c4f6b94f25d4f5",
      "english": "[ctrl:FFA3]No thanks.[ctrl:FFB1]\nVery firmly, no thanks.",
      "translator_note": null
    },
    {
      "id": "msb_00052E58",
      "source_words_sha256": "2b8a434f7db59c8738322f9eed74dc4351616af7cbc6b756b17f194c5cff9158",
      "english": "[ctrl:FFA3]Right. Is Katsura...\nI mean, Zurako\nnot here tonight?",
      "translator_note": null
    },
    {
      "id": "msb_00052E9C",
      "source_words_sha256": "dcb42d00d72160b35b2872e37aeb5ca0a25f5e459b2454fc0941dd13631cf893",
      "english": "[ctrl:FFA3]Really?!\nHe's here, then?!",
      "translator_note": null
    },
    {
      "id": "msb_00052EC8",
      "source_words_sha256": "92bf5888579616822ebc01c5b98c0ffaae456a3f3b3594dfe828c676f0c71efd",
      "english": "[ctrl:FFA3]Yeah, I know.\n...Sorry to bother you!",
      "translator_note": null
    },
    {
      "id": "msb_00052EF8",
      "source_words_sha256": "42bae88d1813dd37737e88883766ca5ba74cff36c8f75968bbbb826e8a56419f",
      "english": "[ctrl:FFA3]Damn Zura...\nJust missed him.",
      "translator_note": null
    },
    {
      "id": "msb_00052F28",
      "source_words_sha256": "8318abbcaba541aa112906525b029bc8194b9e5913bc28440027fbd6b7900580",
      "english": "[ctrl:FFA3]Calm down, Shinpachi.\nHearing things. Puberty.",
      "translator_note": null
    },
    {
      "id": "msb_00052F60",
      "source_words_sha256": "f45601aa839e99f0fe7ce38487f5b47147e97d251bbbfaf8159d97287ab030d2",
      "english": "[ctrl:FFA3]Right. Drink some\nstrawberry milk.\nLet's find Zura.",
      "translator_note": null
    },
    {
      "id": "msb_00052FA0",
      "source_words_sha256": "89e23898530c708e108a48b317754b81e559b6bd630e4f0291f25bffb685d3ff",
      "english": "[ctrl:FFA2]Need more calcium.",
      "translator_note": null
    },
    {
      "id": "msb_00052FC0",
      "source_words_sha256": "6abcb36b129a56e5f9a31e3f38b8cc94fb5132086360b152bd6e70c00c21ff9f",
      "english": "[ctrl:FFA5]Hahaha! [ctrl:FFA3]It's fine.\nCome on. Join us!",
      "translator_note": null
    },
    {
      "id": "msb_00053008",
      "source_words_sha256": "9ef39ac272dc8abdf52f0021f0f8880f5a9171eca1224c0be352bce251ca0a72",
      "english": "[ctrl:FFA3]What? Some impudent\ndrag queen snubbed me?\nMama, make her [ctrl:FFA5]slit her belly.",
      "translator_note": null
    },
    {
      "id": "msb_0005306C",
      "source_words_sha256": "5a932b504259aeb29eee71bb5459936fc20d9b5ac289b4ec9c20347f788952d7",
      "english": "[ctrl:FFA5]Hm? [ctrl:FFA3]Not drinking?\nYoungsters. No fun at all.",
      "translator_note": null
    },
    {
      "id": "msb_000530AC",
      "source_words_sha256": "7e25176c40bf8766630392c602b646d729558031319e2289cb3addc4d840e7e7",
      "english": "[ctrl:FFA1]Oh! [ctrl:FFA2]Sweet potato surprise!",
      "translator_note": null
    },
    {
      "id": "msb_000530D0",
      "source_words_sha256": "0ee5a01889b8f36c7cc17278514bff7bb46a74075f6031effb5f562a0d70be74",
      "english": "[ctrl:FFA3]You lot again?\nStop getting\nin the way of work!",
      "translator_note": null
    },
    {
      "id": "msb_00053120",
      "source_words_sha256": "a4a9f0db05d4ca13e8275118d15e6883759c21ba29d56cd833ed6e1c2a9bb61e",
      "english": "[ctrl:FFA3]Huh? Zurako?\nOdd. Where is she...?",
      "translator_note": null
    },
    {
      "id": "msb_00053158",
      "source_words_sha256": "45dc9c20498ea358c50177e922f882a36a6b36dd814509d4f4e2ee58c11011f9",
      "english": "[ctrl:FFA3]Why would I lie?\nShe insisted on\nworking tonight's party...",
      "translator_note": null
    },
    {
      "id": "msb_000531BC",
      "source_words_sha256": "a33ef838b7f2bca87fc097396154a8e02a1224fb40e37bb8869b6d9010d140b4",
      "english": "[ctrl:FFA3]S-Saigo...?!",
      "translator_note": null
    },
    {
      "id": "msb_000531E0",
      "source_words_sha256": "d41fac1ce1f09b4fdb6a5426a69a0747b081941c56f1001c68af9317c18a5e50",
      "english": "[ctrl:FFA3]Gin, if Saigo's here,\ncould that mean...?",
      "translator_note": null
    },
    {
      "id": "msb_00053220",
      "source_words_sha256": "01aee3df72538de042dd471f87bbd125c90ed9988c9d3f94be41988341cfab18",
      "english": "[ctrl:FFA2]...Gin!",
      "translator_note": null
    },
    {
      "id": "msb_0005323C",
      "source_words_sha256": "51ed0685df596e35205446c5dedbf576ee46cecc1e0570bfc4239fb06abd6976",
      "english": "[ctrl:FFA2]No doubt now!\nThe rebels' shady\nGin Tama deal is here!",
      "translator_note": null
    },
    {
      "id": "msb_00053284",
      "source_words_sha256": "f4ea0e23ae30f0edb865307dd5af36e47d7a7bbb1a5a01ecbf4ad4998134704f",
      "english": "[ctrl:FFA2]...And Mr. Katsura\nis involved!",
      "translator_note": null
    },
    {
      "id": "msb_000532B4",
      "source_words_sha256": "3fef684d843f6558cd3d80fbacd3763feaa272d94a1edddcbc7dd7c428890834",
      "english": "[ctrl:FFA2]I-I[ctrl:FFB1] just[ctrl:FFB2] heard[ctrl:FFB1]\nOtsu's voice!",
      "translator_note": null
    },
    {
      "id": "msb_00053374",
      "source_words_sha256": "d04ef0ffac07c39abffd59d4aba05972a0aa9533caf6bc2cc2049d4618c7bf84",
      "english": "ARGH! Get changed!\nTake off the makeup!",
      "translator_note": null
    },
    {
      "id": "msb_00053488",
      "source_words_sha256": "164289bbd3243e98655bfccbfd6af99b797482474a6d8640335c2da4c0bb1fd9",
      "english": "I'll buy time.",
      "translator_note": null
    },
    {
      "id": "msb_00053590",
      "source_words_sha256": "5b8f63b987d5b3a33cb56bef17c9a582266badbeda02e0c878694e12ed22c3f8",
      "english": "Interfere?\nToo much trouble.",
      "translator_note": null
    },
    {
      "id": "msb_000537B4",
      "source_words_sha256": "a2ae7a277d5a9d1d65a2b6dc9a9e857a4ede7dc2b61e807566f3230dfa38d19a",
      "english": "Shut up! Get in the way\nand you're arrested too!",
      "translator_note": null
    },
    {
      "id": "msb_0005394C",
      "source_words_sha256": "5a7a622008620045fb6dff6bf7f5ff062048f06637607d835b74a4ce8c52c3e8",
      "english": "[ctrl:FFA3]Coming in!",
      "translator_note": null
    },
    {
      "id": "msb_00053960",
      "source_words_sha256": "7a96af781c959c6e3bf9ec6ee0aeb785fedb9e190f0c0ef41e70949917b38b3c",
      "english": "[ctrl:FFA3]My, my. Calling your\nlifesaver names?",
      "translator_note": null
    },
    {
      "id": "msb_00053998",
      "source_words_sha256": "ce5d689d22c83e3b039d994b7c6f589dd4db25e4101f7c91c4c83ae662bd9948",
      "english": "[ctrl:FFA3]Right! Honesty's best!\nHere's your reward.",
      "translator_note": null
    },
    {
      "id": "msb_000539DC",
      "source_words_sha256": "c1836c53e2c6d37fc197c0ec599fa931c11155616304207a5338141210560a20",
      "english": "[ctrl:FFA3]That rebel Gin Tama deal?\nThe Idiot Prince\nmasterminded it.",
      "translator_note": null
    },
    {
      "id": "msb_00053A18",
      "source_words_sha256": "69e5a37b2c777a71273c9952c6ba7064d23760942cd551a3cef062f075f782cf",
      "english": "[ctrl:FFA3]Idiot Prince set it up.\nThe rebels were dupes.\nRight, Shinpachi?",
      "translator_note": null
    },
    {
      "id": "msb_00053A74",
      "source_words_sha256": "d53dee2b9aa48a4e13bd2e4208301f3468b83ec27e12d1d2a59602c1aea048f1",
      "english": "[ctrl:FFA3]So arrest him,\nmake him confess,\nor cut him down. Your choice.",
      "translator_note": null
    },
    {
      "id": "msb_00053ACC",
      "source_words_sha256": "078e7f6e0886fbb2ba5ecaf31f3aaace78ffdf2c554ed976fe6aaddc641a5f74",
      "english": "[ctrl:FFA3]Doubt me? Wasting\na good citizen's\nkindness, are we?",
      "translator_note": null
    },
    {
      "id": "msb_00053B18",
      "source_words_sha256": "590c91a51f4cd55d00381e01a5ff87fa0c211204dc581f160f95cf540571ca84",
      "english": "[ctrl:FFA3]Civic duty done.\nTime to go home.",
      "translator_note": null
    },
    {
      "id": "msb_00053B50",
      "source_words_sha256": "c07e207517b3bdfc323f4793758d99b7167fe19ec56bc13577d75d7d98294641",
      "english": "[ctrl:FFA2]Me?![ctrl:FFB1] So I WAS\nthe gift you brought!",
      "translator_note": null
    },
    {
      "id": "msb_00053B8C",
      "source_words_sha256": "168e79cfaa2a2ed7db151a1ba153085e03db201e9efa5bf8e5f15c8d2bb38ce9",
      "english": "[ctrl:FFA2]Don't embellish!",
      "translator_note": null
    },
    {
      "id": "msb_00053BA8",
      "source_words_sha256": "3a3d5acc08f47b10eb369c746619b488da4756dac9a29ab59eaee3470ac91166",
      "english": "[ctrl:FFA2]Idiot again...!\nThat name will stick!",
      "translator_note": null
    },
    {
      "id": "msb_00053BEC",
      "source_words_sha256": "b444522d9f54906d8804193c52d49ec955116591d0337c1da2950f00b2cf23c0",
      "english": "[ctrl:FFA3]Too late, Prince.\nIt already has.",
      "translator_note": null
    },
    {
      "id": "msb_00053C20",
      "source_words_sha256": "49c08852ad7cba006aa47c14be710258033bc921f146d53e6d61e1baa8b17adc",
      "english": "[ctrl:FFA2]And he meant\nto eat that cicada!",
      "translator_note": null
    },
    {
      "id": "msb_00053C54",
      "source_words_sha256": "cd70872dd0a71e20f661c0f5b2ea49fa663b109e8918bf891513b7a9a544c3b1",
      "english": "[ctrl:FFA2]What do you want?!",
      "translator_note": null
    },
    {
      "id": "msb_00053C6C",
      "source_words_sha256": "a6659277dbcf124c11cdc79a45d7ab33e42215601cb56f834607a081d1fb9d95",
      "english": "[ctrl:FFA5]U-ugh... [ctrl:FFA3]Damn.\n...Thanks for your help\nat [blue]Mayoi Bridge[/color]. Hmph!",
      "translator_note": null
    },
    {
      "id": "msb_00053CC8",
      "source_words_sha256": "6d0dfbd139c0a34fa1b527902585bb99901ab62d66324f5ea910a0cdb461d719",
      "english": "[ctrl:FFA1]Hm?",
      "translator_note": null
    },
    {
      "id": "msb_00053CD4",
      "source_words_sha256": "bc95baa60175e8ec7f61f8605cbb2207822d0d3eececc05b28b33e9f18beca26",
      "english": "[ctrl:FFA3]...You'd better be right.",
      "translator_note": null
    },
    {
      "id": "msb_00053CF8",
      "source_words_sha256": "4458c95c20fc8a609f1ed6ff72e9db3c450c4d94a288121fead30a3cf8117e63",
      "english": "[ctrl:FFA3]...I see.[ctrl:FFB2] Fine.[ctrl:FFB1]\n[ctrl:FFA2]Yamazaki, arrest the idiot.",
      "translator_note": null
    },
    {
      "id": "msb_00053D3C",
      "source_words_sha256": "475c1370ca641455f6eaf7120f1f79380698dd8aef487258e312f5a3656e4032",
      "english": "[ctrl:FFA3]Oh? [ctrl:FFA2]Yorozuya?",
      "translator_note": null
    },
    {
      "id": "msb_00053D5C",
      "source_words_sha256": "fee598621ab197f7809ae3f18dbfa24f7744228ac9287116eca638369ec56109",
      "english": "[ctrl:FFA2]Mastermind?\nThen, sir,[ctrl:FFB1] this case...?",
      "translator_note": null
    },
    {
      "id": "msb_00053D98",
      "source_words_sha256": "94f464320330c25b67bbc75db226039fa82c9cb85eb80cbe9e00892ba78ec2ca",
      "english": "[ctrl:FFA2]Kondo, cash and Gin Tama\nin the Idiot Prince's bags!\nSeems he told the truth.",
      "translator_note": null
    },
    {
      "id": "msb_00053DFC",
      "source_words_sha256": "6fa9a4d2169e54e17f9abf561c244c524d62fbfdfe46745e25e28d42009925f4",
      "english": "[ctrl:FFA3]Heh...\nEver the slippery one...",
      "translator_note": null
    },
    {
      "id": "msb_00053E38",
      "source_words_sha256": "d4e1cdcb1241be40b590ae503a150c09547bccc1f5dee7d9aad0440860c6df4c",
      "english": "[ctrl:FFA2]Y-yes! Selling Gin Tama\nat outrageous prices\nto buy a space cicada!",
      "translator_note": null
    },
    {
      "id": "msb_00053E94",
      "source_words_sha256": "ef89008fbf4bc0235d78d8a8e4b0d2fdc2fd7376fb864756bf6a9f900b5f3175",
      "english": "[ctrl:FFA1]Yes![ctrl:FFA2] Move it, idiot!",
      "translator_note": null
    },
    {
      "id": "msb_000541F8",
      "source_words_sha256": "dbd0779618f896573ea712a2bda621aa4155d8f8099fe83ebd577ae693acde08",
      "english": "Not a grain of rice left.\nWe'll really starve\nat this rate...",
      "translator_note": null
    },
    {
      "id": "msb_00054270",
      "source_words_sha256": "783e8353a9182b242dbd264a516dedeafc4d839a3393f283c02655a567cf2de3",
      "english": "Don't worry.\nBack where we belong.",
      "translator_note": null
    },
    {
      "id": "msb_000542A8",
      "source_words_sha256": "8e94eb67b1bf0c2ed629841c824481529ac8574f87f31fb6b944e49257ae9642",
      "english": "Annoying perm, though.",
      "translator_note": null
    },
    {
      "id": "msb_0005442C",
      "source_words_sha256": "9fc25c0d5d4ce7f8acbd1f0d0a9805e0917d5d81a0b161d27376628c98cd9fe3",
      "english": "That's a line for people\nwho've actually HAD money\ncome their way!\fFind a job! Now!\nOr I'll throw you out\nfor real!",
      "translator_note": null
    },
    {
      "id": "msb_000544C0",
      "source_words_sha256": "04cf368c1cb143f7356cf056fd7ad2067ef17fe84998abbbb42b89de528b9624",
      "english": "Still have the nerve\nto say that?!!",
      "translator_note": null
    },
    {
      "id": "msb_00054634",
      "source_words_sha256": "47cb8aa810b28d1b9159db2fdf143dbaaedf96c6b4bcf7fc8d29ae5248fb28ef",
      "english": "...Apparently blamed\nfor failing to supervise us.",
      "translator_note": null
    },
    {
      "id": "msb_00054668",
      "source_words_sha256": "bfd752569a08b8e83f2041934a9746e1d9cdcd722489cbdc0082a5244c5cb74f",
      "english": "More like thrown out\nof our NEW home...",
      "translator_note": null
    },
    {
      "id": "msb_000547A8",
      "source_words_sha256": "7bb996f98bbc648c7a31a02f1ad596e6e443ed2ec8e2d3fa717c40befbe7d0d6",
      "english": "Then what?\nNo space pirates\nthis time, either...\fOh! The Shinsengumi!\nBanning Tama inquiries?\nSuspicious, aren't they?",
      "translator_note": null
    },
    {
      "id": "msb_00054930",
      "source_words_sha256": "669a372177de605b105ef78f0a2456ca2bf8da0dfc0ef4537ffab36a1c441d1a",
      "english": "[ctrl:FFA3]A promise between men.\nTalk to the manager.",
      "translator_note": null
    },
    {
      "id": "msb_00054964",
      "source_words_sha256": "21f43cba7a03ae93de3091e39bff1b1a5e676dcda496a05d45a6c95772d9e421",
      "english": "[ctrl:FFA2]Damn! I lost!!",
      "translator_note": null
    },
    {
      "id": "msb_00054988",
      "source_words_sha256": "0940cccdf65fe47126d8e9566dba4155dcc0a96d774bdd7c78e9fb3c784e9d27",
      "english": "[ctrl:FFA1]Damn! [ctrl:FFA3]Fine.\nI'll talk to him.[ctrl:FFB1] But!\nDon't you disgrace me!",
      "translator_note": null
    },
    {
      "id": "msb_000549E4",
      "source_words_sha256": "886b6a7f029447b27a144c650b18fbf21a75ca174133e53d581078aa55192eb6",
      "english": "[ctrl:FFA2]Relax. Not much\nof a face to lose.",
      "translator_note": null
    },
    {
      "id": "msb_00054A18",
      "source_words_sha256": "57ad5d434464be28a6bef104d79fb73a550efa7b323abf0aa06ca39d39a02dbb",
      "english": "[ctrl:FFA3]Ugh, fine. A loss\nis a loss. I admit it.\nI'll work here as promised!",
      "translator_note": null
    },
    {
      "id": "msb_00054A6C",
      "source_words_sha256": "55022eeacb6fe0bebb393d6c57f14adc14da0479ee3b31b95c4fb0b6fbb50543",
      "english": "[ctrl:FFA5]Hahaha! [ctrl:FFA3]Serves you right!\nI win!",
      "translator_note": null
    },
    {
      "id": "msb_00054A9C",
      "source_words_sha256": "8de5d505afb8be6a9cb85c5a812f4f56f5095fa7e9cc5428bbea83660165002f",
      "english": "[ctrl:FFA3]...",
      "translator_note": null
    },
    {
      "id": "msb_00054AB0",
      "source_words_sha256": "8de5d505afb8be6a9cb85c5a812f4f56f5095fa7e9cc5428bbea83660165002f",
      "english": "[ctrl:FFA3]...",
      "translator_note": null
    },
    {
      "id": "msb_00054AC4",
      "source_words_sha256": "84c89baccb40c342cca78fabd4262fa1b371b9d302f5a43a9116b5b31619c161",
      "english": "[ctrl:FFA3]Somehow, this\ndoesn't sit right...",
      "translator_note": null
    },
    {
      "id": "msb_00054AF4",
      "source_words_sha256": "25f48c45cf606f7dcfacfee4859713895607a7c8db393c47b04f6f7d7c01527a",
      "english": "[ctrl:FFA3]...",
      "translator_note": null
    },
    {
      "id": "msb_00054B14",
      "source_words_sha256": "b91d11aca6c2f5982dbb27c8e0a5aef96dd99856900f6bfecf77b4a324726742",
      "english": "[ctrl:FFA2]Gin and Shinpachi!\nSo manly and honorable!",
      "translator_note": null
    },
    {
      "id": "msb_00054B44",
      "source_words_sha256": "3329bdf223836280404bd4274b2c04f41311be65f2323d7e749bcbb9a20bbff5",
      "english": "[ctrl:FFA2]Leap before thinking!",
      "translator_note": null
    },
    {
      "id": "msb_00054B60",
      "source_words_sha256": "bf987fbe2047caea0de9110d24b9b5ce60f0c601bdf03484d5b334b5e86df342",
      "english": "[ctrl:FFA3]A promise between men.\nI hate it, but\nwe have to honor it.",
      "translator_note": null
    },
    {
      "id": "msb_00054B9C",
      "source_words_sha256": "3e9adc9639397882cb02d007af3083efe339ddd310f7cee1fb42395592e16f5b",
      "english": "[ctrl:FFA3]Don't think, Mr. Hasegawa.\nThink and you lose!",
      "translator_note": null
    },
    {
      "id": "msb_00054BD0",
      "source_words_sha256": "7996697f1d7f6996ed6221cb0483185b0615c24c696c2190f33f9fdb36ae010e",
      "english": "[ctrl:FFA3]Hehehe. Justice wins.",
      "translator_note": null
    },
    {
      "id": "msb_00054BEC",
      "source_words_sha256": "660660195a2156c24f3f61e515890c35f97da1f2e7b6d3547e6475a7a1726fe2",
      "english": "[ctrl:FFA3]As promised.\nInto the kitchen.",
      "translator_note": null
    },
    {
      "id": "msb_00054C14",
      "source_words_sha256": "c45c03c9ebaa0bba09502597e424340e1c297946160070f56d264a78b81f0822",
      "english": "[ctrl:FFA3]Say we're chefs\ntrained at a famous\nKyoto place. Whatever.",
      "translator_note": null
    },
    {
      "id": "msb_00054C54",
      "source_words_sha256": "d768eb23c446430e648eb67f7b448cd7c1df33532b17fa709a40044a771054fd",
      "english": "[ctrl:FFA3]What?! Even I\nhaven't set foot\nin the kitchen!",
      "translator_note": null
    },
    {
      "id": "msb_00054C98",
      "source_words_sha256": "9f9398aca69597f36052dd53fcd4594c8a44e765ee4cf96d4ea27f69777bf371",
      "english": "[ctrl:FFA3]What do I tell the boss...?",
      "translator_note": null
    },
    {
      "id": "msb_00054CC0",
      "source_words_sha256": "25f48c45cf606f7dcfacfee4859713895607a7c8db393c47b04f6f7d7c01527a",
      "english": "[ctrl:FFA3]...",
      "translator_note": null
    },
    {
      "id": "msb_00054CE0",
      "source_words_sha256": "7e8947a0962a956879d8fe645ccb4e41d732c8d683cb23eb52337efc56208c7a",
      "english": "[ctrl:FFA2]Yes! I won!",
      "translator_note": null
    },
    {
      "id": "msb_00054CF8",
      "source_words_sha256": "e309c388aca86cd1d09e72a5f451be7f74847f42bc90abaa003000995ea48d90",
      "english": "[ctrl:FFA3]Damn. I lost...",
      "translator_note": null
    },
    {
      "id": "msb_00054D20",
      "source_words_sha256": "f0c044042151cbd84841cc3f6c877372276895bf75e68edd78f728cadb316f3a",
      "english": "[ctrl:FFA2]Wait! Don't be rash![ctrl:FFB1]\nListen! This is a game!",
      "translator_note": null
    },
    {
      "id": "msb_00054D5C",
      "source_words_sha256": "3c3e3927a3cf34ff26a7234abf1708277d88e9dd5d13c8a65b96e0faba61f0e1",
      "english": "[ctrl:FFA3]Games have a last resort.",
      "translator_note": null
    },
    {
      "id": "msb_00054D80",
      "source_words_sha256": "58b3014e9639759ddf7372e688a7fce570b67f49354b450a91bac3e16e9c0e37",
      "english": "[ctrl:FFA3]Fail? Just try again!",
      "translator_note": null
    },
    {
      "id": "msb_00054DA8",
      "source_words_sha256": "97154f04f8daf18ede35b55bfdf1cc250bf855e5d8580ceac3a1f3fa5c834bc6",
      "english": "[ctrl:FFA3]For now, [red]GAME OVER[/color]!!",
      "translator_note": null
    },
    {
      "id": "msb_00054DD4",
      "source_words_sha256": "46eb90146eec99cb61ae7c1238b8e0975b1ef12c5785c730195f9ac95fd58eff",
      "english": "[ctrl:FFA3]As promised,[ctrl:FFA3]\nyou're[ctrl:FFA1] FIRED!",
      "translator_note": null
    },
    {
      "id": "msb_00054DF8",
      "source_words_sha256": "c593b6e4ab06cb28753a4641e11a3e44557a23f8d1811bd6f6748597d513a262",
      "english": "[ctrl:FFA1]No! [ctrl:FFA3]Absolutely[ctrl:FFA1] NOT!",
      "translator_note": null
    },
    {
      "id": "msb_00054E18",
      "source_words_sha256": "412b638693d03c36a5c3f0cd4b08689434860bafca4e772d72a635ee81c41017",
      "english": "[ctrl:FFA2]Gin's fault!\nNow we'll all starve!\nSTARVE!",
      "translator_note": null
    },
    {
      "id": "msb_00054E50",
      "source_words_sha256": "65577a52dfd83af6ffc23f425464b443e20ff8df529358e421147e2893ee42a4",
      "english": "[ctrl:FFA2]Last resort? What?",
      "translator_note": null
    },
    {
      "id": "msb_00054E68",
      "source_words_sha256": "1327cda5177521d8a144ebff982e7c67168a7a8a3faed72ebb903792b61bd4d2",
      "english": "[ctrl:FFA2]Please, Mr. Hasegawa!",
      "translator_note": null
    },
    {
      "id": "msb_00054E8C",
      "source_words_sha256": "9b8a33f5e511fe3338c1e90fa5d2433a981010f8edc0cc8121cbee93cc5f10ea",
      "english": "[ctrl:FFA2]So what is it?",
      "translator_note": null
    },
    {
      "id": "msb_00054EA8",
      "source_words_sha256": "e2ce4a50d0a39ac3cc131989f6afe22d76d2ed95af72596936ca58db736c3bbe",
      "english": "[ctrl:FFA3]...Meaning?",
      "translator_note": null
    },
    {
      "id": "msb_00054EC4",
      "source_words_sha256": "25f48c45cf606f7dcfacfee4859713895607a7c8db393c47b04f6f7d7c01527a",
      "english": "[ctrl:FFA3]...",
      "translator_note": null
    },
    {
      "id": "msb_00054F20",
      "source_words_sha256": "1d932bbd50499c735d640bcc9542b648f96ea3d75bf7df3cb693f90c7834c2dc",
      "english": "Not asking HIM\nfor help!",
      "translator_note": null
    },
    {
      "id": "msb_00054F48",
      "source_words_sha256": "a465d77f86218caf5d3ad9170e6136b58a9673b9cba6b45a8725fcf27ba1313b",
      "english": "Gin Tama will beat you!\nBrace yourself, robot!",
      "translator_note": null
    },
    {
      "id": "msb_00055248",
      "source_words_sha256": "58072bd88fbc340fc4f3a6505f75fdb518671ef60ca2c4a2d21d4a4aeac17c0c",
      "english": "Hm... Seen him\nsomewhere before.",
      "translator_note": null
    },
    {
      "id": "msb_000552C4",
      "source_words_sha256": "4a1ca3ef53468e94eb73446de6989365d24f8a72287f0d412084fa2b53897099",
      "english": "This old man\nbuilt the robot.",
      "translator_note": null
    },
    {
      "id": "msb_000554AC",
      "source_words_sha256": "3921a09ba850f5476779857c5e62b3cdc28ed6e8e9a15b8ac401bc02c8412ea3",
      "english": "The past makes\nthe present.\nThat's history.",
      "translator_note": null
    },
    {
      "id": "msb_000557BC",
      "source_words_sha256": "aed29f4a15744cc5ce8b1b7872c599f21ac03e48ccea78653ddb6fb96b948475",
      "english": "Who IS this old man?",
      "translator_note": null
    },
    {
      "id": "msb_000557FC",
      "source_words_sha256": "dcd74100b681821274a234bd4e95f00f8159caaa06dd8a2769108e258b6cbf5d",
      "english": "Wait, old man.",
      "translator_note": null
    },
    {
      "id": "msb_000558DC",
      "source_words_sha256": "7ffac2d76553f4c8ab9991f5f0ec223f7c66d34aee048ac94c5ca45b7207d776",
      "english": "Briefly.",
      "translator_note": null
    },
    {
      "id": "msb_00055EA8",
      "source_words_sha256": "469b9fa932fc002fd68d809ef80b8cd8fb0cf8e678d5b6d1a61232db18e8c8f4",
      "english": "Whoa!!\nIt talked?!",
      "translator_note": null
    },
    {
      "id": "msb_0005612C",
      "source_words_sha256": "629d6bf48bdcca94bfef8b0069d6bae9f382da11c116e09d2ab74b491e4600e7",
      "english": "Not fair, Katsura!",
      "translator_note": null
    },
    {
      "id": "msb_00056164",
      "source_words_sha256": "05a1372e0fa34eb860f826b6c33c063e9d66aa18e8869d6f8a340dc6ab84f23d",
      "english": "Fine. A promise\nis a promise. Do as you like.\n...Let's go, Shinpachi, Kagura.",
      "translator_note": null
    },
    {
      "id": "msb_00056254",
      "source_words_sha256": "f422b3a3fdb9c6b9c6fe6a62c036be30d18cb3ccc54705f2d7d52cea81987544",
      "english": "I win. As promised,\nno more prying.",
      "translator_note": null
    },
    {
      "id": "msb_000564F0",
      "source_words_sha256": "ac5d2c2b0b14da155d9ca1e299a2e7b0b84cedee3cd7aecc62f516e702903631",
      "english": "Next time, buy me\nmatcha cream zenzai.",
      "translator_note": null
    },
    {
      "id": "msb_00056528",
      "source_words_sha256": "0fd22935ea1ace70d8843f2ab5fbac31bcad4ee09080aaf0e77bf3ca82e6d435",
      "english": "Advice? What?\nNot 'cut back on sweets.'\nThey're my reason to live.",
      "translator_note": null
    },
    {
      "id": "msb_00056574",
      "source_words_sha256": "e56aa83826900d2effd7499d1dedc016a32964bfef2002ac7cbd85816de6edeb",
      "english": "...Yeah. I'll try\nto remember. Bye!",
      "translator_note": null
    },
    {
      "id": "msb_000565E8",
      "source_words_sha256": "c2633a0b496bcf5f0f7b87d5f7a6aa6da9ded05ba6d4cc6c8429d0dce9aa7e3d",
      "english": "Hm? Oh, damn.\nI DID tell them\nrebels gather here...",
      "translator_note": null
    },
    {
      "id": "msb_00056648",
      "source_words_sha256": "fffff486d4015cfa7c0ab52a94ffa5b9c97a58fc6fb8803654926c34d73d83a8",
      "english": "Trying to let old Hiraga\nescape. Slipped out...\fThat bastard tricked me!\nSaid investigating\nGin Tama was forbidden!",
      "translator_note": null
    },
    {
      "id": "msb_00056868",
      "source_words_sha256": "a38e93fbfe8da9cba99a1e54742ee03fff2029a16f166e5f7375d6c32825e3e1",
      "english": "A rare cicada creature\nfrom Alpha was online.\nI simply had to have it.",
      "translator_note": null
    },
    {
      "id": "msb_00056DC4",
      "source_words_sha256": "c9703b71a2f4a14da23ad2d5f0f14086ff46baad2fc7a8edd77d1a838edfc1cb",
      "english": "Remember this!",
      "translator_note": null
    },
    {
      "id": "msb_00056EB4",
      "source_words_sha256": "ee61cbe3363711cb3cd0c3545dc5e07e423e71b04ad2d4d5ac6b98432cc36f39",
      "english": "Tch! Don't care!\nOverthinking makes you bald.\nBald AND glasses? No girls!",
      "translator_note": null
    },
    {
      "id": "msb_00056FF0",
      "source_words_sha256": "7c051f9df351f0cef724784ec045a7bc7f77ef58e9b0e3ee12c02156c879a131",
      "english": "Gin's hiding his blush.",
      "translator_note": null
    },
    {
      "id": "msb_00057228",
      "source_words_sha256": "95d1ec1f5aee9e8897f4d1bb95197169c7972690822871ef0af728dfa9653ad7",
      "english": "Wait. Extra-mayo\nmeat bowl? Yes.",
      "translator_note": null
    },
    {
      "id": "msb_000573A4",
      "source_words_sha256": "b9441fe4026bd9fc58097ad9b6393aa83eedc00ae3459f1db7b0f19d272e0a66",
      "english": "Because you can't\npark illegally\nwherever you like... Right?",
      "translator_note": null
    },
    {
      "id": "msb_0005749C",
      "source_words_sha256": "c2aa002e0154ca111d0cbcb40746baf09e84d98fb31be372c86ee0cbdd7fad06",
      "english": "Kondo's responsible.\nMaybe...\fHe means to investigate\nGin Tama alone.",
      "translator_note": null
    },
    {
      "id": "msb_00057528",
      "source_words_sha256": "a9cbf114ea008bb2a81daddd1934a226bdeda145d6582175f31a525000637991",
      "english": "No one's committing seppuku!\fDirty work's for me,\nthe Vice-Chief.",
      "translator_note": null
    },
    {
      "id": "msb_000576E0",
      "source_words_sha256": "620b406ad994ff9cf9441b6e224471a6a9a8af8caf2e3a9474ce9e3e45bff058",
      "english": "All that racket swinging...\nDoesn't he get tired?",
      "translator_note": null
    },
    {
      "id": "msb_00057798",
      "source_words_sha256": "a3a6671b2f489d3283cf801d43d75c6414a762cee1b652be558b4425f6fa57f5",
      "english": "Take out trash\non the proper day.",
      "translator_note": null
    },
    {
      "id": "msb_000577C4",
      "source_words_sha256": "5aaabc7fa5de793c4e2ad471328a30bba497299f0b998a456f7f7341527a49fc",
      "english": "Ah, Shinsengumi!\nWhat can I do for you?",
      "translator_note": null
    },
    {
      "id": "msb_00057820",
      "source_words_sha256": "07dce0259007ed439125cc2015a889c9c86a38b35ef975b508b599e554f4561d",
      "english": "Stop by sometimes, sir.",
      "translator_note": null
    },
    {
      "id": "msb_00057874",
      "source_words_sha256": "c449ab2afd565573dd3375fa447a91ae74e74ea086bde68930c70cab5bf15b30",
      "english": "Green juice-roe parfait.\nSweet syrup omelet.",
      "translator_note": null
    },
    {
      "id": "msb_000578A4",
      "source_words_sha256": "c9f3aa6b3df180fef2c7b3b54e9e0f855cad74ce36092a4302a038db1c719460",
      "english": "And an extra-mayo\nmeat bowl.",
      "translator_note": null
    },
    {
      "id": "msb_000578C8",
      "source_words_sha256": "0d33c766112e5bf66230ee2f35bd2e1901625646ff6d1a03456d19705cb11a1d",
      "english": "That's our man.",
      "translator_note": null
    },
    {
      "id": "msb_00057AF0",
      "source_words_sha256": "5a49974ad64fe5020e7ed25f7ea16e92d07f803a9fbe1c565ee2b93e8950bb32",
      "english": "Yes, well...\nI delivered\nthe finishing stroke.",
      "translator_note": null
    },
    {
      "id": "msb_00057CB8",
      "source_words_sha256": "e0c5bd7dd4f477e9b84b5dccad020bd182c91d4ccf4f5b01ae74c4ba3da55229",
      "english": "Yes. Finally issued.",
      "translator_note": null
    },
    {
      "id": "msb_00057E38",
      "source_words_sha256": "eb075da19904d2e1333f8080734f46f96b3e6c8827c3c6a3aeea8745c1de7c99",
      "english": "Hey, a question.",
      "translator_note": null
    },
    {
      "id": "msb_000581AC",
      "source_words_sha256": "e7a2f66eb5edbb83a90475b50fbaaea63e27b07d1d7c3cbf32cedc506088add0",
      "english": "I'll kill you! How rude!\fOh, I get it!\nA new pickup line!!",
      "translator_note": null
    },
    {
      "id": "msb_00058244",
      "source_words_sha256": "6e18bae5abaab8f1ba53838512cfad6a3a78878adf3e67d8ad1688c2179f9224",
      "english": "I understand\nwhy you'd try...\fI'm beautiful.\nClever and charming.\fOf course men\ncan't leave me alone.",
      "translator_note": null
    },
    {
      "id": "msb_000582E8",
      "source_words_sha256": "f16fa2d6505782a51a1e834ec53be159f1aa8b43ce634bef1573cc98045e1c24",
      "english": "Bossy husband already?",
      "translator_note": null
    },
    {
      "id": "msb_0005837C",
      "source_words_sha256": "a480323f676a9b1ae4a026916f23c76785eed77d93f237ce67ccfd31423dc320",
      "english": "That gorilla\nbought lots of dango.\fWhat's with him?\nQuite a lavish gorilla.",
      "translator_note": null
    },
    {
      "id": "msb_000583EC",
      "source_words_sha256": "a4f1439db9df2b9e3418bd2d6d90e9f5891e08b26901f6c349e24349b369ce35",
      "english": "Lavish gorilla?\nWent toward [blue]Nabeya[/color].",
      "translator_note": null
    },
    {
      "id": "msb_0005841C",
      "source_words_sha256": "70f04ccbebe36c1e86b5f27f9c02f85b5b9336607f74de8e8355d66c1f4bbb04",
      "english": "Let's ask him.\fHey, a question.",
      "translator_note": null
    },
    {
      "id": "msb_000585B0",
      "source_words_sha256": "9fa4e1740a2ee489245e21fc0fbe3eff84a34b83b40b4b5ce24f5fb0e3370831",
      "english": "Which way did\nMr. Lavish Gorilla go?",
      "translator_note": null
    },
    {
      "id": "msb_0005884C",
      "source_words_sha256": "1e299ec468c728ec3bd5ae612e583a2b92e51c83055d67b4b7488c8c6753be8f",
      "english": "Thanks. Let's go, Sougo.",
      "translator_note": null
    },
    {
      "id": "msb_000588F0",
      "source_words_sha256": "63e0717d262767ed2b6800fff74cc5110d8ab3bd7c6d80038419a38748cc7a38",
      "english": "Hey, old man. A moment?",
      "translator_note": null
    },
    {
      "id": "msb_00058930",
      "source_words_sha256": "6db48a87355008757d4f7856da2b9e892e2305dcfa3f6b436c4052ba1c1d479b",
      "english": "Hm? Old man,\nhave we met before?",
      "translator_note": null
    },
    {
      "id": "msb_000589BC",
      "source_words_sha256": "5d40ffa9e1c22bd15e3afbe1b03f210c62da581ed3349f29dd97915e9de00801",
      "english": "Missing person?\nGo to [blue]Oedo Police[/color].",
      "translator_note": null
    },
    {
      "id": "msb_00058C7C",
      "source_words_sha256": "de34119d9e8b2cd8fd29c3c00e685ad4105046289e9386b5f1ca47793d7250bc",
      "english": "Let's ask\nthat old man.",
      "translator_note": null
    },
    {
      "id": "msb_00058D50",
      "source_words_sha256": "a29a1cd3a72ce2dfb20ad5d7390b02c210ec8378024265e9c3efc611e788a226",
      "english": "Can we just leave\nthis old man here?",
      "translator_note": null
    },
    {
      "id": "msb_00058DC8",
      "source_words_sha256": "f485b71170c4d8412b8427b6edb494ff0fe2e71c07b6f8658d4472a21efdc839",
      "english": "Game over without\nme, the hero, appearing?\nImpossible!\fGin fans nationwide\nwould be in tears.",
      "translator_note": null
    },
    {
      "id": "msb_0005917C",
      "source_words_sha256": "7d91256e2282745f5cc2f85ceadfb5e18ad02ce6b62030fc5f3770400afe614e",
      "english": "Using the chaos\nto kill me, huh.",
      "translator_note": null
    },
    {
      "id": "msb_00059660",
      "source_words_sha256": "0d0382cb9ac67f802eaa0c70a01683d6ffe4ba583d016dff82f8f8847018a98d",
      "english": "Toshi! This is\nthe moment to prove\nmy love!",
      "translator_note": null
    },
    {
      "id": "msb_00059694",
      "source_words_sha256": "a73f771f299a965d38d963c7f42ccab9affd993b60d870c186290f321e3b880b",
      "english": "No one blocks my love!\nNot even you, Toshi!",
      "translator_note": null
    },
    {
      "id": "msb_00059760",
      "source_words_sha256": "773b49568a1ab8c8f05cd08f15b4c7d44e7cb8c43d8230bb6bbb06f77bfe8a49",
      "english": "Well, Toshi?\nStill interfering?",
      "translator_note": null
    },
    {
      "id": "msb_00059CA8",
      "source_words_sha256": "61426c4e088ba6dba929a80f01d90c9ad1fca6e0322ad3b941b40fb6904f57a3",
      "english": "Prepare, Hijikata!",
      "translator_note": null
    },
    {
      "id": "msb_00059E98",
      "source_words_sha256": "1460813ada88a683633f8b5bb72354fc198902e9675a02d78ab2a8d50ca45a33",
      "english": "Shameless!\nLeave the dango\nand go home!!",
      "translator_note": null
    },
    {
      "id": "msb_0005A014",
      "source_words_sha256": "56436cc5314889700f2b5f4295f69542a87b4e7be1c95a827d6505fff6ee0664",
      "english": "Can't let that pass.",
      "translator_note": null
    },
    {
      "id": "msb_0005A02C",
      "source_words_sha256": "dcf78fe09209f0d6a10d45cf8082ace7601c375314155af84cdada511aeee5d3",
      "english": "About Kondo's dream.\nCould it be...?",
      "translator_note": null
    },
    {
      "id": "msb_0005A088",
      "source_words_sha256": "1bef55e5fb606dcd66c5a54cae373e2c12d28d399fc6ce7653e374ac6dd10270",
      "english": "A peaceful life\nwithout a persistent\nstalker following me.",
      "translator_note": null
    },
    {
      "id": "msb_0005A4F4",
      "source_words_sha256": "2ca180ee4d5487a8ef73e7e3ac64c94d7a19e7c936e04e4bedc374cce27b8384",
      "english": "Yes. Worth looking into.",
      "translator_note": null
    },
    {
      "id": "msb_0005A5F4",
      "source_words_sha256": "6cd738541547763ad2d28fc89faad83fec143a3a8dcc493637f700e45b399c71",
      "english": "Don't shout!!\nYou're embarrassing ME!",
      "translator_note": null
    },
    {
      "id": "msb_0005A620",
      "source_words_sha256": "9b4963a0cc51f8d9a87ee834ffcd8e1f47a96ae15f6fb70e503e15e24401e087",
      "english": "Stop shouting!!",
      "translator_note": null
    },
    {
      "id": "msb_0005A698",
      "source_words_sha256": "da8016e764f56e0cd6dae1908947140dc927a447151eb3e66b610d9d592de631",
      "english": "Too sweet to drink.",
      "translator_note": null
    },
    {
      "id": "msb_0005A6D4",
      "source_words_sha256": "ddc1b371240f505d7c5ad1401891d6a27f1f967429096284d0d32f78d3cc2e51",
      "english": "Leave it there.\nSomeone'll drink it.",
      "translator_note": null
    },
    {
      "id": "msb_0005A884",
      "source_words_sha256": "1a303a12dd984739aba4db499028902970665313078658584d7a6848ce8721dc",
      "english": "Asking stars\nfor autographs is polite.",
      "translator_note": null
    },
    {
      "id": "msb_0005A8E8",
      "source_words_sha256": "bce51fd4ad4c095122f153a921b2f8758094804efe2958bd77960d0b9fa879f4",
      "english": "A local police case.\nShinsengumi weren't called.",
      "translator_note": null
    }
  ]
}
