      "translator_note": null
    },
    {
      "id": "msb_000603B0",
      "source_words_sha256": "13e36030a951130fdc8d4529cd5bb6c3c3898cc6d3ab523d40d5678515879c9f",
      "english": "Hold on. Wrong way.",
      "translator_note": null
    },
    {
      "id": "msb_00060444",
      "source_words_sha256": "f4c1cfdc003b0f566a554ab144bc056a9503aafbac87b3b5e4b512475edb1448",
