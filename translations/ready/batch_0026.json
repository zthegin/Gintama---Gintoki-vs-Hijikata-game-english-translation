      "source_words_sha256": "313c1be3280b9227303f981621d8e86c3a5ce5a9574ba512141028fa75799501",
      "english": "Fine, then.",
      "translator_note": null
    },
    {
      "id": "msb_0005ED64",
      "source_words_sha256": "251116a9f2268c32ce5e774f54aa0775a1f52199c2dcde737fc9a8703ec9737c",
      "english": "Don't misread.",
      "translator_note": null
    },
    {
      "id": "msb_0005ED74",
      "source_words_sha256": "1eb72b5ce4eb778935a06643b60dca7e6380864dcaf2989f56b7bd0ddee9e707",
      "english": "All yours.",
      "translator_note": null
    },
    {
      "id": "msb_0005ED80",
