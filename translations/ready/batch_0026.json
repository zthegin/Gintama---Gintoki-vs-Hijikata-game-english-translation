      "english": "Wait! We've been here already!",
      "translator_note": null
    },
    {
      "id": "msb_000600B4",
      "source_words_sha256": "5848ca62135744da54f2f43c66381cf39e90ce9c3d764c12c8185fa1b6322610",
      "english": "Where are we?",
      "translator_note": null
    },
    {
      "id": "msb_000600C8",
      "source_words_sha256": "4a2d43b93e32bb6e4db70f9d530b397e69a06eddc18663e7ed00722faba57f59",
