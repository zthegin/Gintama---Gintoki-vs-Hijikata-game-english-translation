      "english": "Leave this to us!",
      "translator_note": null
    },
    {
      "id": "msb_0005EE08",
      "source_words_sha256": "80a238b70f16d45b42d224335262ed2671abc109f60607915db871f367324128",
      "english": "Come on! Get out of here! ...You said it yourself!",
      "translator_note": null
    },
