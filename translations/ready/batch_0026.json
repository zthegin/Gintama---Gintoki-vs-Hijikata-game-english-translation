      "english": "Dunno...",
      "translator_note": null
    },
    {
      "id": "msb_0005FECC",
      "source_words_sha256": "303d54ad50bfd64f941fcee64cd72bf0001742f606822e9c224dd38bde123994",
      "english": "Yeah...",
      "translator_note": null
    },
    {
      "id": "msb_0005FF60",
