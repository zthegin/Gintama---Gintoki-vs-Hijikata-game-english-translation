      "english": "Where are you, Katsura?! ...Oh! Yorozuya?!",
      "translator_note": null
    },
    {
      "id": "msb_0005F194",
      "source_words_sha256": "5eda596e0da620c63a4a8295dab4a93d577a1b3a89d7636bf744ee872360172c",
      "english": "Shut up! Out of the way!",
      "translator_note": null
    },
    {
      "id": "msb_0005F360",
      "source_words_sha256": "060657f3bc0b1275da427704d7b3576b85fa895a6b8b65f2dc604bb96105a80a",
      "english": "I win! Move!",
      "translator_note": null
    },
    {
      "id": "msb_0005F3B4",
