      "id": "msb_000605D8",
      "source_words_sha256": "e44761fd6d1f4a6f275111cf925b979d15397462fcbe4923de7b9d7f1c325cef",
      "english": "Wait.",
      "translator_note": null
    },
    {
      "id": "msb_0006063C",
      "source_words_sha256": "a9ab9d2a1002bb38681df74e91acb0fecba870747661b92d0b45df4293c2bdcb",
      "english": "Right! Storm in!",
      "translator_note": null
    },
    {
      "id": "msb_00060654",
      "source_words_sha256": "8d4d24b2d8c083d739951c8712da1c401f30a57cdcae30f6238e52674a0efc3e",
      "english": "Back for more Gin Tama.",
      "translator_note": null
    },
    {
      "id": "msb_00060678",
      "source_words_sha256": "85e6e60d0d329fe1a0dd7b68652fb19e0d3f2ab61176b36278a797c3415c1d09",
      "english": "Right. Maybe gather Gin Tama before we go in.",
      "translator_note": null
    },
    {
      "id": "msb_000606BC",
      "source_words_sha256": "4b47743d5f236f4055872ff81630e5144217a7068901d3755a2aa6df9958db7e",
      "english": "What now, Hijikata?",
      "translator_note": null
    },
    {
      "id": "msb_000606D8",
      "source_words_sha256": "0fb4e2b6e816876903d312a794828c6b9f343adf5c4ac8cca9cdfe84b8f1a6c9",
      "english": "If you say so, Hijikata. Let's storm in.",
      "translator_note": null
    },
    {
      "id": "msb_00060708",
      "source_words_sha256": "2350da1680f06165dd727258cfb15f4288f867b6d48c9627bdf8e78507b8e32f",
      "english": "OK.",
      "translator_note": null
    },
    {
      "id": "msb_00060710",
      "source_words_sha256": "285b6ad52aedc58b09c108da16ec10c18153a0bf862c87f974b66b0e5570a7ca",
      "english": "Damn... Guess we have to keep searching on foot...",
      "translator_note": null
    },
    {
      "id": "msb_00060758",
      "source_words_sha256": "15e1d3b7f8636d77bb1f327890c8abd755b62b8fa7785d0119213a3e03b95162",
      "english": "Hey! Could you stop doing that? Bad for my heart...",
      "translator_note": null
    },
    {
      "id": "msb_00060798",
      "source_words_sha256": "9af26e528611cccf621a7c4f9ca3226d3bf972cacb808f9d205b4a36773a2ea7",
      "english": "Oh! My bike key! Finally fixed, then.",
      "translator_note": null
    },
    {
      "id": "msb_000607E8",
      "source_words_sha256": "31c547d0806739915a1f09a2b657a9838b2c053f0cf64142fc00f2361e2d6839",
      "english": "Huh?! Can't go wherever I want? On MY bike?!",
      "translator_note": null
    },
    {
      "id": "msb_0006084C",
      "source_words_sha256": "f6a9dd8955255b9901b0546922a8b0ba05bdc7ebec34b18161be7cfb7f731da6",
      "english": "Well, it'll be easier than before, at least.",
      "translator_note": null
    },
    {
      "id": "msb_00060880",
      "source_words_sha256": "015ba4d563d5d1693ed2519905e0492c4fad9a0fa88fa747af310243a011439c",
      "english": "Let's use it to get around.",
      "translator_note": null
    },
    {
      "id": "msb_000608AC",
      "source_words_sha256": "e408f3c0754f38dfe0e4c8a1a330ab046d1298789de0dfd5041f417b31cf3aec",
      "english": "Travel by bike. Where to?",
      "translator_note": null
    },
    {
      "id": "msb_000608E0",
      "source_words_sha256": "51e49783c373b0376a14877fe9566fac38ed709319e0b57023f0dacd96d2952e",
      "english": "Ah!",
      "translator_note": null
    },
    {
      "id": "msb_000608F0",
      "source_words_sha256": "3fbb403d64982e91e1fc551943ff87ad5b397ca692c327b4d0f0df772e39f3a5",
      "english": "Sorry... Hearing you say on foot just reminded me...",
      "translator_note": null
    },
    {
      "id": "msb_00060940",
      "source_words_sha256": "720998e312f89289dd64ed9a736ce439b6e2dc0fecab6952043da065f9768693",
      "english": "Gengai gave me this for you.",
      "translator_note": null
    },
    {
      "id": "msb_000609C0",
      "source_words_sha256": "40fe023ca73472051af3bf7ebc89988a283e27268a0fe874ccf62396aff20d62",
      "english": "Only takes you to set places, unfortunately...",
      "translator_note": null
    },
    {
      "id": "msb_000609FC",
      "source_words_sha256": "9ea330af789b14a2c0f8af8792d1f676b1f92a0f8e68213cc5f5ca3f272689b7",
      "english": "Please don't question that part too much.",
      "translator_note": null
    },
    {
      "id": "msb_00060A2C",
      "source_words_sha256": "d30fa238887f079ef3dd6e9cb8385f2c824fd304574dd7af3941e1d61fe356ae",
      "english": "Young folks wandering around all day... Nice life.",
      "translator_note": null
    },
    {
      "id": "msb_00060B0C",
      "source_words_sha256": "916cb3a18bfa4d3723f97db2cec3c35b3ce0d347ad6befa5a2dfa4fb0cece1d3",
      "english": "Oh? Found work?",
      "translator_note": null
    },
    {
      "id": "msb_00060C38",
      "source_words_sha256": "6652ed0e55d43ea5229b799f48c78028b45c7673c917a6857fea6066b5330602",
      "english": "You government lackeys wouldn't know how ordinary folks suffer!",
      "translator_note": null
    },
    {
      "id": "msb_00060C90",
      "source_words_sha256": "641fed0cd392a88528ad942638e4053c06d809fa253ea68ecf27cbe8ef906f81",
      "english": "Keep pestering me and I'll tell your boss.",
      "translator_note": null
    },
    {
      "id": "msb_00060D18",
      "source_words_sha256": "1e469195cf53638052d379f038ba9e19d8021f92ddcabbb4d1a17f3f5ef706ab",
      "english": "We have problems too!\fLousy pay, the boss always yelling...\fOh! Tell me if you find a good job!",
      "translator_note": null
    },
    {
      "id": "msb_00060F54",
      "source_words_sha256": "634f1d4121f073a9bbe598de3bd09b9a41543826b1e29d7091905a59682b3739",
      "english": "Where are you taking those gloomy faces?",
      "translator_note": null
    },
    {
      "id": "msb_00060F80",
      "source_words_sha256": "7e175ff532302549555264a93490af7ec136d86a3f9aa4fc99bd1e7e6bbc38fa",
      "english": "Hungry and need work? Work in a restaurant. Cash AND food!",
      "translator_note": null
    },
    {
      "id": "msb_00060FFC",
      "source_words_sha256": "1e66af1494fb8352954f25fcca66942b0070ac9e5a2d5dbdb417b344ce7ef5a8",
      "english": "Found work? ...Silly question, really.",
      "translator_note": null
    },
    {
      "id": "msb_00061094",
      "source_words_sha256": "843f6756123d1c436bbd70778f8a0a66da1ee085ef4d76c3c30fe56fbc59fb5f",
      "english": "Looking for work.",
      "translator_note": null
    },
    {
      "id": "msb_000610FC",
      "source_words_sha256": "12ccc58cb7010b2f8e9c2cfefc4dd0028149ee2583ac9dfe26c1aeb8f6c12aca",
      "english": "What a precocious little brat...",
      "translator_note": null
    },
    {
      "id": "msb_00061200",
      "source_words_sha256": "1a7275082111d4ffe5c81f28eef6effb894e650354d4d5c247af23bb206e2672",
      "english": "Any Gin Tama lying around?",
      "translator_note": null
    },
    {
      "id": "msb_0006129C",
      "source_words_sha256": "1e692226abf3af1db6e4874e23a99369cf58ae8722efd2d8d5f2b3b8e24699a5",
      "english": "Not for you! Find your own.",
      "translator_note": null
    },
    {
      "id": "msb_000613B0",
      "source_words_sha256": "0435099969fc20459cb0334b9cbcfa5d33a2330fb3b521c8df97a9b37a5c68ce",
      "english": "No business with ham.",
      "translator_note": null
    },
    {
      "id": "msb_000613C8",
      "source_words_sha256": "395d59f4b1d30a012db2cb75e3e6e24fc0d14387e2a18325c58da62bbb115d7f",
      "english": "What?! I'm not Hamuko! My name's Kimiko! KIMIKO!",
      "translator_note": null
    },
    {
      "id": "msb_000615FC",
      "source_words_sha256": "7a7951e68b054fd77de2854df4a7443b967bff8b997eb0d0cca5c83179829bed",
      "english": "...So we're unwanted people.",
      "translator_note": null
    },
    {
      "id": "msb_00061754",
      "source_words_sha256": "2da4e8ea80408bbfbf9f4c62c052a764d6274e1d50791f5019711684ce0006cf",
      "english": "Hmm. Sorry, can't do it.",
      "translator_note": null
    },
    {
      "id": "msb_00061820",
      "source_words_sha256": "fbd6c0772a208b7cb4649384ac07821ded7727e6e809ba343079293630997436",
      "english": "N-no way!",
      "translator_note": null
    },
    {
      "id": "msb_00061874",
      "source_words_sha256": "cb321f1fcd0e0d418ffce654e19e64bcd55764d50995003f0766bbdcbea7b65c",
      "english": "Um... Could you hire us? We're looking for work.",
      "translator_note": null
    },
    {
      "id": "msb_000618E4",
      "source_words_sha256": "feabd5eb9ecf5b82d090a16dbd8c78f30b759007bbba268cd966db82c0d3f4cd",
      "english": "...Pathetic.",
      "translator_note": null
    },
    {
      "id": "msb_00061A84",
      "source_words_sha256": "7d160a3efc6d0953f9581340244f0b6d9881024d9825d19da24aea66558d0626",
      "english": "Only dust on you now, Gin. Not pride.",
      "translator_note": null
    }
  ]
}
