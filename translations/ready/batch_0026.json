      "translator_note": null
    },
    {
      "id": "msb_000602CC",
      "source_words_sha256": "091d61f044fc49abf3d0d66c17fdd63d7b36ba77a35c8d4779900452529bf479",
      "english": "Wrong way again, isn't it?",
      "translator_note": null
    },
    {
      "id": "msb_000602EC",
      "source_words_sha256": "8119a6756bfdaaa1b282da7b770e63059db180fb749a799fd5f203b1abb173ab",
