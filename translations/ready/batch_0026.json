      "id": "msb_0005F668",
      "source_words_sha256": "2309e0a08f83ccfe741a2d61fafec866ef634a1b7a6d38d3ba263f9ccf0db229",
      "english": "Wait... Maybe that was Shigeyoshi, not a gorilla...",
