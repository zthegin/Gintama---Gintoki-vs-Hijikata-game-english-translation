      "english": "I know!",
      "translator_note": null
    },
    {
      "id": "msb_0005ECB4",
      "source_words_sha256": "970e4751b08226698ec616102f8b0dd8a1850cf8dc1839937ea5c8bc1303539f",
      "english": "Trading Gin Tama? What are you plotting?!",
      "translator_note": null
    },
