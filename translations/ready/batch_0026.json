      "english": "Wrong way again?",
      "translator_note": null
    },
    {
      "id": "msb_00060194",
      "source_words_sha256": "96c405a52e5f5df35c58543d70574e7d106c4a7b51410a45b89111717c344ff3",
      "english": "Hey. Is this the right way?",
      "translator_note": null
    },
    {
      "id": "msb_000601D8",
      "source_words_sha256": "b24903dfa27f0ad8e1e132eaa430a98ea116a8fa14e5f47ffc88ad6221bdbe4a",
      "english": "That won't do.",
      "translator_note": null
    },
    {
      "id": "msb_00060270",
