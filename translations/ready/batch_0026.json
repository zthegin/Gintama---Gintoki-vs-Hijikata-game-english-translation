      "translator_note": null
    },
    {
      "id": "msb_0005F580",
      "source_words_sha256": "9e030ad249eeca42b0308c712b440c891743695245c6493b592c788869d3e2d3",
      "english": "Memory's getting worse... Who was I again?",
      "translator_note": null
    },
    {
      "id": "msb_0005F5DC",
      "source_words_sha256": "749e54d3e3782735797f4eabaac30ff57eb4eec2b5947a97438988ee6407cb93",
      "english": "You must know, Shigeyoshi.",
      "translator_note": null
    },
