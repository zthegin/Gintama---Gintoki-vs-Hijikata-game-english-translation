      "id": "msb_0005F3D4",
      "source_words_sha256": "e2eedb8de03db84eb439d07d3aee9901f45c7a6e005f517785777a9ff48ab031",
      "english": "...Gintoki.",
      "translator_note": null
    },
    {
      "id": "msb_0005F3E8",
      "source_words_sha256": "da2e74fd9f49d89097d82567f2aa048de4c981363aea7520619f784019d47595",
      "english": "...Sorry again, Gintoki!",
      "translator_note": null
    },
