      "english": "How cold...",
      "translator_note": null
    },
    {
      "id": "msb_00047500",
      "source_words_sha256": "1dae55513cbad6201a51fe4d0e43d88b4fb0aa3feedf3a8fe9d3cbfb04e25b09",
      "english": "Police business.",
      "translator_note": null
    },
