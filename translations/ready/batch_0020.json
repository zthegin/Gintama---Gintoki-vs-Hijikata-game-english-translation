      "english": "Told about twenty people already.",
      "translator_note": null
    },
    {
      "id": "msb_00047DAC",
      "source_words_sha256": "5e17287a2f572cc77e409ad5c41abb5e1370d35bb3e882ba33173afd9f02574e",
      "english": "Hey, where are you going?",
      "translator_note": null
    },
    {
      "id": "msb_00047DC8",
