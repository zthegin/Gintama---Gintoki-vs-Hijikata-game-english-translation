      "id": "msb_00021AC8",
      "source_words_sha256": "aa9612ecf5791b11be8c578dffa184cd58c34e06fbbefb70fa406a54475bf7a6",
      "english": "[ctrl:FFA2]Damn!",
      "translator_note": null
    },
    {
      "id": "msb_00021AD8",
      "source_words_sha256": "8580ff7db27a7c75dc17adb8b283ebd6901ee3b30b3c749dfdb8b9819eb8fd33",
      "english": "[ctrl:FFA2]...Hmph. A thief\nhas been after\nthose Tama.",
