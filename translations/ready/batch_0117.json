      "id": "msb_000218F8",
      "source_words_sha256": "8c90a0dfca6a7f209273a833c0858b52bb8af89a15e7256d398da95fd2ef3a2b",
      "english": "[ctrl:FFA3]Playing dumb...?",
      "translator_note": null
    },
    {
      "id": "msb_00021918",
      "source_words_sha256": "ca8ad7ebfbc494fff48c092b05f97e3163668212a6117d2911a01edc442c5069",
      "english": "[ctrl:FFA3]Yes, we're\ncollecting them...",
      "translator_note": null
    },
    {
      "id": "msb_00021948",
      "source_words_sha256": "ac98394a546b61a7a7301439c6d364a6071c494a46e9a0bb10faab962b66af35",
      "english": "[ctrl:FFA2]Fine if no one sees?!",
      "translator_note": null
    },
    {
      "id": "msb_00021968",
      "source_words_sha256": "7fe6f91da8fac06392f211671ef6cf59e85a3404c2f3e4cced1bca5081781748",
      "english": "[ctrl:FFA3]W-[ctrl:FFA2]Wait...\f[ctrl:FFA2]What's wrong with\ncollecting Gin Tama?\n[ctrl:FFA2]I don't get this at all!",
      "translator_note": null
    },
    {
      "id": "msb_000219D0",
      "source_words_sha256": "81261ce867b8163a66185dc8e87748c2ae3dc00a9bd367e87e7b99b64f79e0b9",
      "english": "[ctrl:FFA2]I win.",
      "translator_note": null
    },
    {
      "id": "msb_000219E4",
      "source_words_sha256": "770f9800b596a01a5b55c2c59c1f73589721da547c763b120a579a4d38566b54",
      "english": "[ctrl:FFA3]Now, answer\nmy questions\nas promised.",
      "translator_note": null
    },
    {
      "id": "msb_00021A10",
      "source_words_sha256": "1ff1a9e46fcb0e4fb0e88afb3a47ecee859df19d0df915b71d9c9a981f409492",
      "english": "[ctrl:FFA3]Hurry up and answer.\nUm...\f[ctrl:FFA3]What was it, Shinichi?",
      "translator_note": null
    },
    {
      "id": "msb_00021A60",
