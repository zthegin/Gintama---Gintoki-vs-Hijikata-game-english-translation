      "english": "[ctrl:FFA3]A word?[ctrl:FFA2] We haven't\ndone anything.",
      "translator_note": null
    },
    {
      "id": "msb_000218C0",
      "source_words_sha256": "d75b25260196c0786ccd293ac3552e9b89143666cc2f353e3835ed04fd075c29",
      "english": "[ctrl:FFA3]Oh, Gin Tama.\f[ctrl:FFA3]What about them?",
      "translator_note": null
    },
