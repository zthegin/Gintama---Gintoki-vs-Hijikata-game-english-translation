      "id": "msb_00021A8C",
      "source_words_sha256": "f7d37ca2cf359fe23425deb1a7112bef556144fedc1c53c9c57ae57bce5c55b2",
      "english": "[ctrl:FFA3]One stupid thief,\n[ctrl:FFA3]believing that nonsense.",
      "translator_note": null
    },
