{
  "format": "gintama-community-translation-v1",
  "batch_id": "batch_0117",
  "records": [
    {
      "id": "msb_0001A290",
      "source_words_sha256": "a9ba72dcffb36fae8b4c7fba420ad628f9d9e6c9931f9d21f2edb8c0bb7e537f",
      "english": "No retorts? Then\nShinpachi has no purpose!",
      "translator_note": null
    },
    {
      "id": "msb_0001A2E0",
      "source_words_sha256": "210d85f222b3be1692fc8e2c61b23647f5659a789f9ee9ce0990b20196c1a30b",
      "english": "Come on. Do as I say\nif you don't want\nto get hurt.",
      "translator_note": null
    },
    {
      "id": "msb_0001A34C",
      "source_words_sha256": "fbbe55c0f1ff5a6186a5d99e2a2d41d737ed576be4a85ca603f39b1313fad30e",
      "english": "Out of my way!!",
      "translator_note": null
    },
    {
      "id": "msb_0001A3CC",
      "source_words_sha256": "c2004979284591a165c96b917bed29e96b2fb555c5517c136a1cf9cd5813b97c",
      "english": "S-sorry!\nIn a hurry! Forgive me!",
      "translator_note": null
    },
    {
      "id": "msb_0001A448",
      "source_words_sha256": "39b7cbad79647c3de9a47835e7e655cc2c1f729ea14053d09c973d699a2b8188",
      "english": "Well, sir, I'm in a hurry...",
      "translator_note": null
    },
    {
      "id": "msb_0001A584",
      "source_words_sha256": "51dbfd0aac2cff049a252664046b257a1794476d210e4e1225e96bcde454bde6",
      "english": "Scream?!",
      "translator_note": null
    },
    {
      "id": "msb_0001A86C",
      "source_words_sha256": "6fffa07519423bc8f06a4988b6e7bfaa4920ebb9c2b11e44d0a79870381e7e08",
      "english": "Damn! I thought I'd get\nthe Dragon Tama here\nand wrap up the story!",
      "translator_note": null
    },
    {
      "id": "msb_0001A8E4",
      "source_words_sha256": "639c1ebc9b14ca53df7ddd05e139003b89f22bdfb4860e4a700a150698ce5899",
      "english": "Don't abandon me\nover something this small!",
      "translator_note": null
    },
    {
      "id": "msb_0001A98C",
      "source_words_sha256": "40126d86c0273846877b8a755559f3846a43930cfc9dc9cf42b6a9afd709adc1",
      "english": "Don't act so grand!\nAsk more humbly!",
      "translator_note": null
    },
    {
      "id": "msb_0001ABD8",
      "source_words_sha256": "65b164c7866641b36cf3d11dcf381e12d1f549713f7f6e2d80ad0d9a6132a4b6",
      "english": "Rebels, space pirates...\nCrackdowns are getting\npretty strict lately.\fLife's getting hard\nfor people in my\nline of shady work.\fFewer and fewer\njob offers, too...\fLast month's pay?\nWasn't even cash.\fJust a kilo of rice!\nNo vegetables, meat\nor fish!",
      "translator_note": null
    },
    {
      "id": "msb_0001ADFC",
      "source_words_sha256": "d80a5f46d234c821e2ac7333519d7f7b945ec9159608a5dcc66b40f3a855605f",
      "english": "Please, let me go!\nLet me have that Tama...",
      "translator_note": null
    },
    {
      "id": "msb_0001AE74",
      "source_words_sha256": "0637c49e37d45ea4563c5211ef63be92a26b2d2be0dafc75556fd9566fe2b60d",
      "english": "OUCH!\f...Sacchan's heart\njust took a direct hit.",
      "translator_note": null
    },
    {
      "id": "msb_0001AEC4",
      "source_words_sha256": "f7275c3800f58844db36cf63d177fe1064539521a82495ffbb5f8e5339c0d1c9",
      "english": "G-Gin...\fHehe... I've fallen\nfor you all over again.",
      "translator_note": null
    },
    {
      "id": "msb_0001B214",
      "source_words_sha256": "611d40c7351f68923a84125259ed785b1129d3dd930b791d6e9985cfc68e1323",
      "english": "When someone pours\ntheir heart into a wish\nand prays for it...\fThat single-minded desire,\nthat shining soul...\fThat's what finally\nreaches heaven, isn't it?!",
      "translator_note": null
    },
    {
      "id": "msb_0001B29C",
      "source_words_sha256": "28745d3277684438a9a6b6820619223874d838df9d4373cc3d7daa95c6f26557",
      "english": "What matters isn't\nthat golden Tama.\fThe real treasure is\nthe pure human desire\nput into it!\fA stolen Dragon Tama\nhas no value.\fIt's just a gold-plated ball!",
      "translator_note": null
    },
    {
      "id": "msb_0001B35C",
      "source_words_sha256": "9cc44e6b64b33ee489df295dded6012beba6d066b355312baa9d1c63a61ad3c5",
      "english": "Yes. What just pierced\nyour heart...\f...That's the real treasure!",
      "translator_note": null
    },
    {
      "id": "msb_0001B3E4",
      "source_words_sha256": "704e872e43735ef35b2152e5ae62d93c463febd6d65a285106083dad8c2013f8",
      "english": "Go on. Get out of here.\nTrouble if the gorilla\nand his gang find you.",
      "translator_note": null
    },
    {
      "id": "msb_0001B94C",
      "source_words_sha256": "ef887d8f5c479b82ad8641ed9a543399fc24636b9c7b0ac4b2505b104e32aeeb",
      "english": "...\fStill...\fThat person who ran\ninto Kagura looked\nfamiliar...\fWho was it...?\fOh, well.",
      "translator_note": null
    },
    {
      "id": "msb_0001BA14",
      "source_words_sha256": "ce278d9ff8d5e83da4787ad03f9edfa6b896bc6deb121f06a1c5d6e647b9758b",
      "english": "...Gintoki, that may be\na troublesome item.",
      "translator_note": null
    },
    {
      "id": "msb_0001D334",
      "source_words_sha256": "5294290ae38f525428675a5f9a731224f27b51d43f17d9d304983b5e2780c023",
      "english": "Yamazaki!\n...\nWhere'd you spring from?",
      "translator_note": null
    },
    {
      "id": "msb_0001D614",
      "source_words_sha256": "07dc32b387e1bf67ac25f96190be1484e09d200cc571500e695de076df2f420c",
      "english": "Need help? Gladly\nfinish your seppuku.",
      "translator_note": null
    },
    {
      "id": "msb_0001D850",
      "source_words_sha256": "191d5c0f00edd90efb28ba1a12e1dcf702eec51cfa1a1c298cce867f1469a643",
      "english": "I know, Zaki.\nI won't disgrace\nthe Shinsengumi name.",
      "translator_note": null
    },
    {
      "id": "msb_0001D914",
      "source_words_sha256": "30172bf52e220cddcff72139baa5252d09c7b4e1e632e32f16cce1c5865a3e2a",
      "english": "Stop calling me that!\nSounds like a death spell!",
      "translator_note": null
    },
    {
      "id": "msb_0001D9DC",
      "source_words_sha256": "7e0e8fc746ebba49b6c453c67d64dca920ef32a4afdfdbac79d7e161e2e68f0b",
      "english": "The Demon Vice-Chief!\nI'm no match for you.\fYou shouldn't lose\nto most people\naround here.\fBut Gin Tama battles\naren't real swordplay.\nDon't get careless.\fToo few Tama? No chance.\nBe sure to search\nfor plenty of them.\fApparently there are\nrare Tama even\nI don't know about...\fI've heard of...\fKotodama Boost,\nwhich enhances\nKotodama Gin Tama...\fAnd Character Tama\nthat summon allies.",
      "translator_note": null
    },
    {
      "id": "msb_0001DC24",
      "source_words_sha256": "141d9b956846f24151414d2ff99fc37d46fafc95ea095d45b591539d3d8bacc7",
      "english": "You usually get those\nfrom side quests.\nSomething to look forward to.",
      "translator_note": null
    },
    {
      "id": "msb_0001DE08",
      "source_words_sha256": "aecc0425ae6fedda583b33c62035c277380dc4bb349b85c910ed11b2e80e9efd",
      "english": "You might find\na rare Tama unexpectedly.\fI've heard of...\fKotodama Boost,\nwhich enhances\nKotodama Gin Tama...\fAnd Character Tama\nthat summon allies.",
      "translator_note": null
    },
    {
      "id": "msb_0001DF40",
      "source_words_sha256": "141d9b956846f24151414d2ff99fc37d46fafc95ea095d45b591539d3d8bacc7",
      "english": "You usually get those\nfrom side quests.\nSomething to look forward to.",
      "translator_note": null
    },
    {
      "id": "msb_0001DFA0",
      "source_words_sha256": "d5b368604fab47986a1520136ce8a0de4fce35353d498266a844bf4fcc2ccac4",
      "english": "Hmph. While he was\ngetting his medicine\nat the pharmacy...",
      "translator_note": null
    },
    {
      "id": "msb_0001E11C",
      "source_words_sha256": "ce28a290d899c07940970ddba8ee183a24d5f9a356837be8ce22fb34aa186167",
      "english": "No wonder it was targeted.\fBut without a real one\nto examine, investigating\nwill be difficult.",
      "translator_note": null
    },
    {
      "id": "msb_0001E17C",
      "source_words_sha256": "b3d1a42a68be2dc28368bfb63d3a01a5b103e4e5f491398a8ef28964be2eb82e",
      "english": "Of course.\fI'd like to know\nwhat we're chasing.",
      "translator_note": null
    },
    {
      "id": "msb_0001E3DC",
      "source_words_sha256": "02db175c66de242645343eb26bb668e662cda9a7e9c21333fee5c68e3ff5745c",
      "english": "A battle? Kondo,\nyou don't even\nhave any Tama!",
      "translator_note": null
    },
    {
      "id": "msb_0001E570",
      "source_words_sha256": "a6f19570e9bd66cb9df1acc59774c04cefeb7e393ef1c341dadc260d5de331d2",
      "english": "Rumor or not,\nI want to take a chance!\fI'm desperate!",
      "translator_note": null
    },
    {
      "id": "msb_0001E5F4",
      "source_words_sha256": "2ec34865a8daead1bb4df73cb83ea8c7cab5d06a3edaa5f8a650c76dd5ff55f3",
      "english": "Sougo! I owe you!\fYou'll be guest of honor\nat my wedding to Otae!",
      "translator_note": null
    },
    {
      "id": "msb_0001EB40",
      "source_words_sha256": "4069439f42220de05b6df6ef34ed6777ad04b6f1ba98dff866f2ef8fc34005fd",
      "english": "Shouldn't you\nask Otae first?\fAbout the wedding,\nnot the seating plan...",
      "translator_note": null
    },
    {
      "id": "msb_0001EC48",
      "source_words_sha256": "b494d52e96d118025a71b9bd11bee4d3a132f7cc22fdd7e3c29a3a91dc135849",
      "english": "Win and the Tama's yours.\fBut lose and give up\ngracefully, okay?\nNo hard feelings.",
      "translator_note": null
    },
    {
      "id": "msb_0001EE34",
      "source_words_sha256": "bfe5bc288677d92e6fa6a50c5fc09af84c2739477953f7c78a0ed6e40d57d11a",
      "english": "That shine! That sheen!\nA super-rare Dragon Tama!\fI owe you, Sougo!",
      "translator_note": null
    },
    {
      "id": "msb_0001EEAC",
      "source_words_sha256": "5a4b1b4b7eec8c2b6052ad9471816ae1b76891d1b89865de51f2adb626fdde8f",
      "english": "Seven Dragon Tama!\nA future with Otae!",
      "translator_note": null
    },
    {
      "id": "msb_0001EFB0",
      "source_words_sha256": "fd600aaa3f7d3d1f7bf3b640248f54cb84f93a8e0b6507431fb1027b32b21b2e",
      "english": "Damn! I lost!\nThe Dragon Tama\nwas almost mine!",
      "translator_note": null
    },
    {
      "id": "msb_0001F034",
      "source_words_sha256": "946157ad12fbab6e3951423b78c842eaa5dce7e5e7e10e195918e77e29c24541",
      "english": "Damn, a long road...\nBut I'll do it!\nI'll see it through!",
      "translator_note": null
    },
    {
      "id": "msb_0001F080",
      "source_words_sha256": "5a4b1b4b7eec8c2b6052ad9471816ae1b76891d1b89865de51f2adb626fdde8f",
      "english": "Seven Dragon Tama!\nA future with Otae!",
      "translator_note": null
    },
    {
      "id": "msb_0001F164",
      "source_words_sha256": "a334cd065cff05f337e731dd1cf7bb10c81e7ff3bbff0c39c272e482bc14b88b",
      "english": "Right! Back to the case!\fCatch the thief\nand make his\nDragon Tama mine!",
      "translator_note": null
    },
    {
      "id": "msb_0001F2C4",
      "source_words_sha256": "4025b3e59e983d0e69213a7a3c9f0ed7c74348cf6ebc67b82e8ef8026dca6843",
      "english": "Quiet, Kondo.\nHe'll notice us.",
      "translator_note": null
    },
    {
      "id": "msb_0001F438",
      "source_words_sha256": "e4b817c484fb3982450b05ed28413aab5edf70a76bf257142816b13372a4808f",
      "english": "Phew. Walking nonstop...\nI'm tired.",
      "translator_note": null
    },
    {
      "id": "msb_0001F534",
      "source_words_sha256": "30d8b4be73d997d22f2f0e4a6db9a600b24a571a15d703718a15d5a87d7622f8",
      "english": "Damn Katsura!\nRare Tama? The nerve!\fI'll take it from him.",
      "translator_note": null
    },
    {
      "id": "msb_0001F5E4",
      "source_words_sha256": "ca01a4d08aaab861ce993a5bd8d6c133c26ddef4a74e024776553e598acb8ee1",
      "english": "Can't tell if that's\nhonesty or carelessness.",
      "translator_note": null
    },
    {
      "id": "msb_0001F660",
      "source_words_sha256": "6b8cb3dae9e7ce9a46c10add5abda32ffa570de2ee264f28dfd9397fd71e7cf9",
      "english": "Look over there.",
      "translator_note": null
    },
    {
      "id": "msb_0001FAA4",
      "source_words_sha256": "6626339c705b7ac9e6fc3fd2ba4df05f52b39ea612a511c7ea2b34de51b5204b",
      "english": "An honorable\nGin Tama duel!",
      "translator_note": null
    },
    {
      "id": "msb_0001FB44",
      "source_words_sha256": "def788d18b85e9c28f01630bc0f556fc7ba5ef0a32de0bfea82327cf97ef044d",
      "english": "Well, Katsura?\nAccept the challenge\nor not?",
      "translator_note": null
    },
    {
      "id": "msb_0001FB78",
      "source_words_sha256": "21b86fdc853f38964a41cb9d34bf11ce05d8e616dee2fb69d91f32bc4bd6d382",
      "english": "You've got guts!\nGo, Toshi!\nBeat him senseless!",
      "translator_note": null
    },
    {
      "id": "msb_0001FBB0",
      "source_words_sha256": "6c0c80c517539a22f033a1b8ceed69c238450aa44b672a570f62af385c7a8eb7",
      "english": "Poor excuses don't\nsuit you, Mr. Zura.",
      "translator_note": null
    },
    {
      "id": "msb_0001FBE4",
      "source_words_sha256": "aa1e20785bdddf712c080f00bb658ac1e17a4808d8a807576d0c8fc172f3d1d8",
      "english": "Kondo, don't\nget in the way!",
      "translator_note": null
    },
    {
      "id": "msb_0001FD70",
      "source_words_sha256": "6a2069a84b23a3f49bba728f07a9d131ee5f4315f3e111aa0bfe8ceb8127b02c",
      "english": "Damn! Careless...!",
      "translator_note": null
    },
    {
      "id": "msb_0001FE30",
      "source_words_sha256": "595e12a37dfc4a15db164ac8e364caa6463a87e6ed7705cadd0b802788c8eada",
      "english": "Sorry. By way of apology,\nlet me tell you one thing...",
      "translator_note": null
    },
    {
      "id": "msb_0001FEE4",
      "source_words_sha256": "ce8d348f97457b457bafc60a6d52ddfb05deca19f3f624c73ec6c23a1145c008",
      "english": "Katsura! Cheater!\nSome samurai!",
      "translator_note": null
    },
    {
      "id": "msb_0001FF58",
      "source_words_sha256": "fcb4479bac770c894a67b85120f8d1f1a9e2b3e07b0ea1f0d19feba47c68abdb",
      "english": "Well, well.\nWhat's got into you?\fHardly like the great\nKotaro Katsura\nto act this way...",
      "translator_note": null
    },
    {
      "id": "msb_0001FFEC",
      "source_words_sha256": "f00821c8e064aff0157c332224782a5e602ff3fd8a27429c3612f917a0b680a2",
      "english": "...Strange, though...\fKatsura stooping\nto such blatant\ndirty tricks...",
      "translator_note": null
    },
    {
      "id": "msb_00020158",
      "source_words_sha256": "7f655410b5a2467b6f4b476c959ba6cc42838074fb3ce60523eb6a21a23dc529",
      "english": "Damn! So close!\nG-game over...!\n...Zzz.",
      "translator_note": null
    },
    {
      "id": "msb_000201F8",
      "source_words_sha256": "686a743a18296d1c0eaac208323e4aa8d8029ca35183896c3162a2f0344b08d3",
      "english": "What?! Dirty trick!\nCall yourself a samurai?!",
      "translator_note": null
    },
    {
      "id": "msb_00020260",
      "source_words_sha256": "bca7d3a1cfb6da2cb8b0bb1ab4c6a04586b80d5582587b7a3fa7b9ce8dd047f2",
      "english": "What are you doing,\nToshi?! No dinner for you!",
      "translator_note": null
    },
    {
      "id": "msb_00020294",
      "source_words_sha256": "c2b977229423650b7fd683a107879ba87101031f07a9dc5e3d8b6a7c3577d177",
      "english": "Never agreed to that!",
      "translator_note": null
    },
    {
      "id": "msb_000202B4",
      "source_words_sha256": "a11625cbc12843e0ebf380f6a46f797c00c52d0382cfb6945cd869b540ccf41e",
      "english": "Don't know about that!\fWhen did I promise?\nHour, minute, second!",
      "translator_note": null
    },
    {
      "id": "msb_00020330",
      "source_words_sha256": "7a00504ecc5be3e2b1a6dc474380165a9b60e4be23298278456bea9dac63b0e3",
      "english": "Sougo, idiot! Don't sleep!\nKatsura... Zzz.",
      "translator_note": null
    },
    {
      "id": "msb_000203BC",
      "source_words_sha256": "4c58a77d3fe27bb55eb2c7c7b0a5c991614c3a02bd29dd53d15816e611c18f9b",
      "english": "This smoke's\nsleeping gas...\nCough... Zzz.",
      "translator_note": null
    },
    {
      "id": "msb_000205E0",
      "source_words_sha256": "b58535ec9a0a936771a26e577fe9485a8db80cd4e8882bed57d98b8556559b46",
      "english": "We go together.\nKeep him out of the way.\f...Sorry to bother you, granny.",
      "translator_note": null
    },
    {
      "id": "msb_00020624",
      "source_words_sha256": "0d179a97730e980633a5f0eccb48c3171917e2df53b565d124c53678341782c8",
      "english": "Tch. His landlady\nshould know where he is.",
      "translator_note": null
    },
    {
      "id": "msb_000206D4",
      "source_words_sha256": "83f123abd37817fa79e8f535fae6252c744ab19fbe7b3a1fafdcecb802e4dd3d",
      "english": "That's the story.\fSorry about\nthe gorilla's manners.\nCould you help us?",
      "translator_note": null
    },
    {
      "id": "msb_000207B4",
      "source_words_sha256": "380aadf56f6d7ac711628bd4cb75ba541ed414c6dab79ee2e0e26344679c5484",
      "english": "See? Just as I said.\fKnew this sort of story\nwould catch his interest.",
      "translator_note": null
    },
    {
      "id": "msb_0002082C",
      "source_words_sha256": "8d8311219a41edc3d6ff2831387cd81c3e42e77d75fb3be1fd7c1eda118d7ec1",
      "english": "Those freeloaders?\nWent out. Haven't returned.\fMaybe ran away\nwithout paying rent.",
      "translator_note": null
    },
    {
      "id": "msb_000209B0",
      "source_words_sha256": "ded2a54f99ba156edb65a2999501acb581831ac6b9fd22268ddae66ea228c5a2",
      "english": "Says he'll get rich\nby gathering seven\nrare Dragon Tama.\fHonestly. Ridiculous...\fBelieving silly rumors.\nSounds just like him.",
      "translator_note": null
    },
    {
      "id": "msb_00020A68",
      "source_words_sha256": "79cc36a16e239ebceb2cd256e14ad1dc18765b37cb871cc0a2884dc70801e1c7",
      "english": "Hehehe! Toshi, Sougo!\fWhat a haul!\nLook at all these Gin Tama!",
      "translator_note": null
    },
    {
      "id": "msb_00020AB4",
      "source_words_sha256": "1b458a3f2f9e8fba06bd9701d91fe536a64e15d25bf617d303bbbebd62c1c622",
      "english": "At this rate,\nwe'll have seven\nDragon Tama before long!\fHahaha! Wonderful!",
      "translator_note": null
    },
    {
      "id": "msb_00020E0C",
      "source_words_sha256": "d4527ec39136100b6604899fcb70b23054ec3de50c72d36db9e5eaf07c4c5c2a",
      "english": "No proof,\nbut there's a witness.\fA silver-haired man\nwith a perm\nand dead-fish eyes...\fAn unremarkable boy\nwith glasses...\fAnd a cheeky-looking girl\nin Chinese dress...\fSaw those three\naround here.\nHard to mistake them.",
      "translator_note": null
    },
    {
      "id": "msb_00020F14",
      "source_words_sha256": "66acee21e61d31d02bcacfe1a107229f850054171e45811010b875cadc209a26",
      "english": "Huh? Yeah, that's\ndefinitely Gintoki.",
      "translator_note": null
    },
    {
      "id": "msb_00020F58",
      "source_words_sha256": "bea381142307f55523e4879ac1ac4916d0e8e5348c69d9482925598042fceff5",
      "english": "[ctrl:FFA3]Sorry, I don't\nspeak gorilla...",
      "translator_note": null
    },
    {
      "id": "msb_00020F90",
      "source_words_sha256": "76ce47dc61665df8cab094519b61d6e8c471fc1a71eaa7f05204f2ca8daf522d",
      "english": "What do the gorilla\nand friends want?",
      "translator_note": null
    },
    {
      "id": "msb_00020FBC",
      "source_words_sha256": "c27585942eb21dfb3b7e9c763c9b2a8360af3f4402fea806821b7bf51ba679eb",
      "english": "[ctrl:FFA3]Fun. To the zoo?",
      "translator_note": null
    },
    {
      "id": "msb_00020FE8",
      "source_words_sha256": "6cb10c1e7de3f4acab17309160dc64df086a0583881427f94840b2e13c5f7c21",
      "english": "[ctrl:FFA3]So what if we are?\f[ctrl:FFA3]They're not\ncontraband, are they?",
      "translator_note": null
    },
    {
      "id": "msb_00021034",
      "source_words_sha256": "4690f8afde91890a2f12ba2b2c83abadaa34270b126cdba2b26ac83fb5541969",
      "english": "[ctrl:FFA3]Huh? Save your jokes,\nyou horny gorilla.",
      "translator_note": null
    },
    {
      "id": "msb_00021068",
      "source_words_sha256": "98efacba4b6935ae1c80434a3af2c93e988d9eaf15afe0a0532093d7ebe751fb",
      "english": "[ctrl:FFA3]Don't like your tone.\f[ctrl:FFA3]Didn't kindergarten\nteach you to ask\npeople politely?",
      "translator_note": null
    },
    {
      "id": "msb_000210CC",
      "source_words_sha256": "3b1d2fa05c2c8d1bd8033ac4a761d6c92707ff6c151bcec36b8187cd51831fd2",
      "english": "[ctrl:FFA3]Right. Let's settle\nthis with a\nGin Tama battle.",
      "translator_note": null
    },
    {
      "id": "msb_00021108",
      "source_words_sha256": "73cd893523411603696ae08cc3890e22b85f542d6d1e1bef772762127f06223c",
      "english": "[ctrl:FFA3]You win,\nI'll tell you anything.\f[ctrl:FFA3]But if I win...\f[ctrl:FFA3]You answer\nMY questions.",
      "translator_note": null
    },
    {
      "id": "msb_0002116C",
      "source_words_sha256": "fe69c756f039f803f1d40a373fe92c3a4486dca1d378cd7e3de52e3a139186e0",
      "english": "[ctrl:FFA3]Settled, then.\f[ctrl:FFA2]Come on,\nshogunate's dog!",
      "translator_note": null
    },
    {
      "id": "msb_0002119C",
      "source_words_sha256": "c39872de94ae1c728b132baf79bb6008b1e3eb54fe3e6ae3b80b404a33907b89",
      "english": "[ctrl:FFA3]Hey, you three.\n[ctrl:FFA2]Stop.",
      "translator_note": null
    },
    {
      "id": "msb_000211F8",
      "source_words_sha256": "3cd28e8ddbbfc719953fd2ad47093fb6009e7e246b47890215512e93c265f3a7",
      "english": "[ctrl:FFA2]Who're you calling\na gorilla's friend?!\f[ctrl:FFA2]I could arrest you\nright here!",
      "translator_note": null
    },
    {
      "id": "msb_00021248",
      "source_words_sha256": "7ff311895f55b5e267e8ff5c3f82d17e077647cf37929ea1c3705f024d9d01d6",
      "english": "[ctrl:FFA2]You bastard...!",
      "translator_note": null
    },
    {
      "id": "msb_00021268",
      "source_words_sha256": "7d6e6c4f02366242e109d1b9458812524f46e95d459063f443ad7e270ca26438",
      "english": "[ctrl:FFA2]Don't play dumb.\nI heard you!\f[ctrl:FFA3]Rare Dragon Tama...\nMaking more money...\f[ctrl:FFA2]You're collecting\nGin Tama, aren't you?",
      "translator_note": null
    },
    {
      "id": "msb_000212E0",
      "source_words_sha256": "420dfe75200fe55f2de4baca6f91cc75ac34f086f0e3c2143e3f07a41129bde7",
      "english": "[ctrl:FFA2]So, Gin Tama!",
      "translator_note": null
    },
    {
      "id": "msb_00021300",
      "source_words_sha256": "eab0e28aa7aee498a6363708e71d1e6b4f54692ed5a6edea5251c575f9814710",
      "english": "[ctrl:FFA1]Hey!",
      "translator_note": null
    },
    {
      "id": "msb_0002130C",
      "source_words_sha256": "82cb3080488e3a746b28c22b190a14a56c6294d9efd4b0d29bd1ada3979dad4a",
      "english": "[ctrl:FFA3]Stop, Sougo.[ctrl:FFA2]\nTrouble if we're seen.",
      "translator_note": null
    },
    {
      "id": "msb_00021338",
      "source_words_sha256": "b6b0b76379b4f33504c0a94c54e6bfce1e35c6a07114fbf47029b7ffc605592c",
      "english": "[ctrl:FFA1]Sougo...!",
      "translator_note": null
    },
    {
      "id": "msb_00021350",
      "source_words_sha256": "5a57da2c98f228f6b64fa0375ee297b087c6e95a1c1aaafd099a9aca65160624",
      "english": "[ctrl:FFA2]...You mean\nyou usually aren't?!",
      "translator_note": null
    },
    {
      "id": "msb_00021380",
      "source_words_sha256": "ac9ee84cc005c6b89fc18a7e861bab6c62170fa621fb96e9b39ac862453d0da1",
      "english": "[ctrl:FFA2]Shut up!\nWE ask the questions!\f[ctrl:FFA2]Just answer\nwhat you're asked!",
      "translator_note": null
    },
    {
      "id": "msb_000213D0",
      "source_words_sha256": "f1f86fabd01c68e55c7896f4ec6cddd6ecc789507b9a55a02cd44ff754a660a2",
      "english": "[ctrl:FFA2]What was that?!",
      "translator_note": null
    },
    {
      "id": "msb_000213E8",
      "source_words_sha256": "86b144badebb2cbb00c8eab761797921acf0bed34259b8dec41c34ce1d9faecc",
      "english": "[ctrl:FFA2]What?",
      "translator_note": null
    },
    {
      "id": "msb_000213F4",
      "source_words_sha256": "d559d445949d6f623ab48c1f68b8930d34ba79bb9c9e4b626be9a30d63f103d0",
      "english": "[ctrl:FFA3]You mocking\nthe Shinsengumi...?",
      "translator_note": null
    },
    {
      "id": "msb_0002141C",
      "source_words_sha256": "b86afda09182c304842eb5ae0e386f49c7e15d9e57ec267b3f467fff88f5839f",
      "english": "[ctrl:FFA1]Sougo!",
      "translator_note": null
    },
    {
      "id": "msb_00021428",
      "source_words_sha256": "14a5a5266e9854f10be7da1a7c22925c1cb456d450f2686c756bd8e07887b12b",
      "english": "[ctrl:FFA1]Tch![ctrl:FFA2] How did\nit come to this...?!",
      "translator_note": null
    },
    {
      "id": "msb_00021458",
      "source_words_sha256": "552bd3eafaf98a494b3da5da6d2884e6cd837be7b4b79c3d2d5a67eda1323ff5",
      "english": "[ctrl:FFA1]Sougo...!",
      "translator_note": null
    },
    {
      "id": "msb_00021474",
      "source_words_sha256": "a1f8afd60d0f598646c68922d8d749eb490f0dd405216d3b1e9330f432dd1dc4",
      "english": "[ctrl:FFA2]Only started\ncollecting yesterday, yes.",
      "translator_note": null
    },
    {
      "id": "msb_000214A8",
      "source_words_sha256": "dc807fbfe7eb3ced471a00fe3311bf014d71d20f0412fa208b42e0485cedb552",
      "english": "[ctrl:FFA2]Sorry.[ctrl:FFA3] Got a few\nquestions for you.",
      "translator_note": null
    },
    {
      "id": "msb_000214DC",
      "source_words_sha256": "0b53f221085d177f915999aadcb9cb205d93712ec142bc5c9d80eee2439c0448",
      "english": "[ctrl:FFA2]What, bastard?!\nWho's a gorilla?!",
      "translator_note": null
    },
    {
      "id": "msb_0002151C",
      "source_words_sha256": "7abb77483f9a4039c88e80ebf6e9e1e9b4574ceb4683e030514fd8008563ab49",
      "english": "[ctrl:FFA1]Don't play dumb, boy!\f[ctrl:FFA1]We [ctrl:FFA2]already know\nyou're out\ncollecting Gin Tama!\f[ctrl:FFA2]Otose confirmed it!\f[ctrl:FFA2]Otae's brother or not,\nno special treatment!\f[ctrl:FFA2]Keep playing dumb\nand I'll arrest you!",
      "translator_note": null
    },
    {
      "id": "msb_000215FC",
      "source_words_sha256": "178c445b2c7e293d80b9f59d3779324f7f4817d9e8a792af24b741b101067ac2",
      "english": "[ctrl:FFA2]You bastard!\nHand over your Tama!\nGive them here!\f[ctrl:FFA2]Gold ones, not silver!\nThe Dragon Tama!",
      "translator_note": null
    },
    {
      "id": "msb_00021660",
      "source_words_sha256": "6bff5aa4709fd5923af8ff97a18b43c6b825ed47b79236c90acce8b2f4857205",
      "english": "[ctrl:FFA1]What?!\f[ctrl:FFA2]Sougo! Cut him down!\nKill him!\f[ctrl:FFA2]Toshi takes the blame!",
      "translator_note": null
    },
    {
      "id": "msb_000216AC",
      "source_words_sha256": "46c6fa09fabe46f9cd3bd956193bd7892078b20096b166ca2ce44be23dde3ac5",
      "english": "[ctrl:FFA3]Kondo, perhaps.",
      "translator_note": null
    },
    {
      "id": "msb_000216C4",
      "source_words_sha256": "3caf30d18574d78b0420983972552870160168479b2eb027196e14fd76fbb59f",
      "english": "[ctrl:FFA3]Now, now.\nYou too, Hijikata?\f[ctrl:FFA3]Actually, Yorozuya,\nwe need a word.",
      "translator_note": null
    },
    {
      "id": "msb_00021718",
      "source_words_sha256": "ee403e1f9d88467581e590c8fe7b32ef22d61c06cb7555bfb42b9455fe6b22d6",
      "english": "[ctrl:FFA3]That sounded interesting.\nWhat were you saying?",
      "translator_note": null
    },
    {
      "id": "msb_00021750",
      "source_words_sha256": "c59d16f46c5a2ff06436162be72b685779b0511a7ad1f7858e771e278a4a2c84",
      "english": "[ctrl:FFA2]So unreasonable again...",
      "translator_note": null
    },
    {
      "id": "msb_0002177C",
      "source_words_sha256": "d3d8ff7820cfdc2bb2a9a23876227805aa746ed14b197de635013c036471fcbc",
      "english": "[ctrl:FFA2]Tch...\f[ctrl:FFA3]Could use the chaos\nto get Hijikata...",
      "translator_note": null
    },
    {
      "id": "msb_000217C4",
      "source_words_sha256": "e76205f3b4da17427064a6c8ef2e8162ea80b2e4c556be4b9cb4ea02b5c721d0",
      "english": "[ctrl:FFA2]Don't glare, Hijikata.\f[ctrl:FFA2]A joke.[ctrl:FFA3] A joke.\f[ctrl:FFA5]This time.",
      "translator_note": null
    },
    {
      "id": "msb_00021814",
      "source_words_sha256": "af7e3754999360b190bf708288f8a64d507cab08445fab89739e07e81ba77610",
      "english": "[ctrl:FFA2]Fine. Challenge accepted.\f[ctrl:FFA5]By Hijikata.",
      "translator_note": null
    },
    {
      "id": "msb_00021854",
      "source_words_sha256": "4cf9cb988d2f7b4aa9fd160be7bba54a62a095ef725b4ff6ba5312103a013a25",
      "english": "[ctrl:FFA3]Good luck, Hijikata!",
      "translator_note": null
    },
    {
      "id": "msb_00021878",
      "source_words_sha256": "3de295032aae966699d80c16a30cf0e4109c6f6e64599eba06feeca8f8b4dd58",
      "english": "[ctrl:FFA3]Huh...?",
      "translator_note": null
    },
