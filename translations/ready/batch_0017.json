      "english": "What, bastard?! Wanna go?!",
      "translator_note": null
    },
    {
      "id": "msb_0003DA68",
      "source_words_sha256": "c3dc24c0c761a8ac71061cfc90a329b70aa3c2c95d9b9fed2341b814ef428d5c",
      "english": "Right. They'll kill each other.",
      "translator_note": null
    },
    {
      "id": "msb_0003DA84",
      "source_words_sha256": "6bdb35e9aaf89fbf95c0e740d7d5f17eb12a2bb9360caadc45221ec192ea4c45",
      "english": "Let's storm in.",
      "translator_note": null
    },
    {
      "id": "msb_0003DA9C",
