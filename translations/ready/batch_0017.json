      "english": "A silver-haired perm-head saved me. Stupid, but strong.",
      "translator_note": null
    },
    {
      "id": "msb_0003E160",
      "source_words_sha256": "c900b0c7f745ff5fba21a18873a1ec45eff45838da441c80d37f5cfa123654e0",
      "english": "A space pirate. What was his name...?",
      "translator_note": null
    },
    {
      "id": "msb_0003E188",
      "source_words_sha256": "9348da7a3fb099024cf5f62ddcf18408a9801f08c6d62d3cfddf78220bbc30c6",
      "english": "Waaah! He's back!",
      "translator_note": null
    },
    {
      "id": "msb_0003E1AC",
      "source_words_sha256": "965e02e4273783f3ad2c4c50c9bc5d4e797c490c068fcbcbdd361d389f57b7ad",
