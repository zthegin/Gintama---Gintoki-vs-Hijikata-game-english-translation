      "english": "You the Shinsengumi...?",
      "translator_note": null
    },
    {
      "id": "msb_0003DEB0",
      "source_words_sha256": "4c2adb994305e1bd45be04443dd38187215db3843f54bf5216026853d645fde9",
      "english": "Him? Don't know. Just hand over the idiot prince.",
      "translator_note": null
    },
    {
      "id": "msb_0003DEE0",
      "source_words_sha256": "32dd48afc3d09d7b9112a56ffdc825020bbb198369a8d7c9bb28eea3e92f0b96",
      "english": "Get them, boys!",
      "translator_note": null
    },
    {
      "id": "msb_0003DEF8",
      "source_words_sha256": "bc05b34521e2ede973e8d00f7e2da3565eb8e368b92184e77cd805a99f0e5f55",
      "english": "Please don't blow me up!",
      "translator_note": null
    },
    {
      "id": "msb_0003DF10",
      "source_words_sha256": "dce01c7ac26b1378ebfdfc02dc27f04bab65e8e27f302c6b1c41b3769c61a4ba",
      "english": "YOU'RE the idiot!",
      "translator_note": null
    },
    {
      "id": "msb_0003DF28",
      "source_words_sha256": "1f380e0ead74e72a98522f246400619ffe4d32e9e10ef09c415490d14bfec695",
      "english": "I'll kill you too, old geezer!",
      "translator_note": null
    },
    {
      "id": "msb_0003DF4C",
      "source_words_sha256": "2efab0b820100b131f278e15a5c71680d9e5792fc73cc7de1990c111dd2997e4",
