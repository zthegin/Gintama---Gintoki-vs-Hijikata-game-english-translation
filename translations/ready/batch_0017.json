      "english": "Guess I'll take it.",
      "translator_note": null
    },
    {
      "id": "msb_0003DC3C",
      "source_words_sha256": "c5bbce63572562c5602f31b593deb9ead63843a46041a7254a75e65a114df649",
      "english": "Small fry stay small fry? What's this?!\fI'm a MAIN character!",
      "translator_note": null
    },
    {
      "id": "msb_0003DC88",
      "source_words_sha256": "38f260b921d2ac74b8ec45ec5dba85ad058168e67b4d87cba15ba9d3fc48f7a9",
      "english": "Tch! Fine. We're going in!",
      "translator_note": null
    },
    {
      "id": "msb_0003DCB0",
      "source_words_sha256": "8b655b6773ccdefac457f0f8cc702e1c13db0d75f9a52c8b0a04716778ae32f8",
      "english": "Waaah! I lost!",
      "translator_note": null
    },
    {
      "id": "msb_0003DCD0",
      "source_words_sha256": "89886475438ff6223933b3d67180982bbdc053117d32af2b1761565bcf6dcbcc",
      "english": "I wanted kelp! GIVE ME KELP!",
      "translator_note": null
    },
    {
      "id": "msb_0003DD0C",
      "source_words_sha256": "92e4e4d48a374ffd8775fe2d35cb89fceb77ce8380a638ff69d87f8136a28a9f",
      "english": "Wait!",
      "translator_note": null
    },
    {
      "id": "msb_0003DD1C",
      "source_words_sha256": "bed43e6b4f350cc71b2f8980d6a7da39c5be1725e92b31d4d5866ca31f1b4572",
      "english": "Have a Gin Tama.",
      "translator_note": null
    },
    {
      "id": "msb_0003DD30",
      "source_words_sha256": "18e1a623d69829f2329744768b9112f93f3a0cc27ef26a11ebba7db7bace8548",
      "english": "I lost. Yato honor demands it!",
      "translator_note": null
    },
    {
      "id": "msb_0003DD60",
      "source_words_sha256": "37445542be3cdece09a211ecd09e38539a626339fcd13d72dc38f91efb5feb64",
      "english": "Use it well.",
      "translator_note": null
    },
    {
      "id": "msb_0003DD74",
      "source_words_sha256": "e4afc837fd2cfad74e332138e085c8212e34d200392b56173349e24f9db4e82c",
      "english": "Gin... Where'd you go...?",
      "translator_note": null
    },
    {
      "id": "msb_0003DD9C",
      "source_words_sha256": "e3de56507975933f7807fec20aab721965910bc8ac6f83aff92757db0046e9e6",
      "english": "There's writing inside.",
      "translator_note": null
    },
    {
      "id": "msb_0003DDC8",
      "source_words_sha256": "1a766746bf13b45e3365424b60dd361905c0d391ee168d6c208dd547bd2f03e7",
      "english": "Like hell I will!\fI'd love to cut him, but I'll reset first!",
      "translator_note": null
    },
    {
      "id": "msb_0003DE10",
      "source_words_sha256": "8b38551a6d98c9e56da101a7ecb2585dcfba9ba731c0a8e07380e6a59536cf7f",
      "english": "You're weak.",
      "translator_note": null
    },
    {
      "id": "msb_0003DE24",
      "source_words_sha256": "f37f7c272893b96c5e7c00aac44f75cabfc9fe749ee5fcf49ac60d7648d58c4a",
      "english": "No need. It's game over.",
      "translator_note": null
    },
    {
      "id": "msb_0003DE4C",
      "source_words_sha256": "280af78434833d6a4ba038930a5f0bfe51ea7804d68c62fc25c3b0684442f0ee",
      "english": "Toshi! You okay?!",
      "translator_note": null
    },
    {
      "id": "msb_0003DE64",
      "source_words_sha256": "4d1401714845652a66e7ca3afc2930fc69042d19d4ba3ca9be89c9604216d7d0",
      "english": "Hijikata. Cut your belly.",
      "translator_note": null
    },
    {
      "id": "msb_0003DE8C",
