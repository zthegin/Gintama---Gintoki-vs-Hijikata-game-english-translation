      "translator_note": null
    },
    {
      "id": "msb_0003DF68",
      "source_words_sha256": "4862ce39ac689d5acfbe22b635c65f25f339689fa7ca1113837cd60062592326",
      "english": "Wait! There's a good reason!",
      "translator_note": null
    },
    {
      "id": "msb_0003DF8C",
      "source_words_sha256": "07432fb0b32d42f7ae6c75ec296985b9ee6a4a723dd3abfff21b15b2328b9e25",
      "english": "Stupid old man! That's no deep reason!",
      "translator_note": null
    },
    {
      "id": "msb_0003DFD8",
      "source_words_sha256": "ef694ef665021428877bd89af4832383d7936f017104c0b201b0035c7f4ad133",
      "english": "Hey! What are you saying?!",
      "translator_note": null
    },
    {
      "id": "msb_0003DFF8",
      "source_words_sha256": "be5bcf17eca9593b1d986c048e317b43663b195c1793f128d1b7936e8e7fa3c2",
      "english": "Liar!\fYou're still single!",
      "translator_note": null
    },
    {
      "id": "msb_0003E038",
      "source_words_sha256": "1c6153690ad460fd8884500da7656079c5afa54c2f2e37920974dec6a3d17c0e",
      "english": "Oh, right! Have a Dragon Tama! Just spare ME!",
      "translator_note": null
    },
    {
      "id": "msb_0003E078",
      "source_words_sha256": "df962bd03137c6c4ea036c57c51067149f4834a262b4c2b4ae144ef6b533fa84",
      "english": "Shut up, useless old man!",
      "translator_note": null
    },
    {
      "id": "msb_0003E0B8",
      "source_words_sha256": "aa79c7d468b41102115bd60cad9d1c6856b4d0fa32efa500f895cd5935505183",
      "english": "Eek! What is it?",
      "translator_note": null
    },
    {
      "id": "msb_0003E0CC",
      "source_words_sha256": "347a769a936c9062ddd5c484151cfb6aed427f9ba3f9a5d929b0bde6d6bd541d",
      "english": "You caught the culprit?!",
      "translator_note": null
    },
    {
      "id": "msb_0003E0E4",
      "source_words_sha256": "e7897f4b08ade44c9bce2ab57eb6ab59e07301b2169001dfc5b7db9b20e6ca5f",
      "english": "No! Not at all!",
      "translator_note": null
    },
    {
      "id": "msb_0003E100",
      "source_words_sha256": "8626496e6b8bb141844cfc8509dbc1bb05d7db40503d39109db0bf19aa64f833",
      "english": "That's why I hid here.",
      "translator_note": null
    },
    {
      "id": "msb_0003E11C",
