      "english": "Buy your own!",
      "translator_note": null
    },
    {
      "id": "msb_0003DBD8",
      "source_words_sha256": "d0a65798e9d5ac986c2dca972462530a696e791bc77b7bf640bb55419efe724e",
      "english": "I won. Let me through.",
      "translator_note": null
    },
    {
      "id": "msb_0003DBF8",
      "source_words_sha256": "c21ff3e845fa68113a0963745b9df02159de1d56f89868c13e36ec85fd9698c5",
      "english": "What? Still need me?",
      "translator_note": null
    },
    {
      "id": "msb_0003DC0C",
      "source_words_sha256": "ba546d9f144845d26127510af7146b979f86ad5fc2f807351c455c73b09b0856",
      "english": "Why give me this?",
      "translator_note": null
    },
    {
      "id": "msb_0003DC20",
