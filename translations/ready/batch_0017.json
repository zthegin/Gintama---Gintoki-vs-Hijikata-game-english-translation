      "english": "There you are!",
      "translator_note": null
    },
    {
      "id": "msb_0003DAB0",
      "source_words_sha256": "4e4c5cd760fb714f522a75a58ef1bd90781ec7cb6754d1508af145fd6c412481",
      "english": "What?!",
      "translator_note": null
    },
    {
      "id": "msb_0003DAC0",
      "source_words_sha256": "d9ec4f85bb9eb364e839f47c1d08e86ac9bf432b017428f9e5fcf3b3eebf4cc9",
      "english": "Move! Out of my way!",
      "translator_note": null
    },
    {
      "id": "msb_0003DADC",
      "source_words_sha256": "d49d3c1c6e332db3da7a6091670df7294ee848f5e1b64b68c19bf59f79902708",
      "english": "Fine. Bring it on.",
      "translator_note": null
    },
    {
      "id": "msb_0003DB1C",
      "source_words_sha256": "53c2c47ccc21747337c2d2a0973a06403809b39fd12622812fe869193125104d",
      "english": "Not from some little brat!",
      "translator_note": null
    },
    {
      "id": "msb_0003DB50",
      "source_words_sha256": "cf19b19688623a8feb4c819971389382169a1c97d70ea2964d0562e8b3e8dad0",
      "english": "Don't stop me, Hijikata! I'll kill her!",
      "translator_note": null
    },
    {
      "id": "msb_0003DB74",
      "source_words_sha256": "4c7848599e86f22cf4960a4a49e0b1d49f9c3236fef00d5ec1a0351fa5d7aef2",
      "english": "Why?",
      "translator_note": null
    },
    {
      "id": "msb_0003DB8C",
      "source_words_sha256": "f5ca6c355f21a29692fd47f596fd29b7cb6301a99078689b1d1d5d9ee1e23a9b",
      "english": "Tch!",
      "translator_note": null
    },
    {
      "id": "msb_0003DB98",
      "source_words_sha256": "78b94934daf0ae4d859188431652017299e352a6b8b5eb72f4e6e6dc1a61b3e2",
      "english": "Hijikata cuts his belly.",
      "translator_note": null
    },
    {
