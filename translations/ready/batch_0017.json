      "source_words_sha256": "5a11913dda9d4e6192ea8fd91d740f81956d47e018396e83deb485367e015c62",
      "english": "Out of the way, Glasses!",
      "translator_note": null
    },
    {
      "id": "msb_0003E1D8",
      "source_words_sha256": "09b82f829c6b2f085e79e6e09e057aff854dda0f95cdd16634c954fa8d38d1e3",
      "english": "Shut up!",
      "translator_note": null
    },
    {
      "id": "msb_0003E1E8",
      "source_words_sha256": "c41cc5ecc01cc2a97b3aaa960557ec6996a487e6b37ed3b3aa7d58a54b2b6b4c",
      "english": "Come out, broker!",
      "translator_note": null
    },
    {
      "id": "msb_0003E204",
      "source_words_sha256": "7d680a40aac188f69a2d7ec23310c239a68f082900551b430c107bda5a3690bb",
      "english": "You're...?!",
      "translator_note": null
    },
    {
      "id": "msb_0003E218",
      "source_words_sha256": "ecf8f9d74574226642463e3a57d153bc6c8535afb48963818aba3af4d5f3a272",
      "english": "What are YOU doing?!",
      "translator_note": null
    },
    {
      "id": "msb_0003E248",
      "source_words_sha256": "c3efbfa2108375d4dc73240dc279bfb0ffd40a5cf015922403a74df24264a488",
      "english": "A good reason? Let's hear it.",
      "translator_note": null
    },
    {
      "id": "msb_0003E2F8",
      "source_words_sha256": "e0524c91bc8e0d2126fcb12a66528df21a06cbeab8da897806a3c50f48b411f8",
      "english": "Hold it!",
      "translator_note": null
    },
    {
      "id": "msb_0003E308",
      "source_words_sha256": "9d07928a3fd1afffa667c7be22a0ef8cde33751ad6ab683b612aad225675b9a6",
      "english": "Not done yet. About the orb murders.",
      "translator_note": null
    },
    {
      "id": "msb_0003E330",
      "source_words_sha256": "520d658bde1aabebfbeccbfd56a66409b57fcdcc3bbacb3bca1af55d7e6ef254",
      "english": "Aren't YOU the killer?",
      "translator_note": null
    },
    {
      "id": "msb_0003E360",
      "source_words_sha256": "0159bf6247feba2e9dabfe810e6e4c3b4483aefeb36db3dc9fabbfc17544a803",
      "english": "The killer?!",
      "translator_note": null
    },
    {
      "id": "msb_0003E374",
      "source_words_sha256": "38285e5b2dc6ffc55ebf46c0e20276af1a20a5fd4dd2da0acaa089659636ac53",
      "english": "Oh, right. What about him?",
      "translator_note": null
    },
    {
      "id": "msb_0003E398",
