      "english": "Fine! I'll settle it with Gin Tama!",
      "translator_note": null
    },
    {
      "id": "msb_0003E3D4",
      "source_words_sha256": "702f64c6398e2d6ca6052e44cf6c16a11014950029f73ff40398e51b7898ea24",
      "english": "The prince IS an idiot. That's not his name!",
      "translator_note": null
    },
    {
      "id": "msb_0003E474",
      "source_words_sha256": "d3885f9e69404578332c8e594d731c16f4ad140c1d9c960d766e4e8693924a05",
      "english": "My wife and kids are hostages!",
      "translator_note": null
    },
    {
      "id": "msb_0003E490",
      "source_words_sha256": "a0071faafddcab81665296941e3c0f2f2725c8f4104a56f7e87664bbff80aac5",
      "english": "What?! Just you?! Prince, save me too!",
      "translator_note": null
    },
    {
      "id": "msb_0003E4C8",
      "source_words_sha256": "363ea478989bf97c4564eedf1788a2994bb90702557cccfc467175ea1c20146c",
      "english": "WE were targeted!",
      "translator_note": null
    },
    {
      "id": "msb_0003E4E8",
      "source_words_sha256": "7c73184cc86a6b25ae2678e996d06d5907e1f933171d80de8a263733c81aaf7e",
      "english": "But we got attacked.",
      "translator_note": null
    },
    {
      "id": "msb_0003E4FC",
      "source_words_sha256": "a5edb94b382884cc5dd1cd7aa37a4641e2e2b0281b11ad86c8cc6a759fb9612a",
      "english": "Just now.",
      "translator_note": null
    },
    {
      "id": "msb_0003E50C",
      "source_words_sha256": "96239c11109e0e8797b459fb4845126a1414494c66053b0ec011374f5a11247c",
      "english": "Easy, Sougo.",
      "translator_note": null
    },
    {
      "id": "msb_0003E524",
      "source_words_sha256": "4d8eb03acc38531e4318b0d50760304a3474aec16b64dec5554e8c9598888459",
      "english": "Idiot prince!",
      "translator_note": null
    },
    {
      "id": "msb_0003E534",
      "source_words_sha256": "47bf24935319d7fc642eb4a74f3ae11eba13866e4d4767581930d67301b38046",
      "english": "Seriously?!",
      "translator_note": null
    },
    {
      "id": "msb_0003E544",
      "source_words_sha256": "89fd8cb42ec1863352756fd6047bb7c5b53abcabb694e02d167688511e23ae1e",
      "english": "A Dragon Tama? Perfect!",
      "translator_note": null
    },
