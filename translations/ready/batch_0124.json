      "source_words_sha256": "62958be407f26311b7415ad2838a9cf249f44cf78224c4efeba0e6b7d0f1e288",
      "english": "[ctrl:FFA2]The river's Dragon God\nwill get mad!",
      "translator_note": null
    },
    {
      "id": "msb_00050A34",
      "source_words_sha256": "7411f00707705c58cf085352766dc558b0918d81c7c682352f59d04d639fe2d5",
      "english": "[ctrl:FFA2]The Dragon God's curse!",
      "translator_note": null
    },
    {
      "id": "msb_00050A50",
      "source_words_sha256": "fffffdc723105f05898ccad6d900b21e043bbbf8eb6b220ba0fda98d83fce013",
      "english": "[ctrl:FFA3]Assuming you haven't\nbeen fired by tomorrow...",
      "translator_note": null
    },
    {
      "id": "msb_00050A8C",
      "source_words_sha256": "529d69a42378502d411c30d82744d88c24d00c562e52d4406cdecd49ab2693ea",
      "english": "[ctrl:FFA3]I don't need that from\nan adult who can't\nface reality.",
      "translator_note": null
    },
    {
      "id": "msb_00050AD0",
      "source_words_sha256": "59222fcbe6392b04ac241426fb67394f609a0c829237782ee7344ec31637e924",
      "english": "[ctrl:FFA3]Wh-what's wrong?!\nWhy the sudden shouting?",
      "translator_note": null
    },
    {
      "id": "msb_00050B04",
      "source_words_sha256": "3cddfb6df6c998e34fc9f6c4d4a026231cdd5c3dd1b7d9f04290dfe366f3b38f",
      "english": "[ctrl:FFA1]Huh?",
      "translator_note": null
    },
    {
      "id": "msb_00050B10",
      "source_words_sha256": "7afe424a9aa329d1b44b8a6823f0ab7001fdeda8ae5a0063f7a09fa5b0dbf074",
      "english": "[ctrl:FFA3]Come to think of it,\nwe're near [blue]Saguri Bridge[/color].\nShe must be gone by now.",
      "translator_note": null
    },
    {
      "id": "msb_00050B6C",
      "source_words_sha256": "316f594911f8b085ed5dfd37d48acccf8418caaab5f7fdf5cb541bba8d6970f1",
      "english": "[ctrl:FFA3]I think it's fine...",
      "translator_note": null
    },
    {
      "id": "msb_00050B90",
      "source_words_sha256": "45fb8f6a16a38f0e0d837669aeb12db47e455b07d6354e167a2d5f6fbbccccd1",
      "english": "[ctrl:FFA3]What is it now?!",
      "translator_note": null
    },
    {
      "id": "msb_00050BAC",
      "source_words_sha256": "0add6c10023d88709771e5cd3d219e5734d9f279d2b27f37156a03c3cb099a5e",
      "english": "[ctrl:FFA3]Gin, what's wrong?!",
      "translator_note": null
    },
    {
      "id": "msb_00050BCC",
      "source_words_sha256": "684936e87a7a7c470a49e18e236c43e81402c9b6dcc61c1ca46e306fafd9bd07",
      "english": "[ctrl:FFA3]Why? Why is there\nstrawberry milk on a bridge?!",
      "translator_note": null
    },
    {
      "id": "msb_00050BFC",
      "source_words_sha256": "bafd9a453343fefa2a009d62bb5eb4ddc5a00da2d7c030e2a9950303e74f8f8a",
      "english": "[ctrl:FFA2]Quit haggling over sips!",
      "translator_note": null
    },
    {
      "id": "msb_00050C18",
      "source_words_sha256": "07e4482734f1cf087d741489fc9d1b8c089abc726e0cffd21f540ebf761a5a23",
      "english": "[ctrl:FFA1]No thanks!\n[ctrl:FFA2]That's practically empty!",
      "translator_note": null
    },
    {
      "id": "msb_00050C48",
      "source_words_sha256": "7e5b35b7895dd44d9b2cedd7f8db5ebdc786b60a7a1e7b2856bf2affd2d53111",
      "english": "[ctrl:FFA3]You'll really drink it?",
      "translator_note": null
    },
    {
      "id": "msb_00050C64",
      "source_words_sha256": "f4aa301cb11f08740cbbdcc4f3c1e482dee6b32dd307e1a94560dc82f58179bf",
      "english": "[ctrl:FFA3]We don't even know\nwho left it here!",
      "translator_note": null
    },
    {
      "id": "msb_00050C98",
      "source_words_sha256": "c14cd4055872df2eb0cffe8629d5e9beaf58c6b907641a194d481266d1db49e1",
      "english": "[ctrl:FFA3]It could be spoiled...",
      "translator_note": null
    },
    {
      "id": "msb_00050CB8",
      "source_words_sha256": "bc8f918f2eea373f84046b803812e3ca6e3e65aada4339fd6e168ea46a7528bf",
      "english": "[ctrl:FFA3]Or even poisoned...",
      "translator_note": null
    },
    {
      "id": "msb_00050CE0",
      "source_words_sha256": "d48acfada1bd50ab16316fe56d398298161bfd51841ba69ed9f065cb84f0c412",
      "english": "[ctrl:FFA3]Are you actually\nserious about that?!",
      "translator_note": null
    },
    {
      "id": "msb_00050D0C",
      "source_words_sha256": "77e58237fb1bfb001adeb342b642deea7d64ebb455d7cbe6a7b3ba1e3d754a64",
      "english": "[ctrl:FFA2]I give up on you two!",
      "translator_note": null
    },
    {
      "id": "msb_00050D30",
      "source_words_sha256": "6188fa6535a9402bb8494851c21b1f66b887e4e3cddbeca5f459175448a47c55",
      "english": "[ctrl:FFA2]You greedy pigs!",
      "translator_note": null
    },
    {
      "id": "msb_00050D48",
      "source_words_sha256": "b8be9fca2e4a814ab9070ad13c93d94d5ea099e00f35b3cb73a870aeef0ed10a",
      "english": "[ctrl:FFA2]Exactly! And littering\nin the river too!\nYou're the worst!",
      "translator_note": null
    },
    {
      "id": "msb_00050D8C",
      "source_words_sha256": "2bedbffea20a4f852235e8fc4d256c3452d26272e3f76d2c001e2f763ad518c6",
      "english": "[ctrl:FFA2]Same result either way!",
      "translator_note": null
    },
    {
      "id": "msb_00050DAC",
      "source_words_sha256": "98cabddbf6e83ffb56d69ed2b0ac2891e3a8e08c96790084ed1463e6b3969660",
      "english": "[ctrl:FFA2]Wh-what?",
      "translator_note": null
    },
    {
      "id": "msb_00050DC0",
      "source_words_sha256": "f2b2de965673d5e92d5be71a49dee17eb79eea72d8be3102eceaed84267ff067",
      "english": "[ctrl:FFA3]Ah... What's this?!",
      "translator_note": null
    },
    {
      "id": "msb_00050DDC",
      "source_words_sha256": "4d55eb02c3cb73772cc01cc097fbb9ce7394e2d68393a9dba498f6830e425ee3",
      "english": "[ctrl:FFA3]It's the same carton!",
      "translator_note": null
    },
    {
      "id": "msb_00050DFC",
      "source_words_sha256": "1abb3412d49913b97624f914684af2792c9acc191e3c05fe260033c8682ca7e9",
      "english": "[ctrl:FFA2]No way![ctrl:FFB2] Really?!",
      "translator_note": null
    },
    {
      "id": "msb_00050E18",
      "source_words_sha256": "b01c29e5c4a2918349f3b0f209eb04048d8bc7970bed9cad30bde946a354c3ad",
      "english": "[ctrl:FFA2]W-wait![ctrl:FFB1]\nDon't leave me!",
      "translator_note": null
    },
    {
      "id": "msb_00050E40",
      "source_words_sha256": "1500f0902ecf3c8b038a9a53d0c6f00e0d12f7f63d11edd403057a5344464b42",
      "english": "[ctrl:FFA3]Work's over.\nI'm going home.",
      "translator_note": null
    },
    {
      "id": "msb_00050E6C",
      "source_words_sha256": "8779802fc55282539f7cc9f5089407491ab4ab8a3aa68c3c1bd125de70572340",
      "english": "[ctrl:FFA3]I make my own rules.",
      "translator_note": null
    },
    {
      "id": "msb_00050E8C",
      "source_words_sha256": "0143ab5486f812d1ececd66930b58292dd85d09d20e64791b37786444a9b6256",
      "english": "[ctrl:FFA3]Tell me. I'll help.\nFor a fee, of course.\nI'm an odd-jobs man.",
      "translator_note": null
    },
    {
      "id": "msb_00050ECC",
      "source_words_sha256": "712742e64ebc535c3502933782ae629ac9a796f43b4d6e2c419221ac198ccda8",
      "english": "[ctrl:FFA3]Who says you can?",
      "translator_note": null
    },
    {
      "id": "msb_00050EE0",
      "source_words_sha256": "662f336183b6b2beb29a546e435101584bc394d70c3641702ef69fad9d774d07",
      "english": "[ctrl:FFA3]Out of place?",
      "translator_note": null
    },
    {
      "id": "msb_00050EF8",
      "source_words_sha256": "8de5d505afb8be6a9cb85c5a812f4f56f5095fa7e9cc5428bbea83660165002f",
      "english": "[ctrl:FFA3]...",
      "translator_note": null
    },
    {
      "id": "msb_00050F0C",
      "source_words_sha256": "8de5d505afb8be6a9cb85c5a812f4f56f5095fa7e9cc5428bbea83660165002f",
      "english": "[ctrl:FFA3]...",
      "translator_note": null
    },
    {
      "id": "msb_00050F20",
      "source_words_sha256": "8de5d505afb8be6a9cb85c5a812f4f56f5095fa7e9cc5428bbea83660165002f",
      "english": "[ctrl:FFA3]...",
      "translator_note": null
    },
    {
      "id": "msb_00050F34",
      "source_words_sha256": "8de5d505afb8be6a9cb85c5a812f4f56f5095fa7e9cc5428bbea83660165002f",
      "english": "[ctrl:FFA3]...",
      "translator_note": null
    },
    {
      "id": "msb_00050F48",
      "source_words_sha256": "8de5d505afb8be6a9cb85c5a812f4f56f5095fa7e9cc5428bbea83660165002f",
      "english": "[ctrl:FFA3]...",
      "translator_note": null
    },
    {
      "id": "msb_00050F5C",
      "source_words_sha256": "ea74c848bcc71447e9a70d81d233db0feeb93aae1c8e4bb17a4f8f4edf94ad4e",
      "english": "[ctrl:FFA3]...Hm? What was that?",
      "translator_note": null
    },
    {
      "id": "msb_00050F80",
      "source_words_sha256": "0493c777c151aa77f568f7a0ab7f664f0933a31a46bd98c9cbd3aa2e3decf15c",
      "english": "[ctrl:FFA3]Edo's famous for fireworks,\nbut that wasn't one.",
      "translator_note": null
    },
    {
      "id": "msb_00050FBC",
      "source_words_sha256": "53b0cf664bd97f1ba3c974a781f7c047b7db0b0a905ff4fdff23b18fc0bc890f",
      "english": "[ctrl:FFA3]I'll go look!",
      "translator_note": null
    },
    {
      "id": "msb_00050FD4",
      "source_words_sha256": "a216b5f0850e025d15ba452d56469fb87725d05356e67dd0cca199c198a823da",
      "english": "[ctrl:FFA2]I can handle it alone!\nYou two head home!",
      "translator_note": null
    },
    {
      "id": "msb_00051004",
      "source_words_sha256": "135fefd14f75c530c135742a588dacb035f94066fc65fe78ef6c6f63450c0a61",
      "english": "[ctrl:FFA2]There you are!\nWhat do you think\nyou're doing?!",
      "translator_note": null
    },
    {
      "id": "msb_00051040",
      "source_words_sha256": "f04a0a707e2f6464b561961372adf5ef70f90b2aea5e07b820a0b9e97979c7bb",
      "english": "[ctrl:FFA2]You don't decide\nwhen work ends!",
      "translator_note": null
    },
    {
      "id": "msb_00051064",
      "source_words_sha256": "426d7c331177952bf978f01427269348136d5167f22cdf98d413132fa234e4ce",
      "english": "[ctrl:FFA3]I shouldn't have helped\nyou get hired!\nYou'll give me an ulcer!",
      "translator_note": null
    },
    {
      "id": "msb_000510B0",
      "source_words_sha256": "0e7193deb39346b196d3b592eee53b8a475a06a44daff6a2ef261354e456a68e",
      "english": "[ctrl:FFA2]Don't act like it's not\nyour problem! [ctrl:FFA3]...Jeez.\nI've enough to worry about.",
      "translator_note": null
    },
    {
      "id": "msb_0005110C",
      "source_words_sha256": "e4df4a5056f4386b5daf9b4233a4ab440163a43c369d27df47143948e9c480cc",
      "english": "[ctrl:FFA3]I saw something worrying.",
      "translator_note": null
    },
    {
      "id": "msb_00051130",
      "source_words_sha256": "4445a81de692c481dc66521964777f4f7a1c8c9cf6e54ee8362549ff285978d7",
      "english": "[ctrl:FFA3]Please don't do anything.",
      "translator_note": null
    },
    {
      "id": "msb_00051150",
      "source_words_sha256": "96914bd202616d938cc3a4c6010e882b8db5f4b38520a799d0e46f9fec8ce0a6",
      "english": "[ctrl:FFA3]Maybe nothing,\nbut odd customers\nat our shop.",
      "translator_note": null
    },
    {
      "id": "msb_00051190",
      "source_words_sha256": "17adcf9aa9b019bdebdf430de0d430ef93dbac9f40553e459da7e335f9bbd1ff",
      "english": "[ctrl:FFA3]We're a fancy place,\nas you know. Rich folks\nand officials come here.",
      "translator_note": null
    },
    {
      "id": "msb_000511D0",
      "source_words_sha256": "a23f917230b88e77eeb7a0ca42b2a8d6b8651d4f5c5233129632bb9222dee4d5",
      "english": "[ctrl:FFA3]But this bunch\nlooked out of place...",
      "translator_note": null
    },
    {
      "id": "msb_00051208",
      "source_words_sha256": "049c678df433e106a9b8678b2f3e881368ea5b942f6fe76da4cc17d09aecb3c0",
      "english": "[ctrl:FFA3]Shifty-eyed ronin.\nWhispering about Gin Tama\nand the shogunate.",
      "translator_note": null
    },
    {
      "id": "msb_00051260",
      "source_words_sha256": "24977003aed9a9307061686d3c7c2979f721e6bc1096c15339ff7c7d4790d9f7",
      "english": "[ctrl:FFA3]Looked like rebels.",
      "translator_note": null
    },
    {
      "id": "msb_00051280",
      "source_words_sha256": "6ddbbdc2a905748fe041e1277ee264a7f35f7039cdcafca990a7a92fcb5de0a1",
      "english": "[ctrl:FFA3]They said something\nabout making a deal\nat our place tonight.",
      "translator_note": null
    },
    {
      "id": "msb_000512C4",
      "source_words_sha256": "fbfcded34e88861a2f4c9fe0817c24a716608b9fc5e5063c50eb111378ecff6e",
      "english": "[ctrl:FFA2]What a day!\n[ctrl:FFA3]An unlucky day!\n[ctrl:FFA2]That's what it is!",
      "translator_note": null
    },
    {
      "id": "msb_00051304",
      "source_words_sha256": "be35484c1db317feab8f79e61da926c2cf64b8313bf327665fdba4120966659c",
      "english": "[ctrl:FFA3]Can't stand around.\nI'll check the restaurant\nonce more.",
      "translator_note": null
    },
    {
      "id": "msb_00051340",
      "source_words_sha256": "e84c0f48b9b8c9f1c30b020d7f4eb76410ea8dfe6b753657c59e65dd85c21bdc",
      "english": "[ctrl:FFA2]Hey! You don't get\nto clock out on your own!",
      "translator_note": null
    },
    {
      "id": "msb_00051374",
      "source_words_sha256": "ee30806316773fd5beea66c94b28d5299ae497fdb8e85b1b87255e570e1f6e40",
      "english": "[ctrl:FFA2]Oh, a loser running here!",
      "translator_note": null
    },
    {
      "id": "msb_00051398",
      "source_words_sha256": "5fca11dcb17fd52ad78c0cdec036685e9965dc39088cff1f0614c7a57a373d79",
      "english": "[ctrl:FFA2]Sounds noble,\nbut you're just selfish.",
      "translator_note": null
    },
    {
      "id": "msb_000513CC",
      "source_words_sha256": "f599606eea14324c2cd5f64d3ebd6545d7b2e0835929cd1dc2ad5f2eb0481afc",
      "english": "[ctrl:FFA2]Ah... He's gone.",
      "translator_note": null
    },
    {
      "id": "msb_000513F0",
      "source_words_sha256": "d547f44ede38a223c3593383f63d37c377eee42d1466a0ed7d0a139dbe128499",
      "english": "[ctrl:FFA2]Fireworks?",
      "translator_note": null
    },
    {
      "id": "msb_00051404",
      "source_words_sha256": "59148f7f3a93f2ffac2e7322d55aba53523103985dde78bade4d98cae6a1412f",
      "english": "[ctrl:FFA2]I'm coming too!",
      "translator_note": null
    },
    {
      "id": "msb_00051418",
      "source_words_sha256": "eb9cc97ee62998e1ad423397e80bf9e33554e02de6ef69318eb0dfb9d62329b6",
      "english": "[ctrl:FFA2]Got it!",
      "translator_note": null
    },
    {
      "id": "msb_00051428",
      "source_words_sha256": "46ea883f8598c2ac6736ef48f548459b938cf1103a1a8c61be3a62793db71810",
      "english": "[ctrl:FFA2]It is Mr. Hasegawa.\n[ctrl:FFA3]Is he mad we left work?\nHe looks furious...",
      "translator_note": null
    },
    {
      "id": "msb_00051484",
      "source_words_sha256": "8c6e963f1236a9596760d18f6083f6efdb71f9913a25135db755db766bc197c4",
      "english": "[ctrl:FFA3]Now, now, Mr. Hasegawa.\nSomething good is\nbound to happen someday!",
      "translator_note": null
    },
    {
      "id": "msb_000514C8",
      "source_words_sha256": "a1db78b100e73e6478f2e800e104b7f2d6a5ef5395db5b1c1f8754ea164c796f",
      "english": "[ctrl:FFA3]Worried?",
      "translator_note": null
    },
    {
      "id": "msb_000514D8",
      "source_words_sha256": "05409e704231fcae15ea2ff2959ca70a9fcb4b59a95d5ddc3473b1aae582fd3e",
      "english": "[ctrl:FFA3]Come on, tell us.\nWe won't charge you.",
      "translator_note": null
    },
    {
      "id": "msb_00051518",
      "source_words_sha256": "95a35195b8c83a26bd10259a6fc1ba2fa84dce508049d9fdf567e405fcc246f5",
      "english": "[ctrl:FFA3]Odd guests?",
      "translator_note": null
    },
    {
      "id": "msb_0005152C",
      "source_words_sha256": "a4677fa7fbccc2b4178761b1a378bdb0d1320ccb3426456818a55ff0dab63de3",
      "english": "[ctrl:FFA3]Ronin?",
      "translator_note": null
    },
    {
      "id": "msb_00051540",
      "source_words_sha256": "a044edb28169c4f6e2c1709120e14b2327e3b8d0893bed940bfe3a1fc918d8e4",
      "english": "[ctrl:FFA3]Rebels and Gin Tama...\nHow are they connected?",
      "translator_note": null
    },
    {
      "id": "msb_00051584",
      "source_words_sha256": "702170a507132cb17c4642a1247b08682128c1f55f9a586b0e2fbf741a7d65b7",
      "english": "[ctrl:FFA3]A shady Gin Tama deal?\nBut why would rebels...?",
      "translator_note": null
    },
    {
      "id": "msb_000515C0",
      "source_words_sha256": "b11dcbbbb2ab7e26ae0c9ea0c264f0147e01d339fdc7b25c55686d195b6f614c",
      "english": "[ctrl:FFA3]Gin, could Mr. Katsura\nbe involved...?\nOh[ctrl:FFB1], maybe Prince Hata too?!",
      "translator_note": null
    },
    {
      "id": "msb_00051614",
      "source_words_sha256": "0fcb410ab3c21c9414d22f837bfcbac876975717ead1341e3a95412ffa5452a4",
      "english": "[ctrl:FFA2]Gin! Don't just stand\nthere! Say something!",
      "translator_note": null
    },
    {
      "id": "msb_00051654",
      "source_words_sha256": "2d18a0c02809febf711329244517ba0d5e1bf6ed478ea6fad56be1a5a46b9275",
      "english": "[ctrl:FFA3]That was a huge noise.",
      "translator_note": null
    },
    {
      "id": "msb_00051670",
      "source_words_sha256": "21931f3f22ff98a1def1b143bf2ffb6f44bef2331657635e07448c68d83bc9af",
      "english": "[ctrl:FFA3]From [blue]Mayoi Bridge[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_00051690",
      "source_words_sha256": "7c91bea25ac640d30b91a6313ed286d86a66e2d5ee2daf05c9e0db7e3db38ac2",
      "english": "[ctrl:FFA3]Gin?!",
      "translator_note": null
    },
    {
      "id": "msb_000516A0",
      "source_words_sha256": "e9eb5150fd90f45d2c554abbed29bc053ec80aabe77161d10fef1d481ea235ec",
      "english": "[ctrl:FFA2]I'm coming too!",
      "translator_note": null
    },
    {
      "id": "msb_000516B4",
      "source_words_sha256": "d2ef8e10272777d2786289c8c463a5da4cae7c72f954ae4c014396266371df40",
      "english": "[ctrl:FFA3]Okay. Understood.",
      "translator_note": null
    },
    {
      "id": "msb_00051834",
      "source_words_sha256": "e366d8f94ed4fe41138bf5d5c7e11cee420418bff702de718e8c1da61755abb7",
      "english": "I'd love to smash it,\nbut that woman's a hostage.",
      "translator_note": null
    },
    {
      "id": "msb_00051884",
      "source_words_sha256": "3c260571131440ea6cb71607a345fe6d3ee2110e172893d81549eafc9eec8b9c",
      "english": "I'll avenge Kondo!!",
      "translator_note": null
    },
    {
      "id": "msb_00051910",
      "source_words_sha256": "96240b8ef9ed52e82d2a93787a6f7327d1b484535b7f97a2d3f0bd16cef33074",
      "english": "Yorozuya!",
      "translator_note": null
    },
    {
      "id": "msb_0005196C",
      "source_words_sha256": "5e858003b1c194ac9c108c36cf15ab016ddfaf7ff8c84d37c828884dce3452d2",
      "english": "But he's trouble.\nWhy not ask the Yorozuya\nto help us out?",
      "translator_note": null
    },
    {
      "id": "msb_000519E8",
      "source_words_sha256": "8a863051e758ac3a4f86666073d80b3e3d29327f37944c0d86a5d60f00774ec3",
      "english": "[ctrl:FFA3]Yeah, got it.",
      "translator_note": null
    },
    {
      "id": "msb_000519FC",
      "source_words_sha256": "cf07e4d419aac02c8661d88cff86a24df23ef54cc78c31d78bba171546baff06",
      "english": "[ctrl:FFA3]Who knows?\n[ctrl:FFA2]That's why we're\ngoing in to find out.",
      "translator_note": null
    },
    {
      "id": "msb_00051A54",
      "source_words_sha256": "4c59486366a09feb412308d0406d98c422b278cfe8bf75b4fc737a9716d85f46",
      "english": "[ctrl:FFA3]...Though it may be\na bit heavy for\na midnight snack.",
      "translator_note": null
    },
    {
      "id": "msb_00051A98",
      "source_words_sha256": "f3d0dbf5c9e7f1f6a3faa2972f2756212dd706e52b9e36e458bee2797e51d646",
      "english": "[ctrl:FFA5]Idiot. [ctrl:FFA3]Old ties.[ctrl:FFB1] [ctrl:FFA2]Old ties.",
      "translator_note": null
    },
    {
      "id": "msb_00051AC4",
      "source_words_sha256": "0f9efccf11a23ca86e75d7134a31c3e172e015ed105b3e9bb4100738d90112f2",
      "english": "[ctrl:FFA3]But, you know...",
      "translator_note": null
    },
    {
      "id": "msb_00051ADC",
      "source_words_sha256": "6628e7d904980b1d18f9b863b2a1bfb3291395a6cad9a4bd68420edc6ea88aab",
      "english": "[ctrl:FFA3]But, you know...\nMaybe life's most precious\nthing is that rotten bond.",
      "translator_note": null
    },
    {
      "id": "msb_00051B3C",
      "source_words_sha256": "c4579002dd6ebd22d327cf70fb8d0748da5c873f8e71f85f1277493a645d1542",
      "english": "[ctrl:FFA3]...Shall we go, then?\nCatch that idiot we're\nstuck with...",
      "translator_note": null
    },
    {
      "id": "msb_00051B80",
      "source_words_sha256": "34325e99aca216eeefccb9d686fd52880f3a345be3c5ed756c123575716e6d3c",
      "english": "[ctrl:FFA2]Quit nagging, old hag!",
      "translator_note": null
    },
    {
      "id": "msb_00051BA4",
      "source_words_sha256": "b84bc19c5907a765bedae9230f54b1bc56779d0a1a71b6f24c8db70de6ad1bed",
      "english": "[ctrl:FFA2]Waiter duty means\nall the snacks we want!",
      "translator_note": null
    },
    {
      "id": "msb_00051BD0",
      "source_words_sha256": "143c3d50608aa03455e5a35e87d132339175a64c14ad94984b329498e45fdd76",
      "english": "[ctrl:FFA3]Working till night?\nImpressive. Finally\nturned over a new leaf?",
      "translator_note": null
    },
    {
      "id": "msb_00051C18",
      "source_words_sha256": "05b7a266cc2f4160c93def55706ba4dd15e46aff69fa230e8bc83b27758d05a1",
      "english": "[ctrl:FFA3]Well, listen to you.\nI'll look forward to...\n[ctrl:FFA2]YOUR OVERDUE RENT!",
      "translator_note": null
    },
    {
      "id": "msb_00051C64",
      "source_words_sha256": "d65e841a26578275f87e42ed83524daa3fd63a7c5b1507d1a88ce01a964538a1",
      "english": "[ctrl:FFA3]I'll look forward to...\n[ctrl:FFA2]YOUR OVERDUE RENT!!",
      "translator_note": null
    },
    {
      "id": "msb_00051C98",
      "source_words_sha256": "ae80d472ab38afe822c3f2e3d4758c8df573ebb2c1aa8ffe632c5c119e73d46b",
      "english": "[ctrl:FFA3]I asked Mr. Hasegawa\nto put us on waiter duty\nfor the night shift.",
      "translator_note": null
    },
    {
      "id": "msb_00051CE0",
      "source_words_sha256": "714a2af74943f1d77f8b68eceb92ec6bf415f8e845de1f7fe94dda7481faf2c1",
      "english": "[ctrl:FFA3]...Do you really think\nsomething will happen?",
      "translator_note": null
    },
    {
      "id": "msb_00051D14",
      "source_words_sha256": "1feada48bde57e1a4427c0361906db14289a866ae91382b496072e456bffbce1",
      "english": "[ctrl:FFA3]Gin... Whatever you say,\nyou really do care\nabout Mr. Katsura...",
      "translator_note": null
    },
    {
      "id": "msb_00051D60",
      "source_words_sha256": "3c5fa328be6b36a6e4728dafcf5d3ad4fa26de1e1454b284456b3af25ba561a6",
      "english": "[ctrl:FFA3]Gin?",
      "translator_note": null
    },
    {
      "id": "msb_00051D70",
      "source_words_sha256": "912c27352824727e5a77bc347510b926259e8611aca4dd369ce67d5e0fd7cf68",
      "english": "[ctrl:FFA1]!![ctrl:FFB2] [ctrl:FFA3]Gin!",
      "translator_note": null
    },
    {
      "id": "msb_00051D88",
      "source_words_sha256": "302a315cecb4a1cc858430ee2c8ee859838d8def730356e861bd389217e52a79",
      "english": "[ctrl:FFA3]Let's search room by room.\nLuckily, that nag Hasegawa\nis nowhere in sight.",
      "translator_note": null
    },
    {
      "id": "msb_00051DE0",
      "source_words_sha256": "b0a945ca2030ceab4ce0c2227fa0cbe9847c091e7a3fe4d81395657408f5ff09",
      "english": "[ctrl:FFA3]That man and his broom.",
      "translator_note": null
    },
    {
      "id": "msb_00051E08",
      "source_words_sha256": "88b29eae1b851c2dbb77d320dae7639e78a4841fd8ce01dbe4c26310a7aec23a",
      "english": "[ctrl:FFA3]WAAAAH![ctrl:FFB2]\nDREAMS COME TRUE!!",
      "translator_note": null
    },
    {
      "id": "msb_00051E3C",
      "source_words_sha256": "f4cc5dcca6d2c29011c220f546e43c64ce59261e96b44963e2fb93beb7b00fac",
      "english": "[ctrl:FFA2]He was sweeping outside.",
      "translator_note": null
    },
    {
      "id": "msb_00051E5C",
      "source_words_sha256": "df961b2b09c668641d814ce269312127ea99d53e2e0a7a769f9fdd2da0c8c927",
      "english": "[ctrl:FFA2]Ignore him.\nA loser barking away.",
      "translator_note": null
    },
    {
      "id": "msb_00051E8C",
      "source_words_sha256": "b258438133081f9cf25ada92bfea671a38d03958356991780dd64b70902f8585",
      "english": "[ctrl:FFA3]I just asked.\nAll tonight's customers\nhave arrived already.",
      "translator_note": null
    },
    {
      "id": "msb_00051ED8",
      "source_words_sha256": "d41d3f867f91f7f9e0e3e15a234da4dc5dbdcf43705eea1d6136a68f5f18c8e6",
      "english": "[ctrl:FFA3]Huh? I thought I\njust heard Mr. Hasegawa...",
      "translator_note": null
    },
    {
      "id": "msb_00051F1C",
      "source_words_sha256": "69d23541bacf2e89df9fc3ca1aef3001f527aa67bedbf5beb91d91051782c976",
      "english": "[ctrl:FFA3]Clever... but cruel.",
      "translator_note": null
    },
    {
      "id": "msb_00051F40",
      "source_words_sha256": "7f0fccef9b29e1dcd025604d44bf4ea1c592b539e97ae8caacabfd74d52417a0",
      "english": "[ctrl:FFA3]Uh, welcome.\nLovely day, isn't it...?",
      "translator_note": null
    },
    {
      "id": "msb_00051F7C",
      "source_words_sha256": "e5dd3ce9f514328ff404fda5c6576e1e0f32c8a345683ea74cfb1669d1c32064",
      "english": "[ctrl:FFA3]Table for one, sir?",
      "translator_note": null
    },
    {
      "id": "msb_00051F9C",
      "source_words_sha256": "4c7b17340f5af5177e11ad9e1469576767ca0adac8fa7417c233cecb7b81341a",
      "english": "[ctrl:FFA3]Why so nervous?\nYou're up to\nsomething shady...!",
      "translator_note": null
    },
    {
      "id": "msb_00051FEC",
      "source_words_sha256": "eec9c098546c81aaa8b09ca137538a78f52ccbee91db59dff6ab5c5352fbe6d2",
      "english": "[ctrl:FFA3]Seems so. Just\none stupid, unpopular\nlooking guy here.",
      "translator_note": null
    },
    {
      "id": "msb_0005203C",
      "source_words_sha256": "878aa5c337c8b788e0d79ac86cb2410eb5ad32767dd2d09dfb51af5d5e7b0d3d",
      "english": "[ctrl:FFA3]...So there you have it.\nSorry to bother you.",
      "translator_note": null
    },
    {
      "id": "msb_00052070",
      "source_words_sha256": "caedf0338b682b6c147588d16c596bfa8c1df7d8ffc3d1ca21a4245ee0821f84",
      "english": "[ctrl:FFA2]Waste of time!\nNext room![ctrl:FFB1] Next!",
      "translator_note": null
    },
    {
      "id": "msb_00052098",
      "source_words_sha256": "5f300e907cede147faf5409f76e5569b64a2ce10759b871180166c9fd77fbf1e",
      "english": "[ctrl:FFA2]Shut up.",
      "translator_note": null
    },
    {
      "id": "msb_000520A8",
      "source_words_sha256": "f492bb7dc7d00e088ab52a577a808e2b311873d06609b758326434c2db40a2c8",
      "english": "[ctrl:FFA2]Tch! Then we can't\nsneak any food here!",
      "translator_note": null
    },
    {
      "id": "msb_000520DC",
      "source_words_sha256": "6deae2dece4f389cd998b8085e771545a0cda25c7913cd00f19925d8f2e93b09",
      "english": "[ctrl:FFA2]Wait here forever\nfor your imaginary lover.",
      "translator_note": null
    },
    {
      "id": "msb_00052108",
      "source_words_sha256": "05daf6b2ba240ddea8b7097fbee754f47eeab2c44c59a8422f4e87607bee76a9",
      "english": "[ctrl:FFA2]OH!\nWhat's this, all of a sudden?!",
      "translator_note": null
    },
    {
      "id": "msb_0005212C",
      "source_words_sha256": "25f899624706a38361fcf7a68d87d0194997b1e10ba5bdc5aa486b1408f92cd4",
      "english": "[ctrl:FFA1]Impressions?[ctrl:FFB2] [ctrl:FFA2]But the food\nhasn't arrived! Nothing!",
      "translator_note": null
    },
    {
      "id": "msb_00052170",
      "source_words_sha256": "dd44a1e3f586b967c87a46c73e4fced9ef59e06db8d0abf8f6827c0db11d52d8",
      "english": "[ctrl:FFA2]P[ctrl:FFB1]-p[ctrl:FFB1]-private business!\nNo intrusive questions!\nThat's a big NO!",
      "translator_note": null
    },
    {
      "id": "msb_000521BC",
      "source_words_sha256": "270a1211f2630d5bc0f7945d03dbf301d431e218e2221513667edf2d5edc842f",
      "english": "[ctrl:FFA2]Too much accusation!\nI'm dating Jennifer tonight!\nWhat's wrong with that?!",
      "translator_note": null
    },
    {
      "id": "msb_00052214",
      "source_words_sha256": "c51783cbf2f5e84fa51660e0865a2a081dcab6d94941b4925cbf4ac73e6497fa",
      "english": "[ctrl:FFA2]If you bad-mouth me,\ndo it out of earshot!",
      "translator_note": null
    },
    {
      "id": "msb_0005224C",
      "source_words_sha256": "77379ed944a2ad35d405cbdff84f8bc100c526f14822158974173d6e419959e1",
      "english": "[ctrl:FFA1]!!",
      "translator_note": null
    },
    {
      "id": "msb_00052258",
      "source_words_sha256": "f1ca3bff00eee5d7b75cf61ca8521aa16fef005514b10c956f6248c9ad870d27",
      "english": "[ctrl:FFA2]OUCH! What the hell?!\nWhat's illegal about\nan ab workout machine?!",
      "translator_note": null
    },
    {
      "id": "msb_000522A4",
      "source_words_sha256": "9a66e289e448e6d906234db343505abf2c65437f11deffefe0098bd0fe7996c1",
      "english": "[ctrl:FFA3]Um... We're staff.\nJust asking how\nyou like the food...",
      "translator_note": null
    },
    {
      "id": "msb_000522EC",
      "source_words_sha256": "cd74c861ff020605209c7319c154641e0d7538e26c558241d9de40b3a2a77273",
      "english": "[ctrl:FFA3]Gin, wrong room, right?\nNo Mr. Katsura or ronin...",
      "translator_note": null
    },
    {
      "id": "msb_00052330",
      "source_words_sha256": "c9d5c13eac3ef4b86bb34d52335c160caf7a32660b02d9f1acbb83af774bf99e",
      "english": "[ctrl:FFA3]Sorry to bother you!",
      "translator_note": null
    },
    {
      "id": "msb_00052348",
      "source_words_sha256": "da37d838c1d91d999c838f6fe01e7af389c72c78ea706f3a67c01eb2d8bdd3f0",
      "english": "[ctrl:FFA3]Wrong room, then.",
      "translator_note": null
    }
  ]
}
