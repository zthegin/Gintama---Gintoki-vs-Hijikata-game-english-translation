{
  "format": "gintama-community-translation-v1",
  "batch_id": "batch_0126",
  "records": [
    {
      "id": "msb_0005A95C",
      "source_words_sha256": "e81b6845ae1d6928bd1ee3b33a4440800b5057b821651ccfcbbf16b1b0406456",
      "english": "Yes. Forensics woman's job.",
      "translator_note": null
    },
    {
      "id": "msb_0005A9D8",
      "source_words_sha256": "10801f92c811f74a3515f28666d341ebc147fd19465090cc2d9df25932320e73",
      "english": "Daytime stroll?",
      "translator_note": null
    },
    {
      "id": "msb_0005AC24",
      "source_words_sha256": "1bbd7238847ec2e3e0a034a0aebe530c15578a8edc9945a9ceaec2e5394cf48b",
      "english": "Good luck, old man.",
      "translator_note": null
    },
    {
      "id": "msb_0005AC50",
      "source_words_sha256": "1c7c4456a85b00a565778b1a3b7b20163acda106f1cbb537f63193f1791ff45f",
      "english": "A kind old man.",
      "translator_note": null
    },
    {
      "id": "msb_0005AC6C",
      "source_words_sha256": "0639e64b0c4aaf932307c33d203a01dc98dbc98e38d79a467cea123078bd765c",
      "english": "Toshi, want this\nstrawberry milk?",
      "translator_note": null
    },
    {
      "id": "msb_0005AD34",
      "source_words_sha256": "72bd7f5da0b17ce7432737a210315ed70c316da4587412807a4dd30a6cd07b3d",
      "english": "Okay. Find him,\ncut him down.",
      "translator_note": null
    },
    {
      "id": "msb_0005AD5C",
      "source_words_sha256": "6f8b69542fef31b587f28967cf13f406d84cb89941ed97dd10879dbfa64b136f",
      "english": "It's fine. Punish\nthose dangerous men\nafter the shogunate.",
      "translator_note": null
    },
    {
      "id": "msb_0005AE50",
      "source_words_sha256": "894703549c3341150e134331dd19ba4f4a3bb2c171b6b9616eb59a407326647c",
      "english": "Orders from above?\nAmanto interference.",
      "translator_note": null
    },
    {
      "id": "msb_0005AEC4",
      "source_words_sha256": "75b45a260ea26f779282d7c880eb183dcafb4c7901531752b7f561fd875a6c4d",
      "english": "Like it or not,\nI'll obey. It's work.",
      "translator_note": null
    },
    {
      "id": "msb_0005B0C4",
      "source_words_sha256": "97c55aeabcf0fd1c305140654322aa2b3656394f967ff2988d069e719ff3d23a",
      "english": "Not our job.\nThat's forensics work.",
      "translator_note": null
    },
    {
      "id": "msb_0005B1F4",
      "source_words_sha256": "ee9abfb9c138ea6cadd93ee07bc33a2db7e0c79fd4100d9c70745ebd07396081",
      "english": "Don't be rude!\nNo wig allegations!!",
      "translator_note": null
    },
    {
      "id": "msb_0005B424",
      "source_words_sha256": "b8da37655ebe7017c9b1bdbd8178a4fffd88bfb99f41472afbf94afa34eace90",
      "english": "You're hindering\nthe case... I mean work!",
      "translator_note": null
    },
    {
      "id": "msb_0005B450",
      "source_words_sha256": "485a0d7085ce69af104ac4670b307fd528ed9769eede1913e3c19ae7dd8968b2",
      "english": "Stay out of this.\nJust present the weather.",
      "translator_note": null
    },
    {
      "id": "msb_0005B71C",
      "source_words_sha256": "15541840363aa52eaa9f93d30b8f21641b7c79ce139f8b19ee54cb760eee1979",
      "english": "Ketsuno reporting.\nTake a look.\fThe Shinsengumi\nseem to be investigating.",
      "translator_note": null
    },
    {
      "id": "msb_0005B7D8",
      "source_words_sha256": "a6ce579f12ad8a83e306f6a666ec76358f1defc055d00c826ecb878f8e0f1903",
      "english": "No interviews?!",
      "translator_note": null
    },
    {
      "id": "msb_0005B824",
      "source_words_sha256": "fea3a1168edbf84203f47d6d2563a3ac3004b3f69c12a873b1e4d0a7d4e23554",
      "english": "Sorry. I cover\ncrime stories too.",
      "translator_note": null
    },
    {
      "id": "msb_0005B84C",
      "source_words_sha256": "d797580f54b2bf6260efb5b5a01e257d41e3768571dab1f2bc1dfa859d569588",
      "english": "As you can see,\nShinsengumi are no fun.\nBack to the studio.",
      "translator_note": null
    },
    {
      "id": "msb_0005B8CC",
      "source_words_sha256": "6490dab6b8eec40f05d72145ae69cb5f4c1920c3ef2e2426779e945bb56e9cde",
      "english": "Proof of love.",
      "translator_note": null
    },
    {
      "id": "msb_0005B8DC",
      "source_words_sha256": "04222830f020b34f09399d4f1077490d42c28aa5058f3d4610d313b98cfa9614",
      "english": "Point a camera at me\nand I get n-nervous...",
      "translator_note": null
    },
    {
      "id": "msb_0005BB5C",
      "source_words_sha256": "b8f4e99a55e19d0811d7d2e109def665373d1ea78198ab8e2e0943e345c6cfbb",
      "english": "Fast current too.",
      "translator_note": null
    },
    {
      "id": "msb_0005BBFC",
      "source_words_sha256": "aec9a9b8745a1fb1b998f49926bbcca78525bae76799287bd3dc159704926496",
      "english": "The current's\nfast, too...",
      "translator_note": null
    },
    {
      "id": "msb_0005BCC4",
      "source_words_sha256": "1907ba51438276e520c8e5be50e0001359fddb64190a0fda619fe9e6c8b33706",
      "english": "Local police\nrequest backup!",
      "translator_note": null
    },
    {
      "id": "msb_0005BCE8",
      "source_words_sha256": "74d17df4ba61a214850e7821b1f3e0f1ec55af7b0048c665fd8cff6e3328b7ab",
      "english": "Too much for\nthe forensics woman...",
      "translator_note": null
    },
    {
      "id": "msb_0005BD2C",
      "source_words_sha256": "034006dd76fc97cc08ec5225cf7b256b8a0ad4a044790475307e81b6f813995f",
      "english": "Otae of [blue]Kodokan Dojo[/color]\nwas kidnapped.",
      "translator_note": null
    },
    {
      "id": "msb_0005BFE8",
      "source_words_sha256": "c9da288623acf7d3e26ddf7fc7cac3cca72e3123621471148fcf6d75550f7a59",
      "english": "Ugh...!\nOut of my way!!",
      "translator_note": null
    },
    {
      "id": "msb_0005C4EC",
      "source_words_sha256": "ba16b817a63af4ab1f45c107e2e47a7605487c52511275c0890091914ee94590",
      "english": "Damn. Envious.",
      "translator_note": null
    },
    {
      "id": "msb_0005C5DC",
      "source_words_sha256": "a11d41dd5b0ea5df1bed34b82c1024ee4b063e1fa0318a29b69b3111998f7579",
      "english": "I know. If it comes\nto it, I'm prepared\nfor seppuku.",
      "translator_note": null
    },
    {
      "id": "msb_0005C660",
      "source_words_sha256": "1cfd876a96c9edeebd8d9d3d4f617ce656f536510a7a8e33aa0a24ba3c73d2cc",
      "english": "Toshi, we're comrades.\nSink or swim together!\n...Right?",
      "translator_note": null
    },
    {
      "id": "msb_0005C6B0",
      "source_words_sha256": "22b98635a1d1124c324d51a94018f1b02646d69012873c4aab560f76718c47df",
      "english": "Raid the rebels'\nhideout now!",
      "translator_note": null
    },
    {
      "id": "msb_0005C72C",
      "source_words_sha256": "8550c928beaad93c0136e4cc387df2b505584bd558699a188ea90cec74d9d9d0",
      "english": "Know a restaurant\ncalled [blue]Nabeya[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_0005C7A0",
      "source_words_sha256": "ddfeb1e8e899dbe58176533e3bb45966d1661bd31b5bb57cb005a453832e42e2",
      "english": "Yes. Reliable source.\n...And on top of that...",
      "translator_note": null
    },
    {
      "id": "msb_0005C864",
      "source_words_sha256": "ca956043db6b66dc88a2b61fe2da7ec13a5d8aaa245151d0c83fcf642c4f3524",
      "english": "Worth looking\ninto, I think.",
      "translator_note": null
    },
    {
      "id": "msb_0005CC8C",
      "source_words_sha256": "9011b786151a6691d4dab18f1e85b1b3832c937885e56779242f08ba9b0b8ebb",
      "english": "We've learned\nrebel ronin\nare hiding there!",
      "translator_note": null
    },
    {
      "id": "msb_0005CD20",
      "source_words_sha256": "33cda78b69c722b319fbfd6bba389599107db25ef014ab6d1071095bbc6dcd92",
      "english": "Stay clear!",
      "translator_note": null
    },
    {
      "id": "msb_0005CD30",
      "source_words_sha256": "a505d59a7cab9fadaa59cb13d1c67a91d9ba3e8fef31b060722c3bcd7f435c6f",
      "english": "Fine!\nI'll crush you!",
      "translator_note": null
    },
    {
      "id": "msb_0005CD70",
      "source_words_sha256": "1835030faf514e93fc386e89bc51f33e2036ab0d18c8fe452cf89caa5c235a61",
      "english": "Dream all you like.\nJust stay out of the way.",
      "translator_note": null
    },
    {
      "id": "msb_0005CEBC",
      "source_words_sha256": "f19415614cb756fc514e762041e1c0e6793d8ecc59562adca259117919150985",
      "english": "Missed this feeling!",
      "translator_note": null
    },
    {
      "id": "msb_0005CED8",
      "source_words_sha256": "7178896273abd29e75527aaf9732dd00246ae9f57dbaccf0f56adff5e1e9642e",
      "english": "I'll arrest you all!",
      "translator_note": null
    },
    {
      "id": "msb_0005D004",
      "source_words_sha256": "cdbd64d39a651e93f11cacf946504e5d4747cd98bc164b771d4b675362883a81",
      "english": "Admitted it! Arrested!",
      "translator_note": null
    },
    {
      "id": "msb_0005D064",
      "source_words_sha256": "6b6de1a28e7fa07d6f2724e7b0bbf122ca08227207b5acabeb1875595fe6808d",
      "english": "Expensive?!\nSelling things you\nfound for a fortune?!",
      "translator_note": null
    },
    {
      "id": "msb_0005D3F4",
      "source_words_sha256": "27ca473a1121b25c1f94b1a7cf2bfd465222beb077c271d81d30be9ba445c3eb",
      "english": "OUCH!!\nNo one said arrest!",
      "translator_note": null
    },
    {
      "id": "msb_0005D514",
      "source_words_sha256": "2e61d3b45d14e35d1268c3445ff64879ffa2a3e42dec77b8589a340fcfa2215f",
      "english": "GREAT!! Costly,\nbut effective, right?",
      "translator_note": null
    },
    {
      "id": "msb_0005D540",
      "source_words_sha256": "b51b01f3ca28e5a66b340d15ed5af2c9b638bddab692f207e2fed77c19297e79",
      "english": "High prices\nare illegal?!",
      "translator_note": null
    },
    {
      "id": "msb_0005D564",
      "source_words_sha256": "0423ff21b75c52fdf33c76c4bda0b9c4dc9eaedbe5b45613d447e5119fae4957",
      "english": "That's absurd!\nI'm not the one\nsetting the prices!",
      "translator_note": null
    },
    {
      "id": "msb_0005D6BC",
      "source_words_sha256": "5e715e86e77888c32499a27ad7b188e9afa9819487efb963bbc4a9aea4a60ec6",
      "english": "OUCH! What the hell?!\fWhat's illegal about\nan ab workout machine?!",
      "translator_note": null
    },
    {
      "id": "msb_0005D7A0",
      "source_words_sha256": "faa0b60fb761c75c0314be2cec70ae4a6fb5f2fd396ebc67f6b92de88a8aa575",
      "english": "Overcharging\nfor huge profits?!",
      "translator_note": null
    },
    {
      "id": "msb_0005D870",
      "source_words_sha256": "d5459746ac2d9bf72601e71906b56884bb06b4ca098018f1f04c9c5b57a845a1",
      "english": "How many clients?",
      "translator_note": null
    },
    {
      "id": "msb_0005DB9C",
      "source_words_sha256": "1b3ded84222cd668b4e15b575efa54f49ae7dd2f7deeddfc435d8e5f9e333531",
      "english": "Hold on!\nWhy am I\nbeing arrested?!",
      "translator_note": null
    },
    {
      "id": "msb_0005DC58",
      "source_words_sha256": "75a54669774ef9321f9902f83cf78aac7175167622c7d5423452f85ed900ebe6",
      "english": "Heard Michael's\nbad-mouthing me.\fThought I'd crash\nhis date and\nteach him a lesson.",
      "translator_note": null
    },
    {
      "id": "msb_0005DD7C",
      "source_words_sha256": "e57b63216b579a35f89d5777a93d37808480d78e077778e239cc43d43f44ceac",
      "english": "Arrested anyway!",
      "translator_note": null
    },
    {
      "id": "msb_0005DDE8",
      "source_words_sha256": "b89f068d0827a90a97170222d891bd5bd6d0a89cabdfe28257f2482f4f221354",
      "english": "Showbiz too, huh.",
      "translator_note": null
    },
    {
      "id": "msb_0005DDFC",
      "source_words_sha256": "d1f1804472327bd930e1768f1c2fe2844737dd3403b066a51be2a67637bb2e0f",
      "english": "A rebel deal\ninvolving TV\nand showbiz.",
      "translator_note": null
    },
    {
      "id": "msb_0005DE74",
      "source_words_sha256": "22cd0dcfb9e2d37bda40a48e231fdfbb0dec6b8409d7f048a6810b21b7b08917",
      "english": "Talk at the station.",
      "translator_note": null
    },
    {
      "id": "msb_0005DEA8",
      "source_words_sha256": "bbe66348c5eb5d17d1b6bee8f1a3605ac363addfcd975dd2886827d130eb6d53",
      "english": "Woman or not, no mercy!",
      "translator_note": null
    },
    {
      "id": "msb_0005DF80",
      "source_words_sha256": "1779eaf2b845a5cb2a393bcad764b5c136f25f1b61ea4c9c468210c8ebd3773f",
      "english": "I'm ready.",
      "translator_note": null
    },
    {
      "id": "msb_0005DF90",
      "source_words_sha256": "cb016d88a9801417c83af0a3e0094eec9417ad8f758c12f78b7e1b97d5612810",
      "english": "Hey, idol.\nShogunate bigwig's\nnext door?",
      "translator_note": null
    },
    {
      "id": "msb_0005E040",
      "source_words_sha256": "68db0829b88b49fc73b7e1d83070397e3eecf1956056bb849ba208ce7f1cc634",
      "english": "Talk at the station.\nTake her away.",
      "translator_note": null
    },
    {
      "id": "msb_0005E0FC",
      "source_words_sha256": "163f13718de658a5307a011a7eb119ded12041ec8d128751c959d604f3be8133",
      "english": "You can be last.\nFirst, arrest\nthe shogunate official!",
      "translator_note": null
    },
    {
      "id": "msb_0005E224",
      "source_words_sha256": "bc1e00d51e3372d7ba904b475ae272cecddaaeae450e3cdc40dbeac2f910f3ca",
      "english": "Wait a minute!\nWhy arrest me?!",
      "translator_note": null
    },
    {
      "id": "msb_0005E26C",
      "source_words_sha256": "0d654b5a234891a1c90ac2efc57c6b654904432269dcbb37afebc2e5cadd606d",
      "english": "Shogunate clients.",
      "translator_note": null
    },
    {
      "id": "msb_0005E288",
      "source_words_sha256": "e324d4b6fd3e2b56be1b7d536aaadb26c64b864d326c22238f575aa5b7b218e7",
      "english": "In showbiz,\npolitical connections\nare a weapon.",
      "translator_note": null
    },
    {
      "id": "msb_0005E2BC",
      "source_words_sha256": "849673c8c609cbcca87f4e56c7a2857669dbdb30797a44a1a0d9477cd3038db7",
      "english": "Don't cry, Otsu!\nYour legend\nhas only just begun!",
      "translator_note": null
    },
    {
      "id": "msb_0005E2F0",
      "source_words_sha256": "400dba69164bcd29f13dad019c8ec866d1861a914dca1faf0fcf4d90993c6d67",
      "english": "Wait! I really\ndon't know anything!",
      "translator_note": null
    },
    {
      "id": "msb_0005E56C",
      "source_words_sha256": "3580def5bb09a8372c44da06c5051f37b8cac3b6e3ec04bf037470ba7909bb1b",
      "english": "Hired as geisha.\nRight, Mama?",
      "translator_note": null
    },
    {
      "id": "msb_0005E6E4",
      "source_words_sha256": "6c2353f6e60b3a94bb3d45dbf678aa514e15961ff0e26deca386f7182635f8bd",
      "english": "Cut them down!!",
      "translator_note": null
    },
    {
      "id": "msb_0005E728",
      "source_words_sha256": "36bf4114d3b4af4bbd3d305656575da3926cb4a27f9c45522c3bbd8b0c8d45d6",
      "english": "True...\nJust a drunk old man\nand drag-queen geisha.",
      "translator_note": null
    },
    {
      "id": "msb_0005E7F0",
      "source_words_sha256": "455ae91511af20bf5427dd5aa669386dde2567c4011fad69b5bdf5e8eb833ad2",
      "english": "Intel said\nrebels were hiding\nin this restaurant.",
      "translator_note": null
    },
    {
      "id": "msb_0005E854",
      "source_words_sha256": "f7800dfdbed5b9fb66b7f3917b8627ec3d744254bac8bb19622bf8748449ec11",
      "english": "TV, showbiz,\neven shogunate VIPs\nseem involved.",
      "translator_note": null
    },
    {
      "id": "msb_0005E950",
      "source_words_sha256": "a8d03480b67df82a3879cad3d4a633bcd8d9227a284c47b034ec69b5e3248f7b",
      "english": "Late meeting with geisha!",
      "translator_note": null
    },
    {
      "id": "msb_0005EC18",
      "source_words_sha256": "9bd4754e49ab5ce86405d98f7f1be7cc029177ed42bc496563fe5dceeca1abc8",
      "english": "Matsu! Amazing!!\nWonderful!!",
      "translator_note": null
    },
    {
      "id": "msb_0005ECE4",
      "source_words_sha256": "9079dc33f44d216ddf1a50b37d34abf8ffb9e0fe8bdc0a6910dc058e714f5dfb",
      "english": "Shut up! Resist\nand I'll cut you down!",
      "translator_note": null
    },
    {
      "id": "msb_0005ED14",
      "source_words_sha256": "7dae426e7a606743f1fdf534fea30c8f2d990f1c907657f51117b3680de7bc90",
      "english": "Move, small fry!",
      "translator_note": null
    },
    {
      "id": "msb_0005EDC0",
      "source_words_sha256": "bea8ce245e22424a92b8b1a8e8d7b61416aeec72a851f910924a57b4af0f387d",
      "english": "I know. Just run, Zura!\fI'll buy you time.",
      "translator_note": null
    },
    {
      "id": "msb_0005EF10",
      "source_words_sha256": "5b8f63b987d5b3a33cb56bef17c9a582266badbeda02e0c878694e12ed22c3f8",
      "english": "Interfere?\nToo much trouble.",
      "translator_note": null
    },
    {
      "id": "msb_0005F1DC",
      "source_words_sha256": "a2ae7a277d5a9d1d65a2b6dc9a9e857a4ede7dc2b61e807566f3230dfa38d19a",
      "english": "Shut up! Get in the way\nand you're arrested too!",
      "translator_note": null
    },
    {
      "id": "msb_0005F350",
      "source_words_sha256": "c9703b71a2f4a14da23ad2d5f0f14086ff46baad2fc7a8edd77d1a838edfc1cb",
      "english": "Remember this!",
      "translator_note": null
    },
    {
      "id": "msb_0005F4D4",
      "source_words_sha256": "52a18a0221cc6923907e77049411fd63c4b027f49c906aff6b053d2fdb742502",
      "english": "Seems Kondo went\ntoward [blue]Health Spa[/color]...",
      "translator_note": null
    },
    {
      "id": "msb_0005F520",
      "source_words_sha256": "65d4653641154f664e7f68b9d6cdf3428882d2e0a3cd8b81e87aaa097ff10369",
      "english": "Thanks, old man.",
      "translator_note": null
    },
    {
      "id": "msb_0005F630",
      "source_words_sha256": "74dcb8770e0cb403062da722cd26e04b7456eee82d15432d1ccc21cf9079aa1d",
      "english": "Come to think of it...\nSaw a gorilla walking by.",
      "translator_note": null
    },
    {
      "id": "msb_0005F6B8",
      "source_words_sha256": "7f3e012b5861345efd1f0e94743f1c313d7b749ef02009e20d70923480fae06d",
      "english": "[blue]Health Spa[/color].",
      "translator_note": null
    },
    {
      "id": "msb_0005F94C",
      "source_words_sha256": "115acb19eabf289c036dedc61ee9f6c8fa93cfd39a0d5bcef81ed242fd1aade6",
      "english": "A moving house?\nThat's faulty construction.",
      "translator_note": null
    },
    {
      "id": "msb_0005F9D8",
      "source_words_sha256": "a031ba8360a5e1dfb7c66a17299cc104dac0035bcbde4e0a1ce7585e9ba56b22",
      "english": "Salmon? Pigeons?\nRadiation-loving\nmonster king?",
      "translator_note": null
    },
    {
      "id": "msb_0005FA38",
      "source_words_sha256": "1ebf5b630aa221cf5fcc5d086a84377f1b4d8b7b7a1d9db453218d6595040ec3",
      "english": "Embarrassing.\nDon't tell anyone.",
      "translator_note": null
    },
    {
      "id": "msb_0005FC48",
      "source_words_sha256": "33bb1def4a396c97f9b4af7d99e48d68fbf0479433e707d2957b687bd589124f",
      "english": "Wait a minute.\nThis is [blue]Koei Theater[/color].",
      "translator_note": null
    },
    {
      "id": "msb_0005FC7C",
      "source_words_sha256": "593da5a81f4e749397725b70129473e93b75b27173a64e4de6764e01f41a5040",
      "english": "An interesting film.\n'Alien vs Yakuza: Part 2'!",
      "translator_note": null
    },
    {
      "id": "msb_0005FCDC",
      "source_words_sha256": "436c97158ac0f40da52fa67e2d3ebac031530494f32d19b30302bbe269f43e8c",
      "english": "At [blue]Koei Theater[/color] again.",
      "translator_note": null
    },
    {
      "id": "msb_0005FE9C",
      "source_words_sha256": "8a5d11edda2f9132dd81bd85e34fae7b6ace900125dbe64d7a4a9bcf0f88f09b",
      "english": "[blue]Health Spa[/color], sir.",
      "translator_note": null
    },
    {
      "id": "msb_00060010",
      "source_words_sha256": "96e8dc35d3005c9bfbe0a092be59830673647f4bfd5d15bc73cc71458a1e9892",
      "english": "Good we noticed now.\nWe'd have ended up\nlost out here.",
      "translator_note": null
    },
    {
      "id": "msb_0006007C",
      "source_words_sha256": "08f33f04bdac4dd835a832df77ebe64b35fd3c8989f31a86f91bcef8e03633a6",
      "english": "Actually lost now?",
      "translator_note": null
    },
    {
      "id": "msb_00060110",
      "source_words_sha256": "2e42d3fdd4de6e5b7816a17cd82d6db598b604f44149ae303f5f94adc0ee933f",
      "english": "Toshi! Memorize\nthe lay of the land!",
      "translator_note": null
    },
    {
      "id": "msb_00060158",
      "source_words_sha256": "211efefc842e071de9e5de4e920a5f5c4447476590cf21dc3369ed414f27b985",
      "english": "Tomorrow's too late!\nTo [blue]Nabeya[/color], now!",
      "translator_note": null
    },
    {
      "id": "msb_0006020C",
      "source_words_sha256": "4d8e8e50350c4d6c16ede297271eda7e331005ffbba503a72b5decf991b527db",
      "english": "Back at the cinema.",
      "translator_note": null
    },
    {
      "id": "msb_00060398",
      "source_words_sha256": "5f40312ad6ac7b5e0e3500349a61556fedb0a212ebd40385a9d159f347e9400e",
      "english": "Lost in town? Please.",
      "translator_note": null
    },
    {
      "id": "msb_000603DC",
      "source_words_sha256": "a59596862a1276614e6b2c175557a05a784956c6d3979c07d0a28f580bffb194",
      "english": "[blue]Cafe St.[/color], sir.",
      "translator_note": null
    },
    {
      "id": "msb_00060564",
      "source_words_sha256": "f14beac86ca4ab7efcaacd49ddd486f66f79afe8003d73cda90df4c30677fd7d",
      "english": "He may escape\nwhile we gather Tama.\nGo in now.",
      "translator_note": null
    },
    {
      "id": "msb_00060968",
      "source_words_sha256": "8697c2edcaf8fddc252f61b2463042034f7dc85d0ca14d57b9a3cf8e63c2df51",
      "english": "Instant travel\nto distant places\nmakes exploring easier.",
      "translator_note": null
    },
    {
      "id": "msb_00060A70",
      "source_words_sha256": "a9969a458a8f6aab8a70a7ce7689c9cb6a687dcc93a11caece2a64c048344d7f",
      "english": "Job hunting?\nWalk around and\ngather information.\fThese days, finding work\nisn't easy...",
      "translator_note": null
    },
    {
      "id": "msb_00060BA0",
      "source_words_sha256": "86220ec36b85f2b050fe12dcc35bf05c7d916c8851b5a06143b75b3ac63d916f",
      "english": "A famous restaurant.\nWork hard. Don't\nembarrass the place!",
      "translator_note": null
    },
    {
      "id": "msb_00060E1C",
      "source_words_sha256": "a5f5ad1cccbdaddcbe7496bfae69699015b6412adb34d74f39b2eb620ab9799c",
      "english": "Huh? Hired\nat [blue]Nabeya[/color]?!\fLucky...\nWish they'd hire me too.",
      "translator_note": null
    },
    {
      "id": "msb_00060EA4",
      "source_words_sha256": "4178dc0075f3d0b6de107450bb4f4b8f17bbc330c75355761ab593bd6fbc3dc4",
      "english": "You brat!\nSuch rude words\nin that innocent tone!",
      "translator_note": null
    },
    {
      "id": "msb_00060F34",
      "source_words_sha256": "9db94cdffcc9a9e39170dba6dc702ace6fd8cf30628587d1942bb828bb1072de",
      "english": "We'll starve\nat this rate.",
      "translator_note": null
    },
    {
      "id": "msb_00061340",
      "source_words_sha256": "08df5bf9e729956f77ba12b31134f0196c0c51f00dfe065c5749a112197ec718",
      "english": "Shut up. A name\nshould fit its owner.\nHamuko it is.",
      "translator_note": null
    },
    {
      "id": "msb_00061454",
      "source_words_sha256": "1b2801a819819998f7100d2b3b82084cd5dabd1a97dcc4e42bce93512dd03d32",
      "english": "What?! An unemployed bum\ncalling me processed meat?\nHow rude!!",
      "translator_note": null
    },
    {
      "id": "msb_00061574",
      "source_words_sha256": "8fc557c9b0ca756aa439ee088e026eb1ef62ad72775140697b77173e06664df6",
      "english": "We need to find work,\nso we'll be going.",
      "translator_note": null
    },
    {
      "id": "msb_00061854",
      "source_words_sha256": "41ca13eddca21a3aaa950a34ef31184002d7197f2ef4b65f65d78b0c3d7a7d6f",
      "english": "We'll starve! STARVE!",
      "translator_note": null
    },
    {
      "id": "msb_000618C0",
      "source_words_sha256": "5c6cb161dedc8be07fd98f57da7a96c765c8069aaf63b046c7bd490f63bba780",
      "english": "Hard to deny, though.",
      "translator_note": null
    },
    {
      "id": "msb_0006197C",
      "source_words_sha256": "5bedd9a94a6298d01e3a3cec0ec608bc7f349de5e594fff19d89b70abb9f4f07",
      "english": "And you're yakuza,\nout in broad daylight.",
      "translator_note": null
    },
    {
      "id": "msb_00061B10",
      "source_words_sha256": "20f5cfd787ba045f02f530de74508248e44dcf804f58111e9c319bdd9df135f2",
      "english": "Such a gloomy face.",
      "translator_note": null
    },
    {
      "id": "msb_00061B34",
      "source_words_sha256": "1caebd472f55441477ce187450c8192c0f1a6de17ffb9992b44b1c3392811e81",
      "english": "What?! Yakuza can't\nwalk in daylight?!\nDon't discriminate, bastard!",
      "translator_note": null
    },
    {
      "id": "msb_00061BA8",
      "source_words_sha256": "06a0f7d76a031ca2b252db88080e4781ba0606322dc2e0c70b8b9b2bc22dfc0b",
      "english": "You guys got jobs\nat [blue]Nabeya[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_00061C18",
      "source_words_sha256": "49f9929f14db617aaa444337cd35bb68b99d3c3a3e9e48ec5c656e5cc5f50886",
      "english": "No! Samurai keep\ntheir pride even hungry!\nSome dignity, please!",
      "translator_note": null
    },
    {
      "id": "msb_00061CFC",
      "source_words_sha256": "606648829354f062b7757127a6a6ec507a1d9460281e58189ca60bfde9ffc44b",
      "english": "Really? What about\nworkers' rights?",
      "translator_note": null
    },
    {
      "id": "msb_00062230",
      "source_words_sha256": "46ccba705a5e160438c7712c47b6c746b838ad5b9139d73b229d0ae514707f31",
      "english": "Dressing it up\nin lofty words\nwon't fool me.",
      "translator_note": null
    },
    {
      "id": "msb_000622F4",
      "source_words_sha256": "d49f83b9ef69dc3bd9d13237addc09acfd237f0a6f4b5d497f4dc0e1bd975858",
      "english": "Maybe it's\nthe will of heaven.",
      "translator_note": null
    },
    {
      "id": "msb_000623CC",
      "source_words_sha256": "57e22a22de434f5d6d393025e6c34730d7e9d212c293f1051b6a9e2f643d1b7b",
      "english": "We're heading to [blue]Nabeya[/color].\nThe cinema's this way.",
      "translator_note": null
    },
    {
      "id": "msb_0006281C",
      "source_words_sha256": "1f559947482618ae335c6a43448f30fdbef1064bf9f1111fbc84fdccf4ffb5fa",
      "english": "Hmph! Just testing\nwhether you remembered\nthe way!",
      "translator_note": null
    },
    {
      "id": "msb_000628A0",
      "source_words_sha256": "3714883e07a55b8b79115f5e21971721ab92abde49ad22c7414f8c0758abbf29",
      "english": "Memory of a chicken.",
      "translator_note": null
    },
    {
      "id": "msb_000629C0",
      "source_words_sha256": "3792a4ad819ece7786e3f39bacc5290bc7776ade5a9776de4aaec747ded9813f",
      "english": "Right, Kagura.\nInsulting to chickens.",
      "translator_note": null
    },
    {
      "id": "msb_00062EF0",
      "source_words_sha256": "9f01f421cf177578f4bdfc13faec1f502564028857db97a14c59c3bbdfa61e8a",
      "english": "Tch! Useless!\nNever asking again!\nTax thief!",
      "translator_note": null
    },
    {
      "id": "msb_00062F48",
      "source_words_sha256": "320f219f00e74b2b642cdd0243aef3585106b01847049e59a697b80bc429bb38",
      "english": "No comment on taxes!",
      "translator_note": null
    },
    {
      "id": "msb_00062F68",
      "source_words_sha256": "ed38f1331c5073a5cc6d1a0512f37ad2451f740ea18c769ddcb7d3bd166c2325",
      "english": "Shut up! Not a word!\nI can't hear anything!!",
      "translator_note": null
    },
    {
      "id": "msb_00063088",
      "source_words_sha256": "2bb7763834a031074357d3a1c749afb7e35dd83f0d8cdcf192669022bf865baf",
      "english": "...Do you pay taxes?",
      "translator_note": null
    },
    {
      "id": "msb_00063364",
      "source_words_sha256": "a92e28f6265424a6da912e3afb5e700e6e909aa539b43279c92ce4b4fb817fdd",
      "english": "Clever words\nwon't earn you praise.",
      "translator_note": null
    },
    {
      "id": "msb_00063470",
      "source_words_sha256": "c46d6f36c7d0cff658784fa02f3fca99f813588d16db89d1df01383ccfa2087d",
      "english": "Finding a shady guy here\nis like finding a pearl\non a beach.",
      "translator_note": null
    },
    {
      "id": "msb_00063730",
      "source_words_sha256": "dd300b5c6a73b45b4ad97355e0d8c2e2f7389671f3951b6229a1a2a8434160a8",
      "english": "Why raise the price...?!",
      "translator_note": null
    },
    {
      "id": "msb_00063774",
      "source_words_sha256": "2eb71487a7a60f0f84fb8b1a0ac323848b4a81bd5a442888e0a23c66b5dc05e6",
      "english": "Raised it AGAIN?!!",
      "translator_note": null
    },
    {
      "id": "msb_000637E0",
      "source_words_sha256": "bfa21d1742ec441581b42313c5048bb8737e3d3ac9eec235e8a8964831c16fa1",
      "english": "You attacked Shinpachi?\nA grudge, huh.\nVindictive bastard.",
      "translator_note": null
    },
    {
      "id": "msb_00063860",
      "source_words_sha256": "95591dcd6f80267d1b2d0e0cc165094b85270e001e06b17257b7d3e31fe57ac8",
      "english": "Forgiven for 1,000 yen.",
      "translator_note": null
    },
    {
      "id": "msb_0006389C",
      "source_words_sha256": "fa0232c8952a9b3ec3f5f12956c867200fd91f2ec185e6af7c96dc2d509022f1",
      "english": "Forgiven for 5,000 yen.",
      "translator_note": null
    },
    {
      "id": "msb_000638C0",
      "source_words_sha256": "ea3724fdf3dfd6cbd44df17b7f70d736cd2a38846124497a75a367db2be12775",
      "english": "Tch! I was ready\nto settle for\n10,000 yen now.",
      "translator_note": null
    },
    {
      "id": "msb_00063900",
      "source_words_sha256": "12491b861ebcd9093ca87d7134b164c6797c8e961102edea51076f63e8775926",
      "english": "Gin... What business\nare you starting\nwith the biker gang?",
      "translator_note": null
    },
    {
      "id": "msb_00063AC8",
      "source_words_sha256": "39c41908a1449bcc4fb2667b78d681a4df8d038792e968743756dcab33b9ca6d",
      "english": "No thanks!\nI'd sooner go naked\nthan wear that!",
      "translator_note": null
    },
    {
      "id": "msb_00063F4C",
      "source_words_sha256": "03f143715fb05e4207449b5cb6475015930e1e54c640e73772e3cfc8cb2b8077",
      "english": "Searching every day.\nNot a single clue...",
      "translator_note": null
    },
    {
      "id": "msb_00064188",
      "source_words_sha256": "1eacf1e960f990a3827bb5b99e59d3b4a5923321c29671e887595679d1430550",
      "english": "Welcome to\nthe [blue]Laptop Cafe[/color]!",
      "translator_note": null
    },
    {
      "id": "msb_0006427C",
      "source_words_sha256": "d30472b5d7e004d6006cd3af9ad3d04b0b548bbfe3a56224d50f7d7c97a113ee",
      "english": "Stay away,\nyou jinx!!",
      "translator_note": null
    },
    {
      "id": "msb_0006434C",
      "source_words_sha256": "1da3384b037e249db9766f5c22503ded517a0f4fe8c205e32373abd2f36a4421",
      "english": "What?! I attacked\none of your men?\nInsolence!\fMy sword targets\nonly the rotten\nshogunate!!",
      "translator_note": null
    },
    {
      "id": "msb_00064488",
      "source_words_sha256": "68bdcdc605ed71ec2d2d40230de3369880038080ac8303ea2629eaeb2127e5af",
      "english": "...Remember this, Shinpachi.",
      "translator_note": null
    },
    {
      "id": "msb_00064730",
      "source_words_sha256": "74e3759910f2e46c2a8922fb42957b07f8e5591900d940939ed1160c1aa245da",
      "english": "How rude!\nI'm not a kappa!",
      "translator_note": null
    },
    {
      "id": "msb_00064948",
      "source_words_sha256": "1a267a463941ebea0d2b3cba6383035acbe1759450e66d937b86e5ebcb5930fe",
      "english": "Damn tax thief!",
      "translator_note": null
    },
    {
      "id": "msb_00064B18",
      "source_words_sha256": "f80f768db1dec7ea74f31e75244484b07f1e4cebe3e37167d297e0c58a7fd291",
      "english": "You were right there...!\nTake responsibility\nand catch the culprit!",
      "translator_note": null
    },
    {
      "id": "msb_00064DD8",
      "source_words_sha256": "c0e1237bdd078a2405af6c9a887ed62641a3308f42cad48e27859844a972313b",
      "english": "Oh, old man.\nRemember something?",
      "translator_note": null
    },
    {
      "id": "msb_00064EA4",
      "source_words_sha256": "f6eb0c4b098be7c8f31447de213337b106f74de9be9c1272581223da47c47822",
      "english": "No 'Shuwatch!'\nNo hand lasers either.",
      "translator_note": null
    },
    {
      "id": "msb_00064FA4",
      "source_words_sha256": "3649d84c314a91e6cae35481c60661338d15c18e3c66097dd4330b99b9a2bf4a",
      "english": "Hands off my antennae!",
      "translator_note": null
    },
    {
      "id": "msb_00065204",
      "source_words_sha256": "72c4201268dd04a010f4e28731f25b6bd3187432230a7c5e379421cfb2f52d08",
      "english": "Heh...\nI've gone straight.\nNo more grand schemes.",
      "translator_note": null
    },
    {
      "id": "msb_000652C4",
      "source_words_sha256": "3f79f20f09f42451d9888ecd2251a776af1b834081a333d5c9080bf49da122a4",
      "english": "How much money\nto start a business...?",
      "translator_note": null
    },
    {
      "id": "msb_00065320",
      "source_words_sha256": "f532f3bb7c8e1830934fd821d775c7da844281b3a648b1313c0c5e1a0a797b4a",
      "english": "Damn! Now\nI need to pee too!!",
      "translator_note": null
    },
    {
      "id": "msb_000653CC",
      "source_words_sha256": "b98925bb7568c1b23e602b2f8bb15039b3a42d396ad5abf28aec6b07da11bdea",
      "english": "This rose scent ISN'T\nto cover armpit odor!\fGot it?\nAbsolutely NOT!!",
      "translator_note": null
    },
    {
      "id": "msb_000657BC",
      "source_words_sha256": "5dbfa3316f3b2bc6ef67cabc1d61d512445cd6e55e3a5bdf7c4e4b672f00842e",
      "english": "Shinpachi's suddenly\nacting so high and mighty...",
      "translator_note": null
    },
    {
      "id": "msb_000657F0",
      "source_words_sha256": "a6c5a50bc768eb36c0fe06934c5f2c4f6c42065df418fed983b54f83c083d82c",
      "english": "...Really full of himself.",
      "translator_note": null
    },
    {
      "id": "msb_00065838",
      "source_words_sha256": "6514acc8656880df636be14551c7812d27d0746def17d60edb4a631d67d9d53d",
      "english": "No need to act\nso grand, yes...",
      "translator_note": null
    },
    {
      "id": "msb_000658C0",
      "source_words_sha256": "a9aa2a29146d2fbbda7fd0705293cecc1b0c0d5cfe63085dc9a73b682a785dd5",
      "english": "Sorry! Um...\nOh, right!\n[blue]North Golden St.[/color]!",
      "translator_note": null
    },
    {
      "id": "msb_0006597C",
      "source_words_sha256": "d48a3eb9e9105ea4de2515f5f510a917fbdb4293ae8640bb49d5b64dc9e97ce3",
      "english": "Glad I reported it.",
      "translator_note": null
    },
    {
      "id": "msb_0006610C",
      "source_words_sha256": "6dd22a611d72fcf1b2fc79cfd6ed8d837e88be8fb40d14b9cf6babd6ab9b1936",
      "english": "N-no, not at all!\nOnly did what I should!\nExcuse me!!",
      "translator_note": null
    },
    {
      "id": "msb_00066220",
      "source_words_sha256": "ae9880ae2f8582ae8cedf7a7d2732775c6841e2128c1b1f112370dedf83009ad",
      "english": "Not yet... Damn!\nShameful for\nthe Fan Club Captain!",
      "translator_note": null
    },
    {
      "id": "msb_00066264",
      "source_words_sha256": "a80bc41ca4df322f2dbb6e26acd1153418dbe3264dd326637e66198302013911",
      "english": "Yes, somehow.\nThanks for the tip.",
      "translator_note": null
    },
    {
      "id": "msb_000663D0",
      "source_words_sha256": "33543090f3d54ca8bcf0a32125f6eba3c5b87e9b5b2160859750d4959f8137d9",
      "english": "Rude!!\nCall her Lady Otsu!",
      "translator_note": null
    },
    {
      "id": "msb_00066AF4",
      "source_words_sha256": "4f184b2758b3a0aa37f1e91b5e6885baac05727f8b0722119be1124a551f3d33",
      "english": "Whatever you say, Gin...\nYou're protecting\nMr. Katsura...",
      "translator_note": null
    },
    {
      "id": "msb_00066B64",
      "source_words_sha256": "01f964638eb2d31ebdf388311d779bfe5d065d13172bbb79f9b5c1530d50e0d2",
      "english": "Oh, Yorozuya!",
      "translator_note": null
    },
    {
      "id": "msb_00066B7C",
      "source_words_sha256": "0b3bb473559d0b4f32186e551618c258a83abc8cd5976b79be316d4d15dc666b",
      "english": "Good timing...\nHave you seen\nthat bastard Katsura?",
      "translator_note": null
    },
    {
      "id": "msb_00066BD0",
      "source_words_sha256": "8b85dd0e1a00245cd2a4552cd8764f5ca0207d489ed5088e0b7a9f3da9b696a6",
      "english": "I see...\nSightings of a Katsura\nlookalike near [blue]Saguri Bridge[/color].\fNot seen him? Fine.\nSorry to bother you.",
      "translator_note": null
    },
    {
      "id": "msb_00066C54",
      "source_words_sha256": "6a0df3f19967acf0fc290be602b9118858c02ecd6ebff3c8c911f2e0f7dc7567",
      "english": "Ah, Yorozuya!",
      "translator_note": null
    },
    {
      "id": "msb_00066C70",
      "source_words_sha256": "5c68d980fdf4edbf3a21d5555a1d03244b184133d7e0b64fab80a79d3683de1d",
      "english": "I'm searching this area.\nDoesn't seem\nto be nearby...\fTell us if you see him.\nKatsura was sighted\naround [blue]Saguri Bridge[/color].",
      "translator_note": null
    },
    {
      "id": "msb_00067404",
      "source_words_sha256": "9dee6395001157cea2ea6fca5559e7107a8df065a04e565abcd7d5f90f453fee",
      "english": "Mr. Katsura's a worry.\nRoams wherever\nhe pleases...\fWorried something might\nhappen to our leader.\nTell him to stop that.",
      "translator_note": null
    },
    {
      "id": "msb_0006769C",
      "source_words_sha256": "cc4481800060f41739cc2db1be11a9a6cad3615637875805f2e72b7c21423fe3",
      "english": "For the information,\nmay I suck your blood?\nJust a little...",
      "translator_note": null
    },
    {
      "id": "msb_000677C8",
      "source_words_sha256": "a716a8239558354ac1d85c0b7337bd092582a5b3dda9543e2dd4bad35163dfdc",
      "english": "Lovely weather today.\nThe stars should\nbe beautiful tonight...\fSure to be a lovely,\nromantic evening...",
      "translator_note": null
    },
    {
      "id": "msb_000678B4",
      "source_words_sha256": "945ff7d49899b2e8c71003882e4b0c97f45dbbe7b638fd59507b7fc3c34d058b",
      "english": "Gone soft after all.",
      "translator_note": null
    },
    {
      "id": "msb_000678D4",
      "source_words_sha256": "e9a314b50c58c5679a27803cd926ad3a53ff7635f86ee7a7fada89c6d809b647",
      "english": "Gone soft!",
      "translator_note": null
    },
    {
      "id": "msb_00067A0C",
      "source_words_sha256": "5024d2dad5e2c20a9314902092a2daae0437b8558cd82effa9137877e7dc65c1",
      "english": "Oh! Sergeant?!\nIt's you!",
      "translator_note": null
    },
    {
      "id": "msb_00067B58",
      "source_words_sha256": "92e720ecd581b621bde7e999f5e92be6c2105b865caa67f82321af4a1d90cf84",
      "english": "So tired...\nEven tired of being tired.",
      "translator_note": null
    },
    {
      "id": "msb_00067B8C",
      "source_words_sha256": "a975762ed287a2adc5d324b621c901f57914624995388c5adf26f2968ec2b870",
      "english": "Tired of living.\nDying's too much work...\nWhat should I do?",
      "translator_note": null
    },
    {
      "id": "msb_00067C64",
      "source_words_sha256": "5cc0afb70bfcd974f17f3e87ebe91fc787b24603862fce88bff43f5b70287b43",
      "english": "What?!\nThat's almost philosophical!",
      "translator_note": null
    },
    {
      "id": "msb_00067EB0",
      "source_words_sha256": "1b7537e8fac28451c1a7833e8254a8a5fe191f6a7dc4f1470257991dfe58c67f",
      "english": "Gambling's a pain.\nDrinking's a hassle.\n...Now what?",
      "translator_note": null
    },
    {
      "id": "msb_00067F68",
      "source_words_sha256": "ae3ac6074e2502f3ba625588c8c7325bed89555bc6c7573ca59a69b2cbce0942",
      "english": "A playboy too lazy to play...\nGiving up your identity?",
      "translator_note": null
    },
    {
      "id": "msb_000680FC",
      "source_words_sha256": "f439f0f1e78701b1fd2a615af9c9c8b2635eb2272acac96d62990851e50ff028",
      "english": "But stealing...\nIt's so tiring...",
      "translator_note": null
    },
    {
      "id": "msb_000681D4",
      "source_words_sha256": "71ee0467a41695a7f7836cb229321478cf1ac795fdfe0d74d4d1ab762cd55aa8",
      "english": "Even Tamo's\ngone soft!",
      "translator_note": null
    },
    {
      "id": "msb_000681F8",
      "source_words_sha256": "2d05c649e680b320ee6b0f92d22426d07962cb0afb6c5d0b2a0d1fc0ae79ee73",
      "english": "A hundred million\nTamo fans would cry\nif they heard that...",
      "translator_note": null
    },
    {
      "id": "msb_00068248",
      "source_words_sha256": "df532574f4b22d3acd5e4078c3a10e2a92020e039b022bf645216ad7379333a3",
      "english": "Meant to have a drink.\nCan't be bothered now...",
      "translator_note": null
    },
    {
      "id": "msb_00068300",
      "source_words_sha256": "2187313cefc8988ce7d187ae12c58ef8201e845908d9273533e39c40ae3038b2",
      "english": "Denying your\nwhole identity...?",
      "translator_note": null
    },
    {
      "id": "msb_0006836C",
      "source_words_sha256": "ccc6c2cdf61b3d271d28abdd6fae6266e0d27190ddb93a1e4406dd8be6eacea5",
      "english": "No more shaving\nor makeup!\nToo much work!",
      "translator_note": null
    },
    {
      "id": "msb_00068494",
      "source_words_sha256": "aab5e080b1f11d097decda49130ebf9778d9bc0f8ae60af873db1ba26b931550",
      "english": "Just so you know,\nI'm not the guy\nfrom lesson one...\f...Oh, who cares.",
      "translator_note": null
    },
    {
      "id": "msb_00068508",
      "source_words_sha256": "7152f76b8c0bd603ed796388041fabf56e7aae7c6d6e65f89ec400d92f0a3a24",
      "english": "I'm not the guy\nfrom lesson one...\n...Forget it. Too much work.",
      "translator_note": null
    },
    {
      "id": "msb_00068598",
      "source_words_sha256": "ca9a7220b52337876255dea1e9018c0da52687bada0d58666903aea421754f04",
      "english": "Even one word\nis too much effort now...",
      "translator_note": null
    },
    {
      "id": "msb_00068620",
      "source_words_sha256": "f65a8cdab70b54d3407fb8f29a9e8a937617aeb0e525ab7ba9e7f9a0a20521cf",
      "english": "Can't be bothered\nwith all that work.\nIt's exhausting...",
      "translator_note": null
    },
    {
      "id": "msb_0006870C",
      "source_words_sha256": "ffc4fe9aea25060f3da7781290fcd7ea7d67e28b83be15ac6574d744472f1efe",
      "english": "What about world conquest?",
      "translator_note": null
    },
    {
      "id": "msb_00068944",
      "source_words_sha256": "14eaee3f9b623b1218ac4e763b220d60e4caaede6d9e5f10025c00cb24ada374",
      "english": "For now, just breathing...\nIn... Out... In... Out...\fI'll quit when I get bored.",
      "translator_note": null
    },
    {
      "id": "msb_00068A14",
      "source_words_sha256": "5bd3ac970961343810f24675f76b21534c7eb97f140f9ce313143a91c8cefc69",
      "english": "A kid! You shouldn't\nbe out at this hour...",
      "translator_note": null
    },
    {
      "id": "msb_00068B98",
      "source_words_sha256": "d265d5e3410f944ecb0722232173761b94c622a626eb3e3c9d47054762b5cdbc",
      "english": "I was putting a roof\non that house.\nToo much work. I quit.",
      "translator_note": null
    },
    {
      "id": "msb_00068C18",
      "source_words_sha256": "92f3d792e9260b036d3bd3b6cf5a6c5146f3791f38a00f8fbf533c076dd38868",
      "english": "Forget the roof...\nMaybe no walls either.\nToo much work...",
      "translator_note": null
    },
    {
      "id": "msb_00068C60",
      "source_words_sha256": "9e9d4b0b669f27b1f37b2e180db3e16e9d31c87da95cb0730f396b9d7ec5399d",
      "english": "Actually...\nPillars sound like work too.",
      "translator_note": null
    },
    {
      "id": "msb_00068CB4",
      "source_words_sha256": "fd58ff0a154499a15bfd69d8ba0aa43f7db5c459c7a2c2e1c89aec45a1d17216",
      "english": "Wait! No roof?!\fWithout a roof,\nit's not even a house!",
      "translator_note": null
    },
    {
      "id": "msb_00068D38",
      "source_words_sha256": "8b9d18b260d3a490da7787090595471707d115e3497c516c38d6b3963ce12fa4",
      "english": "No pillars?!",
      "translator_note": null
    },
    {
      "id": "msb_00068D90",
      "source_words_sha256": "0055fa3b492f524e3a52fe0357adb277d674d8978f7f4df6019d01e5136c0ed9",
      "english": "Pass on, then.",
      "translator_note": null
    },
    {
      "id": "msb_00068DA0",
      "source_words_sha256": "737b640d46511294cbc37edb3bdce2cf299fd854af362c836fedcfe2a50f3122",
      "english": "So weary...\nLiving's so tiring...\nMaybe I'll just pass on...",
      "translator_note": null
    },
    {
      "id": "msb_00068E70",
      "source_words_sha256": "13801a0590e185f51ebbe2f431575f3832c16162cf267f63acfbe97889b74565",
      "english": "Already a fool.\nWhat's wrong with\nbeing a listless fool?",
      "translator_note": null
    },
    {
      "id": "msb_00068EAC",
      "source_words_sha256": "44bb732c9d24d36cdfb52e30c14d84457d834f438409719d6da93e820e936135",
      "english": "Oh, Yorozuya...\nAren't you tired...?",
      "translator_note": null
    },
    {
      "id": "msb_00068EE4",
      "source_words_sha256": "05c5f7337ed225f5915d8ec265977439d0bba4a84365a19bd8b3d704dda634c6",
      "english": "Clever words...\nToo tired to praise you.",
      "translator_note": null
    },
    {
      "id": "msb_00068F1C",
      "source_words_sha256": "3fa430c22dacbd8a2e3fe7e7daf1c40b5ebcd48adb93e430e40c4edf69c18278",
      "english": "Oh, Yorozuya...\nStill walking?\nHow hardworking...",
      "translator_note": null
    },
    {
      "id": "msb_00068F68",
      "source_words_sha256": "407a9478fc885b9602449db30612fb1a9a4a1e8471369552201ec3a2f424255f",
      "english": "A great Shinsengumi\nman gone completely soft!",
      "translator_note": null
    },
    {
      "id": "msb_00068F98",
      "source_words_sha256": "e21325190e04d126a769cc5d73c97b8240c291a16bb530a5510b6c120c2dce91",
      "english": "Symptoms worsening...",
      "translator_note": null
    },
    {
      "id": "msb_00068FBC",
      "source_words_sha256": "ea640c34c36bc93b69176c3f771ec416dc6fe184f36a1167709cb80d7f953404",
      "english": "Plan to starve...?",
      "translator_note": null
    }
  ]
}
