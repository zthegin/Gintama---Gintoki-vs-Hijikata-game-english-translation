      "id": "msb_0004A0DC",
      "source_words_sha256": "b27912faf5940134b6b3aef9cf2b9ac07fa01d98c6ed1525bd7ab2af9289552f",
      "english": "A case?",
      "translator_note": null
    },
    {
      "id": "msb_0004A11C",
      "source_words_sha256": "c5086bc928f813fd68f0457847fcc754a5dff0be35bb5379ee5f2c81ef3d372f",
      "english": "Use my Gin Tama, if you'd like.",
      "translator_note": null
    },
    {
      "id": "msb_0004A144",
      "source_words_sha256": "b3fe85e33985f812dc4e35fa6bd360fb03e1313a6c0b74b744165299ae45632f",
      "english": "Not Shinsengumi, but I hate evil too.",
      "translator_note": null
    },
    {
      "id": "msb_0004A17C",
      "source_words_sha256": "821e2d62415fbfbd9929bc97e48977fe3ae4e9843f18c84fad2c01a0120b69f3",
      "english": "We're behind you, Shinsengumi!\fGood luck!",
      "translator_note": null
    },
    {
      "id": "msb_0004A1B8",
      "source_words_sha256": "37300952ca71355e5d5fdcb2cf2771aca371f22a4d725dd24396481429a2aed8",
      "english": "Know where that gorilla-like man went?",
      "translator_note": null
    },
    {
      "id": "msb_0004A1EC",
      "source_words_sha256": "1b13a97f2f0fd2a270eec7fd13a10303decec69327c666c31588f48867590354",
      "english": "Thanks for remembering.",
      "translator_note": null
    },
    {
      "id": "msb_0004A304",
      "source_words_sha256": "b9dc8a826d9ee457b0f9f23d1f55ed67ed805600d4a9c86dae34cb3f9fda87ae",
      "english": "What is it this time?",
      "translator_note": null
    },
    {
      "id": "msb_0004A400",
      "source_words_sha256": "10a68aead96e7a918db382f27a495a2abd5b8d711454a45c5ae132b785742b0a",
      "english": "Yeah. Lots going on.",
      "translator_note": null
    },
    {
      "id": "msb_0004A418",
      "source_words_sha256": "f3876d109ce0f522613a02064fb9e286e4b794d5daaa6bf9f47d830c7f41ff83",
      "english": "No, thanks. Complicated. Don't want to trouble you.",
      "translator_note": null
    },
    {
      "id": "msb_0004A454",
      "source_words_sha256": "f07e3206f214db901ab5ff6855bfa27697e8c6ee2b17d0e79696c90a611040d5",
      "english": "Shinsengumi, huh. Busy?",
      "translator_note": null
    },
    {
      "id": "msb_0004A478",
      "source_words_sha256": "99013bc0cdaf1ee953a1a620d0156144dd3e51f2361ce79a7fd3461a70b24d97",
      "english": "Hmm. Want a hand?",
      "translator_note": null
    },
    {
      "id": "msb_0004A498",
      "source_words_sha256": "279b133eca138a4e7dbdf0198a99e66df2566d3d00ed7d322013c3d6877bfe88",
      "english": "Can't help it, then. Good luck.",
      "translator_note": null
    },
    {
      "id": "msb_0004A5AC",
      "source_words_sha256": "5e2fd9131c0fb21fe28d4c5ea542fbcdbee7135d2900ff5867018fa7562bdc81",
      "english": "Want a Gin Tama battle with me?",
      "translator_note": null
    },
    {
      "id": "msb_0004A5D0",
      "source_words_sha256": "3c23677c30d38fc47ed47e699134c9ee869712c42b5efa76c06f73bf144c267f",
      "english": "Fighting different people gives you experience...",
      "translator_note": null
    },
    {
      "id": "msb_0004A60C",
      "source_words_sha256": "b0c66a6c8189e3e0275a4425e20bbd8fcdedea2a4809738c90f10b921274e67e",
      "english": "All right... Tell me when you want a battle.",
      "translator_note": null
    },
    {
      "id": "msb_0004A650",
      "source_words_sha256": "09cf28c6ee007735048b39d76de79811ea5ab29edc4c721dcf4bdaf25990240a",
      "english": "Impressive... I give up.",
      "translator_note": null
    },
    {
      "id": "msb_0004A674",
      "source_words_sha256": "1ba2af4944964b350408d2b57ef7f0f2de20ee5e696e06064f1df7100c780ea8",
      "english": "Collect Gin Tama and try again.",
      "translator_note": null
    },
    {
      "id": "msb_0004A6E4",
      "source_words_sha256": "099ce7c00b3fc214dad90429a844a632cd496e9bae6d0d7a449d893ce30180a1",
      "english": "I've got bigger problems!",
      "translator_note": null
    },
    {
      "id": "msb_0004A720",
      "source_words_sha256": "16432356cf7a1343fa2095c9ee55798f41aadc052cea5c6df4a9bc59beb6119f",
      "english": "Play kick the can with me?",
      "translator_note": null
    },
    {
      "id": "msb_0004A738",
      "source_words_sha256": "002617fc8ad4b4cbc52ed1be90a47fee03eb90d690442fe269473df027be7c2c",
      "english": "Kick the can is fun!",
      "translator_note": null
    },
    {
      "id": "msb_0004A750",
      "source_words_sha256": "32f79e56c3ca935729ba079000516b2c561a2b76a937c0359bbca6d8f6df7621",
      "english": "Tch...",
      "translator_note": null
    },
    {
      "id": "msb_0004A84C",
      "source_words_sha256": "501a6c50e33e4c52edd93ca912cd4c4149cb59489a8f067a4f2524010bbe70df",
      "english": "Where are you rushing to?",
      "translator_note": null
    },
    {
      "id": "msb_0004A870",
      "source_words_sha256": "83bef3315e9d3df28f6bea49dff32b5d5ff7d1aa1cff7c0e535b8cd011dde2b5",
      "english": "Om Makayasha Vajrasattva.",
      "translator_note": null
    },
    {
      "id": "msb_0004A894",
      "source_words_sha256": "b44f01348895086ecb1d1800624e67a80af9b194b49e72e49834667cd0eacddf",
      "english": "Work. Sorry, no time for you.",
      "translator_note": null
    },
    {
      "id": "msb_0004AC20",
      "source_words_sha256": "82748081a3fb89ff05620fe8fc1017d7e61240219cf437a352b89740e95cd755",
      "english": "My, a handsome man... How about...\fSome squats together?",
      "translator_note": null
    },
    {
      "id": "msb_0004AC68",
      "source_words_sha256": "1b0674139081da398ca0949848fc3cc000c9eab41ee89ceb8adac6c321afe060",
      "english": "Damn... Missed out on Jump AGAIN!\fI know who bought the last one before me!\fThat bastard! Unforgivable!",
      "translator_note": null
    },
    {
      "id": "msb_0004ACF4",
      "source_words_sha256": "0cd49815f9c97e575752dd63b40ba4def841649f4b7ef3e9802044b963d0e081",
      "english": "Odd rumor.",
      "translator_note": null
    },
    {
      "id": "msb_0004AD08",
      "source_words_sha256": "762aa6325746a0fb252339ba853bf4f3e23dc2ed84d8ffabda650d9f1c611092",
      "english": "My dad's playing kick the can.",
      "translator_note": null
    },
    {
      "id": "msb_0004AD30",
      "source_words_sha256": "6229ca236591b38d305891550f6994347d65c0475cfa0b22ddf5076bb96c1243",
      "english": "No... My dad's dead.",
      "translator_note": null
    },
    {
      "id": "msb_0004AD6C",
      "source_words_sha256": "afa2309598b3a32f61b1d101c6cd6a2fe7698b4ec522a65287766dc6198dc6c4",
      "english": "If Dad asks, play kick the can with him.",
      "translator_note": null
    },
    {
      "id": "msb_0004ADA0",
      "source_words_sha256": "446c6a07a976c9820b4405be13cba35c0f8b4c16881628d6d187da2dcb7b8beb",
      "english": "Please. If Dad asks, play with him.",
      "translator_note": null
    },
    {
      "id": "msb_0004ADDC",
      "source_words_sha256": "320c32cfdd962290761928049585bbf6e982127858ff48731898e4f0a46b48a5",
      "english": "A case?",
      "translator_note": null
    },
    {
      "id": "msb_0004AE20",
      "source_words_sha256": "e1235e93cd1377cfa62f9171786147be79e66f0445790b8db94dd0148c0412ef",
      "english": "Here. Take this.",
      "translator_note": null
    },
    {
      "id": "msb_0004AE38",
      "source_words_sha256": "34181ac72b46e88295e099b525bc0cb210b1c128e0578c366201556d608ec62f",
      "english": "Might come in handy.",
      "translator_note": null
    },
    {
      "id": "msb_0004AE78",
      "source_words_sha256": "136db22a17dff4c665212da66041565338915ed8c6c3774076b917cc46b14e39",
      "english": "Another Gin Tama, then.",
      "translator_note": null
    },
    {
      "id": "msb_0004AE9C",
      "source_words_sha256": "eee70de50e39e867a4876479c8b693486493cc2eda0e73a651eded411548f2db",
      "english": "Piles feel fine tonight. A bleeding bargain!",
      "translator_note": null
    },
    {
      "id": "msb_0004AEC8",
      "source_words_sha256": "39a73f2d9659086a3cc0d684bb5ca43d390095f3165e5b0ffa35e3b76cb167a5",
      "english": "Don't say that...",
      "translator_note": null
    },
    {
      "id": "msb_0004AEE4",
      "source_words_sha256": "60657bb4ddba56677face10ef20969925285868d616fa50e18ffe105a529a042",
      "english": "Oh no... My piles...!\fO-ow...!\fMight REALLY be bleeding...",
      "translator_note": null
    },
    {
      "id": "msb_0004AF48",
      "source_words_sha256": "02c6b3665850e70fe1fba53f67c6491ddef1e06482498ab747588358421bbb8a",
      "english": "What rumor?",
      "translator_note": null
    },
    {
      "id": "msb_0004AF58",
      "source_words_sha256": "7e303bd061b5c243a0000084676debfb5ef9ea5d945d01865fadd3f2036e9b9b",
      "english": "Good for him.",
      "translator_note": null
    },
    {
      "id": "msb_0004AF80",
      "source_words_sha256": "b2c828b7caac7c4d29faf921b8e4d265178563f3e5174ffa77a09e1461de7e0c",
      "english": "Nothing... I'm in a hurry... I'll go...",
      "translator_note": null
    },
    {
      "id": "msb_0004AFCC",
      "source_words_sha256": "0410ba26435b78d377c578e6ad9f33a3ba4a59377b976ca7736a804c94ad56dc",
      "english": "N-no thanks...",
      "translator_note": null
    },
    {
      "id": "msb_0004AFFC",
      "source_words_sha256": "1ebec878d63338413f39eff247aa88b6bcec6dff5b574f4aa2aebdba4990256b",
      "english": "Still no thanks...",
      "translator_note": null
    },
    {
      "id": "msb_0004B04C",
      "source_words_sha256": "de0cc5a34c942c08ed4a67e542e6efb677dcc3c56abaf6425ad4b372a0b1bbee",
      "english": "Gin Tama...",
      "translator_note": null
    },
    {
      "id": "msb_0004B06C",
      "source_words_sha256": "53fa9523f2aeb1c1742c3c5ff440c07dbe840fb5c55094d0383bdabdee670855",
      "english": "Right. Thanks, I'll take it.",
      "translator_note": null
    },
    {
      "id": "msb_0004B0A4",
      "source_words_sha256": "fc59aefab5b8fa31db7fd78842a59061b28e668863c09d50c72d513d4995e776",
      "english": "More for me?",
      "translator_note": null
    },
    {
      "id": "msb_0004B0B8",
      "source_words_sha256": "ca4bdb186e22a1212bcd4b864c487beb4a17b640eaba5c47ba2bbfae9a696e36",
      "english": "Wouldn't bleeding be bad?",
      "translator_note": null
    },
    {
      "id": "msb_0004B108",
      "source_words_sha256": "485345de88a9941d3f57d4999fa23d82357cda1e600e3acf2e99fca0f13a8018",
      "english": "Not Zura.",
      "translator_note": null
    },
    {
      "id": "msb_0004B118",
      "source_words_sha256": "b8f5e6ff2d8a0c81f5c4c120fbb6cecc75a9f620a0626a9164b1df7d0a9966ed",
      "english": "...Good point.",
      "translator_note": null
    },
    {
      "id": "msb_0004B148",
      "source_words_sha256": "e621b6ab7bf039de88c9857a096170c300464bb2add5716fb889c32d75bc6e1a",
      "english": "Idiot! Of course I object! What are you doing, sneaking about?!",
      "translator_note": null
    },
    {
      "id": "msb_0004B1A0",
      "source_words_sha256": "665fc726e98785d2b459048f5064de73e56ddf6d7df204bf27d2a4126d7c97df",
      "english": "What? Keep it down.",
      "translator_note": null
    },
    {
      "id": "msb_0004B1B8",
      "source_words_sha256": "51d364bc3d7f220a1a4119cc5d081cb0b7efa245bce43b8b01a4eeab34317964",
      "english": "Huh?",
      "translator_note": null
    },
    {
      "id": "msb_0004B1C4",
      "source_words_sha256": "56847aa45f782a0ee627338384eeed0bf36670b90d91f6abb4c0e2ef38125749",
      "english": "Looked suspicious... Turns out it WAS!",
      "translator_note": null
    },
    {
      "id": "msb_0004B228",
      "source_words_sha256": "f8cff47174850cffc37c14b3d58a1d85738c300adc1b4fb5338b58e938940f0b",
      "english": "Zura. Explain.",
      "translator_note": null
    },
    {
      "id": "msb_0004B244",
      "source_words_sha256": "8fd90c1db2402c2ec955b1020f6fba16b7830827a3ef878ffb20ecf5fe8e4bf4",
      "english": "An Amanto prince meeting a Joi rebel...\fDon't tell me it's just Gin Tama trading.",
      "translator_note": null
    },
    {
      "id": "msb_0004B2B4",
      "source_words_sha256": "b74e5d912262a06b85eb65456bc8839b7c479b887cf0a0feb692cf4926e0d254",
      "english": "Quiet, idiot prince! Now, Zura. Answer.",
      "translator_note": null
    },
    {
      "id": "msb_0004B2EC",
      "source_words_sha256": "05e5397ace149acff563eee1a6866c1061c00014047b33c081c7ebae602df9bc",
      "english": "Don't, Shinpachi...",
      "translator_note": null
    },
    {
      "id": "msb_0004B330",
      "source_words_sha256": "6007abedd45a298934c93823ac404eaea05a34dc9bdf9f926470873060ab5306",
      "english": "?!",
      "translator_note": null
    },
    {
      "id": "msb_0004B384",
      "source_words_sha256": "c36f93480c83eaff871bebf59604f623651fc007f70e39f2c41662c3cd9633e2",
      "english": "Let's settle this with a Gin Tama battle!",
      "translator_note": null
    },
    {
      "id": "msb_0004B458",
      "source_words_sha256": "12970859399136c56a727229ef8960b65b6c9100ba2e33686d2dfc7165e8d919",
      "english": "Quiet, idiot!",
      "translator_note": null
    },
    {
      "id": "msb_0004B488",
      "source_words_sha256": "7664d663a56934b659f349e6c4cef018b7ce83845196b577bc4550f2353b507f",
      "english": "You lot AGAIN?!",
      "translator_note": null
    },
    {
      "id": "msb_0004B4F4",
      "source_words_sha256": "a2d41e40e5825bf3bba9b21787370d8782852a0b8716045658dd8bb2c1d0c972",
      "english": "Yes, trading! He'll buy my collection at fifty percent over market price!",
      "translator_note": null
    },
    {
      "id": "msb_0004B560",
      "source_words_sha256": "c1cac4bc542786186fb904d79b76bbe4ccdf2e04b843799c8602b30299d31fb9",
      "english": "W-wait! I didn't mean...",
      "translator_note": null
    },
    {
      "id": "msb_0004B58C",
      "source_words_sha256": "90cd52aa5eba4268539b8fb18503c85318ff863ee1052c15951a21a8279d0260",
      "english": "You called me an idiot! At least add PRINCE!",
      "translator_note": null
    },
    {
      "id": "msb_0004B5C8",
      "source_words_sha256": "4f02a8070025b46f8b2705827d0402c978e7de46761d8ad4be08fe34fad834a1",
      "english": "Hard to say.",
      "translator_note": null
    },
    {
      "id": "msb_0004B5DC",
      "source_words_sha256": "dbc1e44714f4333f0b9d64099094196fc7aa580f5454e6fe359cfaf0cee74809",
      "english": "Kelp! Kelp!",
      "translator_note": null
    },
    {
      "id": "msb_0004B5F8",
      "source_words_sha256": "2a584db0817647421073c2b148fcf7f98681a629442a9ce1fb7530b76319ee54",
      "english": "What about Dragon Tama and getting rich?",
      "translator_note": null
    },
    {
      "id": "msb_0004B620",
      "source_words_sha256": "31817467adbd69e42284aef1380cc06c5780ad3f9a98bb69cd1de8949ecfc302",
      "english": "A job? What kind? Ironing wrinkles? Rejuvenation treatments?",
      "translator_note": null
    },
    {
      "id": "msb_0004B670",
      "source_words_sha256": "4ad9a8b47af107bcafb0708289ee08a7ab377c143d32c558d1fb46012056e4cc",
      "english": "Not so quiet after all.",
      "translator_note": null
    },
    {
      "id": "msb_0004B68C",
      "source_words_sha256": "4e074e59709a2e413e0cc3bdd09797948ca6e4a46c39efb90098f1d1d012394e",
      "english": "Fine.",
      "translator_note": null
    },
    {
      "id": "msb_0004B69C",
      "source_words_sha256": "770d456431d3bc478d056eee5533db288991197b24a7e359527b8354c0dba85a",
      "english": "Happy now?",
      "translator_note": null
    },
    {
      "id": "msb_0004B710",
      "source_words_sha256": "e441e8cd602243fb9744481b72b39311c319cab1228b0e883d3fb36de37cdb6b",
      "english": "...Gintoki. I told you not to get involved.",
      "translator_note": null
    },
    {
      "id": "msb_0004B754",
      "source_words_sha256": "68d7aad8cf879ffaada3f647a89c488ee37d7cd19526a0a4c2e29f26eba63e02",
      "english": "...Hm? But what?",
      "translator_note": null
    },
    {
      "id": "msb_0004B798",
      "source_words_sha256": "15a4c95b8d198b384045e238c87e72d8ac4f438a213324f65fb900e1c391b057",
      "english": "...Shinpachi. Gintoki... Sorry... But...!",
      "translator_note": null
    },
    {
      "id": "msb_0004B7FC",
      "source_words_sha256": "cb649f9c53924d46be874fd64f170b35c76d50fcf4737b2ef1a7ad181f81d2c4",
      "english": "Can't tell you yet. No... Can't drag you into this!",
      "translator_note": null
    },
    {
      "id": "msb_0004B854",
      "source_words_sha256": "e2efb321ebb9a08defa885c9e59fb0cfc29b55370cec29253cdac1944e996887",
      "english": "Gintoki...?",
      "translator_note": null
    },
    {
      "id": "msb_0004B86C",
      "source_words_sha256": "9294f65e1147ed071a22aebbe296b880f24745014bc89a642e92a20107f93045",
      "english": "What? With Gin Tama?",
      "translator_note": null
    },
    {
      "id": "msb_0004B884",
      "source_words_sha256": "6f5daf90c26d584c2f4bf5e635672f0229518c59fcd4aa8ac57d099368392202",
      "english": "...All right. Very well.",
      "translator_note": null
    },
    {
      "id": "msb_0004B8A8",
      "source_words_sha256": "15c7acb84670456718092aa4601273d55962a0d64c683791c9b0d6b7e9ef7df6",
      "english": "I win. Now pay every penny you owe.",
      "translator_note": null
    },
    {
      "id": "msb_0004B8E0",
      "source_words_sha256": "681b58d5f53605a804af29bdd376fc842133615355ab2f6b907373c37095b79d",
      "english": "Then quit loafing around in broad daylight! Go find work!",
      "translator_note": null
    },
    {
      "id": "msb_0004B92C",
      "source_words_sha256": "cdca8fd54f4220231608bbd70dc10ff34af3725a958999439b6ad29f5106fa7a",
      "english": "Don't change the subject!",
      "translator_note": null
    },
    {
      "id": "msb_0004B944",
      "source_words_sha256": "d39df861ebabbdb6cda56b9781b7f6d2d6f40bff2922f6b3ec7fe563d467b78b",
