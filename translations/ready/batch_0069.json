      "source_words_sha256": "a2e49efe8490ac30400c518f7c92a203a7f2cfb9f4ad134053e4bab02e975383",
      "english": "Stop...!",
      "translator_note": null
    },
    {
      "id": "msb_000F4AC0",
      "source_words_sha256": "92ffe081a53f17433c0715b6c5ac4f93e86f5e3d2b202d1f8207e1e4dee77e18",
      "english": "S-stay back...",
      "translator_note": null
    },
    {
      "id": "msb_000F4ADC",
      "source_words_sha256": "6219afd248e199c3cbc5e2d74ae5c1b790b0e91d5088b0d2c4add32d3b9457df",
      "english": "Toshi's dying! A desperate, life-or-death crisis!",
