      "english": "TOSHI!",
      "translator_note": null
    },
    {
      "id": "msb_000F5390",
      "source_words_sha256": "4216e811a10fa6bcf3a06525ed432c12acae22c8b44395eb2f5c2811f57b4f35",
      "english": "If a drag queen will do, I'm right here.",
      "translator_note": null
    },
    {
      "id": "msb_000F53E4",
      "source_words_sha256": "0adb0e73726d77a45f0f1901f99344f50b459ab36d7b6fcefb79137920ad56ec",
      "english": "Oh. Stopped breathing.",
      "translator_note": null
    },
    {
      "id": "msb_000F5400",
      "source_words_sha256": "eb3a8a2b9531667b47c92e78062d9c6a7257b99b97c887fed2a31b0b297be8ac",
      "english": "Ugh...!",
      "translator_note": null
    },
    {
      "id": "msb_000F5418",
      "source_words_sha256": "f1a3ca99013afdc1ed9733311ec5c0bb3d0340d624e302eb3702c30b80946929",
      "english": "Phew... Feel a bit lighter.",
      "translator_note": null
    },
    {
      "id": "msb_000F5448",
      "source_words_sha256": "7892a5fc745b33bc247f36281c395c00f9e745c7ee4e20f906bf13db794f6e86",
      "english": "Yeah. I'm fine.",
      "translator_note": null
    },
    {
      "id": "msb_000F5460",
      "source_words_sha256": "9c7468abfbf578161a77249c53cf6be4ecb8a5ca46d1b617d6e95c1109791e17",
      "english": "Gin Tama... Why've you got one?",
      "translator_note": null
    },
    {
      "id": "msb_000F5494",
      "source_words_sha256": "2285bd16aa249ceb76c554646be39908a3e680e4c5030e5443406cc2e96082dc",
      "english": "I see... I'll gladly take it, then.",
      "translator_note": null
    },
    {
      "id": "msb_000F54C8",
      "source_words_sha256": "4ef8e8c7b5401f48e456db9043fe7450478e8c2522e9d60f6497db1b3aa8cf91",
      "english": "See ya.",
      "translator_note": null
    },
    {
      "id": "msb_000F54D4",
      "source_words_sha256": "68737cf1d31a9d3379a37ee3e231096bf9184a332c6c1d6bec7e458e84fde3ee",
      "english": "What?!",
      "translator_note": null
    },
    {
      "id": "msb_000F54E4",
      "source_words_sha256": "b92e27d8c249ac8d0f6548ad067d12c2daf37f3302128006eb8e0854da6daeba",
      "english": "You okay?",
      "translator_note": null
    },
    {
      "id": "msb_000F54F4",
