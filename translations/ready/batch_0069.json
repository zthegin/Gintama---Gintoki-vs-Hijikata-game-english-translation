      "english": "Don't get lost.",
      "translator_note": null
    },
    {
      "id": "msb_000F5508",
      "source_words_sha256": "a59f9d73d33bf8670f29f7f71a5b2f7b203583b2f0a3bcfd980183750c82e18a",
      "english": "Coming out of Hijikata's body, maybe?",
      "translator_note": null
    },
    {
      "id": "msb_000F553C",
      "source_words_sha256": "5a744ab4b7d93f0060bb5ab6ab9f6a5f330c7f871a4f7a2b0b5112e6664776c8",
      "english": "Get home safely.",
      "translator_note": null
    },
    {
      "id": "msb_000F5554",
      "source_words_sha256": "20ff001c344c0760dd7d4ab93918f24d049e8b124f64ffe1aa85307dd629a127",
