{
  "format": "gintama-community-translation-v1",
  "batch_id": "batch_0069",
  "records": [
    {
      "id": "msb_000F39E0",
      "source_words_sha256": "19650e8c389ff30f8efe619ff0ac7dcc4b497bb97c96848927b5849177a465c1",
      "english": "Beauty...?! Calling ME a beauty, huh?!",
      "translator_note": null
    },
    {
      "id": "msb_000F3A14",
      "source_words_sha256": "7fd0405090719423f579391f0a6ac35bc54a9264c193218b9e09c1fe33e7df7e",
      "english": "Hey. You saying I'm a beauty?",
      "translator_note": null
    },
    {
      "id": "msb_000F3A40",
      "source_words_sha256": "8b164273d437387b0e581daec837b30b477f1b9d43589157ffff60577c873a17",
      "english": "You bastard!\fYou know your stuff! I like you!",
      "translator_note": null
    },
    {
      "id": "msb_000F3A7C",
      "source_words_sha256": "5f8bf840b4b109e734b9f7a4358c9e6d7b46f4c81dfef2ed9eee8c297de9544e",
      "english": "Since you're here, I'll tell you my life story.",
      "translator_note": null
    },
    {
      "id": "msb_000F3AAC",
      "source_words_sha256": "644d57ff86d3ea4e36eb50d78bebcecae05df11bb3798bea563c91a02cea9fee",
      "english": "Oh... Too bad. Well, call me if there's a fire.",
      "translator_note": null
    },
    {
      "id": "msb_000F3B58",
      "source_words_sha256": "5010308b991ccb9224f3d476f866528de760b646422a2bc2a85410e3a943be77",
      "english": "Was it...?",
      "translator_note": null
    },
    {
      "id": "msb_000F3B74",
      "source_words_sha256": "4594e3455a6d2337bfb5a3b63b4beca1c4f8860d3cbf32e130558ebec7f2b532",
      "english": "Forecast?",
      "translator_note": null
    },
    {
      "id": "msb_000F3B88",
      "source_words_sha256": "88625d1688d61cf2262e3eae9b2c7caec89e81df2f76995b19c14e00544a5668",
      "english": "Should be fine. Must've absorbed the life energy.",
      "translator_note": null
    },
    {
      "id": "msb_000F3BC0",
      "source_words_sha256": "50e7abd8f2e4ba3c526ab593a2495d31c24e2c38679978819a86bd78225041bb",
      "english": "Don't worry! Let's go.",
      "translator_note": null
    },
    {
      "id": "msb_000F3BE4",
      "source_words_sha256": "336bfe115efe23b8f62c83812017dcd2f5b462bd72042361dbb99f297f549d6d",
      "english": "If I'll do, go ahead.",
      "translator_note": null
    },
    {
      "id": "msb_000F3C00",
      "source_words_sha256": "fa3ea549bc69671b2a9f7d69762573b3a1bbc860668d4a70da2b15fe9c1c61ca",
      "english": "Thank you. Did you bring an umbrella today?",
      "translator_note": null
    },
    {
      "id": "msb_000F3CFC",
      "source_words_sha256": "05ea5113f6bff9703196b594a9117e2b36cd0f26d8d641e27dc7c1ae0942fab6",
      "english": "A joke, of course.",
      "translator_note": null
    },
    {
      "id": "msb_000F3D14",
      "source_words_sha256": "c403b243b5eb3b5a6b697da59b61d4a39e3efc0a6b615cf5621e9f25eb88eb36",
      "english": "Where would THAT rain down?! Give me a location!",
      "translator_note": null
    },
    {
      "id": "msb_000F3D80",
      "source_words_sha256": "7b857f19b9986cc6d1f503eb5e61286bffe3427e74c51dfd6c1e32b1cd3c9473",
      "english": "Hijikata. Done yet?",
      "translator_note": null
    },
    {
      "id": "msb_000F3E00",
      "source_words_sha256": "f6a3eceb38f32b498436b952851bb0df313e10fdf1bbc240cffedb82928b9a82",
      "english": "Complicated reasons.",
      "translator_note": null
    },
    {
      "id": "msb_000F3E58",
      "source_words_sha256": "e65e12be07ac0a863eb4a08adc80f41a19a4be6640ab1de42e307d840c935acd",
      "english": "No... No need for that!",
      "translator_note": null
    },
    {
      "id": "msb_000F3E7C",
      "source_words_sha256": "80a51fa44aae3949a0f948e2e0f627c7534595cae6a44e97561b7c5dea5d8ab0",
      "english": "I said, it's not like that!",
      "translator_note": null
    },
    {
      "id": "msb_000F3ED4",
      "source_words_sha256": "5383bfd3218e5da26665fcbad3acd0734d896018212fec48d769be0ecf929995",
      "english": "Talked enough. Should be fine.",
      "translator_note": null
    },
    {
      "id": "msb_000F3EF4",
      "source_words_sha256": "dc7cc794e9f91e6ed95fc52729a4868b7e91083a241392935e90359cb02a407c",
      "english": "Kondo. Restrain yourself. Let's go.",
      "translator_note": null
    },
    {
      "id": "msb_000F3F18",
      "source_words_sha256": "7da323061b99f032db355b2909d8958b513aa8906c985bbee7b9e8f00abfb532",
      "english": "What's anisakis?",
      "translator_note": null
    },
    {
      "id": "msb_000F3F34",
      "source_words_sha256": "b5be21adeaaf16cc93fb215712baa6b02d4e800154c1927f12b7a36e58515200",
      "english": "My stomach... Kinda hurts...",
      "translator_note": null
    },
    {
      "id": "msb_000F3F5C",
      "source_words_sha256": "a3dc8da702134064b7ce13ae4087bc2bb283984c7e2c5184cb3729e410c5bd81",
      "english": "No, thanks...",
      "translator_note": null
    },
    {
      "id": "msb_000F3F74",
      "source_words_sha256": "6305bbe67b5e82eb6af1eb9017fca3a7278259669f718fc3c680ffa2f9ed4ee6",
      "english": "Y-yeah...",
      "translator_note": null
    },
    {
      "id": "msb_000F3F8C",
      "source_words_sha256": "859a828f5dd6e3a485aebee42627280bde2c49837011cde4e0b4c9bbf90a43b5",
      "english": "Force it out and Hijikata dies.",
      "translator_note": null
    },
    {
      "id": "msb_000F3FC4",
      "source_words_sha256": "52de582e3502c222586abc5db4e10b143a4cfc922f281b974da05f27b41dc471",
      "english": "Sure it's okay? What about life energy?",
      "translator_note": null
    },
    {
      "id": "msb_000F3FF4",
      "source_words_sha256": "71b9ec99bc255f9f9e076ac61302964f411f972d6548cc1217c6890b231362ed",
      "english": "Ate Otae's omelet again, huh?",
      "translator_note": null
    },
    {
      "id": "msb_000F4024",
      "source_words_sha256": "0504fc91f8a5739a89727d084ccd57110a3e752fdcd685af38fd6fa13f8adc00",
      "english": "I don't mind, but is something wrong?",
      "translator_note": null
    },
    {
      "id": "msb_000F4050",
      "source_words_sha256": "aeb83fab286bf49b0fcd67329594ab025ba7c84b63b4103110c49ed6cf981a8d",
      "english": "Feeling unwell?",
      "translator_note": null
    },
    {
      "id": "msb_000F4064",
      "source_words_sha256": "ae90bfede21f3898ab40909b85ddc1123d87456d30ba225f775896b122a6046f",
      "english": "Oh, no! Go to the hospital and have it removed!",
      "translator_note": null
    },
    {
      "id": "msb_000F4098",
      "source_words_sha256": "5ca690281440351933011fcf28167ee5255c3bc5e3ff7775f2643021d6d5ec27",
      "english": "Parasites need removing quickly! Especially anisakis. Dangerous!",
      "translator_note": null
    },
    {
      "id": "msb_000F40D8",
      "source_words_sha256": "69524b22e172d9c30552199d5ba5c1aee279ab07317b3a01da6ce5b73fa8fa9c",
      "english": "Shall I call an ambulance?",
      "translator_note": null
    },
    {
      "id": "msb_000F40FC",
      "source_words_sha256": "073a85ac5b3a6029e0732616468dfce254d41708ec1a22f0276d3416e149a797",
      "english": "Shall I take you to the vet?",
      "translator_note": null
    },
    {
      "id": "msb_000F4124",
      "source_words_sha256": "0606a5ccbfa5c549fb5cab030b1f76bc60f051be226d4ed345ea82d904215df9",
      "english": "Right! That makes ten!",
      "translator_note": null
    },
    {
      "id": "msb_000F4144",
      "source_words_sha256": "b536bc22ed59c2e514eeb611487f4d72e797ee94aac856495a20e844ff842bc8",
      "english": "...Nothing's happened yet...",
      "translator_note": null
    },
    {
      "id": "msb_000F4174",
      "source_words_sha256": "4ba8e7a93bfe3dc8009d6d95268c3c877f9bc34086885943036fffe7447a9356",
      "english": "Don't know what might happen.",
      "translator_note": null
    },
    {
      "id": "msb_000F41C0",
      "source_words_sha256": "ca8459e29f8509ac2b311e2607dc89dc00d7b99405706da3708480d711326065",
      "english": "Toshi. Any change?",
      "translator_note": null
    },
    {
      "id": "msb_000F420C",
      "source_words_sha256": "ea1ab1d13e6b5f66032d523d37118c161e28bdba3b85d19664b4a58fc0b5790c",
      "english": "Hold on!",
      "translator_note": null
    },
    {
      "id": "msb_000F4220",
      "source_words_sha256": "0fc8fde196d9fcd27b77fb309c015c88c071432d35c0b7b8003122b537e9cd96",
      "english": "Maybe we've talked to ten beauties now?",
      "translator_note": null
    },
    {
      "id": "msb_000F4264",
      "source_words_sha256": "439f6ff572f550d25c07f011b0ff34928eff7c40d789b6966e4627bbec941150",
      "english": "Shouldn't we go back where we started?",
      "translator_note": null
    },
    {
      "id": "msb_000F429C",
      "source_words_sha256": "a7bdfbf3878a3dd05c735a2247ee17b721480f10194bca32d338cd833e265373",
      "english": "Ugh...!",
      "translator_note": null
    },
    {
      "id": "msb_000F42B4",
      "source_words_sha256": "6f56377ad141c32c8c2eacabd6ae6fb95ae3c7d14628ecd80408ad1d9e868a97",
      "english": "Don't... say another word...",
      "translator_note": null
    },
    {
      "id": "msb_000F42E4",
      "source_words_sha256": "086b8c0f3ddae752a3e6c0afdbb244b9e3fccde965c1b00058326649330c1295",
      "english": "Oh! Because he talked to Otose!",
      "translator_note": null
    },
    {
      "id": "msb_000F430C",
      "source_words_sha256": "214103c9805504b6f9648500637dd8e9a2bec51c37987e76e1e63e14f6072d26",
      "english": "No, it's true! Talk to a woman who isn't beautiful, and he dies!",
      "translator_note": null
    },
    {
      "id": "msb_000F4358",
      "source_words_sha256": "425d80d57ed928d19dce667b6481f1994078dab95fdf67aff3c3fa9c7bdd10aa",
      "english": "This is hopeless...",
      "translator_note": null
    },
    {
      "id": "msb_000F4388",
      "source_words_sha256": "edd3c840efab2abf1ab867a5dfbd5386b754ea664feb3116f8611ab30eeb27c0",
      "english": "What's wrong? Feeling ill?",
      "translator_note": null
    },
    {
      "id": "msb_000F43B4",
      "source_words_sha256": "309e3745e3cad16572c97cbf913bdfe10e89246f6b178f4d3f04a0f3d2bbaf15",
      "english": "Of course not!!",
      "translator_note": null
    },
    {
      "id": "msb_000F43D4",
      "source_words_sha256": "69ee67f6b7539a7d71f4f0bc7c5ceb196b78b7cf3ad77231d66721725ea9113c",
      "english": "I'll kill the lot of you!",
      "translator_note": null
    },
    {
      "id": "msb_000F43F8",
      "source_words_sha256": "9f45fd18113fd7bc04d941a9c22dfcdb10ca2d17a8a69a7bb2e621f6515bcfb2",
      "english": "SHUT UP!",
      "translator_note": null
    },
    {
      "id": "msb_000F4414",
      "source_words_sha256": "09abf5343973fc6ca072ce6c3f9058cee523acb0908ffa8c5616b4e8aadea2e9",
      "english": "WANT TO PLAY WITH ME?",
      "translator_note": null
    },
    {
      "id": "msb_000F442C",
      "source_words_sha256": "75ad9af75c825c4a7859f422ac239c56471f719c067ed387901cef43d4de95c3",
      "english": "BAD DOESN'T BEGIN TO COVER IT, BASTARD!",
      "translator_note": null
    },
    {
      "id": "msb_000F4460",
      "source_words_sha256": "09e8a071b1dc8604fc84485ff6b5c77fa0924ec6db1dcd787633c2e04729cebc",
      "english": "HMPH! SORRY I'M NOT BEAUTIFUL!",
      "translator_note": null
    },
    {
      "id": "msb_000F4488",
      "source_words_sha256": "b547b55dc4f55ac4f98057a210ccee44d78f27024a3bb19ae6e5da90dad03138",
      "english": "No cat ears.",
      "translator_note": null
    },
    {
      "id": "msb_000F44B4",
      "source_words_sha256": "af38042edf8a1388663468eb782ab91ac34ce6b261d104090185848c8737e080",
      "english": "An ugly old lady, at that.",
      "translator_note": null
    },
    {
      "id": "msb_000F44F0",
      "source_words_sha256": "ae839e625b24a2c61a2295f0d9e5c71aaba1c3a55905fa42cf69a04a9e146539",
      "english": "Crap! Toshi dies with the alien inside him!",
      "translator_note": null
    },
    {
      "id": "msb_000F452C",
      "source_words_sha256": "bf25645705646ded7a15b0d2139ab9040b518a03542ff5ecc4042bb3246c440c",
      "english": "I refuse to accept a game over like this!",
      "translator_note": null
    },
    {
      "id": "msb_000F4560",
      "source_words_sha256": "3e3a00237245beff646aac9d655d12fdb9ee3455d7edbcd3f005a717ffe56f64",
      "english": "Oh... Isn't this bad...?",
      "translator_note": null
    },
    {
      "id": "msb_000F4588",
      "source_words_sha256": "de4d3d5313dc3ee757f8e7bc0a8849b7cb52d61e84a267fb90f35bd4178764b7",
      "english": "Seems the instant game over for non-beauties is real.",
      "translator_note": null
    },
    {
      "id": "msb_000F45C0",
      "source_words_sha256": "6bc6412b9c21701c50f9105d3cbf6f20544286ae1f7f60e059393ae85357f5f5",
      "english": "Oh, the three Shinsengumi. Need something?",
      "translator_note": null
    },
    {
      "id": "msb_000F45E8",
      "source_words_sha256": "c33617e12fd70624b80ab0388cad355c9e10be36a9e890ef802b977edf308798",
      "english": "That's your greeting?!",
      "translator_note": null
    },
    {
      "id": "msb_000F4600",
      "source_words_sha256": "2badd874a2bcb7e33cd40ed0a5bac05c29e68c08191438f10d619c42cfc00a63",
      "english": "What do you mean? I haven't done anything!",
      "translator_note": null
    },
    {
      "id": "msb_000F462C",
      "source_words_sha256": "a92aba687651c6eec666458da2a1c3b61ecc46d46ad5ba86af9a8ed96a95d6fe",
      "english": "What disease?",
      "translator_note": null
    },
    {
      "id": "msb_000F463C",
      "source_words_sha256": "6d0800cf3de1be9df0ca752577c6e9d2a70d40036779961817a819845e9c7b20",
      "english": "Drop dead!",
      "translator_note": null
    },
    {
      "id": "msb_000F464C",
      "source_words_sha256": "74462738532834acdb72f9a7b50a7e28f28c55ed0607c5cbe1b244ee30b56ec4",
      "english": "How rude! Suffer horribly and DIE!",
      "translator_note": null
    },
    {
      "id": "msb_000F4688",
      "source_words_sha256": "4ee7e7cb4899f7e591767bb1a541047f75ee60d165955a4ad5b1cfecbe495997",
      "english": "Ugh...! C-can't breathe...!",
      "translator_note": null
    },
    {
      "id": "msb_000F46BC",
      "source_words_sha256": "39e48bc132e6360fbbc0fe277c9523add2f3ffb50f803187bbcc6e088c61bfe0",
      "english": "Toshi! Hang in there!",
      "translator_note": null
    },
    {
      "id": "msb_000F46D8",
      "source_words_sha256": "905bc6b219ab5d219f42af22873672c5e1d3ca0ffd3d75c88200d9314336d0ea",
      "english": "Now?! What are you thinking?!",
      "translator_note": null
    },
    {
      "id": "msb_000F4700",
      "source_words_sha256": "a74207a28f0b3a5f488742b521b7f18cd1b28b7bb38d4122d8f4196430e2e32c",
      "english": "Actually, Hijikata's sick.",
      "translator_note": null
    },
    {
      "id": "msb_000F4744",
      "source_words_sha256": "63ce4bb25dba8c0e6b98f825397ac0de5df80003a375cd1fdf2b1da3f985b172",
      "english": "Needed a beauty's help to survive... Too late now.",
      "translator_note": null
    },
    {
      "id": "msb_000F4790",
      "source_words_sha256": "83bf7bd86362b52c4962c70bceff94938151e02816824e0e1e0ba3af9b8c9769",
      "english": "Hijikata. I'll put you out of your misery.",
      "translator_note": null
    },
    {
      "id": "msb_000F47E0",
      "source_words_sha256": "cbb434ed3b77d658f5d6960e0a0058201d41ce514a17b9097dea74ca45243616",
      "english": "Not collecting them. Just need to talk.",
      "translator_note": null
    },
    {
      "id": "msb_000F4814",
      "source_words_sha256": "2739ea936a326af735239a064ea4d06595257e310fb750bfb5d743a834602498",
      "english": "Ugh...! I-it hurts...!",
      "translator_note": null
    },
    {
      "id": "msb_000F4848",
      "source_words_sha256": "fe4f2c8cbae95a6f74d0e7e7dc0852980631e5da14c08d3798b7db0e67eb6995",
      "english": "Aaagh! Toshi! Are you okay?!",
      "translator_note": null
    },
    {
      "id": "msb_000F48B4",
      "source_words_sha256": "aa64364338f9b00957446aef6a99fa936ea5bf2353aece7f6ec8f2160a18a320",
      "english": "Had to go talking to an old lady...",
      "translator_note": null
    },
    {
      "id": "msb_000F48E0",
      "source_words_sha256": "dde04db9126f4440c7627476991fdcba1e884cc4dbd2b63ea60921206970794f",
      "english": "How long ago was that...?",
      "translator_note": null
    },
    {
      "id": "msb_000F4928",
      "source_words_sha256": "da8445bf034879a55b53ff8698290433ed671284d5e44bf3ccd5139c47ba594f",
      "english": "Let's leave him alone.",
      "translator_note": null
    },
    {
      "id": "msb_000F4948",
      "source_words_sha256": "1e151bf550a66a9b2f23e04ababca8295b66691fa3c84d16df14fe6a84d3d78a",
      "english": "What?! What are you doing with ten beauties?",
      "translator_note": null
    },
    {
      "id": "msb_000F4980",
      "source_words_sha256": "708db7ff9feed8c3efc91c3712fce1969e6164a2c58f3b2e13801248e3e8dc9a",
      "english": "I could be one of those ten, you know.",
      "translator_note": null
    },
    {
      "id": "msb_000F49B0",
      "source_words_sha256": "7b544f272ee0237f49cd7a5582518da5879be677354fd29a788d95aecda0e2f6",
      "english": "W-what happened?",
      "translator_note": null
    },
    {
      "id": "msb_000F4A48",
      "source_words_sha256": "34ad6fdae5fc8cdef87739dac33014c11bc941ef290f0f238dc70d73fc7cbf45",
      "english": "Ugh...! Don't talk to me...",
      "translator_note": null
    },
    {
      "id": "msb_000F4A7C",
      "source_words_sha256": "2994b5324649ad7fc2fb1dddfdb43fa2a8c9b7a47957bdb0da7497c21d5e451e",
      "english": "Ugh... No good...!",
      "translator_note": null
    },
    {
