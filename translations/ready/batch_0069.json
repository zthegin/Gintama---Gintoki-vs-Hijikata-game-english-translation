      "source_words_sha256": "98cbcf7d0a6a09d060ef4fc96098fe48c388585f384210e014a4585da7bbe441",
      "english": "So this monster gets sorted into the not-beautiful category, huh.",
      "translator_note": null
    },
    {
      "id": "msb_000F4BC0",
      "source_words_sha256": "d9de9801fc95a6772e3db5fadeade1d0ebc2d7a707d2b45c23ffe65512551762",
      "english": "That's impossible...",
      "translator_note": null
    },
    {
      "id": "msb_000F4BE0",
      "source_words_sha256": "28ea65cabd7111885f0fe7cd2e0b781f3a6198072625967870dd87fe0df18ffe",
      "english": "Oh, Shinsengumi. Fancy meeting you here.",
      "translator_note": null
    },
    {
      "id": "msb_000F4C30",
      "source_words_sha256": "5c5b489666b89dd38011ba4419354da4f7a559d2ae6e40975d5b918c912c6c34",
      "english": "Don't talk about me like garbage!",
      "translator_note": null
    },
    {
      "id": "msb_000F4C8C",
      "source_words_sha256": "0b859c0355034c305563ad1fba1f40751307aa32cb592e226c329b89b681f34a",
      "english": "No need to be shy.",
      "translator_note": null
    },
    {
      "id": "msb_000F4CA8",
      "source_words_sha256": "f7dae2956424a6e776bf2ff16465b09572b1dd6f5343ccd55d22cb907c6b1686",
      "english": "Beauties, huh... If drag queens will do, I know a couple.",
      "translator_note": null
    },
    {
      "id": "msb_000F4CE8",
      "source_words_sha256": "0e01a10427a3770d37c4fdc577fc323710c1aa63548aa5e7d8b7421cdb95ac4c",
      "english": "Paako and Zurako.",
      "translator_note": null
    },
    {
      "id": "msb_000F4DA4",
      "source_words_sha256": "c5f749f09fea681967bdd00c26d8515acda84b9e1e511c2328b844f9c71492ed",
      "english": "No queens.",
      "translator_note": null
    },
    {
      "id": "msb_000F4DB8",
      "source_words_sha256": "851a1a3e0fd2cd9500367dc5d23830974b68cd773a64b6045f697a3494e57709",
      "english": "Not a woman. It's safe.",
      "translator_note": null
    },
    {
      "id": "msb_000F4DD4",
      "source_words_sha256": "bc758f915f87f5d73a67c22c83f2bd7307860de8ea78c888c205e36a9819c604",
      "english": "Ugh... It hurts... Let me sleep...",
      "translator_note": null
    },
    {
      "id": "msb_000F4E18",
      "source_words_sha256": "a41d99a01bf58378146f1fc0e21c77d4f8e57a0cb9bd85c63029ebdff36fccf1",
      "english": "Who are the pretty queens?",
      "translator_note": null
    },
    {
      "id": "msb_000F4E3C",
      "source_words_sha256": "29d34a65d54abc04eaaf46cd92f1272f744b61be049ef37fde26778fe6721269",
      "english": "Paako and Zurako?",
      "translator_note": null
    },
    {
      "id": "msb_000F4E60",
      "source_words_sha256": "1dc819c666d6499500c365b4cb3b24e0bdc611c536b1cb5a41fa3ef09226b30e",
      "english": "Aaagh! What happened?!",
      "translator_note": null
    },
    {
      "id": "msb_000F4EC8",
      "source_words_sha256": "a1347b4c43da62cab157169732d903536ce96aba3d4044ebeb77a32f657072d3",
      "english": "Somebody! HELP!",
      "translator_note": null
    },
    {
      "id": "msb_000F4EF4",
      "source_words_sha256": "e18b45fdc44a7edee2a3895982cf871965873e670dc8d0d8f458adc5f150631a",
      "english": "Hijikata. Is it safe talking to a drag queen?",
      "translator_note": null
    },
    {
      "id": "msb_000F4F2C",
      "source_words_sha256": "d99e0b3f94dad44e8ba48f5dcf5f6db98ab8fc8a62699f3e80eed5fcdb39f224",
      "english": "Kondo. Might be bad.",
      "translator_note": null
    },
    {
      "id": "msb_000F4F44",
      "source_words_sha256": "eeacf82a0bdd4628d1538d151dc576df1405901cddff108f80b6d9f743028785",
      "english": "Hijikata's in pain.",
      "translator_note": null
    },
    {
      "id": "msb_000F4F9C",
      "source_words_sha256": "0b9f8c0461fe8a6694939cceb5719a191c566f3d87d4545410b7f321b66ed8b1",
      "english": "Dying from talking to a drag queen? Hijikata fans nationwide might riot.",
      "translator_note": null
    },
    {
      "id": "msb_000F5028",
      "source_words_sha256": "62df9cf115d7bc345dcefffbf607b70085f709ce91413626951dd09546fbe546",
      "english": "I don't like jokes...",
      "translator_note": null
    },
    {
      "id": "msb_000F5050",
      "source_words_sha256": "e64a761ef02f27582a4dc2cd66fd959749c00df5b359ab8571b23aefb64d1501",
      "english": "Hey. Calm down.",
      "translator_note": null
    },
    {
      "id": "msb_000F5064",
      "source_words_sha256": "607eef4c4d1c910be780601fec6a642d1827a3a25d5316eadf7802023e5ab500",
      "english": "Ugh...!",
      "translator_note": null
    },
    {
      "id": "msb_000F5080",
      "source_words_sha256": "0cfa723816c59da4b8c9bdd95cf9058f27fdfd43caf8a6b40f128d004094be2d",
      "english": "Can't... breathe...",
      "translator_note": null
    },
    {
      "id": "msb_000F50A8",
      "source_words_sha256": "71798b0b4b36db987183625ba00efcef5c4a043c2c1f4a23edf47cf40e4af1c3",
      "english": "What's LUCKY about it, bastard?!",
      "translator_note": null
    },
    {
      "id": "msb_000F50C8",
      "source_words_sha256": "392266c038061d841ab2aad43eb1eab667d366d5f9546762718d811147f6f3ba",
      "english": "What's wrong? You okay?!",
      "translator_note": null
    },
    {
      "id": "msb_000F50E4",
      "source_words_sha256": "c63dc18823f833930fe7eb0dd4f2f0ee2a02934cff19f4f58b8209ee59a74583",
      "english": "You, obviously, damn it!",
      "translator_note": null
    },
    {
      "id": "msb_000F5108",
      "source_words_sha256": "bcd46396fff4a28cea47ee5c7a8c2c61495096f6d10b311c636f53445d5ec34e",
      "english": "Whoa! Back to life?!",
      "translator_note": null
    },
    {
      "id": "msb_000F5120",
      "source_words_sha256": "d16a8001f80b950b0d0562975bef9577bd6a9dfa2ffd805f985cc39bb6334faa",
      "english": "Is your eyesight okay?!",
      "translator_note": null
    },
    {
      "id": "msb_000F513C",
      "source_words_sha256": "1826a93b13815765e1bb50988c14586a07b3675976c80cdbf4862adf4d8b8f1f",
      "english": "There's a beauty right in front of you!",
      "translator_note": null
    },
    {
      "id": "msb_000F5164",
      "source_words_sha256": "7e8ab176f0ae7c53152a85bbe24f4a7de7c91e606e8d1d0cdb103d4b52491597",
      "english": "I don't like jokes either!\fJokes... Jordan... Michael Jordan... Michael... Michael!\fMichael! That bastard! Called me a cyborg!",
      "translator_note": null
    },
    {
      "id": "msb_000F521C",
      "source_words_sha256": "40574e647021f26e91b6a7df32d812164a1e5bb3727e41d1fe0b7448017a7506",
      "english": "Only my NOSE had surgery!",
      "translator_note": null
    },
    {
      "id": "msb_000F523C",
      "source_words_sha256": "2e85127067ca6f16d97fc146e4d0b1786f4029dcdcab8ba4b1a57637bac88227",
      "english": "Who'd you talk to?",
      "translator_note": null
    },
    {
      "id": "msb_000F5254",
      "source_words_sha256": "c554ff807e84e9a62e641304a2e16c66a33e5d94b0e703b99e1f4d3c2b9126b5",
      "english": "Must've talked to a woman who isn't beautiful.",
      "translator_note": null
    },
    {
      "id": "msb_000F5288",
      "source_words_sha256": "009a8d21b2878ca320d574d57d1b28a174827de4b37959fe60693088c2ff8d46",
      "english": "Maybe too late. Lucky.",
      "translator_note": null
    },
    {
      "id": "msb_000F52DC",
      "source_words_sha256": "097b017226c74b140b310f0b0576fd47ecf56c5390aa845ad89aa624df55c709",
      "english": "Ugh... It hurts...!",
      "translator_note": null
    },
    {
      "id": "msb_000F5308",
      "source_words_sha256": "7dddf6e0802d50e368310fee7c4aac0f23b3aaae6d4816ddd4aacb22f513aa7e",
      "english": "Whoa! A drag queen!",
      "translator_note": null
    },
    {
      "id": "msb_000F5328",
      "source_words_sha256": "c320627bfa2087fe7ddab8866c3e7606e61d81b136779316f66757c2032c575c",
      "english": "Toshi! What's wrong?!",
      "translator_note": null
    },
    {
      "id": "msb_000F5340",
      "source_words_sha256": "36f0549f0f50fb22e121e93a1f93f35c1a93dfbfecc8cbe3e4aefe0f5659a562",
      "english": "If the alien inside dies, Toshi dies too!",
      "translator_note": null
    },
    {
