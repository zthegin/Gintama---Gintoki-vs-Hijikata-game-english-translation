      "source_words_sha256": "7aedc74d5a6a3e96784bcad2a42c04ed8668dba7e2d837e52a10c228252a1a96",
      "english": "Beauties... What type do you like?",
      "translator_note": null
    },
    {
      "id": "msb_000F5778",
      "source_words_sha256": "3b6cc0123818e57ed27a52498b493507264f7b236f63f7299c332f38bb6af2e9",
      "english": "Don't know that much.",
      "translator_note": null
    },
    {
      "id": "msb_000F5790",
      "source_words_sha256": "3c644e7f18d2e1a3511f7296c80387412a0eada889759d5af6e8b914c1da806f",
      "english": "Let's go check, anyway.",
      "translator_note": null
    },
    {
      "id": "msb_000F57B0",
      "source_words_sha256": "798313a910a58f69c5c3479fc350af9ffa290987bb87b442e77264db27e5dba3",
      "english": "Heard there's a beauty around here. Know her?",
      "translator_note": null
    },
    {
      "id": "msb_000F57FC",
      "source_words_sha256": "e755db2cc662c067d63a70d651e102d06148ee3e3a703d1bff7edf5b6a1b7388",
      "english": "Jutoku's daughter, isn't it?",
      "translator_note": null
    },
    {
      "id": "msb_000F587C",
      "source_words_sha256": "c9a1f28bb5d6c915f565ead82836b37183aac0549ce1c27a269b7f00cf225eec",
      "english": "Where's Otsu now?",
      "translator_note": null
    },
    {
      "id": "msb_000F5898",
      "source_words_sha256": "19c2cffdb94896e98a5d0b59cefd4c68216c64921fd6086bbe4ac0c665127bdd",
      "english": "Let's go see.",
      "translator_note": null
    },
    {
      "id": "msb_000F58AC",
      "source_words_sha256": "9639312bb3b893409d3009465400821dc86020aa289a45efc080a2d2c6cc049e",
      "english": "Where is she?",
      "translator_note": null
    },
    {
      "id": "msb_000F58C8",
      "source_words_sha256": "6c4f1247170723b0516145bc25ccd66dfdfeb7e004215d250a55337d36cf13fd",
      "english": "Otsu, of course!",
      "translator_note": null
    },
    {
      "id": "msb_000F58FC",
      "source_words_sha256": "e27bf2d4ad96148a7d9aaea9c02b3b237a8404c6dda08afa75ba20344346e654",
      "english": "TV station, maybe? Ask someone who knows more than me.",
      "translator_note": null
    },
    {
      "id": "msb_000F5960",
      "source_words_sha256": "f253b35cfb3fa1e9c6b9bde259658a58944c83cd55f71b2a84cd9c9b5493b0f6",
      "english": "An idol? Alien can't complain about that.",
      "translator_note": null
    },
    {
      "id": "msb_000F5A24",
      "source_words_sha256": "08d1c780128f0883b1f53bc7eaaf4faaf84f617bfcc02889c9cea63c59ba82ea",
      "english": "Where's Otsu?",
      "translator_note": null
    },
    {
      "id": "msb_000F5A3C",
      "source_words_sha256": "e46ed32404bcd0a58859ceb2c668182af32fc00f812608b1e9c7dde0408e52d6",
      "english": "Call yourself a fan?!",
      "translator_note": null
    },
    {
      "id": "msb_000F5A5C",
      "source_words_sha256": "931b9947ad67163dba31245d5e78e7df0dbba464a0e0f02dd50f7052c71c7b54",
      "english": "Don't know.",
      "translator_note": null
    },
    {
      "id": "msb_000F5A6C",
      "source_words_sha256": "5cf002dea1659040533643f4ea9243fd13141ffef25e9d5d19ae0a6971d0c7dc",
      "english": "What can I say? Ask someone else.",
      "translator_note": null
    },
    {
      "id": "msb_000F5AAC",
      "source_words_sha256": "03f384c14828809e3f1704705c677a46f2a8b5c2b4e7001fc244f4e1f203485d",
      "english": "Yamazaki! Good timing. Got a question.",
      "translator_note": null
    },
    {
      "id": "msb_000F5B50",
      "source_words_sha256": "49a920407db558de275f24dd3f0c3e493fc7d1c88e8d61a4db0b049fd64be1ed",
      "english": "I see... Can't just leave that alone...",
      "translator_note": null
    },
    {
      "id": "msb_000F5BB0",
      "source_words_sha256": "3000d3d05e53d0c6f6b8410c24e40458be9f63edf731ecddc8f1656634ff88bd",
