      "translator_note": null
    },
    {
      "id": "msb_000F55E8",
      "source_words_sha256": "c6837ef168e9259719af36b78be56e27bf10eeabd50a4029db8cf0f93d6f99a9",
      "english": "Found it nearby. Was going to take it home as a souvenir of Earth...\fBut life energy and your kindness are the best souvenirs.",
      "translator_note": null
    },
    {
      "id": "msb_000F5678",
      "source_words_sha256": "abc4b23c2fa7e55d3ae13d5e22cfc26e9a20370429a809711d9f6dd668e978e5",
      "english": "Goodbye, amigo!",
      "translator_note": null
    },
    {
      "id": "msb_000F56C4",
