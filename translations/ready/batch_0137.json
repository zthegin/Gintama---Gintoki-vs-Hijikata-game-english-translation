{
  "format": "gintama-community-translation-v1",
  "batch_id": "batch_0137",
  "records": [
    {
      "id": "msb_000EBDC8",
      "source_words_sha256": "ef9d06cadd09f067f4fb815af41356552ffebbaeb960e0d91d4c877630b09add",
      "english": "Local jail?\nHe'll escape again\nand cause trouble.\fSo exile him\nto a remote island\nhe can't escape.",
      "translator_note": null
    },
    {
      "id": "msb_000EBE74",
      "source_words_sha256": "c3c53950a8a3bf6b492ceff2031c9586b2ac5e6d1a4c42b01ac9ee6f4cfb5ad5",
      "english": "No such islands, Hijikata.\nTourism development.\nAll resorts now.",
      "translator_note": null
    },
    {
      "id": "msb_000EBEC4",
      "source_words_sha256": "969f9e0265e940dc0ec537f71d86783da2b526bb7415c3d84a6a23c19eff0cad",
      "english": "Mediate properly,\nHijikata...",
      "translator_note": null
    },
    {
      "id": "msb_000EC0B4",
      "source_words_sha256": "22ada849c8f1f37e8499e52e33848212d2bd9a7bc12cad4b834549495572b312",
      "english": "A fine girl, standing\non her own two feet.\fDoubt some petty scandal\nwould crush her.",
      "translator_note": null
    },
    {
      "id": "msb_000EC124",
      "source_words_sha256": "44dba5744f45377a3ec97354d376ecf7b684917756221f73f24376dfb7e25a7b",
      "english": "Even apart, trust her\nand watch over her warmly.\nIsn't that a parent's job?",
      "translator_note": null
    },
    {
      "id": "msb_000EC1AC",
      "source_words_sha256": "d803b822dc3545a7ab318f535645cd3f9f7a2cfb1eea0a8b4fbc3b0fedc7f5f3",
      "english": "Turn yourself in?",
      "translator_note": null
    },
    {
      "id": "msb_000EC5B4",
      "source_words_sha256": "27303089fd7074c3fe56eeb12ca74759967015222b957f7c9ced6f4682158549",
      "english": "[blue]S. Golden St.[/color]",
      "translator_note": null
    },
    {
      "id": "msb_000EC61C",
      "source_words_sha256": "2ef62c7fae06f98064a94d528aba640976e8336d565d1aeb4038a62d2675c005",
      "english": "Told you.\nI'd settle them all.",
      "translator_note": null
    },
    {
      "id": "msb_000EC6AC",
      "source_words_sha256": "6f706d8bb2afa68214b874785d78c261219a6f6e1cf8b8df7c6a9c35494772af",
      "english": "Hey, that's all\nfour fights\nsettled, right?",
      "translator_note": null
    },
    {
      "id": "msb_000EC8FC",
      "source_words_sha256": "3dbe2aa411d9566740dcd6b6c0475c61df13d76e6332a4408ad168a80b94f589",
      "english": "Easy to settle.",
      "translator_note": null
    },
    {
      "id": "msb_000EC934",
      "source_words_sha256": "04773c5204dfd5e1c42747dc9eb86b8e8d9c8c797930267a752af1f62288091a",
      "english": "Settle this quickly,\nHijikata. Too late\nonce nasty stuff spills out...",
      "translator_note": null
    },
    {
      "id": "msb_000EC990",
      "source_words_sha256": "b6afc58100976751e87ce64c73bec574761065a9b849dfa82fbb4c75162ce74d",
      "english": "Ah! Kimiko!\nCalled Shinsengumi\nto arrest me, huh!",
      "translator_note": null
    },
    {
      "id": "msb_000ECCA4",
      "source_words_sha256": "7ad9fc45520a9f48bce381847fddc4b0011d0b88e7a564033b2e71a900c397ac",
      "english": "Silly...\nMen shouldn't cry so easily.",
      "translator_note": null
    },
    {
      "id": "msb_000ECCD8",
      "source_words_sha256": "6bbfa50c0ed889fdec1b8de34f2bc80d0a1e8ae70224e057ba06fa10b241f292",
      "english": "Officer... Sorry\nfor the trouble.\nHere's a Gin Tama.",
      "translator_note": null
    },
    {
      "id": "msb_000ECD28",
      "source_words_sha256": "bf51e705418f3b9226141ecf0e46d6aa05deb603c7a29590f3c54e92ac61e940",
      "english": "Work. Earn it.",
      "translator_note": null
    },
    {
      "id": "msb_000ECD74",
      "source_words_sha256": "0bf24ff43edc5f848ee2f0ea0fa02e4f252c4805aa5a025705232d1c93ff2b10",
      "english": "A man borrowing\nmoney from a woman.\nPathetic, huh.\fCan't ask unless\nshe knows how\nuncool I am.",
      "translator_note": null
    },
    {
      "id": "msb_000ECFE8",
      "source_words_sha256": "47863ac9af3a6ebdcb951f023c63b2cb01b0b068fd1b2dc37bddee33217e1594",
      "english": "Kimiko's the only one\nI promised\nI'd go straight.\fNobody else\nbelieved me...",
      "translator_note": null
    },
    {
      "id": "msb_000ED098",
      "source_words_sha256": "5ed53520af42e8d18f80072c07f06e451fcf95573a11755bc6445741f700a358",
      "english": "I might cry...",
      "translator_note": null
    },
    {
      "id": "msb_000ED0E8",
      "source_words_sha256": "c56b4ffb81f3e1b449229d58280405d2528d583aeb196068cb6686303242bf73",
      "english": "Toshi, excellent\nmediation.",
      "translator_note": null
    },
    {
      "id": "msb_000ED15C",
      "source_words_sha256": "05eb0299a704cb2fdf3f570bf287232b9fdbce56181b7dd631cd149a6d834e4f",
      "english": "[blue]BUJI TV[/color].",
      "translator_note": null
    },
    {
      "id": "msb_000ED1C8",
      "source_words_sha256": "2ef62c7fae06f98064a94d528aba640976e8336d565d1aeb4038a62d2675c005",
      "english": "Told you.\nI'd settle them all.",
      "translator_note": null
    },
    {
      "id": "msb_000ED258",
      "source_words_sha256": "6f706d8bb2afa68214b874785d78c261219a6f6e1cf8b8df7c6a9c35494772af",
      "english": "Hey, that's all\nfour fights\nsettled, right?",
      "translator_note": null
    },
    {
      "id": "msb_000ED33C",
      "source_words_sha256": "339fbad896cf86373db72206ca5f604a06d96f3dce2efd663cb241abb2998fd1",
      "english": "Instead of borrowing,\ngo out with her.",
      "translator_note": null
    },
    {
      "id": "msb_000ED518",
      "source_words_sha256": "7ec769ba37f97b295f08447027eb437caadb510b6570a7cd7770ebdd98396b51",
      "english": "Utilities cut off,\nand still acting grand!",
      "translator_note": null
    },
    {
      "id": "msb_000ED558",
      "source_words_sha256": "9a08fc7072fa434a62095e15189a522697d80f0785aff30bbba880dc78966a83",
      "english": "Borrow elsewhere.",
      "translator_note": null
    },
    {
      "id": "msb_000ED698",
      "source_words_sha256": "8629dd6e42f24aa4535daeceea7967ce42d8a51b23d4ecd66b7daf97705e9a10",
      "english": "Blame yourself\nbefore blaming others!!",
      "translator_note": null
    },
    {
      "id": "msb_000ED710",
      "source_words_sha256": "cd34a84f25d66a6934431b8e552ba6213e00e98c0883ef173ed64a8697783cfc",
      "english": "Don't repay a cop\nand you're arrested.",
      "translator_note": null
    },
    {
      "id": "msb_000ED8D0",
      "source_words_sha256": "92eb35a0cea46fc7b93016ad216c4964a4a7d890907bea439783966fafdd73fa",
      "english": "What a disgrace.",
      "translator_note": null
    },
    {
      "id": "msb_000ED9D8",
      "source_words_sha256": "cf80c2a03e45c12b0c248da118d8ab6481fbb74242006e94c5c56d0df6ed21be",
      "english": "Don't interfere!",
      "translator_note": null
    },
    {
      "id": "msb_000EDB94",
      "source_words_sha256": "1ac15ac73b7f280db65645dbacbc65d19b9caa66351174f6538c4c408b0336c5",
      "english": "A family matter.\nStay out of it.\fKagura, come\nto space with Papa.",
      "translator_note": null
    },
    {
      "id": "msb_000EDDF4",
      "source_words_sha256": "8712d3b5cfefec07fddf692bcdc173d28ee521e321cff68eee8ebf1973f82d97",
      "english": "What are you doing,\nHijikata? Stop the fight.\nTake responsibility.",
      "translator_note": null
    },
    {
      "id": "msb_000EDE84",
      "source_words_sha256": "daa16a1e60d48acbdfc4d5c5c9076e17e4e44b5431edda8aef046aa59535e326",
      "english": "Go home.\nBefore someone gets hurt.",
      "translator_note": null
    },
    {
      "id": "msb_000EDF2C",
      "source_words_sha256": "efc6cbf44aacb95e4debed6e1cf48ebaa5bfe21f1981e6cc248aa5e11857590b",
      "english": "You did say that.\nBut...\fYour daughter answered\nwith a clear will.\fShe'd change\nher own destiny.",
      "translator_note": null
    },
    {
      "id": "msb_000EE16C",
      "source_words_sha256": "fc98c164c1f4260491ba2e98c49089632b93f48d9f0bd62b5bf97f76e2526dfe",
      "english": "Willing to get\nthem caught in this?",
      "translator_note": null
    },
    {
      "id": "msb_000EE22C",
      "source_words_sha256": "20e0a3732a748cebaaf55dba319ef3d717bdcc2698e509224c07bb6a000cceb4",
      "english": "Well... Seen my girl\nafter so long...\nTime to go home...",
      "translator_note": null
    },
    {
      "id": "msb_000EE330",
      "source_words_sha256": "7aa4f05812cf964874c8d189022737fcf9c1dedf8f3d85cb1fbb590c38c6edce",
      "english": "Oh, forgot.\nBetter settle\nthe other fights...",
      "translator_note": null
    },
    {
      "id": "msb_000EE3A8",
      "source_words_sha256": "66fc9f89a7096c0f91d26b7aefc4428ae0d73ca9f10063481d7adb42e5ef30d5",
      "english": "Managed to settle it.",
      "translator_note": null
    },
    {
      "id": "msb_000EE3FC",
      "source_words_sha256": "2f28aad08ec8e49b2af8634874acb7bd2c16d790336147b3857c4b250899c3a5",
      "english": "Outside [blue]BUJI TV[/color].",
      "translator_note": null
    },
    {
      "id": "msb_000EE438",
      "source_words_sha256": "27303089fd7074c3fe56eeb12ca74759967015222b957f7c9ced6f4682158549",
      "english": "[blue]S. Golden St.[/color]",
      "translator_note": null
    },
    {
      "id": "msb_000EE46C",
      "source_words_sha256": "2ef62c7fae06f98064a94d528aba640976e8336d565d1aeb4038a62d2675c005",
      "english": "Told you.\nI'd settle them all.",
      "translator_note": null
    },
    {
      "id": "msb_000EE4FC",
      "source_words_sha256": "6f706d8bb2afa68214b874785d78c261219a6f6e1cf8b8df7c6a9c35494772af",
      "english": "Hey, that's all\nfour fights\nsettled, right?",
      "translator_note": null
    },
    {
      "id": "msb_000EE6C8",
      "source_words_sha256": "f98c6f4d0531e06441d37cd5d973ae089c34d4874152222ae941ae80965e3c78",
      "english": "More damage\nat this rate.",
      "translator_note": null
    },
    {
      "id": "msb_000EE8A8",
      "source_words_sha256": "d378e66ad2bc02f61866b3ba832229340f0c482161df38a08d2c4a99fe70311a",
      "english": "Our job's walking\naround Kabukicho anyway.\nSearch while we do it.",
      "translator_note": null
    },
    {
      "id": "msb_000EEA80",
      "source_words_sha256": "fdc484556e5e8c4da362ed215251b12d8971fe7d9edab8b749fe3b7155fbd243",
      "english": "Don't curse me\non your own...\nCome on.",
      "translator_note": null
    },
    {
      "id": "msb_000EECC8",
      "source_words_sha256": "86969ae28323b475aff6b2c8946decc0e538ae1a7c12fc3fddd55a22d93e47fd",
      "english": "A cursed Jizo statue...\nWalking at midnight,\ncrying tears of blood...",
      "translator_note": null
    },
    {
      "id": "msb_000EEFB8",
      "source_words_sha256": "4010de5f42cf1f8d6843f29d192cc5734a34b8e1c7b7bd4c89e979a7d7f1df75",
      "english": "Missing Jizo report?\nNever heard of one.",
      "translator_note": null
    },
    {
      "id": "msb_000EF024",
      "source_words_sha256": "7844f0162127b4a1997d0593ed2a9a53ba4781153b395c94f46a452bfdc6d75b",
      "english": "Faster to file\na missing-person report?",
      "translator_note": null
    },
    {
      "id": "msb_000EF04C",
      "source_words_sha256": "7324e2d8015a10d5efe316cfe03c25fdd104b9de614bde73fc0fb3b93fe25ad3",
      "english": "Lost property, then.",
      "translator_note": null
    },
    {
      "id": "msb_000EF1B0",
      "source_words_sha256": "b1119a687ba706ed805eb2306ffc81728c2eb8f6d578ea121ed95f25cca68a96",
      "english": "A bit lonely\nas the end\ngets near, eh...",
      "translator_note": null
    },
    {
      "id": "msb_000EF914",
      "source_words_sha256": "ca4c99b0f1c9868f948b51facc9679248ef751a0d9167bc9f421fbf043990697",
      "english": "Search the area\nthoroughly!\nBefore someone gets hurt.\fSougo's involved.\nOne wrong move threatens\nShinsengumi's existence!",
      "translator_note": null
    },
    {
      "id": "msb_000EFA30",
      "source_words_sha256": "5a4cd3a71489278ac969155bb862cad302eededf42055bf10eaeedeb150d6f97",
      "english": "Um...\fThree on [blue]Dango Shop St.[/color],\none on [blue]Nabeya St.[/color],\ntwo outside [blue]Kodokan Dojo[/color].",
      "translator_note": null
    },
    {
      "id": "msb_000EFBB4",
      "source_words_sha256": "2bbde0dcb9da24a7d837ef5c8fd6a107fc0e62b754ab0320c38f95ce45fdd651",
      "english": "Wait! Sadomaru 25\nis two ken tall?\nThat's about 3.6 meters!",
      "translator_note": null
    },
    {
      "id": "msb_000EFC64",
      "source_words_sha256": "67ddf823d911d9220d37d159860b2196f19034a7222e281ffe8a9ca57cdbdec2",
      "english": "...Damn. Find Sougo\nfast or someone\nwill get hurt...\fMy hunch says\nhe's hiding nearby...",
      "translator_note": null
    },
    {
      "id": "msb_000EFD48",
      "source_words_sha256": "8f12d2ad06b5520704f53a4f8cc6677fc3da4d3027d4be1710a56f3711ee5d62",
      "english": "Where'd he go?\nTalk nicely.\nFor your own good!",
      "translator_note": null
    },
    {
      "id": "msb_000EFE0C",
      "source_words_sha256": "45dbe3cc2319ce88c673ba4407a6a3e0e505599e6b7e360e70986b3726ea74e2",
      "english": "Lost so easily!\nSame size and everything!\nDamn that bastard!",
      "translator_note": null
    },
    {
      "id": "msb_000EFE70",
      "source_words_sha256": "5a5d78c527282aae54987f5f0b9e838f5b1c8bdb458fc41ff6231c038b60e3a8",
      "english": "My Sadaharu 30's tough!\nKing Giant Dung Beetle,\nonly found in the Amazon!",
      "translator_note": null
    },
    {
      "id": "msb_000EFED0",
      "source_words_sha256": "93faa5de9a1f0de047be9fa2aca6d1aae6205c4fedebc33c01c3c41369597f10",
      "english": "Around here?\nThat hateful bastard's\naround here?",
      "translator_note": null
    },
    {
      "id": "msb_000EFFF0",
      "source_words_sha256": "2bbde0dcb9da24a7d837ef5c8fd6a107fc0e62b754ab0320c38f95ce45fdd651",
      "english": "Wait! Sadomaru 25\nis two ken tall?\nThat's about 3.6 meters!",
      "translator_note": null
    },
    {
      "id": "msb_000F013C",
      "source_words_sha256": "8f12d2ad06b5520704f53a4f8cc6677fc3da4d3027d4be1710a56f3711ee5d62",
      "english": "Where'd he go?\nTalk nicely.\nFor your own good!",
      "translator_note": null
    },
    {
      "id": "msb_000F0200",
      "source_words_sha256": "45dbe3cc2319ce88c673ba4407a6a3e0e505599e6b7e360e70986b3726ea74e2",
      "english": "Lost so easily!\nSame size and everything!\nDamn that bastard!",
      "translator_note": null
    },
    {
      "id": "msb_000F0264",
      "source_words_sha256": "5a5d78c527282aae54987f5f0b9e838f5b1c8bdb458fc41ff6231c038b60e3a8",
      "english": "My Sadaharu 30's tough!\nKing Giant Dung Beetle,\nonly found in the Amazon!",
      "translator_note": null
    },
    {
      "id": "msb_000F056C",
      "source_words_sha256": "2e892ee59f016e01ed024b49307b91f35ce45d1e73ada5fc250457d82fcc73be",
      "english": "Never learn,\ndo you, Hijikata...",
      "translator_note": null
    },
    {
      "id": "msb_000F05B8",
      "source_words_sha256": "253d6fc8fd6baf21d592b11a94e6089e517bd09bdefaaa7daeae880eed7ab5d2",
      "english": "Hey! Sougo!\fNo major damage yet.\nI'll overlook it.\nBack to [blue]HQ[/color] now.",
      "translator_note": null
    },
    {
      "id": "msb_000F0690",
      "source_words_sha256": "9837161808d81e4b36adbf9fe2410ca1e866b82182c95a5e449daacb1d0c956d",
      "english": "Wait!!\nHe's MY prey!",
      "translator_note": null
    },
    {
      "id": "msb_000F08B8",
      "source_words_sha256": "8f2c75d23803b5cf70f8eb522924e8b26d3b0de2c86871e1dc8ede6f466bfc8b",
      "english": "How will you take\nresponsibility\nfor that carnage?",
      "translator_note": null
    },
    {
      "id": "msb_000F0E80",
      "source_words_sha256": "f6f52f60cb408fea4c15fc5dfd781d3de5c704ae1f42456f4326f0ee26e42ef8",
      "english": "Don't worry.\nSadomaru 25 is trained.\nWon't attack people.\fOnly rival bugs,\nthe Chinese girl\nand Hijikata.",
      "translator_note": null
    },
    {
      "id": "msb_000F1064",
      "source_words_sha256": "8c764dcaa22fa5481f27e1afbddf22828421403af26f998c25e45e4b99eb5752",
      "english": "Hey! Look!\nSomething's glowing!!",
      "translator_note": null
    },
    {
      "id": "msb_000F10E8",
      "source_words_sha256": "177e7756df5fb46063b74ea1c7d6b54880237251cdcee20c46cc634e6ff9b290",
      "english": "A ghost, then?!",
      "translator_note": null
    },
    {
      "id": "msb_000F1568",
      "source_words_sha256": "a3a17f1fa07a06dc39a9ed3586ce41e12cf7b155bfa80085fea431dca18ef9c5",
      "english": "Don't know...\nCan't feel it...\nProbably in there.",
      "translator_note": null
    },
    {
      "id": "msb_000F15FC",
      "source_words_sha256": "5c6308b395c8b464494de18396d1355973089d502a1ae5b1e179c712710c2ccf",
      "english": "Find beauties fast\nand get this\nfreeloader out.",
      "translator_note": null
    },
    {
      "id": "msb_000F1668",
      "source_words_sha256": "b32f2e59e261e36e5905ea94c28619479cc38be74711d5984a4654904c27d35c",
      "english": "It spoke?!\nThe ghost light spoke?!",
      "translator_note": null
    },
    {
      "id": "msb_000F1700",
      "source_words_sha256": "b4f0c8e042f36fea75b0808663ff4498d7f2c4b0ded6bb1a083ebd26ed4e0ebd",
      "english": "Sugar? Amino acids?\nOr electricity?",
      "translator_note": null
    },
    {
      "id": "msb_000F17A0",
      "source_words_sha256": "37d5b444bd452aa1964d2b8b1eb9ca82f844bb919b2e7676b42d2ccb595d51d9",
      "english": "Possession too?\nMore like a ghost\nthan ever.",
      "translator_note": null
    },
    {
      "id": "msb_000F1924",
      "source_words_sha256": "bb80791230928f355c6f06a5a1a807913ecf1f0f79977acc5b9b1c7c060bb8f3",
      "english": "Ten beauties?\nThat's a pain.",
      "translator_note": null
    },
    {
      "id": "msb_000F19AC",
      "source_words_sha256": "fdafa616aca547699b488a59430e95e8c7ef0f4820afe7057d3b7e1179af6615",
      "english": "Um, I'm not\na ghost light, fireball\nor ghost, though.",
      "translator_note": null
    },
    {
      "id": "msb_000F1B88",
      "source_words_sha256": "6988daac2ad3e8f2caa31f72aea8170e4a8e60a53e15d9edc04666e2c9ce8a99",
      "english": "Life energy.\nHonestly, nearly dead.\fBarely surviving\non energy shared\nby plants nearby...",
      "translator_note": null
    },
    {
      "id": "msb_000F1C14",
      "source_words_sha256": "bb38d0928ff98ee05eb2c765622d4cc5d4101886a8116b2104c979bdd5d04458",
      "english": "Being a ghost\nwouldn't change much.",
      "translator_note": null
    },
    {
      "id": "msb_000F1C74",
      "source_words_sha256": "04018e92fbc15a0ab08928680e78a4b1f84adf18225c2219ef9699f74c335f37",
      "english": "Yes, I want\nlife energy.\fBut take enough\nfrom just one human\nand they'd die.",
      "translator_note": null
    },
    {
      "id": "msb_000F1D50",
      "source_words_sha256": "0e9506a541b2672ab4f003f13e0136563311d32fb70fdc7fbde608ac02e62c1a",
      "english": "Yes. Easy.",
      "translator_note": null
    },
    {
      "id": "msb_000F1E38",
      "source_words_sha256": "4f1d161a36bb41af390d63c924c5ff122101763c868972f14633a74bf38c38ff",
      "english": "Easy, right?",
      "translator_note": null
    },
    {
      "id": "msb_000F2034",
      "source_words_sha256": "8ac279579a6218d1171674498f8b19696ce82139f0782771a4f2a7d553d70935",
      "english": "Well... What is this?\nComplicated\ncircumstances...",
      "translator_note": null
    },
    {
      "id": "msb_000F21E4",
      "source_words_sha256": "1f05741e457df51f26f7cafebcfaa8d17839b8b7d12e0095f61c838a44476ece",
      "english": "Sorry to bother you.",
      "translator_note": null
    },
    {
      "id": "msb_000F238C",
      "source_words_sha256": "c90be08e8301d089e7c11eb7bcb3b777e14ad6164caee4df7b212c8df0008410",
      "english": "Busy. Keep it brief.",
      "translator_note": null
    },
    {
      "id": "msb_000F267C",
      "source_words_sha256": "01d5eb1f2516c01a2206e75154c87a8207ec0ce2b19814a5a9e8fecc0ca40b04",
      "english": "A stroll...?",
      "translator_note": null
    },
    {
      "id": "msb_000F26B8",
      "source_words_sha256": "97e257f1ab9c88b08ea90082e1e30a79270c782a1f117093657f88369b037a74",
      "english": "By chance, but\nspoke to a beauty.",
      "translator_note": null
    },
    {
      "id": "msb_000F26D8",
      "source_words_sha256": "6b17d93d4b59325418b8ccbf5e8b9223b8c58e757191e8da2cc9980bbe414ad6",
      "english": "Princess! Out alone?\nWe've searched for you\non the shogun's orders!",
      "translator_note": null
    },
    {
      "id": "msb_000F2798",
      "source_words_sha256": "17e0f7d7f7ab04e72b665564d05c88628dfb45a34984e5a52e8b48604e22cfd8",
      "english": "Just taking\na short stroll.",
      "translator_note": null
    },
    {
      "id": "msb_000F27EC",
      "source_words_sha256": "05ceee01cbc8bf0c56090ef87c121edc604661f0e9d57c500fdb924bcee72177",
      "english": "Used to it...\nWell, excuse me.",
      "translator_note": null
    },
    {
      "id": "msb_000F28A8",
      "source_words_sha256": "5d1f1af2905d15fb3f51c3c7f7e82334e565ad08c8a5a8b3d56405d1f72a2ddd",
      "english": "Lost money?\nHow so?",
      "translator_note": null
    },
    {
      "id": "msb_000F28E4",
      "source_words_sha256": "ac2885ce03fcb21179d9f406cd7a228930ca6a787d05e4dea9795dc5854b4ef6",
      "english": "Success.\nFind the next one.",
      "translator_note": null
    },
    {
      "id": "msb_000F294C",
      "source_words_sha256": "e3cb29318f92af132d0cd2feccfb380ce362756f36a502ab664e6d50d30b9b16",
      "english": "Well...\nLost quite a bit.",
      "translator_note": null
    },
    {
      "id": "msb_000F2974",
      "source_words_sha256": "7e98dd30d876a5d04f04a19ba009ee7f93632413c478162bbd078f107893b41e",
      "english": "Flattery gets to me.\nEnd up lowering\nmy food prices.",
      "translator_note": null
    },
    {
      "id": "msb_000F2A88",
      "source_words_sha256": "3ae439337c179f033f47e59df412a2b6fc1b9eb508610cc31f80c1e617b75e17",
      "english": "Simply helping someone.",
      "translator_note": null
    },
    {
      "id": "msb_000F316C",
      "source_words_sha256": "f3d598f614c10a9d5ef563cbf9f0dbaf44049b10dd0ce461ce0be4c78f47a57f",
      "english": "Say something...",
      "translator_note": null
    },
    {
      "id": "msb_000F31E8",
      "source_words_sha256": "381777a6e6615d536920d7f8dbf8045e9a110b968fe84af01e4338b2dd13bc3d",
      "english": "No... Don't play it...\nNot a conversation...",
      "translator_note": null
    },
    {
      "id": "msb_000F32C4",
      "source_words_sha256": "f9915401f038e66880567afd43c0f75d199e40379ea2f7ad7079dbee364294c9",
      "english": "Enough. Thanks\nfor your help. Bye.",
      "translator_note": null
    },
    {
      "id": "msb_000F3384",
      "source_words_sha256": "c28af80ecd5f574664b34f5a4d51ca5801f5d8f475af0be389e4e8ea19e9378b",
      "english": "More of a shut-in.",
      "translator_note": null
    },
    {
      "id": "msb_000F33A8",
      "source_words_sha256": "2e2bd8763bb29c764d3a8d7782dbcd15d9b691c09f300d726caac5c6fd46f5a7",
      "english": "Then I'll play.",
      "translator_note": null
    },
    {
      "id": "msb_000F3780",
      "source_words_sha256": "61a781bce7dcdf98cd7efb040ee649b556e2e2e44245a769f706a3202b226a25",
      "english": "Top ten, but not\ntop five or three?\nIs that what you mean?",
      "translator_note": null
    },
    {
      "id": "msb_000F3B28",
      "source_words_sha256": "d568625292231861e00e7e743aec599c32c52fb4e7b3ded76e743122610e0a4c",
      "english": "On TV every morning.",
      "translator_note": null
    },
    {
      "id": "msb_000F3C34",
      "source_words_sha256": "3ea986eb226e6583b3f30d8705252372d73998aa360f4ff0c0317eea3a410e9c",
      "english": "This morning's weather.\nYou said we'd better\ntake umbrellas today.",
      "translator_note": null
    },
    {
      "id": "msb_000F3C8C",
      "source_words_sha256": "0172254195b13c58d393cbca5fbb13eae79acbf7cb9d327b41964191ab8258f9",
      "english": "A weather front.\nRain more likely\nthis afternoon.",
      "translator_note": null
    },
    {
      "id": "msb_000F3CC8",
      "source_words_sha256": "19e39eb04fe1c89fcb609111849c444e88b709e7a6f5de070b906abb630c7ab3",
      "english": "Sunny, partly cloudy.\nMeteors in some areas.",
      "translator_note": null
    },
    {
      "id": "msb_000F3D4C",
      "source_words_sha256": "2f471bb8a3a445fc0132f9e76eb787f4d5d38631631c224371f2b58f6c1de3c4",
      "english": "Really no meteors?\nYou're sure it's safe?",
      "translator_note": null
    },
    {
      "id": "msb_000F4720",
      "source_words_sha256": "14c26b65403270f7c6b797a6e86e3d539994dec49b3321548c0dec7ff9dd1ace",
      "english": "Dies-on-seeing-uglies syndrome.",
      "translator_note": null
    },
    {
      "id": "msb_000F47B8",
      "source_words_sha256": "6b9cd7d33d0c50504851ce2a1ae91e76ac7dcdfc49d027a6eb57cd34c753fe6a",
      "english": "Hijikata!",
      "translator_note": null
    },
    {
      "id": "msb_000F4878",
      "source_words_sha256": "8e3bb429c531e4ff4a5ef11ba0f7a8b030b8d6f1caf5b5baedf3f059c7e79738",
      "english": "Sougo! Bad news!\nToshi's life\nis flashing before his eyes!",
      "translator_note": null
    },
    {
      "id": "msb_000F4904",
      "source_words_sha256": "78e9a9dedcca079b8f9c5a8c50d14687bca52695269f36a73641f006fef6da3c",
      "english": "Lost in memories...",
      "translator_note": null
    },
    {
      "id": "msb_000F49C8",
      "source_words_sha256": "7bbd11bcadeaecb4e7cebfffafa53c55b88ec740c7527f816b0724346b9b52f7",
      "english": "Rude! Before\nI had Otsu,\nI was quite a catch!",
      "translator_note": null
    },
    {
      "id": "msb_000F4A0C",
      "source_words_sha256": "d549852344191a23f236ffe3d422747adc02e397237381fdc3dd86b237a299fc",
      "english": "Before the bubble burst.\nAh, how I shone then.",
      "translator_note": null
    },
    {
      "id": "msb_000F4B1C",
      "source_words_sha256": "6253c6d51a1380dbb7badc27269e5bdc474d2fabb37b2171f13eddbc0589796d",
      "english": "Whoa! Toshi's\nstopped breathing!!\fSougo! Mayo!\nGet mayo!\nIt might revive him!",
      "translator_note": null
    },
    {
      "id": "msb_000F4C18",
      "source_words_sha256": "ff4a3d1c9abca7a44042fdb6dbe612791a8a9ffcef029ff1fa5b7cce583c7ba0",
      "english": "My! How rude!",
      "translator_note": null
    },
    {
      "id": "msb_000F4C54",
      "source_words_sha256": "f699378aff1ef5ec486a2f7fb9646049dfc7c0e5ef847b8afba7b24d16bbdcc4",
      "english": "What? Sick?\nLet me look after you.",
      "translator_note": null
    },
    {
      "id": "msb_000F4D08",
      "source_words_sha256": "294447ec8a74b33e6ab7de362b511ffa1eb053621e232471f83dc900dbb5e239",
      "english": "Planned their debut\nat my bar\nas 'Irezumi'.\fBut they quit\nalmost immediately.",
      "translator_note": null
    },
    {
      "id": "msb_000F4F64",
      "source_words_sha256": "e0ca581d134a903c9e1824cdf7078f8821451a7a7abd53dfa8335ad53eec7df0",
      "english": "Talking to a drag queen\nwas the fatal blow,\nit seems.",
      "translator_note": null
    },
    {
      "id": "msb_000F53B4",
      "source_words_sha256": "0553b7bfc305d3c3124eb01ca6187b31111502cff11a9281bad802a0305ad582",
      "english": "Talking to a drag queen\nwas the fatal blow.",
      "translator_note": null
    },
    {
      "id": "msb_000F558C",
      "source_words_sha256": "a5fc47a291854c239a7044f22dd5f71571d583e1e604cd357fde39b2649f8ed9",
      "english": "Now I can\nreturn to space.\nThank you so much.\fPlease take this\nas thanks.",
      "translator_note": null
    },
    {
      "id": "msb_000F5944",
      "source_words_sha256": "cafe44b93cb566b344863da497c09337248d5a9b82f10c40b6ece6308b4a1160",
      "english": "At [blue]Koei Theater[/color].",
      "translator_note": null
    },
    {
      "id": "msb_000F59B8",
      "source_words_sha256": "91a31e1571c180cb425fa29a6f681f7598a6a8ee541ecdce9346e9f43a0185f1",
      "english": "[blue]BUJI TV[/color], huh...",
      "translator_note": null
    },
    {
      "id": "msb_000F59F0",
      "source_words_sha256": "dd4036ea0794ffe1e86b65c12b22f8281511b3067917dbe179021f85cc717bdf",
      "english": "Should be at\n[blue]BUJI TV[/color]'s outdoor stage.",
      "translator_note": null
    },
    {
      "id": "msb_000F5DA4",
      "source_words_sha256": "d9ed67b58496fa9e72ddc33132bac065f873f192fe9a9e5c76c396daf8f8f2cd",
      "english": "Great soba there.",
      "translator_note": null
    },
    {
      "id": "msb_000F5DBC",
      "source_words_sha256": "6e8b5c55df7b49d67689c2d38898c129d9d847a2e60f83fb8c7a27253d06fdc8",
      "english": "Beauty at the\ngreat soba shop.",
      "translator_note": null
    },
    {
      "id": "msb_000F5E80",
      "source_words_sha256": "a7aa03a7e5a4c9c159a3bcb5cfd27fa229d89fece9803b9ee31056c5e0a57305",
      "english": "Cafe [blue]Asagao[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_000F5EAC",
      "source_words_sha256": "b37b1d3639e5db59e15f4ad143cdde43ae8966f6092ad653618003fc62873ada",
      "english": "At a cafe.",
      "translator_note": null
    },
    {
      "id": "msb_000F5F48",
      "source_words_sha256": "4e030a5a0f67650b561c4c84a708100ffbbccce1a165df7bc25d6c00c30f9518",
      "english": "Emergency. Don't blame me.\fNow! While we can!\nGet Hijikata out of here!",
      "translator_note": null
    },
    {
      "id": "msb_000F6130",
      "source_words_sha256": "fe56d37f23bb50a7837a3f88d3749aed22ca1479676634f06d0b6294f8b31507",
      "english": "Tch... Forgot\nto ask what he looks like.",
      "translator_note": null
    },
    {
      "id": "msb_000F6460",
      "source_words_sha256": "ec5ec447fb85b2129fe2c4c8689f53966908eb3907fa6e6bf37b5ca125222ab5",
      "english": "Looks like a gatekeeper.\nShow him the pass\nto get in...?",
      "translator_note": null
    },
    {
      "id": "msb_000F65DC",
      "source_words_sha256": "3ffd19c5c42f105d524b77bfa2edf27c08448712630695f14d99c580b1af0778",
      "english": "Not you!\nOne person per pass.\nNo companions allowed.",
      "translator_note": null
    },
    {
      "id": "msb_000F67F8",
      "source_words_sha256": "93abf99d811684f1ce49b3e0078ad37d1927d36675609a20906c31a01e10e20e",
      "english": "Join the battles, then.\nWon't learn anything\notherwise.\fShinsengumi Vice... No!\nUm... Yes!\nToshi, the Fresh Samurai!",
      "translator_note": null
    },
    {
      "id": "msb_000F68A8",
      "source_words_sha256": "ceb47474aa510effb2043830ff21b8450f4ef12871e5ce3b7f588ccc4e5324cb",
      "english": "Ladies and gentlemen!\nWelcome to the feast\nof underground Gin Tama!\fWho'll bloom\na grand rose tonight\nin this bloodthirsty arena?!",
      "translator_note": null
    },
    {
      "id": "msb_000F6934",
      "source_words_sha256": "22643f6fce3e853045acb39e2f79816daaccd11a7506e82a3280cd9f0b8b013d",
      "english": "A challenger steps up!\nA stage of fiery excitement!\nLET'S BEGIN!!!!",
      "translator_note": null
    },
    {
      "id": "msb_000F6998",
      "source_words_sha256": "7988f67fc3fcca116e578f21665eb50c373d2e9e92bbf2fd991f715007c5a378",
      "english": "Toshi, the Fresh Samurai.\nAnd you...\nWeren't you...?",
      "translator_note": null
    },
    {
      "id": "msb_000F69F8",
      "source_words_sha256": "e8247d29f0f3c05c187338221e84edcd3a06980d021953062068cca339cf6414",
      "english": "Cheap line. Admitting\nyou're small fry?\nFine. I'll beat you again.",
      "translator_note": null
    },
    {
      "id": "msb_000F6A94",
      "source_words_sha256": "06db6937d9450e792f16828e0baa5f77039ec21cd5aef915d0bfffbfa7bcc074",
      "english": "Remembered me!\nThe [blue]Rengokukan[/color] broker!",
      "translator_note": null
    },
    {
      "id": "msb_000F6AC8",
      "source_words_sha256": "c0fbec930cf18c20143b2219d266cadfdc2170dcf51ad4cae38d5d5f866b2a4e",
      "english": "Bastard...!\nPerfect time for payback.\fLet my guard down\nlast time.\nNot happening again!",
      "translator_note": null
    },
    {
      "id": "msb_000F6BC0",
      "source_words_sha256": "6956acf5e695ca499db8247621fa313248c5271ca3c37f4a8edb1b3890fd1a87",
      "english": "You remembered me.",
      "translator_note": null
    },
    {
      "id": "msb_000F6BDC",
      "source_words_sha256": "c0fbec930cf18c20143b2219d266cadfdc2170dcf51ad4cae38d5d5f866b2a4e",
      "english": "Bastard...!\nPerfect time for payback.\fLet my guard down\nlast time.\nNot happening again!",
      "translator_note": null
    },
    {
      "id": "msb_000F6C54",
      "source_words_sha256": "3e1de56598a504229962a18643e89e3d4c9343c1fc2e8defd059a0677bdc3cdf",
      "english": "Beat you again, then.",
      "translator_note": null
    },
    {
      "id": "msb_000F6DF8",
      "source_words_sha256": "b5e35fc53cb68d59a75535ee04b516466e66e4aec7e7ea4e9861bbf8d969e117",
      "english": "...Just a knockout\ntournament. Winner gets\na top-quality Gin Tama.",
      "translator_note": null
    },
    {
      "id": "msb_000F7190",
      "source_words_sha256": "f30ff7d3d009ea91d81eb92f3d25a06d32f8c2fec6a88b628c51b713a2d25330",
      "english": "Fussing over details?\nAnother sign of small fry.\n...Let's fight.",
      "translator_note": null
    },
    {
      "id": "msb_000F7260",
      "source_words_sha256": "6f92f95006d83e04a716821a6ecd3af2cda10497d3af6719d6a8bd3e2ab0e73e",
      "english": "Toshi, the Fresh Samurai,\nhas one victory!\nSecond challenger! Come out!",
      "translator_note": null
    },
    {
      "id": "msb_000F7310",
      "source_words_sha256": "33ffb77dd3603de9f78511a98c123f953cbabbaa6421ae8a2d9cd09e6df67696",
      "english": "Careless...",
      "translator_note": null
    },
    {
      "id": "msb_000F7474",
      "source_words_sha256": "41b114c152d5e22c9e36a05f4f98353ef7f2cd67e3ba5ca53b115c90b974993e",
      "english": "No originality.\nAnother small-fry Amanto?",
      "translator_note": null
    },
    {
      "id": "msb_000F74E4",
      "source_words_sha256": "bb0713fd8e74ae2be1eff8cc4a50906b8c526e08f2a49efa4231eba6bac714be",
      "english": "Don't be rude!",
      "translator_note": null
    },
    {
      "id": "msb_000F751C",
      "source_words_sha256": "31fbb3f2707952b111946ee89bf16fcacd132be654b27b909d19c7aada498090",
      "english": "Waste of time.\nSkip the pointless\nparting threats.",
      "translator_note": null
    },
    {
      "id": "msb_000F7664",
      "source_words_sha256": "a5c54e5db814f2c3b0eb890594fdd4715fc0835a9a18307773783d662f689ee5",
      "english": "Hahaha! How's losing\nto a small-fry feel?",
      "translator_note": null
    },
    {
      "id": "msb_000F7760",
      "source_words_sha256": "6d0147fdfe95fc94667be4a3e03e4718bc43341f67a951709a115603e1fead55",
      "english": "Silence!\nThat top-quality Gin Tama\nwill aid my world conquest!",
      "translator_note": null
    },
    {
      "id": "msb_000F78B0",
      "source_words_sha256": "f23f17c4b44c2a0fe9add63fc6af02d313d95e3a978d7f233d6659aecb776065",
      "english": "Good chance\nto outgrow\nthose delusions, eh?",
      "translator_note": null
    },
    {
      "id": "msb_000F7A18",
      "source_words_sha256": "4f7925e1c12c5f32d1e0d20de9cfaec4882ffc3ff1f1975052a94ea8543cba50",
      "english": "Justice, evil... Whatever.\nAshamed I lost\nto a delusional fool like you.",
      "translator_note": null
    },
    {
      "id": "msb_000F7C80",
      "source_words_sha256": "59ebe00c6d67865897ce0fa4113e6cf88c582973756fb509f35253d282a9b028",
      "english": "Say no more.\nToshi, the Fresh Samurai\nnow, remember.\fAnyway, what're you\ndoing here?!\nFinally got steady work!",
      "translator_note": null
    },
    {
      "id": "msb_000F8010",
      "source_words_sha256": "d0d0c7b1210d2943c3190c0a7e007f15acdd2780cfd7fb6b3ca7a1de5693baa0",
      "english": "Say no more.\nToshi, the Fresh Samurai\nnow, remember.\fAnyway, what're you\ndoing here?!\fUnemployed or not,\nstay out of\nsuch a dangerous place!",
      "translator_note": null
    },
    {
      "id": "msb_000F824C",
      "source_words_sha256": "5202ca2f341e0fe1a105d0be5da092adcf22804f16d7dd707646d0bc3fd767d5",
      "english": "But... Can't just\ngive up on a rare,\ntop-quality Gin Tama...",
      "translator_note": null
    },
    {
      "id": "msb_000F8428",
      "source_words_sha256": "010e7754cf3d8d88bc527577386803625d9979f3c608ce7ee692e0a95dfc9853",
      "english": "See now? No chance\nof winning one\nwith skills like that.\fWake up already.\n...Start a fixed-term\nsavings account, for one.",
      "translator_note": null
    },
    {
      "id": "msb_000F84CC",
      "source_words_sha256": "d66a97e37412c250575f91dcf21af928d6f1b50538e3b93b2fcfdfb0967d4e07",
      "english": "Hardly much of a style.\nEnglish words\ndon't make it cool.",
      "translator_note": null
    },
    {
      "id": "msb_000F8578",
      "source_words_sha256": "2609668122fe5f0cf1b59c6ba5680fa7bf0e08266f3a6e341b4630e693569abd",
      "english": "Hmph! Big talk,\nnot much skill.\nI win!",
      "translator_note": null
    },
    {
      "id": "msb_000F85C0",
      "source_words_sha256": "950fab4501cbb71891c2a5577069f164e29a63f7c9efeff4b29904f51b248713",
      "english": "Sore loser.\nI'll take\nthe top-quality Gin Tama!",
      "translator_note": null
    },
    {
      "id": "msb_000F86E4",
      "source_words_sha256": "dd8e12d2d121e2146f17a2c227129d8c74a7301f5c205bf582b84eeae61f256f",
      "english": "...Lost to a MADAO?!\nEven with my guard down,\nhow pathetic...!",
      "translator_note": null
    },
    {
      "id": "msb_000F88C4",
      "source_words_sha256": "7fc65ea5e3c366f3acef248f641fc2bb77ae02edad8310c6510960aa6b8ed1c3",
      "english": "Hey! Organizer!\nWhat's this?!\nShe's a minor!\fKeep this up\nand some child welfare\nlaw will get you!!",
      "translator_note": null
    },
    {
      "id": "msb_000F8AEC",
      "source_words_sha256": "24d85a844ec1da922264f4ef11fae46a6e52c6818503ea35c0db8af6d7d1c41b",
      "english": "She's Yato, right?\nThe legendary warrior clan?\fPerfect for [blue]Rengokukan[/color]'s\nunderground battles.\fAnd she works for Sukonbu!\nWonderfully cheap!\n...No problem, then!",
      "translator_note": null
    },
    {
      "id": "msb_000F8BAC",
      "source_words_sha256": "8de2fe7742f5af3b71d9e89104f630c2aeb98aff4e3a42be190940735e07deb9",
      "english": "Chinese girl...?!\nSukonbu bait again?",
      "translator_note": null
    },
    {
      "id": "msb_000F8C54",
      "source_words_sha256": "8037d443e38c094723d48a092304f3b3c287ee6ea9cec9b18e587e8b4e634d81",
      "english": "Twice as much this time!",
      "translator_note": null
    },
    {
      "id": "msb_000F8DA0",
      "source_words_sha256": "56e5dd6a363121b1fdbc61be37a1732d032a1f601c4d417bce1c843c0b984fb5",
      "english": "So close! Damn!\nWinning would've\nearned me more Sukonbu...",
      "translator_note": null
    },
    {
      "id": "msb_000F8E00",
      "source_words_sha256": "cf6d1ff3b77ccf2ff40ac79196e6981a31a0a08dbbfb381da75ae7cbf010448b",
      "english": "Not true!\nFresh rice, hot miso soup...\nThose count too!",
      "translator_note": null
    },
    {
      "id": "msb_000F8F5C",
      "source_words_sha256": "610004d9892d5d9903c319812e1fc0cb7a224148317c37ccd582f5ca4c0ce53b",
      "english": "Win them all\nand get more Sukonbu.\nFull of drive, yes!",
      "translator_note": null
    },
    {
      "id": "msb_000F8FA4",
      "source_words_sha256": "cf6d1ff3b77ccf2ff40ac79196e6981a31a0a08dbbfb381da75ae7cbf010448b",
      "english": "Not true!\nFresh rice, hot miso soup...\nThose count too!",
      "translator_note": null
    },
    {
      "id": "msb_000F9140",
      "source_words_sha256": "21e103310f37e814b410236b15cb6f9377c0a0fb52d2f805a2af35f3c4d8f473",
      "english": "Hmph! Good chance\nto beat that\nattitude out of you!",
      "translator_note": null
    },
    {
      "id": "msb_000F91B4",
      "source_words_sha256": "b6ba1665fd9bfaee77b58d4b97d89404628276b53ca65b7a7ee6be3b163276b2",
      "english": "Our challenger,\nToshi, the Fresh Samurai,\nhas beaten six opponents!\fThe biggest battle\nof [blue]Rengokukan[/color] tonight!\nThe reigning champion!\fChallenger or champion?\nWho wins?!\nThe thrilling final!\fBEGIN!!!!",
      "translator_note": null
    },
    {
      "id": "msb_000F930C",
      "source_words_sha256": "50b62ee822b134a953f887a24ca98077d74119fa916cb756cf7cb9e05e48ec28",
      "english": "My own investigation\nled me to these\nunderground battles.\fMeant to go undercover.\nBecame champion\nbefore I knew it.",
      "translator_note": null
    },
    {
      "id": "msb_000F942C",
      "source_words_sha256": "c4b0910de686e13370540bfb5ceffcd83934e87e3bbeb2e41169f78cd60bff24",
      "english": "Great. Kill Hijikata\nhere and save\nmyself some work.",
      "translator_note": null
    },
    {
      "id": "msb_000F951C",
      "source_words_sha256": "c786e2bad3c1bdbd306746648604673cbf369e2c6fac6708e755ab6f04c1e384",
      "english": "No outlaw career\nchange for you, idiot!\fToday I'll beat that\nrotten attitude\nout of you!",
      "translator_note": null
    },
    {
      "id": "msb_000F95B4",
      "source_words_sha256": "a7b4ba0fbead529e00bd2ce3a1ff3b3376a200f5626634f64de50394f6cebe2c",
      "english": "Our challenger,\nToshi, the Fresh Samurai,\nhas beaten six opponents!\fThe biggest battle\nof [blue]Rengokukan[/color] tonight!\nThe reigning champion!\fChallenger or champion?\nWho wins?!\nThe thrilling final!\fBEGIN!!!!",
      "translator_note": null
    },
    {
      "id": "msb_000F981C",
      "source_words_sha256": "bc5ea0207baa8a87da980e1aa5e2083ef40f7393220319f32056898dd8b5d415",
      "english": "Don't want a shady title!\nJust give me\nthe top-quality Gin Tama!",
      "translator_note": null
    },
    {
      "id": "msb_000F995C",
      "source_words_sha256": "8b1faf7d124b36f8762a6972558958771aedb1fdda638aa62e67a2484a2eb3b1",
      "english": "N-no, wrong!\nNot me. I'm\nToshi, the Fresh Samurai!",
      "translator_note": null
    },
    {
      "id": "msb_000F99D4",
      "source_words_sha256": "26e9fabba4f504236d4d14580809f0a76cee5380831a3d5c46c62e459ea3f376",
      "english": "Congratulations!!\nToshi, the Fresh Samurai!\nA new champion is born!!",
      "translator_note": null
    },
    {
      "id": "msb_000F9B74",
      "source_words_sha256": "c0e642067b865956e59c29dee012db12373af07d18cbec122fbb3d43c6734647",
      "english": "Oh, scary, scary...\nI'll be going first.",
      "translator_note": null
    },
    {
      "id": "msb_000F9C84",
      "source_words_sha256": "d6089c117aa7b4f77191ce5c3ba594e8bfb8eac811b2cb6ec51f1d4e92464e7a",
      "english": "Don't laugh this off!!\n...Kondo, we're going!",
      "translator_note": null
    },
    {
      "id": "msb_000F9D64",
      "source_words_sha256": "6e967860dbbfedcd7f67889d461c3f03d56670b41fa6b94168478b0ad6aebbcd",
      "english": "Good work, Hijikata.",
      "translator_note": null
    },
    {
      "id": "msb_000F9DA4",
      "source_words_sha256": "6c32cf558a498db07981c7c154952dd479d462262651cbca31333702431ad8c2",
      "english": "Now, now.\nSocial obligations\nand all that...",
      "translator_note": null
    },
    {
      "id": "msb_000F9DE0",
      "source_words_sha256": "dce0e180cd3f8cc4dc10353685c06bb878e716a3c9b2e8cc6b6e7f70a09bbb69",
      "english": "Ugh... People with\nno sense of humor...",
      "translator_note": null
    },
    {
      "id": "msb_000F9EB4",
      "source_words_sha256": "0250331c9c48837b7ab7b99760bd8ff5b32c7a04fc5d2af74662787536160375",
      "english": "Why does your comfort\njust make me angrier?",
      "translator_note": null
    },
    {
      "id": "msb_000FA128",
      "source_words_sha256": "bc5ea0207baa8a87da980e1aa5e2083ef40f7393220319f32056898dd8b5d415",
      "english": "Don't want a shady title!\nJust give me\nthe top-quality Gin Tama!",
      "translator_note": null
    },
    {
      "id": "msb_000FA280",
      "source_words_sha256": "26e9fabba4f504236d4d14580809f0a76cee5380831a3d5c46c62e459ea3f376",
      "english": "Congratulations!!\nToshi, the Fresh Samurai!\nA new champion is born!!",
      "translator_note": null
    },
    {
      "id": "msb_000FA350",
      "source_words_sha256": "954724ec0d3d4bfb866150be4d12d88d4c299de16b401b49e68b4fafd7edea90",
      "english": "Sorry. After your\nseven straight wins,\na man insists on fighting you.",
      "translator_note": null
    },
    {
      "id": "msb_000FA3B4",
      "source_words_sha256": "ba9a6b93c23bb3c4df4e666de84d94a7379636548ecd7e53a1b64af43a26936d",
      "english": "Beat one more man\nand the top-quality\nGin Tama is yours.",
      "translator_note": null
    },
    {
      "id": "msb_000FA494",
      "source_words_sha256": "c0e642067b865956e59c29dee012db12373af07d18cbec122fbb3d43c6734647",
      "english": "Oh, scary, scary...\nI'll be going first.",
      "translator_note": null
    },
    {
      "id": "msb_000FA624",
      "source_words_sha256": "1c57aec2c624756efbfd7e8de8565cc72cbe42ed0e04987f6dc7711f2c2d3503",
      "english": "Interested in this\nGin Tama craze too.\nFor several reasons...\fWatching the rumored\nunderground battles,\nsaw a lively little dog...\fCompeting here!\nLeave without saying hello?\nRather cold, isn't it?",
      "translator_note": null
    },
    {
      "id": "msb_000FA740",
      "source_words_sha256": "1018e624b8062e232359e3a7ca6923bca23ff0655b8b38e3c30c3ccb8045b9a1",
      "english": "Heh... Wait.\nWe can catch up\nafter a fight, can't we?",
      "translator_note": null
    },
    {
      "id": "msb_000FA814",
      "source_words_sha256": "fdf9129d33d05313eba7b47594d7870db573f77c1cc6175393022d985a7779f4",
      "english": "Fine! Beat you\nat Gin Tama,\nthen tie you up!",
      "translator_note": null
    },
    {
      "id": "msb_000FAA1C",
      "source_words_sha256": "fefcbeca4711a5adff741d97fec92fe8b7b228113b76d856ba4e235909d7754d",
      "english": "Letting you go today...\n...But!\fShow that ugly face\nin front of me again,\nand no mercy!",
      "translator_note": null
    },
    {
      "id": "msb_000FAAB0",
      "source_words_sha256": "f9400924b2384becf3416d1c3b11178febcce1156a27dcb7b571a4e91649d6a0",
      "english": "Remember this.\n...I'll cut you down!",
      "translator_note": null
    },
    {
      "id": "msb_000FABF8",
      "source_words_sha256": "2f6e3cf9c5c6b53debe5cc42119937fa344b60fdcb4e2b037d75720c433598b6",
      "english": "N-no, wrong!\nNot me. I'm\nToshi, the Fresh Samurai!\fSee you, then!",
      "translator_note": null
    },
    {
      "id": "msb_000FAC70",
      "source_words_sha256": "7af66ac151ccdc2d79993848c1f0a25d5d2e4e1f76c175163ab7db934c9b99af",
      "english": "Congratulations!!\nToshi, the Fresh Samurai!\nA new champion! For real!",
      "translator_note": null
    },
    {
      "id": "msb_000FAE7C",
      "source_words_sha256": "8e833b14b10f2079b87145deb80044f465fb58dab0471401eca7a20fb322e82c",
      "english": "Don't move any further.\fMy men are hidden\nall over this arena.\fTry anything\nand they won't stay quiet.\n...People will die.",
      "translator_note": null
    },
    {
      "id": "msb_000FB16C",
      "source_words_sha256": "cebab73926008219da0a11e88c42559ea98cc4c34799fb6a67e44ec3eed57447",
      "english": "Blame the rotten\nshogunate and\nyour own spinelessness.",
      "translator_note": null
    },
    {
      "id": "msb_000FB3F8",
      "source_words_sha256": "4d0f78536cf7ce886ff9da1a2a18a4d21aaaecb42d0680dc7265cf8f56a8762a",
      "english": "Um...\f'Offer seven Dragon Tama.\nI will work a miracle.'",
      "translator_note": null
    },
    {
      "id": "msb_000FB458",
      "source_words_sha256": "d657fd2e13ba475b1ae5f71853a6483a486a003049f97ff5ad8d4838decc71c4",
      "english": "Says 'Shienryu.'",
      "translator_note": null
    },
    {
      "id": "msb_000FB55C",
      "source_words_sha256": "211b0112ddb65bb058a7f369b6ce47ca246322f9f76033fb9b1905463d31292a",
      "english": "Worth a try, it seems.",
      "translator_note": null
    },
    {
      "id": "msb_000FB580",
      "source_words_sha256": "1228f05d2ef34813eaf6076c5a24807945349f38abc2b7ae76d040a6d2e6d7bf",
      "english": "Shienryu, huh...",
      "translator_note": null
    },
    {
      "id": "msb_000FB5DC",
      "source_words_sha256": "ef03616528311c4752f3b63bef7bc1b3bcf86bc12be253d6b26675948673c986",
      "english": "Said it's Shienryu.",
      "translator_note": null
    },
    {
      "id": "msb_000FB5F4",
      "source_words_sha256": "4d6ff964abb1379ddcf3b24020bfbd8e9bc9a1f7fc367084cc6d3a6c9e64fdb2",
      "english": "Demon or snake...?",
      "translator_note": null
    }
  ]
}
