  "records": [
    {
      "id": "msb_000533A0",
      "source_words_sha256": "99d80c02dd80f82d2385018ecff805e4bef3e212af138da600f86f118d992e10",
      "english": "Not Zura. Katsura. ...But right now, Zurako.",
      "translator_note": null
    },
    {
      "id": "msb_000533F8",
      "source_words_sha256": "6470727e7a1d48a6eed8bd8f06ec0572aaf5809bacd06679ed1822e1960de789",
      "english": "Last room, Gin.",
      "translator_note": null
    },
    {
      "id": "msb_0005341C",
      "source_words_sha256": "2760d29401ed6dededf3f35f17eb9d4f48c0dc6ccde08b6b62b418a0a9bba42b",
      "english": "I know! Just run, Zura!",
      "translator_note": null
    },
    {
      "id": "msb_00053454",
      "source_words_sha256": "3f8446f60c291c4a593bdd967f7cecb8b457aa1053fe8b1d724abbc9cf98df22",
      "english": "No, nothing. Just get going, Zura.",
      "translator_note": null
    },
    {
      "id": "msb_000534A0",
      "source_words_sha256": "2c1f256838cdb4c9027e68eb6ec5a4a1ac4ab519d5dc62994294f1310bd24c72",
      "english": "What a pain! You said it yourself!",
      "translator_note": null
    },
    {
      "id": "msb_000534D4",
      "source_words_sha256": "3a29149833d2beb63d3a4a0615cfe906f1922b9aa4284203c0f7ee878c070bf9",
      "english": "...For this country, right?",
      "translator_note": null
    },
    {
      "id": "msb_000534F4",
      "source_words_sha256": "9a4ed0f3b3cfbdcceb95254d4b4185f65bfb450a153f704402e4a08763c5704a",
      "english": "Come on! Move!",
      "translator_note": null
    },
    {
      "id": "msb_0005350C",
      "source_words_sha256": "b5f9e785bf60fed84beaf32353c35e35bbce04068c95c656bf02901bfee8be6a",
      "english": "Hey. Seeing a lot of you today.",
      "translator_note": null
    },
    {
      "id": "msb_00053528",
      "source_words_sha256": "21006f9856d6f96c4a8b84464778f53d8be9e404881b6e128c7377aba416f45d",
      "english": "Move? This is my workplace.",
      "translator_note": null
    },
    {
      "id": "msb_00053554",
      "source_words_sha256": "ce9eb993670b94eb4dfb3f4d734763170c40eec4faa089b6d895b19cdf53652d",
      "english": "Katsura? Don't know any wig of a guy like that.",
      "translator_note": null
    },
    {
      "id": "msb_000535DC",
      "source_words_sha256": "3b7de2e882e9d283bed9afc5ae437251bd17b18d3d5d6677610e5a1aadae000b",
      "english": "Caught a guy trying to sell Gin Tama to Joi rebels.",
      "translator_note": null
    },
    {
      "id": "msb_00053624",
      "source_words_sha256": "58c32ae7623aa8b8bae320829b9a0ef96514889db3dba65f501b929909206813",
      "english": "Be grateful. I'll give you a discount.",
      "translator_note": null
    },
    {
      "id": "msb_0005364C",
      "source_words_sha256": "017d5770f666800505e52f811fbbf5fdb7b353a42a0bedd58ae6cd999cf61c44",
      "english": "Then what?",
      "translator_note": null
    },
    {
      "id": "msb_00053668",
      "source_words_sha256": "7fe364f5b4912c72a98b0a9eb408316bc0e1bd330291454981841ce91aa57188",
      "english": "Sounds fun. Got Gin Tama to spare!",
      "translator_note": null
    },
    {
      "id": "msb_00053690",
      "source_words_sha256": "bfa73e91970193bc9c2f5426bdbf55bf1322fc45c40357971d21938cf85ec738",
      "english": "A Gin Tama battle, then!",
      "translator_note": null
    },
    {
      "id": "msb_000536A8",
      "source_words_sha256": "f13eb662a75bf7b3c617f8729f4ccc67df4b7798f48a1d07e4971e5f00992a0b",
      "english": "Huh? Me? Are you talking about ME?!",
      "translator_note": null
    },
    {
      "id": "msb_000536E4",
      "source_words_sha256": "78b675e8d83424cb785a40342140ac55a73703d512a10bb5c5191d866cf841eb",
      "english": "...Am I small fry? Am I, old man?",
      "translator_note": null
    },
    {
      "id": "msb_0005371C",
      "source_words_sha256": "36bb63dfcd089a73a54ae531ed7cdc3ce17e5a67936df7b55c6c8828e978ea1c",
      "english": "Katsura! Stop!",
      "translator_note": null
    },
    {
      "id": "msb_00053734",
      "source_words_sha256": "50839e7d24531167cb34e51a85a114ce1fe078d97c0c157e6dbdd1964415d431",
      "english": "Where are you, Katsura?! ...Oh! Gintoki?!",
      "translator_note": null
    },
    {
      "id": "msb_0005376C",
      "source_words_sha256": "d9eac655d8a716750d92602fadf43afdccb6aad5002dacf6844b2a177a9f00bb",
      "english": "Shut up! Out of the way!",
      "translator_note": null
    },
    {
      "id": "msb_00053790",
      "source_words_sha256": "db58b0f5b7088b615a64ca123a09f2b9e0fa2f5152127876d183b3302751b947",
      "english": "You... Letting Katsura escape?",
      "translator_note": null
    },
    {
      "id": "msb_000537F8",
      "source_words_sha256": "2bc1bf77c44d34d77b55f63c0c29545f9be64b1b7a9b428ae83c832a9d93a978",
      "english": "Who'd pay you?! Forget that small fry!",
      "translator_note": null
    },
    {
      "id": "msb_00053838",
      "source_words_sha256": "79ded1f147b2b450da1cb7b33897a75d9eeeda1ccfb9841502309d57dfb4bffb",
      "english": "All this arguing... We're getting nowhere.",
      "translator_note": null
    },
    {
      "id": "msb_00053880",
      "source_words_sha256": "c63ff315673c771f8048c56a553ed0e6aa7b8d9538d013a1951cc7d8b631584a",
      "english": "Force it!",
      "translator_note": null
    },
    {
      "id": "msb_00053894",
      "source_words_sha256": "c02068c0a331f280c27953b9781b57b59a3d240a6c1493797d5a3c2fbaefc562",
      "english": "Bring it on!",
      "translator_note": null
    },
    {
      "id": "msb_000538A8",
      "source_words_sha256": "c20fbe448a935444b365171f657e6369140a9b94c11568631733c138eac7c870",
      "english": "...Well, yes.",
      "translator_note": null
    },
    {
      "id": "msb_000538C0",
      "source_words_sha256": "4709b7a2e224312e649dd55d9fd2190632be71498966616c3f4980d7cc982565",
      "english": "Gintoki! The Shinsengumi...!",
      "translator_note": null
    },
    {
      "id": "msb_000538DC",
      "source_words_sha256": "774188ce5eed8d108f174b5dcc3eb25ae767ed4d65cd1fc6f5280ea3a3f04cbe",
      "english": "Gintoki...",
      "translator_note": null
    },
    {
      "id": "msb_000538F0",
      "source_words_sha256": "74a13063a50a6899ec8fe284ae57adf086960c36a6e294c761e913bcc353017f",
      "english": "B-but...",
      "translator_note": null
    },
    {
      "id": "msb_00053910",
      "source_words_sha256": "4ae8c4db2afafe474c6e8f9776ba300ff33275cf4f7794c9a584bbb1042d35d5",
      "english": "...!!",
      "translator_note": null
    },
    {
      "id": "msb_00053924",
      "source_words_sha256": "03d623296cb59db37c2d876336bfa3ff742c897a906c3dcfc157f7a98efeeb24",
      "english": "...Sorry again, Gintoki!",
      "translator_note": null
    },
    {
      "id": "msb_00053EC0",
      "source_words_sha256": "0b616a7a9635b14920e89e28045f52efb6e584094ce8aa949240b82fa66451d8",
      "english": "...Yeah.",
      "translator_note": null
    },
    {
      "id": "msb_00053EE8",
      "source_words_sha256": "8fdad8151c01521b2eff3322323dae2143b700efdfcc05d0d9924e921513d098",
      "english": "What did you expect? All that trouble in the club? I'd fire me too.",
      "translator_note": null
    },
    {
      "id": "msb_00053F44",
      "source_words_sha256": "f5da9a4d8b5c74ce0cfa4c8b515af5f0136604dfd88c5b52e06a0c109265503f",
      "english": "What? Want to get fired from HERE? Anytime.",
      "translator_note": null
    },
    {
      "id": "msb_00053F80",
      "source_words_sha256": "fe5da7a6d241e0036beead2960c3225a39b7ed6ed88a88cfac38619b71020efc",
      "english": "Oh? Why?",
      "translator_note": null
    },
    {
      "id": "msb_00053F94",
      "source_words_sha256": "4c2ade323e3686b9d1f60fa5ea26f29caeb1ff27f1dd03c84b335f9b8af16238",
      "english": "Poor guy...",
      "translator_note": null
    },
    {
      "id": "msb_00053FB4",
      "source_words_sha256": "ed2f1409dacbe775930c88af5bda5f8f5743d0facd2b6bd3525d187838042fc2",
      "english": "Never mind Hasegawa for now.",
      "translator_note": null
    },
    {
      "id": "msb_00053FD4",
      "source_words_sha256": "a52fbf9973ab8240eaabbfc80a77f4a9a820d07c612a1cbc7534670f29bd8c43",
      "english": "Something's bugging me...",
      "translator_note": null
    },
    {
      "id": "msb_00053FF4",
      "source_words_sha256": "6d15d22a2a8c45ef46ce66323a47fe141113e7cbc599dead7896c9dc9a69fedd",
      "english": "Hmm... What was it?",
      "translator_note": null
    },
    {
      "id": "msb_0005400C",
      "source_words_sha256": "8f8d6e9f11fbceef9d898944f86524629799b1288067cae897db17b10aee1a06",
      "english": "No, don't care about that.",
      "translator_note": null
    },
    {
      "id": "msb_0005402C",
      "source_words_sha256": "686203fd4c0fe77ae656edc67237f97e456541c57d85d772a325f3099d752f74",
      "english": "Who's worried about wigs? I've got plenty of hair!",
      "translator_note": null
    },
    {
      "id": "msb_00054060",
      "source_words_sha256": "d386f5722ff8d6efab5e6d03c88d59597c802fb7d55d8748056f24ace27ce284",
      "english": "No. Rather think about nothing than worry about them.",
      "translator_note": null
    },
    {
      "id": "msb_000540B4",
      "source_words_sha256": "6e0b72b6a124c4b52044a13291fe8e856c9095585988b71a73492c3e0facc0cd",
      "english": "Old hag, but quick ears!",
      "translator_note": null
    },
    {
      "id": "msb_000540D8",
      "source_words_sha256": "1e58ce6a017a1dc6f55852039fd7dc7f78452ce1933e0dbd4eaaa67bae48eba6",
      "english": "Well, uh... Right! Money's made to go round...",
      "translator_note": null
    },
    {
      "id": "msb_00054128",
      "source_words_sha256": "39e71f4e88b68a698a9cae2a0ca183e8b8a26c02a130066f2466aedfe0da2a6e",
      "english": "Shinpachi! Kagura! Run!",
      "translator_note": null
    },
    {
      "id": "msb_00054148",
      "source_words_sha256": "93ae992f87434add9dc4dfd6f22f54f5e0ecd3e6063e6e3384ce5485f1c86d16",
      "english": "Got it! This, Shinpachi! THIS was bothering me!",
      "translator_note": null
    },
    {
      "id": "msb_00054188",
      "source_words_sha256": "7a017d8627ca0f7c973276527c6c47e0e66e42c393b98ea44eb9c33028d23ac3",
      "english": "What's been bugging me all along... Is the overdue rent!",
      "translator_note": null
    },
    {
      "id": "msb_000541D4",
      "source_words_sha256": "ac93ad7ee0486771c908c6462547ab270ec05c316408bcdd857e7fc5a695e908",
      "english": "Just RUN!",
      "translator_note": null
    },
    {
      "id": "msb_00054240",
      "source_words_sha256": "cbb610810674a9b580be98eae711248131436e5461a3514d243a1ae5ad858090",
      "english": "Quiet, Shinpachi! My stomach can't take it!",
      "translator_note": null
    },
    {
      "id": "msb_000542C8",
      "source_words_sha256": "d25c391a9ec00ddbdab4472664023d5a455f6d5d7154fb8d70a19b54596efca6",
      "english": "Feels like we're almost there already...",
      "translator_note": null
    },
    {
      "id": "msb_0005430C",
      "source_words_sha256": "23dc381bcd94f95877f137619e1ff586814b9650788750a2dae168d798898cc9",
      "english": "Wait, Gin! Might as well ask Otose to feed us!",
      "translator_note": null
    },
    {
      "id": "msb_00054364",
      "source_words_sha256": "9067ce96372b60651cd6825448262784b81f62fad112ce1bc2e2fab2b6949043",
      "english": "Oh. Nothing new, then.",
      "translator_note": null
    },
    {
      "id": "msb_00054390",
      "source_words_sha256": "09d74a20d38c604168a763f0375281929c5eb70fbfc2e5fd15e39853e4cb29f3",
      "english": "Gintoki!",
      "translator_note": null
    },
    {
      "id": "msb_000543E8",
      "source_words_sha256": "33243213efc147315c3a5701012a420fe2030fe137ac0d006e476fd9085b6d8e",
      "english": "Blew a perfectly good job! How'll you pay rent?!",
      "translator_note": null
    },
    {
      "id": "msb_00054528",
      "source_words_sha256": "83e1d7acabf02ce6ddfd89587fa13658168bf660046179f6250b7a2f25e87e1f",
      "english": "Ahh... Thought food was sorted for a while...",
      "translator_note": null
    },
    {
      "id": "msb_00054564",
      "source_words_sha256": "699e251a18da1f8867189624b9ca0275814341204faaa97b018279ff293417e7",
      "english": "It's all yeah, yeah, yeah! King of Planet Yeah, are you?!",
      "translator_note": null
    },
    {
      "id": "msb_000545A8",
      "source_words_sha256": "73e611acb72d480028a31427c3c4a48ce47c9730431517d6f0c3097fcebdafee",
      "english": "Defiant again... Oh, right! Speaking of getting fired...",
      "translator_note": null
    },
    {
      "id": "msb_000546B8",
      "source_words_sha256": "4348b77863d1648faf45f92d92cc1f03f2a6498832da0a88ad81ce472386143b",
      "english": "Hm? Something wrong?",
      "translator_note": null
    },
    {
      "id": "msb_000546D4",
      "source_words_sha256": "90857cd2d0a985c43f25b3bb018cd734790ae7c0223836c303445207d39bdb55",
      "english": "Bugging you? What?",
      "translator_note": null
    },
    {
      "id": "msb_00054750",
      "source_words_sha256": "1c260ea8ceecd521eb807c16a8657fdd37ffa0b874306e260528b02c7999100c",
      "english": "Katsura, then? He said Gin Tama weren't just toys...",
      "translator_note": null
    },
    {
      "id": "msb_00054868",
      "source_words_sha256": "9ca2940930ab3654ac3140ba5b199d8cb0f320ec58bf2bd32694982e7f253e79",
      "english": "Hmm... What could it be, then?",
      "translator_note": null
    },
    {
      "id": "msb_00054894",
      "source_words_sha256": "b3e7049289bd7b65d4f42c255575734c9f507b66da3b971c8a7eb6f6eaf80d28",
      "english": "Ugh! Otose?!",
      "translator_note": null
    },
    {
      "id": "msb_000548BC",
      "source_words_sha256": "61d633a1f65177a62b1b5b7e16d68517ba399b97ea2fb05699ff12934e6915f9",
      "english": "Huh? What is?",
      "translator_note": null
    },
    {
      "id": "msb_000548EC",
      "source_words_sha256": "f5d4cac3d6cd1b154bd76718eb2ad59e3390c2ab1c1e2d4d55951d4095bdef1e",
      "english": "...No, Kagura. That's WHY it's a problem...",
      "translator_note": null
    },
    {
      "id": "msb_00054EE4",
      "source_words_sha256": "5cdfab9207d3e128a368366fba5d07d552447def3be69b0a425a0c2fccd98794",
      "english": "No way.",
      "translator_note": null
    },
    {
      "id": "msb_00054EF4",
      "source_words_sha256": "b5ee0f96aae434f2d08d393ef87ca1627270ae627ff6fc8982e7c27a087c436d",
      "english": "Don't feel like helping either.",
      "translator_note": null
    },
    {
      "id": "msb_00054F90",
      "source_words_sha256": "7678c2db6cb6211a6ce0b00193d51cd18453e2b0fd4087b3f4ef499e38457665",
      "english": "What now, then?",
      "translator_note": null
    },
    {
      "id": "msb_00054FB0",
      "source_words_sha256": "00864d79449e7f446cd0e546f89e2446b6d150596b1bc3c565f2f4e424388bec",
      "english": "Ahh. You lost?",
      "translator_note": null
    },
    {
      "id": "msb_00054FD0",
      "source_words_sha256": "c4914c7f630756deef3d343971719756876d70614f35709980e719dc0c6224e9",
      "english": "Game over like this? Hopeless.",
      "translator_note": null
    },
    {
      "id": "msb_00055004",
      "source_words_sha256": "bc15417dfdd89244bb41bbd2c52a51293c5400efab4041593e9b3573f9648470",
      "english": "Might've won if you fought with me...",
      "translator_note": null
    },
    {
      "id": "msb_00055038",
      "source_words_sha256": "f1010a68ad4e2c1e4c37cccdab18b32caa50881b454577604c63c4c65cb81028",
      "english": "Too bad. Game over.",
      "translator_note": null
    },
    {
      "id": "msb_0005505C",
      "source_words_sha256": "fe8b34859029f03d2771ec3aa54ccb2242fc1cc8fc2b628206a3fcc099f81adc",
      "english": "Built pretty tough, aren't you.",
      "translator_note": null
    },
    {
      "id": "msb_00055090",
      "source_words_sha256": "e278059ece8590b2ca4b3865554051b3b709e5b42a92c5f54d43ac5a9216d16f",
      "english": "Game over?!",
      "translator_note": null
    },
    {
      "id": "msb_000550A8",
      "source_words_sha256": "a2735fabd76c66f4366fe0223cf985f7708e465979b7ccdad2a734bacb86797c",
      "english": "This isn't over!",
      "translator_note": null
    },
    {
      "id": "msb_000550C8",
      "source_words_sha256": "da1230f2b19ef78c7d585a656ef075c0daabbae9d8941565f927d92df256c4ac",
      "english": "I'll fight with you.",
      "translator_note": null
    },
    {
      "id": "msb_000550E0",
      "source_words_sha256": "c299a477cb9eb522c0e5e165260cfa6ef0428ac9473d72450a22aa8ccdbfbb06",
      "english": "Don't slow me down.",
      "translator_note": null
    },
    {
      "id": "msb_000550F8",
      "source_words_sha256": "03ea20d6d149b6f2621c1f6d0f912e252266a770d69f6c8157f9c702a67b15b4",
      "english": "Not doing it to help YOU.",
      "translator_note": null
    },
    {
      "id": "msb_0005511C",
      "source_words_sha256": "7112602030e7c0031e15e414eb8408c08818728cb6fbe665f7e871ccd14d8958",
      "english": "Then, much as I hate it, a joint battle!",
      "translator_note": null
    },
    {
      "id": "msb_00055150",
      "source_words_sha256": "5c2db706901599da5728b0bfb474fc4b86ade85ebbc697c8af5906a3756c6ca8",
      "english": "Can't help it... Just this once.",
      "translator_note": null
    },
    {
      "id": "msb_0005517C",
      "source_words_sha256": "5411e5cf0804c19c8c54e16324c0a30697e6805ac570122e6630d95d640a4612",
      "english": "Hmph. YOU don't!",
      "translator_note": null
    },
    {
      "id": "msb_00055194",
      "source_words_sha256": "02fa8ddbf89ab8d050b8febae03ae3c5c89107a8cde798e2f5e93586fd0aeafe",
      "english": "Whatever.",
      "translator_note": null
    },
