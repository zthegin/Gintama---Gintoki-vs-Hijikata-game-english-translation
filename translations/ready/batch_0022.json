      "english": "Dragon Tama?",
      "translator_note": null
    },
    {
      "id": "msb_00055B94",
      "source_words_sha256": "1e6d4ca2f324cc05d921703efba243326734c34a69a822606aff08e03cbb95dc",
      "english": "Saburo knew I was troubled about Dragon Tama...?",
      "translator_note": null
    },
