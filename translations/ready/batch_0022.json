      "id": "msb_00055DCC",
      "source_words_sha256": "ce7bddf43ea49b4245ecf5f3fab6a9fdd4f4ac91c69457b38229e8bb90439b02",
      "english": "The Shinsengumi and Gin saved me.",
      "translator_note": null
    },
    {
      "id": "msb_00055DFC",
      "source_words_sha256": "c57f02339a6130a02dcdb4db05d2cf3535e22d40f4db0c6b7a8cc567304ece8b",
      "english": "I'll head home, then.",
      "translator_note": null
    },
    {
      "id": "msb_00055E18",
      "source_words_sha256": "80d49dae66fa5c8a0b0b4611f20b49cda866850ca672b92c1a5af58c4bdd6e18",
      "english": "No, thanks. I can go alone.",
      "translator_note": null
    },
    {
      "id": "msb_00055E40",
      "source_words_sha256": "3c44f1eb8d042a531b9b8e80bc753bec359634fc8851c7776fc7ebad2958dfeb",
      "english": "...Sigh. Do what you want.",
      "translator_note": null
    },
    {
      "id": "msb_00055E68",
      "source_words_sha256": "0e5f2844020f8d0b7f4ef559651dec86e59f4dffa1f046e2e4c078eb37e13afb",
      "english": "Hey! Lost because of YOU!",
      "translator_note": null
    },
    {
      "id": "msb_00055E94",
      "source_words_sha256": "6b9ab3dc8e4a32faf10ee83f32b98cf07c7c2c741f0e050d74c03c2b83592254",
      "english": "Now what?!",
      "translator_note": null
    },
    {
      "id": "msb_00055EC8",
      "source_words_sha256": "ddf0fadc67719515e0ef434634a881b06e9ce1e5f17e37bc7e5890ca2933b429",
      "english": "Not my fault! YOURS!",
      "translator_note": null
    },
    {
      "id": "msb_00055EF0",
      "source_words_sha256": "6f0f3d363648a12fca71149d3dfe1046eca0005be1ea01f433b700c15ea2573b",
      "english": "How should I know, idiot?!",
      "translator_note": null
    },
    {
      "id": "msb_00055F08",
      "source_words_sha256": "a2116fdb9af8b13582bc2372720cb98703392e142f23d73eb1ce792b474c28e3",
      "english": "And he said something huge!",
      "translator_note": null
    },
    {
      "id": "msb_00055F28",
      "source_words_sha256": "d22b095ab651e2e6d9232085a4f7175be1ddf5ca8cab02ac76927530eb1f774e",
      "english": "Game over!",
      "translator_note": null
    },
    {
      "id": "msb_00055F58",
      "source_words_sha256": "3b309f12574adf2ff901d63bc59b5291286e8441a64d45ccf26274aa72e82bab",
      "english": "I win. Natural result, really.",
      "translator_note": null
    },
    {
      "id": "msb_00055F80",
      "source_words_sha256": "c5b0ec8ac57a8949f31c44be42c19719f0dccbb48f12b5ccabf75e52bf68f5e8",
      "english": "Now talk. What are you planning? Why Gin Tama?",
      "translator_note": null
    },
    {
      "id": "msb_00055FD0",
      "source_words_sha256": "7b697b1fc19eb4762aca9b92d905561fa5cfd9b8ebf9f08f597c6ff4b4778886",
      "english": "Hey!",
      "translator_note": null
    },
    {
      "id": "msb_00055FD8",
      "source_words_sha256": "471ac0b31ce46722a99de9fe0886f443817ed4ef9c7f3e58e02c200e5b045e67",
      "english": "...Zura.",
      "translator_note": null
    },
    {
      "id": "msb_00056008",
      "source_words_sha256": "f4a2d11b81f3a4b23abe20b0f852163c3f81e8329b196c0eeedaba7f0eb4d26e",
      "english": "Ngh...!",
      "translator_note": null
    },
    {
      "id": "msb_00056030",
      "source_words_sha256": "fef0e30cd7380129e551e8506bde0032abe45fa1f07fb53a11713d1e5eafbcf6",
      "english": "Sorry, Gintoki! Still... I still can't tell you...",
      "translator_note": null
    },
    {
      "id": "msb_00056074",
      "source_words_sha256": "986338835edc661798386f0daf45e68581d8439a3ea4fc5836b546226938a6d7",
      "english": "Say what you like. Can't tell you yet.",
      "translator_note": null
    },
    {
      "id": "msb_000560A8",
      "source_words_sha256": "0fe9ffc2b90657696dce407ec792255e58cd9e60536053726c15502402c91bdd",
      "english": "But believe this one thing, Gintoki.",
      "translator_note": null
    },
    {
      "id": "msb_000561B8",
      "source_words_sha256": "ed9cecb04030bc7a8f78f164e1da49244271f1720aaa80f2eefe5f6493f13038",
      "english": "Before I go... One question, Zura.",
      "translator_note": null
    },
    {
      "id": "msb_000561F4",
      "source_words_sha256": "0f7f0a9db91c75d29b6d9bfd1f749fb202747b7d16e3a7eceb524f4749f39b0f",
      "english": "You're sure this isn't... anything shady?",
      "translator_note": null
    },
    {
      "id": "msb_000562A0",
      "source_words_sha256": "086a21fa53ddd028f8844bfa41d39ce4910a78ae10250fb99bb6c7187c3b2a53",
      "english": "What?",
      "translator_note": null
    },
    {
      "id": "msb_000562AC",
      "source_words_sha256": "fefa373a48dbb3800011d9b285d88957017b9075b10117a54c36efaf23c09675",
      "english": "...Believe this, Gintoki.",
      "translator_note": null
    },
    {
      "id": "msb_00056338",
      "source_words_sha256": "3ea35a3ea805cf64afb0bb8445245b04eb83b0ae13498f2fface07c05916260d",
      "english": "G-Gin lost!",
      "translator_note": null
    },
    {
      "id": "msb_0005635C",
      "source_words_sha256": "2800b931f81e739746a144d08da14ee958a90882dda5ffab40c814c3493392a6",
      "english": "You're okay with that?!",
      "translator_note": null
    },
    {
      "id": "msb_00056374",
      "source_words_sha256": "a7398e26a1af9689898c02617d4eed4221f1c8285f8ce3f7bfcede21f7f495aa",
      "english": "...Then why do shady deals with this idiot?",
      "translator_note": null
    },
    {
      "id": "msb_000563D4",
      "source_words_sha256": "05c782f1207860802f11c3f65c8390b333cbb090a0fad3833945fe10ceae90a9",
      "english": "Fine! What a pain! I'll pretend I saw nothing.",
      "translator_note": null
    },
    {
      "id": "msb_00056418",
      "source_words_sha256": "a050087980b93b53d31e9a6b35292f055dacefacca623939ec71b5df33bdafae",
      "english": "Business done? Then come on, idiot prince. Let's leave.",
      "translator_note": null
    },
    {
      "id": "msb_00056468",
      "source_words_sha256": "ebef6f93b9a6f81c17229021ad9eb3ad7fe6a88eb50385ec40f88498ab537edc",
      "english": "Hmph. Can't stand this wighead... But he's never been able to lie.",
      "translator_note": null
    },
    {
      "id": "msb_000564CC",
      "source_words_sha256": "05633427a7ccbb41ccb820fc26626c3569eaf2b22b41c1f443ec480e176afb85",
      "english": "Let's go, Shinpachi! Kagura! Idiot!",
      "translator_note": null
    },
    {
      "id": "msb_000565AC",
      "source_words_sha256": "01ab2821cdc4492b592eaf00925ae8d02f042879508759d6e995937f0267512e",
      "english": "That's greed for you! Already rich, too!",
      "translator_note": null
    },
    {
      "id": "msb_000566E8",
      "source_words_sha256": "e425fc4ffdaca5b5e944cc1d0523869b528907c1b519ce3c8a5d6d730d35bcda",
      "english": "Tch! If you're playing hero, say so first!",
      "translator_note": null
    },
    {
      "id": "msb_0005672C",
      "source_words_sha256": "953e04ffbc10e9349ed35573b8268dfc0460e6f6d2a87a27e48d9134d9c821dc",
      "english": "...Tch. Hey, idiot prince. Stay a little longer.",
      "translator_note": null
    },
    {
      "id": "msb_0005676C",
      "source_words_sha256": "c42fd434bf2271b64c4df9fe01fe1ce1f72359362e08e7c8489a8cb45c9f4d26",
      "english": "Letting the big fish go. Least we can give them a consolation prize.",
      "translator_note": null
    },
    {
      "id": "msb_000567BC",
      "source_words_sha256": "de6c71f3b2a30f55cd919276dfdec43cd833e1f31da7254cb13cc220ed286349",
      "english": "Back to the room! Got it, you two?",
      "translator_note": null
    },
    {
      "id": "msb_000567E4",
      "source_words_sha256": "f216a3eded6b207327d991ddfb0a6ea5a4e51ce16f0a0b28cdaff81687929431",
      "english": "Called me an idiot again!",
      "translator_note": null
    },
    {
      "id": "msb_000567FC",
      "source_words_sha256": "e2854f3798680fa6bc85848679483a4bcc47cce4f80ff34a57c6475b753a4834",
      "english": "A-again with the idiot...!",
      "translator_note": null
    },
    {
      "id": "msb_00056820",
      "source_words_sha256": "594b6f5c2d5bd3d5061a454d8d936e413c6d1d4a2697adaae602c92b4ad5952e",
      "english": "Came to sell Gin Tama. What a disaster!",
      "translator_note": null
    },
    {
      "id": "msb_000568C4",
      "source_words_sha256": "03779677093015ac47563a7fbe2b1bd990205c95c02c89d4f265dc751b796c0b",
      "english": "If I could, there'd be no trouble!",
      "translator_note": null
    },
    {
      "id": "msb_000568F4",
      "source_words_sha256": "b4fbdece31b99256186d6da341336fb19b8275b3b71ea7024d46c7817b556214",
      "english": "W-why?! You just told me to leave...",
      "translator_note": null
    },
    {
      "id": "msb_00056930",
      "source_words_sha256": "23c533fc98a4bcf29df862dee5234dfda595aa59b5929b1488b9baf7ab4fc519",
      "english": "Big fish? Escape? Prize? What are you saying?",
      "translator_note": null
    },
    {
      "id": "msb_00056964",
      "source_words_sha256": "9dd2e4b2f5c0154b3458227dd3351ae4e5eb31dedbaaec1992423011df3f72a8",
      "english": "Prince, quiet. This is the good part!",
      "translator_note": null
    },
    {
      "id": "msb_000569DC",
      "source_words_sha256": "82d787079d6664d33fe6765722f106778dc8fd15d25693a1d490b478d5510eda",
      "english": "What's taboo? Tasty?",
      "translator_note": null
    },
    {
      "id": "msb_00056A04",
      "source_words_sha256": "09d1bcb6a81d1b45c73d0bf330f3e23beabb1ed6e68b652c55375995eff5446f",
      "english": "Right on!",
      "translator_note": null
    },
    {
      "id": "msb_00056A18",
      "source_words_sha256": "5ba2043233a40e3811cf03ab57411bf0469bd79b3b6784bceca3facc9a9305e0",
      "english": "...Everything I do is for this country!",
      "translator_note": null
    },
    {
      "id": "msb_00056A54",
      "source_words_sha256": "5023edccd5785d3457441c02c54167e3c59cd9d1c2f0845e9f425a1e3237e23f",
      "english": "So, Gintoki...",
      "translator_note": null
    },
    {
      "id": "msb_00056A70",
      "source_words_sha256": "c12b7335bc7d052e6a81794d25fece7878d502688b122cbb29734081361443e7",
      "english": "...!",
      "translator_note": null
    },
    {
      "id": "msb_00056A98",
      "source_words_sha256": "06fb37a78e69330b36296d68ccb07ae828e4d464fe7b5f56d49cece3a11cd046",
      "english": "...I owe you.",
      "translator_note": null
    },
    {
      "id": "msb_00056AB0",
      "source_words_sha256": "f884bf5a62721a2c3e3fd57aeb7a60aa0a3bf106317250d384bd2916b7db2b73",
      "english": "...Oh, Gintoki!",
      "translator_note": null
    }
  ]
}
