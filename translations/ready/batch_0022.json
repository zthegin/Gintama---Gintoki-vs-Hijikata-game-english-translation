      "translator_note": null
    },
    {
      "id": "msb_00055D2C",
      "source_words_sha256": "35a92890c820fdfa21d041c421b078608b726961128336ca2ad3ddcc4bffd3ab",
      "english": "Yes! Thank you!",
      "translator_note": null
    },
    {
      "id": "msb_00055D54",
      "source_words_sha256": "8150595c519f59012615ce36697d8040d89475d7dac4c43129ed6965eb9368c2",
      "english": "Kondo's hurt too... I'll go with them, Hijikata.",
      "translator_note": null
    },
    {
      "id": "msb_00055D98",
      "source_words_sha256": "0e121eee211b752c016c5e5138658c0d173baa5c0b6d09bcbeb538fac8931977",
      "english": "Now, now. Let's say you both beat it.",
      "translator_note": null
    },
