      "id": "msb_0005594C",
      "source_words_sha256": "161b63b0e95f9d9a86defc2801d3643a4a4b7f8ac31302cd6d3bc818c085d430",
      "english": "How should I know, idiot?!",
      "translator_note": null
    },
    {
      "id": "msb_00055964",
      "source_words_sha256": "ed3c5082b996a097717022298807c91505bddb8c543f7283482545bd53c30599",
      "english": "Don't wanna hear it either!",
      "translator_note": null
    },
    {
      "id": "msb_00055984",
      "source_words_sha256": "7b4d97607e8f8803b714e2e85fbf1b3fe5eddc92180f991af9c62c0d58fb13f9",
      "english": "Hm? Aaah!",
      "translator_note": null
    },
    {
      "id": "msb_0005599C",
