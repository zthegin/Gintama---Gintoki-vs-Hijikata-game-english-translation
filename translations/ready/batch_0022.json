      "english": "The old man's gone?!",
      "translator_note": null
    },
    {
      "id": "msb_000559B8",
      "source_words_sha256": "2b995b282745fdd7a43f96c6b5182a870d737009a63d2df85252b813cab7e332",
      "english": "You... Did that on purpose to let him escape...?!",
      "translator_note": null
    },
    {
      "id": "msb_000559FC",
      "source_words_sha256": "4dbee776b96555a5cd1a021f24715259fa45a8ca131f5178c163400c385fd9b3",
      "english": "Tch! You bastard!",
      "translator_note": null
    },
    {
      "id": "msb_00055A14",
      "source_words_sha256": "c2bf6dd2dbd8e398a62f92412390f13fe4e44383989562e26841d46effed4f68",
