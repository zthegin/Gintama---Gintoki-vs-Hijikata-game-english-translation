      "id": "msb_00055BDC",
      "source_words_sha256": "78b28941d5c654fad0669eaf88de9ad4fe50f0a363b6ec827da8f6f2da874034",
      "english": "Oh, no... Nothing.",
      "translator_note": null
    },
    {
