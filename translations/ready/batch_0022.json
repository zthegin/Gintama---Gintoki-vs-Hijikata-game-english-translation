      "english": "W-what?! Don't shout all of a sudden!",
      "translator_note": null
    },
    {
      "id": "msb_000558A0",
      "source_words_sha256": "ee9a1c66dd4b3006f508562fff2a41dc1522eb70841722ca9e0f8be467a88977",
      "english": "What? Something important?",
