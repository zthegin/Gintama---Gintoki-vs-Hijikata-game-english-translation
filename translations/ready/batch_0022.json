      "english": "W-what? Need something...?",
      "translator_note": null
    },
    {
      "id": "msb_00055C78",
      "source_words_sha256": "b9a0720bcc2a9d4192c965d5debbb07c7f0d6917df58db342a87d5b0a73f08f6",
      "english": "Otae! Are you hurt?!",
      "translator_note": null
    },
    {
      "id": "msb_00055CA4",
      "source_words_sha256": "3fadad169f82739ddba32360d8fab185a701d8772f26318f55a87599e593b1f8",
      "english": "Thank goodness! Otae's safe! What a relief!",
