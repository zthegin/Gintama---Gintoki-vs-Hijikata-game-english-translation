      "english": "Remember.",
      "translator_note": null
    },
    {
      "id": "msb_000556BC",
      "source_words_sha256": "432473724d8f344e823ecd7f696178aff8a4c779c01197273a48a61dc485841a",
      "english": "Saburo? This contraption?",
      "translator_note": null
    },
    {
      "id": "msb_000556DC",
      "source_words_sha256": "192b0f96bb639e346ff02b2da4b869a860d1bf73da7e3bd08912f4d5f9a40929",
      "english": "Hey. What's going on?",
      "translator_note": null
    },
    {
      "id": "msb_00055710",
      "source_words_sha256": "f5d8d0cdab8dc26291b3c169782134a7789bf8bcac745faf1f357c8aad80b36b",
      "english": "Been attacking Gin Tama owners since last night.",
      "translator_note": null
    },
    {
      "id": "msb_0005573C",
