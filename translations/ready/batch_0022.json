      "english": "Nonsense! Impossible!",
      "translator_note": null
    },
    {
      "id": "msb_00055AF0",
      "source_words_sha256": "42b86ffde2e2af7fafe704c1020262ffdc58877f4436d893a76f3466b19c652e",
      "english": "Can't believe it... Saburo had such a kind heart...",
      "translator_note": null
    },
