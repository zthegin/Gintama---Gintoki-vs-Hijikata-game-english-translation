    },
    {
      "id": "msb_00055750",
      "source_words_sha256": "a22fb89c0e5a2ce1f637c6ee14db52fdf0b21eee75a505285b2fb5321018f261",
      "english": "A reason? Nonsense! Broke and went berserk!",
