      "translator_note": null
    },
    {
      "id": "msb_000340A0",
      "source_words_sha256": "d3ac10d2a1ea8fba709dd2139c13a39205e752347cb24704c70b919e6d01da72",
      "english": "Where is he?",
      "translator_note": null
    },
    {
      "id": "msb_000340B0",
      "source_words_sha256": "099e4ca7f62b561dc872c670e1e82246a12ba446faf12d397cee585f6b1fbb59",
      "english": "This isn't a false lead, right?",
      "translator_note": null
    },
    {
      "id": "msb_000340CC",
      "source_words_sha256": "9c0e64bceb493832c9b1e3fac4b48f0e3827038831537308dd3e4f85b71253b3",
      "english": "How do YOU know, Zura?",
      "translator_note": null
    },
    {
      "id": "msb_000340EC",
      "source_words_sha256": "ca6668542b9ee12ffb6e216c14361d7c18540de1c595bba05376819b740cc7f5",
      "english": "Hmph. Fine.\fShinpachi! Kagura! Let's go.",
      "translator_note": null
    },
    {
      "id": "msb_00034114",
      "source_words_sha256": "222a6d3c35302b213700798f9f8522fc835ee7468e02db3ea9c87b1fe66c8842",
      "english": "You WERE making shady deals!",
      "translator_note": null
    },
    {
      "id": "msb_00034134",
      "source_words_sha256": "ddbc551d954768fcba90cf0f486334e35511c38e35d4bffc39e1b2bfd741394e",
      "english": "I'll come back!",
      "translator_note": null
    },
    {
      "id": "msb_00034148",
      "source_words_sha256": "947edacb3f91f67106f4e49ee877b350898b992fc061a1a405133e085b98f929",
      "english": "That, I know.",
      "translator_note": null
    },
    {
      "id": "msb_00034160",
      "source_words_sha256": "aec41581533d71adcbb9b2c3e44b8c86337d00aa6134045da70e9c96b902e11a",
      "english": "Not Zura! Katsura!",
      "translator_note": null
    },
    {
      "id": "msb_00034178",
      "source_words_sha256": "ac24fbcb3bee29ea15bb7de86bfedc185baf82f15a7c72983b163cdb5d6dbe18",
      "english": "A customer. So?",
      "translator_note": null
    },
    {
      "id": "msb_000341B4",
      "source_words_sha256": "f72d804c5d1a85734e013baba1364c896df76d4395f081b5eaf96f7fd3eb8762",
      "english": "You mean, PLEASE tell me?",
      "translator_note": null
    },
    {
      "id": "msb_000341D0",
      "source_words_sha256": "1dfe9475f172b89f7ef8ae1383407c4c8d979fbf077812e32cc6104961a94701",
      "english": "What? Can't say it?",
      "translator_note": null
    },
    {
      "id": "msb_000341EC",
      "source_words_sha256": "ae4e2c27f6e42c229514b53a6b012a8c6e1f57914efa2080abbe4af8e432edd2",
      "english": "Good. Very well.",
      "translator_note": null
    },
    {
      "id": "msb_00034200",
      "source_words_sha256": "300adea6c7a719ecef465215e76cc00d9244ec2a59ce41fe108e98b2ee8f9b65",
      "english": "The broker's an Amanto.",
      "translator_note": null
    },
    {
      "id": "msb_00034240",
      "source_words_sha256": "1f5e053a8c0d4212db459b8df5e70f65dea8ca868e1c4ceb21e1db9525704dbe",
      "english": "True.",
      "translator_note": null
    },
    {
      "id": "msb_0003424C",
      "source_words_sha256": "1ffacd945a4bff106a538fff04c58ab5535e7aab47c8c33f2c43e4ffcbed6dd7",
      "english": "Can't say now. That's all.",
      "translator_note": null
    },
    {
      "id": "msb_00034268",
      "source_words_sha256": "e48075adaf72c07eb042f810099a43a1e6722cb5f43ce053eaa3c1ddbe39057b",
      "english": "I give up!",
      "translator_note": null
    },
    {
      "id": "msb_0003427C",
      "source_words_sha256": "98cc9915550b6b2ce51d8a83c97dbc0635e10774d80b2764da2e22b3beb320b0",
      "english": "A-all right... I heard there were shady Gin Tama deals here.",
      "translator_note": null
    },
    {
      "id": "msb_000342C4",
      "source_words_sha256": "3b4fe4696b64be0a965fa68575f7ac88921ed1e98a9e2765ddc79c8da0e9f6c8",
      "english": "Don't know! Really!",
      "translator_note": null
    },
    {
      "id": "msb_000342E4",
      "source_words_sha256": "e3ef9981ee2eac0a7b47355c62936ed92a35af427dd3ae176f919b590b332966",
      "english": "I must collect seven Dragon Tama.",
      "translator_note": null
    },
    {
      "id": "msb_00034304",
      "source_words_sha256": "610cc5349c5fb97f0d7f9e7b74252ee407614c4b6bb8b39763e97856b9955a10",
      "english": "They say you can get a fine sword!",
      "translator_note": null
    },
    {
      "id": "msb_00034328",
      "source_words_sha256": "8c9a65fd2bc40831abefeac4ab7e4145c4805a72a92d24aea89385a8c28f296c",
      "english": "All right... Sorry.",
      "translator_note": null
    },
    {
      "id": "msb_0003434C",
      "source_words_sha256": "1f9ba3462d9ae9929ebde879d58411a64b01c486d56e96fe9a54109c82ddcb17",
      "english": "What?! Nobody told me!",
      "translator_note": null
    },
    {
      "id": "msb_0003436C",
      "source_words_sha256": "bf8d36bff5ec98bb8a5ed776e5dd303d2645173b232b18093f1a5bc1c1addf96",
      "english": "What's going on?",
      "translator_note": null
    },
    {
      "id": "msb_00034384",
      "source_words_sha256": "18fc8b03ddba07186797661ccc096ecf0b9185eb9288f01b589a473b6e443207",
      "english": "No causing trouble in my club.\fSorry, you'll have to leave today.",
      "translator_note": null
    },
    {
      "id": "msb_0003444C",
      "source_words_sha256": "2f89c172aa80b0e09e3dabfa5b13e10c995ca4ec2d4c627d809f65fac68661d6",
      "english": "Who knows...",
      "translator_note": null
    },
    {
      "id": "msb_00034460",
      "source_words_sha256": "5cb23179a163a0888ff7d0f1278b250a25bad75b7c75cf20ab5caf46822be79c",
      "english": "Don't bother.",
      "translator_note": null
    },
    {
      "id": "msb_00034474",
      "source_words_sha256": "b71b08ca79d269caad9f3c0691b92863347aeb5ab3db06af532405ac35b0cef0",
      "english": "Really?!",
      "translator_note": null
    },
    {
      "id": "msb_00034484",
      "source_words_sha256": "cf118da5ea4133ef0bf53269a58700e4c44e02f8117e76d2958af584d2a70f3b",
      "english": "Been here all along!",
      "translator_note": null
    },
    {
      "id": "msb_0003449C",
      "source_words_sha256": "b41c3ef66acf30a89ee2147af4f133b6c65e564360c9c72013f5ee893f3bac50",
      "english": "What?! Katsura?!",
      "translator_note": null
    },
    {
      "id": "msb_000344D4",
      "source_words_sha256": "d7d0db83cd91f6a5792c03c5b4fb026fa9964337d774a69f1fe563f996e844a2",
      "english": "Finally know where the broker is.",
      "translator_note": null
    },
    {
      "id": "msb_00034520",
      "source_words_sha256": "7d72bf1179bbb861d37238039f63aba03b2606196c8d4f8863b06cd72062de6a",
      "english": "My dream'll come true tonight.",
      "translator_note": null
    },
    {
      "id": "msb_00034540",
      "source_words_sha256": "a44520dd3431d1e7122b6503ffef1f01231f13915e4de417959e0961fee8d6bd",
      "english": "Hurry, before the Shinsengumi beat us there!",
      "translator_note": null
    },
    {
      "id": "msb_0003456C",
      "source_words_sha256": "188e51c2ac7e1c73f9091d699fa3f60e47d49a3e3f42fbb657a95a60500a1b31",
      "english": "Gwaaah! I lost!",
      "translator_note": null
    },
    {
      "id": "msb_00034590",
      "source_words_sha256": "58dda17fb54fa0d016484a83d50f50db864c66da368b8c26cf335c074ff2daf9",
      "english": "Not the wooden sword!\fWithout it, Gin just isn't Gin!",
      "translator_note": null
    },
    {
      "id": "msb_000345D0",
      "source_words_sha256": "f9256974e9b469d20dae6d154653f17e6fb6e869523e18de41066b9e9b97d77c",
      "english": "Ginpachi-sensei of Class 3-Z.",
      "translator_note": null
    },
    {
      "id": "msb_000345EC",
      "source_words_sha256": "98dea1225312f703e9efb0ad94d5292009feab2db94e0535e34b0a58233a172d",
      "english": "Gin, you idiot!",
      "translator_note": null
    },
    {
      "id": "msb_00034608",
      "source_words_sha256": "0ae8ae240b55fa46e705c69e59365660e2ab8178147cf3e94270b8828aad9a92",
      "english": "Yeah! That wouldn't be Gintama!",
      "translator_note": null
    }
  ]
}
