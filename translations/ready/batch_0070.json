      "id": "msb_000F94E4",
      "source_words_sha256": "9216f87e46499f1dedc777443be00071c8783b599ad680d27aec051b01dbb8de",
      "english": "Still playing champion here?!",
      "translator_note": null
    },
    {
      "id": "msb_000F9588",
      "source_words_sha256": "9cee88dab19f83675099fadafdff73f7fae47dc1c99b715ee34391d77a99bbf3",
      "english": "Don't get smart! Let's go, Sougo!",
      "translator_note": null
    },
    {
      "id": "msb_000F96C0",
      "source_words_sha256": "2f98b85bcd7f2081dd4c5dc4199b3a3f2660d1866dc58a3c9567dc1a9aa89e77",
      "english": "Oh, it's you again, Hijikata.",
      "translator_note": null
    },
    {
      "id": "msb_000F96F8",
      "source_words_sha256": "7b60104c1426fa9b173ce1b8b171c6a03c49b4caf28c7d7b073a73eae57b0cf9",
      "english": "Coincidences keep coming.",
      "translator_note": null
    },
    {
      "id": "msb_000F9718",
      "source_words_sha256": "f5a87076e178c81b68ca4ee08c27e8996e73785b2378a36b83120227c5dbe590",
      "english": "Felt like it... Good benefits here. Considering a career change.",
      "translator_note": null
    },
    {
      "id": "msb_000F9770",
      "source_words_sha256": "2507667d5575d4eb5924acd32c7330d0111310ad2aad0881e64c65f8d84af55b",
      "english": "Want a fight? Won't hold back, even against you, Hijikata.",
      "translator_note": null
    },
    {
      "id": "msb_000F97FC",
      "source_words_sha256": "bb09838b6990fab99915dbfdc0e2aeff36b65caa2bec342bc10be91c405bc690",
      "english": "Honestly! What a bastard!",
      "translator_note": null
    },
    {
      "id": "msb_000F9874",
      "source_words_sha256": "e9b0db1afc04fef860bd3e85ed6bceb55593c66987c73bde97526276a819c005",
      "english": "Hmm... Looks like ordinary Gin Tama.\fI'll try it someday if I get the chance. Oh, and...",
      "translator_note": null
    },
    {
      "id": "msb_000F98F8",
      "source_words_sha256": "a32c1624c8f08f5315dfe2b5ae6d86ba85cfb490d944097b7937e953a093d86e",
      "english": "I'll let it slide today... Get too flashy and I'll arrest you someday!",
      "translator_note": null
    },
    {
      "id": "msb_000F99BC",
      "source_words_sha256": "5af731d50255d15bc817480723df312d678c4c235a92ac1f32e7a3429c24d301",
      "english": "See ya, then!",
      "translator_note": null
    },
    {
      "id": "msb_000F9ADC",
      "source_words_sha256": "b6422b87ed45475ef7b4bfec25d4c3c293a225b29c421f2375096cd1273f30bb",
      "english": "Huh? Arrest?! ...Wait, are you... the police...?!",
      "translator_note": null
    },
    {
      "id": "msb_000F9B3C",
      "source_words_sha256": "208e559fd29df7dd11dce51aae770e559647a417bf41e2844a3b9e9bc557cb6e",
      "english": "Ahh, lost. You're strong, Hijikata!",
      "translator_note": null
    },
    {
      "id": "msb_000F9BB0",
      "source_words_sha256": "f69dcc24823e0163c94ae82d1d94ded662a8e27cdf34350020d797a099156ee7",
      "english": "Of course. Kondo worries too much.",
      "translator_note": null
    },
    {
      "id": "msb_000F9BDC",
      "source_words_sha256": "2b1b98d289331d6ca21253603aae86fb7a0759d499d4f83b14000cc6059d3b02",
      "english": "You! Sougo!",
      "translator_note": null
    },
    {
      "id": "msb_000F9BF0",
      "source_words_sha256": "2303b0de2d3e9230e2a3c717beadeaa9821d66149cc252279cdeb9b51f82cdef",
      "english": "Don't laugh! Turning on me out of nowhere! You absolute idiot!",
      "translator_note": null
    },
    {
      "id": "msb_000F9C38",
      "source_words_sha256": "c7e6252bf2dac49c3249033e6ae3241fa05c9efc7bb4ed10509cfa143c5a992d",
      "english": "You're living all wrong! I'll make you see that someday!",
      "translator_note": null
    },
    {
      "id": "msb_000F9CF4",
      "source_words_sha256": "2b13d68f4cf89f610a6af0e020f15b5a20fdc75e85bff9206e2e266b977deec8",
      "english": "Oh! Toshi! You're safe!",
      "translator_note": null
    },
    {
      "id": "msb_000F9D18",
      "source_words_sha256": "7d79a956b4db51505b13d9b092138ec6f22e25e759ea65f6e49222642ff5f021",
      "english": "Hey, Toshi!\nWait! Don't leave me!",
      "translator_note": null
    },
    {
      "id": "msb_000F9D80",
      "source_words_sha256": "8f1468dd56284f88572739b262aec2ab8b13fe55870c0240b6f53550705206ec",
      "english": "Welcome back. Haha...",
      "translator_note": null
    },
    {
      "id": "msb_000F9E14",
      "source_words_sha256": "29dd302ead70d0cc61a1b98dc4a50d3f40e1ffb5307f235dfa76cbf571b88570",
      "english": "What a short fuse. Needs more calcium...",
      "translator_note": null
    },
    {
      "id": "msb_000F9E6C",
      "source_words_sha256": "6a2cbbdb47bef125f51c925aa922e553b003c723d3d716264eae82c1a0dd0fa5",
      "english": "Damn! How could I lose to that empty-headed Sougo...?!",
      "translator_note": null
    },
    {
      "id": "msb_000F9EEC",
      "source_words_sha256": "274909511a3513132f12ee677670df07117554cee06e6597013975669e98e5d3",
      "english": "After a while? What's that mean, Sougo?",
      "translator_note": null
    },
    {
      "id": "msb_000F9F48",
      "source_words_sha256": "9f7c31c419a742c5dfa2ea3cc4f90d837ecb3dfbe58395cfa679c7a51401a4dc",
      "english": "YOU'RE the cruelest one!",
      "translator_note": null
    },
    {
      "id": "msb_000F9F70",
      "source_words_sha256": "583970faca510e529ae1f7e6ad717f6f6f10b10fecccb1a26c50ac3548feb891",
      "english": "Looks like I win.",
      "translator_note": null
    },
    {
      "id": "msb_000F9F8C",
      "source_words_sha256": "7dca385c780693a85fc308f907d75082020f96a843f8e37b58f174892c8038ac",
      "english": "Luck of the draw... Let's say you were unlucky this time.",
      "translator_note": null
    },
    {
      "id": "msb_000F9FE4",
      "source_words_sha256": "555e24b8cee69f51e45622751dba57cf8f282f302e12899ad6d1bb3770e62143",
      "english": "So try again later... After a little while.",
      "translator_note": null
    },
    {
      "id": "msb_000FA040",
      "source_words_sha256": "052ed0686ce9eba8f3effbf3d2aa4d07019f564b4fad42b3328b236dbc24cfe8",
      "english": "...Game over. My condolences...",
      "translator_note": null
    },
    {
      "id": "msb_000FA080",
      "source_words_sha256": "e90a83888213ccc2b1eaae48193471c957d751d5ac7b0bb9a72d58c789061596",
      "english": "Blame this cruel world, if you must.",
      "translator_note": null
    },
    {
      "id": "msb_000FA180",
      "source_words_sha256": "ccd274a18d83d35804e3e1651a3197584ea49b20b73f8558db8783df43a9e492",
      "english": "Why?",
      "translator_note": null
    },
    {
      "id": "msb_000FA190",
      "source_words_sha256": "4cbeb8c79fd300031407246728a3ee9b5411c45a1ce2f36baed25e0189f27005",
      "english": "What does that mean?",
      "translator_note": null
    },
    {
      "id": "msb_000FA1A8",
      "source_words_sha256": "284a55520b2ec5dcc481121d48657b7fc7032d050492dde4dbe9b2244ab6a6b8",
      "english": "Not what you said! Mocking me, bastard?",
      "translator_note": null
    },
    {
      "id": "msb_000FA1D4",
      "source_words_sha256": "9f7afddd4481a0227cbbff20e36409aa0231edcf3f463c5c4b837c7db8fee7a3",
      "english": "What?! Hah! In for a penny, in for a pound!\fOne challenger? I'll take any number!",
      "translator_note": null
    },
    {
      "id": "msb_000FA250",
      "source_words_sha256": "4d109c9bc0283756f212dc0968658ec121f15c9a0b12d5abc7c57b1eff449eec",
      "english": "Come on, late entrant! Get out here!",
      "translator_note": null
    },
    {
      "id": "msb_000FA4D0",
      "source_words_sha256": "3b88a22c67ea76e8b037ddfda9a1ecff82985464d694e97cba7c40b71519c8b0",
      "english": "You?! ...Takasugi! Shinsuke Takasugi!",
      "translator_note": null
    },
    {
      "id": "msb_000FA520",
      "source_words_sha256": "4ee14d5ba069263b2d01c75729871a37efb7dbfdf360f62f51bd43be9dc2a792",
      "english": "Takasugi... Just showing up like this? Think you'll leave in one piece?",
      "translator_note": null
    },
    {
      "id": "msb_000FA578",
      "source_words_sha256": "a99d348a48b23c0556cb0d1e592416630dad7ffc49f2f84ae482ae2d1abbba0d",
      "english": "...Fine. First, I'll beat you in a Gin Tama battle...",
      "translator_note": null
    },
    {
      "id": "msb_000FA5C8",
      "source_words_sha256": "de96bbcd29976dfe06a3dd3c9dc867051fd4420ae588d3810338fbc1f0d7d61d",
      "english": "Then I'll tie you up!",
      "translator_note": null
    },
    {
      "id": "msb_000FA5EC",
      "source_words_sha256": "d7dcf6f76e0f5a4b0cb2ed91aa35938727c72a1f81e901ef17d0756ea3bf8bd4",
      "english": "Hmph. Do your best.",
      "translator_note": null
    },
    {
      "id": "msb_000FA604",
      "source_words_sha256": "5412f26759ef8e9bd00ad1edaf9c486caa5539e3888154e50f1610bb955ebd72",
      "english": "...Been a while.",
      "translator_note": null
    },
    {
      "id": "msb_000FA7B8",
      "source_words_sha256": "d261cb1ea81fae9fae7a24dd324528607eac53bc71dfce53e29928d216192805",
      "english": "S-Shinsuke Takasugi! Still hanging around here...?!",
      "translator_note": null
    },
    {
      "id": "msb_000FA7F0",
      "source_words_sha256": "0a427bf551b0fbda8451be904871f21fb93ab20522f4db4be20f9adf75d3b5da",
      "english": "What the hell are you thinking?",
      "translator_note": null
    },
    {
      "id": "msb_000FA860",
      "source_words_sha256": "63000def998fcbbe6d20c89f7b9a2abac0251f6e295a8fe72fe4f78c20d382f0",
      "english": "Keep talking... Let's go!",
      "translator_note": null
    },
    {
      "id": "msb_000FA89C",
      "source_words_sha256": "bd67b9a27cea46bf248304759b5e93409ae1944d27194ce7d41b973718f6f37d",
      "english": "...Meet again, shogunate dog.",
      "translator_note": null
    },
    {
      "id": "msb_000FA928",
      "source_words_sha256": "f16daa1bf685579ee5c29ae891f4907de6391f372285960ba2e16376c7375dd3",
      "english": "Heh... Can a shogunate lapdog manage that...?",
      "translator_note": null
    },
    {
      "id": "msb_000FA96C",
      "source_words_sha256": "2f01872e31d9f04721f62082efe86007cfd297eb1b2e24be1c70ecaddda58c2d",
      "english": "You lose, Takasugi.",
      "translator_note": null
    },
    {
      "id": "msb_000FA984",
      "source_words_sha256": "b780f054f1f385759016507d48585f1534e992eeb24351a3af7aff51d71f2b6d",
      "english": "Better than a stray that can only bite and spout selfish excuses.",
      "translator_note": null
    },
    {
      "id": "msb_000FA9CC",
      "source_words_sha256": "2a8923430925fec1c56c053f32973361c7fabbd317a19e5ffe5f2ee2f6336e78",
      "english": "Wait! Like hell I'll just let you go!",
      "translator_note": null
    },
    {
      "id": "msb_000FAAFC",
      "source_words_sha256": "778e38e9705e7590e32bb8205a440575c9d08754c1cc5f91151524a4eb163971",
      "english": "Quiet! I'm in a bad mood! Hand over the prize!",
      "translator_note": null
    },
    {
      "id": "msb_000FAB44",
      "source_words_sha256": "d287390ea5f72731660bde1bbd491b8e7ea8d0142a2c35ddc735b734241cd82c",
      "english": "...I'll try it someday, if I get the chance. Oh, and...",
      "translator_note": null
    },
    {
      "id": "msb_000FADC0",
      "source_words_sha256": "13c96d2a88b311bf3798f9709f4e6e600cae5fbbdbb01597261541e8f40cfedd",
      "english": "...Impressive. Good skills.\fAlmost too good for a shogunate dog.",
      "translator_note": null
    },
    {
      "id": "msb_000FAE20",
      "source_words_sha256": "c9cd8abc0fe0338635e6e9f6f764e9ba0d9d1717420cfc7d386193f4211b8363",
      "english": "Big words... Well, that was fun. See ya, shogunate dog...",
      "translator_note": null
    },
    {
      "id": "msb_000FAF1C",
      "source_words_sha256": "e7e08628fe275a09e731a4e22295a06c51107c4187bc9f2f6f489bcbcdb038bc",
      "english": "Hahahaha! See ya!",
      "translator_note": null
    },
    {
      "id": "msb_000FAF60",
      "source_words_sha256": "0ec91328f39d6d2228257651a60d2806a1ba6cf32c0be257c8c1a8ce49d083f5",
      "english": "...Heh. Looking forward to it.",
      "translator_note": null
    },
    {
      "id": "msb_000FAFDC",
      "source_words_sha256": "5ac166846151eb5ef8966d89d3c9077be10f81960ced863712b53aeff823c7b5",
      "english": "...Refuse and I cut you down!",
      "translator_note": null
    },
    {
      "id": "msb_000FAFFC",
      "source_words_sha256": "6a19728862049c5df3ca2c6560d0d268dbaf956151b2141dabc2dd1a0acec052",
      "english": "What?! What does that mean?",
      "translator_note": null
    },
    {
      "id": "msb_000FB01C",
      "source_words_sha256": "cc9275f5ba5c86a9bd4848a54404fc549039dd74f0e71dbf5b20d7721bd6140f",
      "english": "What?! Such brutally unfair game balance!",
      "translator_note": null
    },
    {
      "id": "msb_000FB058",
      "source_words_sha256": "3c62934c5756a8a38f84e559909ea564052643282cde369f6ecc9199fa8c61a1",
      "english": "Hmph... Sloppy.\fNo cause, no ideals. Just a shogunate lapdog. Fitting end.\fDisappointing. ...Farewell, lapdog.",
      "translator_note": null
    },
    {
      "id": "msb_000FB130",
      "source_words_sha256": "25c3f9c06995ed3c5fbe19cb722773a01cfe42013db21491d31cf3a9d4bcbbc5",
      "english": "Heh... Pathetic. ...Game over.",
      "translator_note": null
    },
    {
      "id": "msb_000FB1AC",
      "source_words_sha256": "4cc8d51fae7c439e79334ac563c61311d592e38aa922ba745819c604195f7fe3",
      "english": "What's this?",
      "translator_note": null
    },
    {
      "id": "msb_000FB1C0",
      "source_words_sha256": "fe43e713199063569fc88abba4585762aa0307a1ba89073ade8b9e1da97b9c97",
      "english": "I can SEE that...\fWas this here before?",
      "translator_note": null
    },
    {
      "id": "msb_000FB20C",
      "source_words_sha256": "5dac2a459a70b200bb49fe179d187a9f516cdbb8631036b7c09918a3b4bb075d",
      "english": "Wrong manga!",
      "translator_note": null
    },
    {
      "id": "msb_000FB22C",
      "source_words_sha256": "ce5489ece2e231c87f924615294609047a558a8ea65557191af32f08e0c8c667",
      "english": "Could it LOOK more like a knockoff?!",
      "translator_note": null
    },
    {
      "id": "msb_000FB250",
      "source_words_sha256": "99364a5a4ea831642b17829e01146287457820767ca8d2afe013b1538e88963e",
      "english": "I see. Bring all seven Dragon Tama here, then.",
      "translator_note": null
    },
    {
      "id": "msb_000FB298",
      "source_words_sha256": "49d708b63a260abe88c81e0f9faa4c47fcfde987f3eb779b7b54cd7371bb6909",
      "english": "Something written here.",
      "translator_note": null
    },
    {
      "id": "msb_000FB2B0",
      "source_words_sha256": "c11d92303abb9f98b4567cfb73b957e7b45e4f0395fb3d26fb996c2f1f5d927d",
      "english": "Dragon Tama?! No! What a waste!",
      "translator_note": null
    },
    {
      "id": "msb_000FB2DC",
      "source_words_sha256": "6201568777b6c41b4c19aa6cd0d9865946c39909786a507161c079d8a437e8b5",
      "english": "Or what? Is this Shenron?",
      "translator_note": null
    },
    {
      "id": "msb_000FB30C",
      "source_words_sha256": "5c08032085d0025f148224b4c14f9f3277166ae7c3030d81725e590943a7ca22",
      "english": "What...?\fSo this dragon is the Dragon Tama god?!",
      "translator_note": null
    },
    {
      "id": "msb_000FB344",
      "source_words_sha256": "118fb22dd20af02e38c75bfcb752c97172b2af5cb01a23cba6ab8fbe413c3a60",
      "english": "Right!\fWait here! I'll gather every Dragon Tama and bring them!",
      "translator_note": null
    },
    {
      "id": "msb_000FB394",
      "source_words_sha256": "3b13324b9c1ea4e325a093d22febf86fbccd05f196ae31893b16e202b34b1e99",
      "english": "A dragon...",
      "translator_note": null
    },
    {
      "id": "msb_000FB3AC",
      "source_words_sha256": "08a187720cf4ae3919b135493de58c381bc81f97a0ff68bcc885b48495a5dc73",
      "english": "Dunno... Probably buried under the scrap.",
      "translator_note": null
    },
    {
      "id": "msb_000FB43C",
      "source_words_sha256": "1dc5c428701b4097841808210943288cc5335d9a8d805b1e55649a6f5be9beac",
      "english": "Close, Kondo.",
      "translator_note": null
    },
    {
      "id": "msb_000FB47C",
      "source_words_sha256": "98264170544f2b3d86f373e855c7ef0df347abcc238c9d5e943d2692f06ae973",
      "english": "...\fName aside, it's clearly linked to Dragon Tama...\fHijikata... Maybe this dragon grants wishes...",
      "translator_note": null
    },
    {
      "id": "msb_000FB52C",
      "source_words_sha256": "b85e132de78633a8ea0f7aceb50f4467c028498031cf336657ac8a56f9231189",
      "english": "Don't know if it's a god, though...",
      "translator_note": null
    },
    {
      "id": "msb_000FB598",
      "source_words_sha256": "4c19a1e32a224556e416e5f979a664f85f5703789c69a22e45881037f56424c8",
      "english": "Wait here! I'll gather every Dragon Tama and bring them!",
      "translator_note": null
    },
    {
      "id": "msb_000FB614",
      "source_words_sha256": "422d2a7f8e3c9d786e7ff2a6f1ed5484fcfecb9531f0d798079fa65a835f1f58",
      "english": "What, Kondo? The Dragon Tama god you've been waiting for!",
      "translator_note": null
    },
    {
      "id": "msb_000FB658",
      "source_words_sha256": "aa7994040c4539a64523a598e729b2781df28d715d15a0d3138b8b181df0dac5",
      "english": "What is it? A dragon, obviously.",
      "translator_note": null
    },
    {
      "id": "msb_000FB69C",
      "source_words_sha256": "9e005b55ff5f2b157b85248d04a132f44f9f80d5cc2850c95f44ca2ad64a662e",
      "english": "Cut.",
      "translator_note": null
    },
    {
      "id": "msb_000FB71C",
      "source_words_sha256": "a30840bfe20a3cb8862211fa4f954fefd34fbbaedb72dbcf220687699f7f308f",
      "english": "Is it that scary?",
      "translator_note": null
    },
    {
      "id": "msb_000FB734",
      "source_words_sha256": "5e00dd6b74db53bf5b28aa16e1cfd0ee193761c58e3a46c900b670caf1c881ba",
      "english": "Well... Time to meet Shenron...",
      "translator_note": null
    },
    {
      "id": "msb_000FB764",
      "source_words_sha256": "c17daf603898341936d80ff496cd543159013634cd04ebbcfab1b4e8cae2c479",
      "english": "S-something's scary about this, Toshi...",
      "translator_note": null
    },
    {
      "id": "msb_000FB818",
      "source_words_sha256": "1bb9d01db18efc1d8a1a33674fc450de2db5174416e97b82b773e5d118598c8a",
      "english": "Maybe... We woke something that should've stayed asleep...?",
      "translator_note": null
    },
    {
      "id": "msb_000FB86C",
      "source_words_sha256": "988bba5fb49e0441433d113796d0016db4a209003c7ccd649c1159a9605993f3",
      "english": "D-\fDEATH NOOOTE!!",
      "translator_note": null
    },
    {
      "id": "msb_000FB8A0",
      "source_words_sha256": "a426069da5217cb9f71e3d03125d832e03734c29051f6a1ef39c6dccf25263f1",
      "english": "SCARYYYYY!",
      "translator_note": null
    },
    {
      "id": "msb_000FB8EC",
      "source_words_sha256": "3ecd40273e593433fec37268e706aba1d6860802a3688b8c54d9d8fcd00ff2af",
      "english": "Don't cut it! That's not what I...!",
      "translator_note": null
    },
    {
      "id": "msb_000FB9B8",
      "source_words_sha256": "90cebd37fac74f632db4656f1192dada47ec85b211eda4d1bae7a7c0538dc2c6",
      "english": "I-\fIT'S HERE!",
      "translator_note": null
    },
    {
      "id": "msb_000FBA00",
      "source_words_sha256": "f4630329a3ca9201a43aed5fcae40cc84a848ff13f9f3a61f1199d1c4a2eff45",
      "english": "R-really taking wishes?\fSo sudden... What do I do...?",
      "translator_note": null
    },
    {
      "id": "msb_000FBAD0",
      "source_words_sha256": "d722203a36bbee33054edaf8718ef1274899678881ab796da4043888da4f9961",
      "english": "What?!",
      "translator_note": null
    },
    {
      "id": "msb_000FBB94",
      "source_words_sha256": "153a618b7f5dba75d5b3051468dbb1924ce0cd4bd1299c598919d9556c12125e",
      "english": "You didn't even SEE it!",
      "translator_note": null
    },
    {
      "id": "msb_000FBBD4",
      "source_words_sha256": "ef0bfe3e8f477d2976929c1901e1709aef7fc89d7f78a5a1e714ffe5fb876748",
      "english": "Kondo. Save that story for later... Come on, Sougo.",
      "translator_note": null
    },
    {
      "id": "msb_000FBC58",
      "source_words_sha256": "38cd4cbf50cf579c197a64106c8058bf48520da4338f2a88b6a182c1269b7cb5",
      "english": "What?! Toshi! What did you wish for?!",
      "translator_note": null
    },
    {
      "id": "msb_000FBC8C",
      "source_words_sha256": "62e93ef1104645e4880a93203e64eeaeb02f7fc9dfe5f7bd616fde4e6657d78b",
      "english": "Hey! No fair, Toshi! WAIT!",
      "translator_note": null
    },
    {
      "id": "msb_000FBCC0",
      "source_words_sha256": "a0b1b4850c1b075f794e2feadb55ba1ff47392c814248dc9ccc7b26c5829eea1",
      "english": "Your wish is granted...\fI return to sleep. If you have courage, gather the Dragon Tama again...\fFarewell...",
      "translator_note": null
    },
    {
      "id": "msb_000FBD3C",
      "source_words_sha256": "f80f28c1ae8a6efcea5bbd82740a081692ad646117fcc3d15050f03a95b11825",
      "english": "...\fWell, that was something.",
      "translator_note": null
    },
    {
      "id": "msb_000FBD74",
      "source_words_sha256": "dbab12612ab77eb8ebd38ce73b5edf33723527f85d9cc8cfed4a4d8415ac7f46",
      "english": "Hijikata muttered a wish.",
      "translator_note": null
    },
    {
      "id": "msb_000FBDBC",
      "source_words_sha256": "7f9b48ac0cce9fed3a3c72346698c1539419f9f587b33655ff5073298ef072ed",
      "english": "...\fDragon Tama collecting's over, then...\fWhat a relief...",
      "translator_note": null
    },
    {
      "id": "msb_000FBEB0",
      "source_words_sha256": "c1b5a73643bc52f0cf9c64a41e175ac75b72f45d370ab5400493b20042444a6d",
      "english": "Hot! My Gin Tama are burning up!",
      "translator_note": null
    },
    {
      "id": "msb_000FC2BC",
      "source_words_sha256": "f63c1214bd10019c2c241cffecee64586be0d2839da6f5dbeeec9d7b30ef2145",
      "english": "Sorry. Can't be bothered, so we're closed today.",
      "translator_note": null
    },
    {
      "id": "msb_000FC4C0",
      "source_words_sha256": "f06b2d5a1f40f4a8fe36d39497283719064d2b993517d1b9ffa9a26613eab404",
      "english": "W... oof...",
      "translator_note": null
    },
    {
      "id": "msb_000FC4D0",
      "source_words_sha256": "df20e8e27511d123a89c861aca94f6010d6987058b058e779613263f50fa17c6",
      "english": "Ahh... So tired...",
      "translator_note": null
    },
    {
      "id": "msb_000FC4E4",
      "source_words_sha256": "cfeba8982f43dcaa343dac2629c23a801206fc471f1613d34ca874ee513c69df",
      "english": "Oedo's scary...\fCan't survive in this concrete jungle!",
      "translator_note": null
    },
    {
      "id": "msb_000FC538",
      "source_words_sha256": "f58814e666b125a5fd1390a3f1dc124afe977d7950b046522902bd6a7f4db0b2",
      "english": "I've got a dream to become a dancer. Won't give up that easily.\fBut... Bought another expensive vase yesterday...",
      "translator_note": null
    },
    {
      "id": "msb_000FC608",
      "source_words_sha256": "1b75dacb367023b332b90b25690b8a377b93444cce8c20ce3401928966f58280",
      "english": "Running's a strategy too!",
      "translator_note": null
    },
    {
      "id": "msb_000FC628",
      "source_words_sha256": "0e9add27354d28aead5c52543d173dd1cbda9c65b1d45edf7fee6d1d6a9cda64",
      "english": "Quick on your feet, huh. Fine. Come back and you're dead.",
      "translator_note": null
    },
    {
      "id": "msb_000FC6E8",
      "source_words_sha256": "1fcaa5ca4fcec5c3b689970fc39e85acb5a3240d478532f4e3c4a0f04e403648",
      "english": "Hey! Are you even the main character?!",
      "translator_note": null
    },
    {
      "id": "msb_000FC948",
      "source_words_sha256": "2ddc0e5fdb1102cf840186ebc62dae1a3a94244b741f72265695bd6d1adb8a15",
      "english": "Hm? Oh! Th-this is...!",
      "translator_note": null
    },
    {
      "id": "msb_000FC978",
      "source_words_sha256": "a7cb7e6a44d2cf357cd3a614322e4785aefc904537ad1f535607e048e295d1ac",
      "english": "DRAGON TAMA GET!",
      "translator_note": null
    },
    {
      "id": "msb_000FC9C4",
      "source_words_sha256": "87a37eafbd9bd9fae4bcdeaaeed17ebcaa41e697bc7e1d53b3d2d7f710bb37ab",
      "english": "Hm? What's this? A Dragon Tama?",
      "translator_note": null
    },
    {
      "id": "msb_000FC9E8",
      "source_words_sha256": "fe22f158a1c0f6e4855a1869692c3a10101be1656770c7dfb74db482bad4eb81",
      "english": "Funny how nobody notices. Guess I'll take it...",
      "translator_note": null
    },
    {
      "id": "msb_000FCB04",
      "source_words_sha256": "d80ca6560a0c6d4217c0d10ded90b5013346f52a20edca0295c3d61ea286c1d2",
      "english": "Nothing suspicious here...",
      "translator_note": null
    },
    {
      "id": "msb_000FCB28",
      "source_words_sha256": "b0a79ac4a2cf5c63fc6fee26f3b0374bf476ca5abaed45ff36c423046452b791",
      "english": "Looks like there's nothing here.",
      "translator_note": "Gintoki inspects an empty spot near the opening."
    },
    {
      "id": "msb_000FCB48",
      "source_words_sha256": "27436114efb0c9bf3a4402e10559e5f058ec2a6f299ad84ab6ae4bd80ee74f5a",
      "english": "Nothing that stands out...",
      "translator_note": null
    },
    {
      "id": "msb_000FCB70",
      "source_words_sha256": "89cdc8c3d07fedb2f905f7d2d267c9c877ac2c817154899e91d71366d89c858a",
      "english": "Nothing here...?",
      "translator_note": null
    },
    {
      "id": "msb_000FCB80",
      "source_words_sha256": "f47213b88e8ab13dcb9eedbace28029cab5634e4939934e4d4f21c7349250a37",
      "english": "Why am I searching here?",
      "translator_note": null
    },
    {
      "id": "msb_000FCBA4",
      "source_words_sha256": "cefa8a863ef3f52b79ea7ec495d7e9feb8e94d50d6efefb3ff5fa82e7eead874",
      "english": "All clear... Try somewhere else...",
      "translator_note": null
    },
    {
      "id": "msb_000FCBC4",
      "source_words_sha256": "4ca866a136bda174ffcfb51f7266c99c57815b82163d273fe5274c918e7a7425",
      "english": "Huh? Out of gas?! Damn it!",
      "translator_note": null
    },
    {
      "id": "msb_000FCBF0",
      "source_words_sha256": "a970bef8bb98c9ca50ff17b4a2889e6e20116cd3ff8d1acc05970a814f8fecf5",
      "english": "Tch... Phone won't connect...",
      "translator_note": null
    },
    {
      "id": "msb_000FCC14",
      "source_words_sha256": "328a3441ca497c88afe37ab9de42604d8476d8728698930a438a410ce574ed12",
      "english": "Save cleared-game data?",
      "translator_note": null
    },
    {
      "id": "msb_000FCE14",
      "source_words_sha256": "383700a66d8734a918f8c76e4b908bb59af397dfb97eeb1f8ca3283fe1e59072",
      "english": "Oh! Gin Tama GET!",
      "translator_note": null
    },
    {
      "id": "msb_000FCE2C",
      "source_words_sha256": "af4d94c29c34eb04837a7da4f8384be159a11507ff6fe2b1d81f8df56e1fa19d",
      "english": "Huh? Isn't this mine? Really? Oh, thank goodness! Found my orb!",
      "translator_note": null
    },
    {
      "id": "msb_000FCE88",
      "source_words_sha256": "f8614c383f6b531e656857adff5ef9a3e9a3cf59e72460e5c47a8ed429237a86",
      "english": "Well, well. Gin Tama here!",
      "translator_note": null
    },
    {
      "id": "msb_000FCEB0",
      "source_words_sha256": "8e0bbf7dd445bed6fcf26c3910ae65563abb6e8e5d6dee047771cd2071dd5418",
      "english": "Someone drop Gin Tama? I'll hold onto it.",
      "translator_note": null
    },
    {
      "id": "msb_000FCEF8",
      "source_words_sha256": "2773123b4ac6072c68eae2c9dbde225aa6f855cc3fd2e410dae31c9ef05922f0",
      "english": "...This one's mine.",
      "translator_note": null
    }
  ]
}
