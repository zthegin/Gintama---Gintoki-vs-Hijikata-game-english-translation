    },
    {
      "id": "msb_00081054",
      "source_words_sha256": "6c041770f44a0fabf677a538d3102151efef512cf1a92c393f1e52d475106bd7",
      "english": "What's this...? Free dango voucher?!",
      "translator_note": null
    },
    {
      "id": "msb_00081088",
      "source_words_sha256": "1ac7bdb13c0378520763ba42d7353aa8d7a310d48f471d2d004792a1c295a5ed",
      "english": "Not for you.",
      "translator_note": null
    },
    {
      "id": "msb_00081098",
      "source_words_sha256": "404914a0ebbf8ee25e9367a6bd0ebf523803ffb1b2a49aaa095d10945ec093c2",
      "english": "Hey. This is for that dango shop, right?",
      "translator_note": null
    },
    {
      "id": "msb_00081104",
      "source_words_sha256": "4629bbde4f119073f5ddb84f4b192daad5d88daf34b5352a354cf0b6e1944573",
      "english": "I said, not for you! Persistent, aren't you!",
      "translator_note": null
    },
    {
      "id": "msb_00081130",
      "source_words_sha256": "4ffc248e12da6806b172218dc266faeceaca34342ebdd8285ef0eb9f065e03dd",
      "english": "Honestly! How greedy can you get?! See ya!",
      "translator_note": null
    },
    {
      "id": "msb_00081164",
      "source_words_sha256": "8d593cd33b13776dae2cc1261b980515810949a7f8efb4cb93a68cec30212156",
      "english": "I said, no!",
      "translator_note": null
    },
    {
      "id": "msb_00081180",
      "source_words_sha256": "730201e313f2dc0b7b251894dac630d0494ed1fdc6621e3253f9212973e7bf84",
      "english": "Oh! A dango voucher?",
      "translator_note": null
    },
    {
      "id": "msb_000811A4",
      "source_words_sha256": "1b12ad0935be8d06e83bbd2ca33ec9225351477e6aeb4f8c3e8fcf6024b26278",
      "english": "No thanks.",
      "translator_note": null
    },
    {
      "id": "msb_000811B4",
      "source_words_sha256": "e2d1619f7cd83d68761ca947c31a30031075b8b365c6c8b42066c67f2a468066",
      "english": "Looks like it.",
      "translator_note": null
    },
    {
      "id": "msb_000811CC",
      "source_words_sha256": "9f5b6676c5d557981a2ffc3dde31fccf888467b37ed334d8f453beccd04b9e48",
      "english": "Wait, lad! That voucher...",
      "translator_note": null
    },
    {
      "id": "msb_00081208",
      "source_words_sha256": "193ee9ebeee4a968e3ae27744b3905c591ef94d1f5109480e43f7269a57ff02e",
      "english": "Lad, that voucher...",
      "translator_note": null
    },
    {
      "id": "msb_00081230",
      "source_words_sha256": "5770541eea14ed76f1c301476b0aaaa40aaa57b1cb0a3e6c132f6c4849ab1cbc",
      "english": "N-no, that's not it...",
      "translator_note": null
    },
    {
      "id": "msb_00081258",
      "source_words_sha256": "bd8528cac5df1d9c920a7d6d0b4d6188a20a3a8f3a25fe7b94fe775561456741",
      "english": "...I said, that's not it.",
      "translator_note": null
    },
    {
      "id": "msb_000812D4",
      "source_words_sha256": "2372c6243bd3dbd0459314d6d2b07b92902ad6a2596ccca70eab5fe4553b0087",
      "english": "What's this?! I came for dango! This is Gin Tama!",
      "translator_note": null
    },
    {
      "id": "msb_0008132C",
      "source_words_sha256": "665fdd45dff4cd196ff6e6c9bc45340d64d1bb26ac5d0468169573db920a62b4",
      "english": "!!!!",
      "translator_note": null
    },
    {
      "id": "msb_00081338",
      "source_words_sha256": "4f759707ed80cbeaef8b9d0a321d6c33c82a5d2ca924c4434971f8d71760f80b",
      "english": "...Damn. Thought I'd get free dango.",
      "translator_note": null
    },
    {
      "id": "msb_00081384",
      "source_words_sha256": "e8e9bb58f01f433621cea1e77d1795582fa438d0f4a01fb754fdbfbd6ddd5011",
      "english": "Strawberry milk... Nice if it's real, but I've got a bad feeling...",
      "translator_note": null
    },
    {
      "id": "msb_00081438",
      "source_words_sha256": "acad6d2a1b679e39b6cd3ebdcec178fc7b60400c17554c591760281cbcd041d6",
      "english": "Welcome.",
      "translator_note": null
    },
    {
      "id": "msb_0008144C",
      "source_words_sha256": "80122656467cb410c501353e939dca36e2c65e9633e00d1c7ab33af5fb885c89",
      "english": "Oh, our free voucher. Of course! Here you go.",
      "translator_note": null
    },
    {
      "id": "msb_0008149C",
      "source_words_sha256": "837240b0a837ca249a25438b94d0970a1c5a4b2001e11cde47e2b5c0e069b627",
      "english": "Yes. A voucher for the Dango Gin Tama.",
      "translator_note": null
    },
    {
      "id": "msb_0008152C",
      "source_words_sha256": "deca9723614cc8e67893808930f854d0cf2c9f3b80c95241c3de7bf0c9b26a87",
      "english": "Keep the used voucher's stub safe, okay?",
      "translator_note": null
    },
    {
      "id": "msb_000815C4",
      "source_words_sha256": "22d8dfe29aec9b1d4a429bbb2410599d8db74bcdbba34801c22d38f4f7537416",
      "english": "Thank you!",
      "translator_note": null
    },
    {
      "id": "msb_000815E0",
      "source_words_sha256": "cd96f6ac38fbb353965ec9ee1bf8b7dbd82a3b48ad2c85d0c53cf8639855130d",
      "english": "Oh, Mama Saigo. Still shopping?",
      "translator_note": null
    },
    {
      "id": "msb_0008160C",
      "source_words_sha256": "793c4f2e764d956c08a21379d8ff3d48c54fb5cc91c48e97122a7f17fb90de19",
      "english": "Not yet.",
      "translator_note": null
    },
    {
      "id": "msb_00081624",
      "source_words_sha256": "d8dcae9703a7c6843fdda0e3dc388345fddd6db430302c52dca2a364de095bce",
      "english": "Oh, right. You did say that.",
      "translator_note": null
    },
    {
      "id": "msb_00081650",
      "source_words_sha256": "79c9114e4d923772c72706d39f2be221c3bcdd3aacec7400a281470cf0e104df",
      "english": "Right. Thanks. I'll go see.",
      "translator_note": null
    },
    {
      "id": "msb_0008167C",
      "source_words_sha256": "201e3d4d1b6ec45dd5cfd66e1ad729e8aa91df397eb9c2d10f5b0a6cdc6ea1f8",
      "english": "Oh, haven't checked yet.",
      "translator_note": null
    },
    {
      "id": "msb_000816C8",
      "source_words_sha256": "622df16201a4ff4847539004de5f4c82d1dc107283c09c769a5e92c11c8046bd",
      "english": "Oh, you.",
      "translator_note": null
    },
    {
      "id": "msb_000816D8",
      "source_words_sha256": "e5a39c67fe80296db2d10299103db44f209bd2809084d2be66d322d78de50d53",
      "english": "Quiet! I'll shop as long as I like!\fAnyway, found whoever attacked Shinpachi...?",
      "translator_note": null
    },
    {
      "id": "msb_000817D0",
      "source_words_sha256": "617936b4ef0d7cf5b89ba54df528b3973d4ff81b89db47ec813c4767713d5075",
      "english": "Useless. Go check! Dawdle and he'll be gone!",
      "translator_note": null
    },
    {
      "id": "msb_00081818",
      "source_words_sha256": "301e3fe5d52bd9e2d3b5adeddacea3245dfbe1701970e2ceefa2f53458e7de80",
      "english": "See that shifty-eyed samurai?",
      "translator_note": null
    },
    {
      "id": "msb_00081838",
      "source_words_sha256": "14ec985b33d48d4b642ce997af2df5ffde2fdeb8846be97d562875f189ad2f1a",
      "english": "What are you doing?! Are you even trying?!",
      "translator_note": null
    },
    {
      "id": "msb_00081894",
      "source_words_sha256": "9d16f69200844ccdbfdab3197df164a6a952c340e7ff67bd60a90374b4b6a508",
      "english": "Quit dawdling! Get going!",
      "translator_note": null
    },
    {
      "id": "msb_000818BC",
      "source_words_sha256": "e218353c7333bbd10a830ec11c91429adbe664ea59403472547bd7c5a66c76b6",
      "english": "Know what this is? ...Not giving it to you, though.",
      "translator_note": null
    },
    {
      "id": "msb_0008192C",
      "source_words_sha256": "73411e14387719cc97db964ae3b13c717d0fd7c6e4027bcd3843fbb1069c683a",
      "english": "Supposedly? That sounds loaded... Well, let's go see.",
      "translator_note": null
    },
    {
      "id": "msb_000819E8",
      "source_words_sha256": "33cd46b81f337031d3869243f22b051b8bf9f166aaa7ba0deecf3625001dde1e",
      "english": "Quiet! I said no! See ya!",
      "translator_note": null
    },
    {
      "id": "msb_00081A24",
      "source_words_sha256": "fe52b6a00186461e9d8d50cde44cafe5376d44480f67f40c54c0c70ad19569f1",
      "english": "I just said I won't give it to you!",
      "translator_note": null
    },
    {
      "id": "msb_00081A88",
      "source_words_sha256": "6a049301c83befcaf92e1418e875afc4854ed71e9c1d3949c874a58dcbaeb286",
      "english": "Don't want that.",
      "translator_note": null
    },
    {
      "id": "msb_00081AA4",
      "source_words_sha256": "ce332f19c0de9f363ecd5fa7c172c1b5189245d8850413e990e179fa9eb6bcb0",
      "english": "Supposedly, yes.",
      "translator_note": null
    },
    {
      "id": "msb_00081AC0",
      "source_words_sha256": "92adfa69eab70c39984f1296968a4637a2b3715bee15b69e3f03400d10b25718",
      "english": "Wait! That stub...",
      "translator_note": null
    },
    {
      "id": "msb_00081AF4",
      "source_words_sha256": "12f73c8377f7da4d14b618e373a9021cc3e673eb9b474110a70d8a2649029942",
      "english": "Lad, that stub...",
      "translator_note": null
    },
    {
      "id": "msb_00081B18",
      "source_words_sha256": "f7ca6527ea2958548463f8d8849c006d5a6f2c927b867f3055343f68c71a54a3",
      "english": "Said I didn't want it. Anyway, lad. About that stub...",
      "translator_note": null
    },
    {
      "id": "msb_00081B70",
      "source_words_sha256": "deaf3c0b897f0532410bddc3b701a99a799c00a6d47421a1596336570561d881",
      "english": "...Really doesn't listen, does he...",
      "translator_note": null
    },
    {
      "id": "msb_00081BF0",
      "source_words_sha256": "ea0df2a50da63cea24918ea794634aa8d0d98904d1e5e2a300905afad1086151",
      "english": "Really? Great! Had a bad feeling, but they'll exchange it properly!",
      "translator_note": null
    },
    {
      "id": "msb_00081C40",
      "source_words_sha256": "fba86f3dae335f6a2dea5a3f5e18451b5acd9962e3a6671c58d38f4c3d929a37",
      "english": "What a relief. Strawberry milk, then!",
      "translator_note": null
    },
    {
      "id": "msb_00081C74",
      "source_words_sha256": "216e146be56b900dd630e7924d86f242717889cdcb3fe73881efc7579710a4f9",
      "english": "Thanks! ...What's this?! Gin Tama?! Where's the strawberry milk?!",
      "translator_note": null
    },
    {
      "id": "msb_00081CD4",
      "source_words_sha256": "7b84980b93a79d4e3949c0cbe779e8aa47539a83a9fb7ab61d3ea1a74a966fab",
      "english": "...Bad feeling was right.",
      "translator_note": null
    },
    {
      "id": "msb_00081CFC",
      "source_words_sha256": "3073c5dcc2af3c47d30bceb8611773b92b1262f7f16f2ab506d454ae1b7e3159",
      "english": "...Figured it'd be like this... Still disappointing...",
      "translator_note": null
    },
    {
      "id": "msb_00081DC8",
      "source_words_sha256": "37af38f3d17a83d71269e56e3fd5baf86e968233d8fbc715d123ac64d3acbd3e",
      "english": "Welcome. Yes, you can certainly use that stub here.",
      "translator_note": null
    },
    {
      "id": "msb_00081E60",
      "source_words_sha256": "6672c4ae07b828a301084bfa01286b89bbdf45ab2373cef09bae2a0c5c26d230",
      "english": "Here you go, then.",
      "translator_note": null
    },
    {
      "id": "msb_00081E7C",
      "source_words_sha256": "d3cc21d3e9dcbf1be5558ecf56b1b58cdc8878329bb4730f6851f70716a0b830",
      "english": "That stub gets you the Strawberry Milk Gin Tama.",
      "translator_note": null
    },
    {
      "id": "msb_00081F14",
      "source_words_sha256": "f5e00364c8ed3b38df74098bfaf566a6552e7c65933d7fd755ad2b2dc0931031",
      "english": "Campaign'll run a while yet. Come back anytime!",
      "translator_note": null
    },
    {
      "id": "msb_00081F60",
      "source_words_sha256": "02f97d21eedb2802a6e7c204ff5aafeb55e19013e9f95fd5d2556c26a31cc52f",
      "english": "Welcome!",
      "translator_note": null
    },
    {
      "id": "msb_00081F78",
      "source_words_sha256": "1a35f1ea4e9a2decbed5d5dc1220bbde91bd25dafb2b69d64159c4d9e4b3ae63",
      "english": "...What a waste of time.",
      "translator_note": null
    },
    {
      "id": "msb_00082010",
      "source_words_sha256": "e14887ce877f0160247b1dbf97043f71745c50e35ffb4996d02b2716b5ccaf79",
      "english": "...They should be around here. Maybe found a clue...\fLet's find those two. For now...",
      "translator_note": null
    },
    {
      "id": "msb_000820B4",
      "source_words_sha256": "20c0363a08ed4d71e76d298e7518909f4ffe9a1d43ed6f802d8b2a5b78e9133a",
      "english": "...Let's try the hospital, then.",
      "translator_note": null
    },
    {
      "id": "msb_000820EC",
      "source_words_sha256": "85264d8b08caaffe46537494a833873a2b02869163dc0e4a214b3def06695c71",
      "english": "Hey, Saburo. Good work.",
      "translator_note": null
    },
    {
      "id": "msb_00082138",
      "source_words_sha256": "41f80fdd91c92ff6db130bcb213e0d12c835f66b177e6fe2c1b0bf89ce072205",
      "english": "See ya. Go home on your own.",
      "translator_note": null
    },
    {
      "id": "msb_00082164",
      "source_words_sha256": "6b0eb6e03c03e6222999ff70017ab7acc2db4a0e3d27ce4e6fd9de17b6f73333",
      "english": "Still here, Saburo?",
      "translator_note": null
    },
    {
      "id": "msb_000821B8",
      "source_words_sha256": "f689bee76749c2745366d1006c91c4a1f1abeecea52efb444bb019c2b905c51c",
      "english": "Relax. I'll go, okay? Oh, you go home on your own.",
      "translator_note": null
    },
    {
      "id": "msb_00082208",
      "source_words_sha256": "485434e5a5da374f633d068cd35afdc964ce7bb4657dd7e86a38a0c1af96234a",
      "english": "We'll gratefully accept the meal!",
      "translator_note": null
    },
    {
      "id": "msb_000822A8",
      "source_words_sha256": "634aff3c5e8d9fabc80c4f7844ca4082fc1cd777cddb8bd83e917405f6999c06",
      "english": "They don't trust us, do they.",
      "translator_note": null
    },
    {
      "id": "msb_0008237C",
      "source_words_sha256": "2adeff01e03921e944d84b7e4f52e231f1c829b96e5acb2f3f02be26b2d47d4f",
      "english": "W-where...? Where was it again?",
      "translator_note": null
    },
    {
      "id": "msb_00082650",
      "source_words_sha256": "83e02e49fe409d98b6f714f73d901e40a93a7f998fc46f61d1883f4f49227e91",
      "english": "Shinpachi's suddenly acting all high and mighty...",
      "translator_note": null
    },
    {
      "id": "msb_00082688",
      "source_words_sha256": "dc1a7b16fdf515e1ff3cf7225f30f4e1f4df0797b29da6b00a0a60cea4775a4a",
      "english": "...Really full of himself.",
      "translator_note": null
    },
    {
      "id": "msb_000826B0",
      "source_words_sha256": "cb9338b0a5d30287c41292a14f28d2713f81cff53ebabf178922e81192d51e52",
      "english": "...You really do change.",
      "translator_note": null
    },
    {
      "id": "msb_000826D8",
      "source_words_sha256": "6eb2b6e08ce6e4fa424a3d5661c90a846d6b72ba1456144ea81b2039b08b6298",
      "english": "No need to be so bossy...",
      "translator_note": null
    },
    {
      "id": "msb_00082A3C",
      "source_words_sha256": "501a69bd8cb741c6eb53ec009b9e0c0e9f4d7abdff1c1ea1892b768bfa798e1f",
      "english": "Stop, Shinpachi! Mama Saigo hears that, you're DEAD...!",
      "translator_note": null
    },
    {
      "id": "msb_00082B10",
      "source_words_sha256": "1f8e5314692c87932b991c92af2efadbae12abfc12544ee8ab13d5377387497f",
      "english": "Wanna die, drag queen?! Look in a mirror first!",
      "translator_note": null
    },
    {
      "id": "msb_00082B74",
      "source_words_sha256": "9e559c28c4c32e51a62614590dfaf28a930577970f91148d1ddf91112be5416a",
      "english": "Keep Otsu's name out of your mouth, drag queen!",
      "translator_note": null
    },
    {
      "id": "msb_00082C0C",
      "source_words_sha256": "ea653bc5997206a69a712acfebe342247656618ab99c2d14587ad1db83006b6d",
      "english": "No, he looks more like a dog...",
      "translator_note": null
    },
    {
      "id": "msb_00082C44",
      "source_words_sha256": "b813638b4618f2a8b3d2a798baabe2e63d85ee92fe0def118cab3ac9fc15a062",
      "english": "Borders? Seriously...?",
      "translator_note": null
    },
    {
      "id": "msb_00082C64",
      "source_words_sha256": "96ca761d64523137641d58f8a38430489a4221a6d497a4cc50c245fc2f9cd8ac",
      "english": "So petty! You're REALLY petty!",
      "translator_note": null
    },
    {
      "id": "msb_00082C9C",
      "source_words_sha256": "17738e2b53bdde7e4229e0d2f3864fc90e93707c89c4214a047a4fba61f59cf9",
      "english": "Our love for Otsu binds us together across borders!",
      "translator_note": null
    },
    {
      "id": "msb_00082CF0",
      "source_words_sha256": "43b036c9beb696cfa49317713fa1ab4d32381fafd0255095df4d1c1e59dce464",
      "english": "Quiet, you microscopic perm-head!\fComrade! Joining? You are, right?! RIGHT NOW, right?!",
      "translator_note": null
    },
    {
      "id": "msb_00082DE8",
      "source_words_sha256": "4f875be533bfa78e2d7ca014e89fd7c61c55a37b20544a384008c3fc30cee1a4",
      "english": "...That dog Amanto... Scared of Shinpachi...!",
      "translator_note": null
    },
    {
      "id": "msb_00082E38",
      "source_words_sha256": "da34a752a86f20262d4f0e4c66006630d4d4af2e47af97461e8b22c72fd28666",
      "english": "...Yep. Definitely scared.",
      "translator_note": null
    },
    {
      "id": "msb_00082E68",
      "source_words_sha256": "e4bd20ac10fe03f56d10ae7e4eecde269a12fce5af176d490f38530200ee4ed0",
      "english": "Shinpachi's fearsome!",
      "translator_note": null
    },
    {
      "id": "msb_00082EC4",
      "source_words_sha256": "be4948bb6a87f42e62b8258cfdaf21f892d63b087991d0f8226a67738cc57218",
      "english": "Cute girls are universal treasures. Amanto or human, no difference.",
      "translator_note": null
    },
    {
      "id": "msb_00082F00",
      "source_words_sha256": "a8af697f446b9bbc2d0882eac1a98f0838baddabd7b6204510a8b40d40e323a1",
      "english": "W-what an outburst...",
      "translator_note": null
    },
    {
      "id": "msb_00082F28",
      "source_words_sha256": "8f25a593020f44ff5196fcc6f02fa91755c08336662e49ff9193df2a1ee3b92b",
      "english": "Yes... I'll think about it.",
      "translator_note": null
    },
    {
      "id": "msb_000830B4",
      "source_words_sha256": "2708c90c55a47c45884c501d44d56a3e281221d186c67852fca0e7de1c34f73e",
      "english": "Comrade! Join Otsu's fan club NOW!",
      "translator_note": null
    },
    {
      "id": "msb_000830E8",
      "source_words_sha256": "98e0997fc1676dbf8c64f3da77b41d6d91681775dfb2459b91572b81d19abd8d",
      "english": "Love for Otsu is universal!",
      "translator_note": null
    },
    {
      "id": "msb_0008311C",
      "source_words_sha256": "66cf80a712e4a762cb15bb8ef8df77f9166627a47fd3960cd9d6142fdf415644",
      "english": "I asked what you'll DO, damn it!",
      "translator_note": null
    },
    {
      "id": "msb_00083244",
      "source_words_sha256": "8701bff190ded42136c4ae42b04c95dcfa6cdc790d7995601e97e1bf1f3be6b3",
      "english": "Then go check! Hurry!",
      "translator_note": null
    },
    {
      "id": "msb_0008332C",
      "source_words_sha256": "dc901faf11e1f5eebd58e8732285b2348e00666ebb23f93711bfe4c1b7de0af0",
      "english": "Still think it's Katsura...",
      "translator_note": null
    },
    {
      "id": "msb_00083418",
      "source_words_sha256": "e893b6382a26f07d51113ac265b8459e6ac0bf6b8ea3db347f1c7ba60b0e942a",
      "english": "Nothing like your dead-eyed perm. A handsome man with long black hair!",
      "translator_note": null
    },
    {
      "id": "msb_00083590",
      "source_words_sha256": "fc3752014778d3b2e21ef4726b714afc720a2c9defc94147c1c0a2ff56b024f3",
      "english": "Tch. Gorilla and Hijikata's lackey.",
      "translator_note": null
    },
    {
      "id": "msb_00083668",
      "source_words_sha256": "d0613fbd235005ad24a10aedcc90e50d873c630ed2b98c48da2b3d01f00d6797",
      "english": "I said I don't KNOW! See ya!",
      "translator_note": null
    },
    {
      "id": "msb_00083694",
      "source_words_sha256": "7c6e2e5756633136bf57c191ee040bda328fbf1485c185302c3b5fbb31c0b5bf",
      "english": "N-not like that! Just don't want to get dragged into trouble!",
      "translator_note": null
    },
    {
      "id": "msb_000836E4",
      "source_words_sha256": "78af8b845d8fcdb97fc212b43299639d35f919c8d85fd871cd777282eda0edc4",
      "english": "Oh, Shinsengumi... Yamazaki, right?",
      "translator_note": null
    },
    {
      "id": "msb_00083884",
      "source_words_sha256": "9e4d0568fefb48276e0f35030acfec69765d69571b0200730f936753d264ceea",
      "english": "Whatever you say, Gin... You're protecting Katsura...",
      "translator_note": null
    },
    {
      "id": "msb_00083AF8",
      "source_words_sha256": "df31e49bd6617a8d69ca4160cee022516f91954774404c70b687fa7e912d585b",
      "english": "There you go joking again.",
      "translator_note": null
    },
    {
      "id": "msb_00083D0C",
      "source_words_sha256": "7281cb08d7ed6e821cff278bea049857086dc3bbb11aaeff5b746567d52d9418",
      "english": "What are you doing here?",
      "translator_note": null
    },
    {
      "id": "msb_00083DB0",
      "source_words_sha256": "74a561d7a9e971c463c1318b2879927863e7a19af06793f47a4b62616357d469",
      "english": "Oh, Ikumatsu! You said you saw Katsura earlier, right...?",
      "translator_note": null
    },
    {
      "id": "msb_00083E88",
      "source_words_sha256": "bd85dd89a1005dc4043601014715726914aae013b640b2842a496580b802f661",
      "english": "Gin... You're not a child.",
      "translator_note": null
    },
    {
      "id": "msb_00083EB4",
      "source_words_sha256": "a409797f6cf44731c263236a78bd849f4ce5b536102641b115f0bbf98cdcf417",
      "english": "Oh, the Joi fellow. What are you doing?",
      "translator_note": null
    },
    {
      "id": "msb_00083FA8",
      "source_words_sha256": "63be82f99b2284f691857516a1badc0b314f7425aeb4a090448547ac85ffc2df",
      "english": "Tch...!",
      "translator_note": null
    },
    {
      "id": "msb_00083FE8",
      "source_words_sha256": "c37f42fb020386c2f9898382a0e6cb8c5678e98655b69af2dad07919dced5a4d",
      "english": "No, nothing... Oh, you're Katsura's friend, right?",
      "translator_note": null
    },
    {
      "id": "msb_000840CC",
      "source_words_sha256": "a5650c26e3a766f7780db558ed20af172315fee329d7a801e71ea31c5680bdef",
      "english": "Oh, you again. Found Katsura?",
      "translator_note": null
    },
    {
      "id": "msb_000842A8",
      "source_words_sha256": "fb1036419827f0f408ecf2bb6036d508f4e3e1206eb2bd8c9b8c5c5a336bad94",
      "english": "Even though you're REALLY concerned...",
      "translator_note": null
    },
    {
      "id": "msb_000842D0",
      "source_words_sha256": "add42ce8c179aa1471fbbcf2e0fdcb95a4f56cd7696c59384706476695232f9f",
      "english": "Not yet, actually.",
      "translator_note": null
    },
    {
      "id": "msb_00084344",
      "source_words_sha256": "2e40402daba2ce06bbc131725524833cc94a9db2665963ab280667e188301e26",
      "english": "Well, then...",
      "translator_note": null
    },
    {
      "id": "msb_0008435C",
      "source_words_sha256": "4f4c915e8e49f3e8c3b587ffea9024ea271fc0f3a42d30dde3dc7872c2fc62f0",
      "english": "You too?! I don't know anything.",
      "translator_note": null
    },
    {
      "id": "msb_00084388",
      "source_words_sha256": "3504af9051939efb384efbc8d278dce1a3885a19a9cf3c259bce515e91af0e9e",
      "english": "Right. Let's head home for now.",
      "translator_note": null
    },
    {
      "id": "msb_000843B4",
      "source_words_sha256": "ad379b9621045fe4e7a2a94cf42b8c49b17244a40ea282e37782e3ab0895da2c",
      "english": "No point staying here either! We're going home!",
      "translator_note": null
    },
    {
      "id": "msb_00084400",
      "source_words_sha256": "2f1c74439c34c846024c500f2deff07ea224fe14dd3fb60488a7f7659ddae632",
      "english": "Gin, I'm hungry.",
      "translator_note": null
    },
    {
      "id": "msb_0008441C",
      "source_words_sha256": "653506df0fd3d8ac682af9060ccc6891b5c83a90c384fdd852b99e840358755b",
      "english": "Katsura escaped while we battled. Worked out well.",
      "translator_note": null
    },
    {
      "id": "msb_00084454",
      "source_words_sha256": "dd7325525948a8f60788798a30444a5883dc6aabd5dc58b43960d8a094033e24",
      "english": "Oh, come on...",
      "translator_note": null
    },
    {
      "id": "msb_000844B8",
      "source_words_sha256": "09f17eb44f820f3b94b4fe803158bc50b8fdb5b52c3bd020befff66287d9fb18",
      "english": "...No food at home either, though...",
      "translator_note": null
    },
    {
      "id": "msb_000844FC",
      "source_words_sha256": "2f3c37d0369b1f7109de71b606edc4ec65c80c9c721fd254a9c1d5e4af3b8881",
      "english": "Okaaay...",
      "translator_note": null
    },
    {
      "id": "msb_00084548",
      "source_words_sha256": "d92caa72e788e938ceef08d777c07c56fbadbb4f943c064eb3a1e893cb8111d5",
      "english": "Standing still won't help. Let's look round town.",
      "translator_note": null
    },
    {
      "id": "msb_00084580",
      "source_words_sha256": "f4f3f4de9fbabfb1b34b1e7f5683af3e0759c6df5cdd71e1fba23c73f96c0464",
      "english": "What now?",
      "translator_note": null
    },
    {
      "id": "msb_0008459C",
      "source_words_sha256": "75f61fdd118dbd57da677b090e3edd339f66f42ca23d0dcfd6699f9509c97f0b",
      "english": "Me too, Gin...",
      "translator_note": null
    },
    {
      "id": "msb_000845BC",
      "source_words_sha256": "274548b44f95f44aabd9b0ae3df4616bc4618c66095f1783872bf5ce926afe72",
      "english": "Let's do that.",
      "translator_note": null
    },
    {
      "id": "msb_00084784",
      "source_words_sha256": "3f0955bc1c1f3df7cc58890fc06806feb744a8221f1488a4bf5c8e9e80bee811",
      "english": "Oh! An Otsu fan-club member!",
      "translator_note": null
    },
    {
      "id": "msb_0008480C",
      "source_words_sha256": "aa249bac8e7730a8794250b6ed8edb8a562cc3ce5f33f0dda024c66fe814de3b",
      "english": "No way... A member of Otsu's proud fan club?!",
      "translator_note": null
    },
    {
      "id": "msb_00084AA0",
      "source_words_sha256": "785bc9f8a52e434399781abe5e07e0b93784f48ad0dd20b2b9adc515a13ff025",
      "english": "A playboy who can't be bothered to play!",
      "translator_note": null
    },
    {
      "id": "msb_00084AD4",
      "source_words_sha256": "8f1f85166d8ba952880a0f3ed31eb9f3a5ecba7c556707f7fa7fec22f1b1471c",
      "english": "Then go drop dead!",
      "translator_note": null
    }
  ]
}
