    },
    {
      "id": "msb_0006D844",
      "source_words_sha256": "3fb0f5bde7f942fdaf4ab400bea5083f5cc2f6783e570cc3d04b88ade260aa78",
      "english": "I'M the ultimate mayo lover!",
      "translator_note": null
    },
    {
      "id": "msb_0006D86C",
      "source_words_sha256": "e87385911e44f90d8a1f272843167f5421bae926be8349c0e8abb6e2beded8c1",
      "english": "What a pointless argument...",
      "translator_note": null
    },
    {
      "id": "msb_0006D890",
      "source_words_sha256": "1b432f587877af6beed6842f49ecfc620ab376a63f0558394c8f6eaa3b14cb2a",
