    },
    {
      "id": "msb_0006D7F4",
      "source_words_sha256": "b7f286a48c9c077b317e743d3350817f7935ce3f051b9698c0b78245d70d1eff",
      "english": "Be careful.",
      "translator_note": null
    },
    {
      "id": "msb_0006D804",
      "source_words_sha256": "6a8400bc46befb2300a9c6c7d47eca8fc4ce6e621add55ef83bea348038f5166",
      "english": "Yeah, love it.",
      "translator_note": null
    },
    {
      "id": "msb_0006D818",
