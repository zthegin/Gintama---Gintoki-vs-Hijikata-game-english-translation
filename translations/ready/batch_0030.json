      "english": "That's it?!",
      "translator_note": null
    },
    {
      "id": "msb_0006D72C",
      "source_words_sha256": "5f437cd7dad8b4d1813c0c69acc8099e2dae0baa9e22601ddeeeabf225bea21d",
