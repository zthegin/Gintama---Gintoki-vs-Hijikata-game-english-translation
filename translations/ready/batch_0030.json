      "english": "You with the Joi rebels?",
      "translator_note": null
    },
    {
      "id": "msb_0006D654",
      "source_words_sha256": "b308c41a707dc1bf88ff021269cac441969a2b9976e27dbeade6b02c0808ffdf",
      "english": "Say something?",
      "translator_note": null
    },
    {
      "id": "msb_0006D668",
      "source_words_sha256": "e63cae9deb92ddc92892a8d83b985fa37a4a43b860b72f9a864df3ee2c63b709",
