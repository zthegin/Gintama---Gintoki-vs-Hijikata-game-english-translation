      "translator_note": null
    },
    {
      "id": "msb_0006D8D8",
      "source_words_sha256": "b3067bc88e03fe69fabc5c27c76312d25407398792b6b1923297c3408f620dda",
      "english": "I love it too!",
      "translator_note": null
    },
    {
      "id": "msb_0006D8F0",
      "source_words_sha256": "f17e89e5d982357129d88fcd044653142b586b916809e97371347e3361c1b4dd",
      "english": "Don't be stupid! I love mayo most in the universe!",
      "translator_note": null
    },
    {
      "id": "msb_0006D92C",
      "source_words_sha256": "dc74612bac622c1c256712dc91be657f67c7bf9c3d36b3ed63e7aa1068319658",
      "english": "Let's stop.",
      "translator_note": null
    },
    {
      "id": "msb_0006D940",
      "source_words_sha256": "726f52199a8ac18ea7ca856ebb7641a8c9c0fda0c907f1bdbbc16a573c215baa",
      "english": "Oh! That mayo guy from before!",
      "translator_note": null
    },
    {
      "id": "msb_0006D988",
      "source_words_sha256": "0f2e663cae3b7bee6c00b3d0c2a5104c787d953c7d97dda01435d2052e330c1b",
      "english": "No police matter.",
      "translator_note": null
    },
    {
      "id": "msb_0006D9A0",
      "source_words_sha256": "42a767f69f90c01518567f95bf0c0f1f1d93607afa6e2f8246baa3b6a1498c4c",
      "english": "I could tell you, but knowing would put you in danger.",
      "translator_note": null
    },
    {
      "id": "msb_0006D9D4",
      "source_words_sha256": "d8026507758e229de3bc3594166a87ab5c22eeda6d340f562e4917546b2da6ab",
      "english": "Better that way.",
      "translator_note": null
    },
    {
      "id": "msb_0006D9E4",
      "source_words_sha256": "e05f13ad90374807745eac9e49c24df228726ed9251028cd44f6a2f7fe7a0700",
      "english": "I'm working. Don't need telling.",
      "translator_note": null
    },
    {
      "id": "msb_0006DA00",
      "source_words_sha256": "30d03bbdb5925b2388441baa900c975d44de0271c94254158ad1fdb13259eef3",
      "english": "Shinsengumi? Is there a case?",
      "translator_note": null
    },
    {
      "id": "msb_0006DA24",
      "source_words_sha256": "8f1f0d77eccc78302f62d13cec7f974bfa97472483a7d22346d8fa03e4a478d6",
      "english": "Something fishy going on?",
      "translator_note": null
    },
    {
      "id": "msb_0006DA7C",
      "source_words_sha256": "a74c5adf1fea6b8ff4c0272c453a5693ef565f22cb962dd4d789fa253bafd731",
      "english": "Do your job properly.",
      "translator_note": null
    },
    {
      "id": "msb_0006DACC",
      "source_words_sha256": "1b6d17bba1df6ce4b6ade1620cfa2731928ce874f5cbdac9509109b76c45b527",
      "english": "Really pisses me off!",
      "translator_note": null
    },
    {
      "id": "msb_0006DC08",
      "source_words_sha256": "e454a050a28543d15e640a009724153d2a6b14efb92541ce0ada19455ef0fed4",
      "english": "I have an idea. Don't worry.",
      "translator_note": null
    },
    {
      "id": "msb_0006DC28",
      "source_words_sha256": "483ad18b2fc5cd5e6e85d9c32450a5e828449de628abd32c8d69921f9254878b",
      "english": "A Gin Tama... I can have it?",
      "translator_note": null
    },
    {
      "id": "msb_0006DCD4",
      "source_words_sha256": "1b6243055104c4e3840c6e37fd6d2e87398238b112815114273a1cb614a51331",
      "english": "I see... Take this, if you like.",
      "translator_note": null
    },
    {
      "id": "msb_0006DD10",
      "source_words_sha256": "1f60fa7b02d6fa8d71e90218dad1226c493ee591e7aab743a1f30adb09f31668",
      "english": "Don't worry. Might come in handy.",
      "translator_note": null
    },
    {
      "id": "msb_0006DD3C",
      "source_words_sha256": "5c79eeda994c3a723a7965f5ce69813be6536b5290a78dc73386f13522f01832",
      "english": "Watch out for fires!\fThat's all I have to say.",
      "translator_note": null
    },
    {
      "id": "msb_0006DD64",
      "source_words_sha256": "d33a4fc1691958c89c31e3a8ab1cb7878c2bb2f2ffef2d2e103693d6af48c99a",
      "english": "Jump's my favorite read.",
      "translator_note": null
    },
    {
      "id": "msb_0006DD80",
      "source_words_sha256": "a697e0e939699757aea81dd753b13dcb8a726d519e9e9dbb24ed5547aa7aa205",
      "english": "Jump taught me all about life.",
      "translator_note": null
    },
    {
      "id": "msb_0006DDA4",
      "source_words_sha256": "56cff16af87aaf00470e8680ad7ba4b5c518dde91afeca5595ed17bcc1bbb4dd",
      "english": "I can do a JoJo pose! Perfectly!",
      "translator_note": null
    },
    {
      "id": "msb_0006DDCC",
      "source_words_sha256": "2d65cc99055e2ba69c146bf427a66e84381aba2d3d6fdbcd942b7d0000d2a157",
      "english": "Is Jump out today?",
      "translator_note": null
    },
    {
      "id": "msb_0006DDEC",
      "source_words_sha256": "f19d59622d20091a95630948223be1ed505d3075dde08922757d47a3450bbd73",
      "english": "Damn... Can't stop thinking about it...",
      "translator_note": null
    },
    {
      "id": "msb_0006DE1C",
      "source_words_sha256": "5a30737dd4c08ea64b3124b181ac48faf1ea075ceb820f79602613c63144807c",
      "english": "I can't live without Jump!\fWhy's it weekly?!\fMake it DAILY!",
      "translator_note": null
    },
    {
      "id": "msb_0006DE74",
      "source_words_sha256": "1c06d588d6a01fb8b314290848a1752e3d3f3beebac06f443c1e4cdd59a33799",
      "english": "I read it too.",
      "translator_note": null
    },
    {
      "id": "msb_0006DE94",
      "source_words_sha256": "d6b7d7736f5958ae5a50c68df129e647b54aaffcfc17f1d4e6d323fc2f9af65c",
      "english": "Do what you want...",
      "translator_note": null
    },
    {
      "id": "msb_0006DEB4",
      "source_words_sha256": "a8be38bedf512617ef74ac7f7cc4b1bfd91fd70daa32625112a771d88d9859fb",
      "english": "Hmm... Can't remember...",
      "translator_note": null
    },
    {
      "id": "msb_0006DEE4",
      "source_words_sha256": "627912e8b0a9fb41e70364775fa7385d464d614aa83b0f2c06dde030823b53e7",
      "english": "Then go check at a bookshop.",
      "translator_note": null
    },
    {
      "id": "msb_0006DF04",
      "source_words_sha256": "c174a48277b96a44c5de35b3ffa45cc80299107a0101ed902a43a1fff0e35eb2",
      "english": "Don't be ridiculous!",
      "translator_note": null
    },
    {
      "id": "msb_0006DF1C",
      "source_words_sha256": "84b7b0ccf1b48d666230a2230fd114aed5362cdbb3bad38f8eddd8914e3b8acf",
      "english": "Huh? You from before...",
      "translator_note": null
    },
    {
      "id": "msb_0006DF48",
      "source_words_sha256": "ddf27701ded25e2585b60ffd1cc3ed84189eab22883bd94f1af3324cf1656893",
      "english": "Not a kappa! Ebina!\fAnd put a \"Mr.\" before it when you address me!",
      "translator_note": null
    },
    {
      "id": "msb_0006DFAC",
      "source_words_sha256": "b3c655c9a8c52768edeb68d97bd8a93745464ba476054218d7b2b9953be2b0bb",
      "english": "Mind your business!",
      "translator_note": null
    },
    {
      "id": "msb_0006DFC4",
      "source_words_sha256": "aad1f208e19372e8a26c76016eb2416457019af728d9b2627682caebf1ecc628",
      "english": "I love cucumbers.",
      "translator_note": null
    },
    {
      "id": "msb_0006DFE0",
      "source_words_sha256": "2d7e189a0b7fb5520a99feaa2f8263ef2d42134242af70c533e322dc2fcb1893",
      "english": "I'm NOT a kappa! How many times must I tell you?!",
      "translator_note": null
    },
    {
      "id": "msb_0006E010",
      "source_words_sha256": "d87690c833bd5b96d96aa4498413066372c058cae5a58484ac8ac3e90e529e53",
      "english": "Kappa...!",
      "translator_note": null
    },
    {
      "id": "msb_0006E028",
      "source_words_sha256": "3b274dd6b4ffc8837071c96ea0717c8e127dde75c7e55aedc8087b46d7cdaee4",
      "english": "What's up, Ebina... Mr. Ebina.",
      "translator_note": null
    },
    {
      "id": "msb_0006E054",
      "source_words_sha256": "3d8958e53981d67a6fee479285dba03f49ae8a1ab4f6b1ae59895d6a0b1052b0",
      "english": "Careful. They'll mistake you for a kappa.",
      "translator_note": null
    },
    {
