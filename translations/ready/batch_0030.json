    },
    {
      "id": "msb_0006D8AC",
      "source_words_sha256": "9cf61b1e09b6cc59a00b82f1319c995f88e1de5b7ef8fde686310ce63b2f0c10",
      "english": "Yeah!",
      "translator_note": null
    },
    {
      "id": "msb_0006D8B8",
      "source_words_sha256": "9385f392f1a187d45e17ae2b7486bba21173cf7b083ab01e05b2c6e18e239c41",
