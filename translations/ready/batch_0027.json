  "format": "gintama-community-translation-v1",
  "batch_id": "batch_0027",
  "records": [
    {
      "id": "msb_00061BE0",
      "source_words_sha256": "bc693fb0814f640f1ae036c65b9c046460320320a5f1771328086b5ee5e25ef5",
      "english": "Discrimination against yakuza? That's quite a phrase...",
      "translator_note": null
    },
    {
      "id": "msb_00061D70",
      "source_words_sha256": "d186ab7074c5a4be98e6b12a79ff5bc205e79b7c2fad3806d633f9e33572598e",
      "english": "Bet he's forgotten by now.",
      "translator_note": null
    },
    {
      "id": "msb_00061E1C",
      "source_words_sha256": "bbe27a76cf0154c132bf8624d9598865396f65513e8cb6db351642d91c8bd6e9",
      "english": "What?! He can't see us now!",
      "translator_note": null
    },
    {
      "id": "msb_00061E58",
      "source_words_sha256": "1bdd08f67299b5ba1b0d8d8299dd8f5f70deb72f3f62f3917678eea643dcefcf",
      "english": "How carefree can you be?! Listen!\fWe walked off the job without asking! He'll be furious!",
      "translator_note": null
    },
    {
      "id": "msb_00061FC8",
      "source_words_sha256": "e714c9db67af110c6c54d3c0787034ff970a3106643a7a4f298db4777550e09b",
      "english": "YOU don't worry enough!",
      "translator_note": null
    },
    {
      "id": "msb_000620C0",
      "source_words_sha256": "1f3e484150cf291ee90ca57ef1b40edbb6f0a88a8bc323ef39ecd2d907e8238f",
      "english": "Listen, Kagura. All roads meet somewhere.",
      "translator_note": null
    },
    {
      "id": "msb_000621B8",
      "source_words_sha256": "20ff571f08a31dcdab4cddb4f1fa8fd0a03dc3f80256139a91dff128c616ab86",
      "english": "Where are you going?",
      "translator_note": null
    },
    {
      "id": "msb_00062380",
      "source_words_sha256": "1dab75fb558dc522eb3d63fc459fd87cb68a9473e2aebed4e3869c8f7b1be6e8",
      "english": "Gin! Let's see a movie after all!",
      "translator_note": null
    },
    {
      "id": "msb_00062440",
      "source_words_sha256": "a39516bfe6f451dda4eb27cf7f89776e6305a567f224d34bcc7be34cd34dee20",
      "english": "Of course not! Hurry or we'll be late!",
      "translator_note": null
    },
    {
      "id": "msb_0006256C",
      "source_words_sha256": "cce335e1dab209db78d57a8f060df5fc1cdc0a5f51d2b19e6f59ad7879c168ce",
      "english": "You know you shouldn't, but you can't stop. Happens, right?",
      "translator_note": null
    },
    {
      "id": "msb_0006260C",
      "source_words_sha256": "934d8640fcc86fd21a6d05166ca5bcddfd44a1a1980c4eeb74f0763bd0932c3e",
      "english": "Hey, Gin! Wrong way!",
      "translator_note": null
    },
    {
      "id": "msb_00062670",
      "source_words_sha256": "eb93d3583f8ec7223b52108e1a00a51afa265ce6157b753af3cc22807ec8a7ee",
      "english": "Pick a more believable excuse, please.",
      "translator_note": null
    },
    {
      "id": "msb_00062728",
      "source_words_sha256": "2b38ced5fe23000bfe474ea3edd33b4ce26154faf895b3f8eb6f7ae37d48ab7f",
      "english": "Keep this up and I won't even play straight man anymore.",
      "translator_note": null
    },
    {
      "id": "msb_00062758",
      "source_words_sha256": "6c6da6ce96086ecb13f1a16e0ad252b3c23d979358e93c4824c7bbd329052b1d",
      "english": "What?! Bad luck!",
      "translator_note": null
    },
    {
      "id": "msb_000627C8",
      "source_words_sha256": "bef57063befd343c8e9660939e74ee8b638babcbd78bb3edb9bff3a1be020a2c",
      "english": "Don't flatter me so much.",
      "translator_note": null
    },
    {
      "id": "msb_00062A00",
      "source_words_sha256": "a6fef9f3d46f05fc9c07c85b472f5636f41fc24294b12e76fd20aa37815965d8",
      "english": "...Definitely a lie.",
      "translator_note": null
    },
    {
      "id": "msb_00062AC4",
      "source_words_sha256": "847d4e70bb2bfb275294dae75ccbd0701b75f32b7528451ff2522ede0c117489",
      "english": "...Now you mention it, maybe not enough...",
      "translator_note": null
    },
    {
      "id": "msb_00062B24",
      "source_words_sha256": "6906c9809671f666504fe1a41f770e9914c8798d43eb71ff1cd2d1600b0dff35",
      "english": "Go before we leave!",
      "translator_note": null
    },
    {
      "id": "msb_00062B44",
      "source_words_sha256": "e444f2642dfc199493d1eccede8e30f10f9d7eaefc0f54595c19f39e023b6990",
      "english": "Wait a moment.",
      "translator_note": null
    },
    {
      "id": "msb_00062B60",
      "source_words_sha256": "f1f835e548b6d946b80e2a55ea5e5a4c93d524abf9095873e25e505f418ba3b7",
      "english": "No! We don't know what'll happen inside, right?\fCould be a battle...",
      "translator_note": null
    },
    {
      "id": "msb_00062BD4",
      "source_words_sha256": "a90153d4ff347a7bb7692c22f2c045ed02f9e5271cd2bae27c2ee337ed3ff132",
      "english": "Enough Gin Tama? If not, we should get some more...",
      "translator_note": null
    },
    {
      "id": "msb_00062C38",
      "source_words_sha256": "754c3cc54e681cdc332de1865078129cec4af2faab73f1d78833f59ae42989f2",
      "english": "All right, then.",
      "translator_note": null
    },
    {
      "id": "msb_00062C84",
      "source_words_sha256": "190bf43822fa2c6ad8ae8ccc591f91afe48ba54a05677afe4c64fde5c32385d4",
      "english": "Uh, odd question... Got a grudge against the Yorozuya?",
      "translator_note": null
    },
    {
      "id": "msb_00062CD8",
      "source_words_sha256": "c48632d84725ba07305ead64040670edabe685a19c441c8f455e305aec4f3986",
      "english": "One more time. Got a grudge against me? Hiding it won't help you.",
      "translator_note": null
    },
    {
      "id": "msb_00062D20",
      "source_words_sha256": "a55449cf566281b04f9bf0a0ac6fb6f40e0381ea9b8d8af5e9eed125b7e19768",
      "english": "What is it?",
      "translator_note": null
    },
    {
      "id": "msb_00062D30",
      "source_words_sha256": "f4f3b891f5e97fc048dca20c25beeed3b94874ee71eb5ced4804fbdf07eaae35",
      "english": "Where'd THAT come from?! Too busy for grudges!",
      "translator_note": null
    },
    {
      "id": "msb_00062D88",
      "source_words_sha256": "987da5c3328902580beec8c6ec7fd80bfad6c8b5e6138961da9da0202aece5ae",
      "english": "What? You again...",
      "translator_note": null
    },
    {
      "id": "msb_00062DB0",
      "source_words_sha256": "0b825e0169dac01913057a6ab689dd4b0ee4ee2c0cf7d08ba88a8d6ad178f4f1",
      "english": "Persistent, aren't you! No idea!",
      "translator_note": null
    },
    {
      "id": "msb_00062DD4",
      "source_words_sha256": "121791bf29dbbddc69cb7d9e54d4cf4fc5a99ff7356a9379138aad0fba3a0307",
      "english": "No grudge, okay?!",
      "translator_note": null
    },
    {
      "id": "msb_00062DF8",
      "source_words_sha256": "5addf0086e520e0153bbd04b9dc4ae0230f0e9061e3ddd6a2963c04cd97a050d",
      "english": "Keep it up and I'll slap you!",
      "translator_note": null
    },
    {
      "id": "msb_00062E20",
      "source_words_sha256": "10c659c32bad3401f4110624e56f8145bebeba2e55b5f8b704eb8c8daa6f8e3d",
      "english": "Gin... Did you do something to her?",
      "translator_note": null
    },
    {
      "id": "msb_00062E54",
      "source_words_sha256": "cb610b22ee99f1722fa57df3fe0191c2da64c3d8062a7fb206fb33a858aefb22",
      "english": "Hey. You lot are like the police, right?",
      "translator_note": null
    },
    {
      "id": "msb_00062E84",
      "source_words_sha256": "244210e7ac29fde409256265a9c655d2596c28f8801e7382b14c835b54d84428",
      "english": "Then catch whoever attacked our Shinpachi.",
      "translator_note": null
    },
    {
      "id": "msb_00062EC4",
      "source_words_sha256": "77b7212f31ce12b7ca42a62e33ee428e0e5b0821b4ff3cc89e8916c08667aa1f",
      "english": "Finding that out is YOUR job!",
      "translator_note": null
    },
    {
      "id": "msb_00062FA0",
      "source_words_sha256": "aba17f8031c4bae76080a460f2629c7f8617cb2939666d42067537f3c446b9c1",
      "english": "Oh, the Yorozuya...",
      "translator_note": null
    },
    {
      "id": "msb_00062FC8",
      "source_words_sha256": "c5512bb906b3af81153b4164b2957a2cdcd172022e9678ca98635ee98dd08ded",
      "english": "Not like the police. We ARE the police...",
      "translator_note": null
    },
    {
      "id": "msb_00063004",
      "source_words_sha256": "cec334ac5d0a88de75e8b1dbb1cc503e7dff34526f1793314a14ba3a1697bd77",
      "english": "Attacked? What was the culprit like?",
      "translator_note": null
    },
    {
      "id": "msb_000630B0",
      "source_words_sha256": "3988f3165af1d2b5d8ef7d6bc91f199d8c273bff08f21b4293b0e23076752df1",
      "english": "Oh, Yorozuya. About earlier...",
      "translator_note": null
    },
    {
      "id": "msb_000630E4",
      "source_words_sha256": "76f2808aa459acd8eb066f58fdc387571c42b9a52e816db6c5f7a6dc5d5bab7a",
      "english": "Oh, Yorozuya...",
      "translator_note": null
    },
    {
      "id": "msb_00063104",
      "source_words_sha256": "b2cb785eea1bf634de6f5ae22435496361f485b057f1685a44f94df3c999585b",
      "english": "Gin... What did you DO?",
      "translator_note": null
    },
    {
      "id": "msb_0006313C",
      "source_words_sha256": "298faaa9c21c966ff845d493454346a06186026d3e926f55ea62ab2f10e58f3e",
      "english": "Seen anyone suspicious round here? And call me big brother.",
      "translator_note": null
    },
    {
      "id": "msb_0006318C",
      "source_words_sha256": "5c6a38e0c8f1f3dd1c28937933e2746b403eabc2649a305c8246860cb1029f18",
      "english": "When?! Where?!",
      "translator_note": null
    },
    {
      "id": "msb_000631A4",
      "source_words_sha256": "ba63cdf621009ce87112bd3b229292b746e636d8c0a57cf14e5030cb3e757ad0",
      "english": "...\fI'll smack you.",
      "translator_note": null
    },
    {
      "id": "msb_00063214",
      "source_words_sha256": "146fff181df63834fe0f7bcd2792f4171d7543c079727dbae7713422d9538494",
      "english": "Still at it, you brat?!",
      "translator_note": null
    },
    {
      "id": "msb_00063238",
      "source_words_sha256": "f31aa78f629c444efea53d3e0c1b22b2ce1beaf15d09dd9790aacc6e9c616afa",
      "english": "Need something, old perm-head...?",
      "translator_note": null
    },
    {
      "id": "msb_00063264",
      "source_words_sha256": "17f26fc1570a0d6ecb2e845654e31b763494f144e7116ac7b83d1c49334039ad",
      "english": "Yeah! SUPER suspicious!",
      "translator_note": null
    },
    {
      "id": "msb_00063284",
      "source_words_sha256": "bc7705f465c146726838b51e945367d0e811336f5089f8967e56b07518898e3a",
      "english": "Right here, right now! YOU'RE suspicious!",
      "translator_note": null
    },
    {
      "id": "msb_000632B4",
      "source_words_sha256": "97f4e246113465fb4567a0a1430ec4397294b7f6a22d498480b5c40040478dc0",
      "english": "Oh, the suspicious old man!",
      "translator_note": null
    },
    {
      "id": "msb_000632D0",
      "source_words_sha256": "459e8d214d1a57f7053557d5c1b266ebb53efa06ae6982577df015184990ee6c",
      "english": "Need something, suspicious guy?",
      "translator_note": null
    },
    {
      "id": "msb_000632F0",
      "source_words_sha256": "06deb849c57680d8b55265b21fa8d2425e2c09d5b23e4156ff774c600a00e0a0",
      "english": "Gin, don't get worked up over a kid.",
      "translator_note": null
    },
    {
      "id": "msb_00063320",
      "source_words_sha256": "b77e00913c3fa42a0089e383b290e09ca5f5d08cf8a1efeb196139085b73c66b",
      "english": "Yeah. Our Shinpachi got attacked...",
      "translator_note": null
    },
    {
      "id": "msb_00063354",
      "source_words_sha256": "c020f6f095b1e756e045f6ee48b1d618bf801965cd30e388fdb39ccd9b3f41ae",
      "english": "Not yet.",
      "translator_note": null
    },
    {
      "id": "msb_00063394",
      "source_words_sha256": "318611c8f45817ffc6c8508102ed47c86df0c1897976894519db7d8c1d6e2880",
      "english": "Butt out!",
      "translator_note": null
    },
    {
      "id": "msb_000633A4",
      "source_words_sha256": "4c06ad78f48a5461b788e4ed898f2a9613b10910e0f2a219e6d97fbad624ef6a",
      "english": "Hm? Seen anyone suspicious, you say?",
      "translator_note": null
    },
    {
      "id": "msb_000633D8",
      "source_words_sha256": "56d1a92279952ea03d359470355ac2270aa34ac90a14db8cc69665d79b248e83",
      "english": "Dunno... Whole town's full of suspicious people, really.\fYou and me included.",
      "translator_note": null
    },
    {
      "id": "msb_00063450",
      "source_words_sha256": "7b4e18c2e4f519c3890bca8e727d9db7ee1aeeaa08b2246f6e87ba1948443dd4",
      "english": "Find your suspicious guy?",
      "translator_note": null
    },
    {
      "id": "msb_000634C8",
      "source_words_sha256": "f8af3d9ff5ae8ef1a392eeb5cec213ca9ae0b7fcd328a7f083cce417ab5bca30",
      "english": "Oh. Now there are THREE suspicious people...",
      "translator_note": null
    },
    {
      "id": "msb_000634FC",
      "source_words_sha256": "17262e74f2389682e369894133e97d1818480849dc60ca4554e1d4cb7fffed07",
      "english": "Hey, Hamuko. Got a moment?",
      "translator_note": null
    },
    {
      "id": "msb_0006351C",
      "source_words_sha256": "4e9efcfca0fe9a14042c093c59cfaf764bdd3e6c648f263fe79e23c98ad8fdf3",
      "english": "So, Ham. Seen anyone suspicious? Besides yourself.",
      "translator_note": null
    },
    {
      "id": "msb_0006355C",
      "source_words_sha256": "cc0877ff80563b6ccbefbb1d797a6ba8aa2c350350dcb6e9c3aecfe660377811",
      "english": "Oh, Hamuko...",
      "translator_note": null
    },
    {
      "id": "msb_00063594",
      "source_words_sha256": "828c4c7c5d8bb2baf17e74dac776df68e1c7c92479e4401f0364c8d3033348db",
      "english": "Don't worry. Anger improves the flavor.",
      "translator_note": null
    },
    {
      "id": "msb_000635C4",
      "source_words_sha256": "9358b8befff76c7645de3dee67ef3e8e3db7bc63fe41c32b113f1ab977c25d1c",
      "english": "What? And stop calling me Hamuko!",
      "translator_note": null
    },
    {
      "id": "msb_000635F4",
      "source_words_sha256": "56efa6f7ddb117b04d3acf986ac47b2f5a78dd9a060d418411067776c72e62e5",
      "english": "At least add ko! KO!",
      "translator_note": null
    },
    {
      "id": "msb_00063614",
      "source_words_sha256": "d0fce30f33bf40f7e1633bb8d2e520d6c15c77dc2e3df316a41ef1754e5dde45",
      "english": "Don't talk to me! So annoying!",
      "translator_note": null
    },
    {
      "id": "msb_00063630",
      "source_words_sha256": "bc9278f362393c10adc1c3125727034942df22236da713f6115e87553f25b45c",
      "english": "I said, don't talk to me!",
      "translator_note": null
    },
    {
      "id": "msb_00063650",
      "source_words_sha256": "3a071f51461ead6499f71a9aa552632882c456599a656c668010c884818ce51e",
      "english": "Can't wait!",
      "translator_note": null
    },
    {
      "id": "msb_00063664",
      "source_words_sha256": "835de186dc13af56fa38a858663b2dd1438d0f229d17c6223bf829fbc06d027d",
      "english": "You upset her again?",
      "translator_note": null
    },
    {
      "id": "msb_0006368C",
      "source_words_sha256": "3ef42419228b059708a5e2b120bff2523be22973583335a5a048b7b08b38ea2f",
      "english": "What? Got a problem?",
      "translator_note": null
    },
    {
      "id": "msb_000636AC",
      "source_words_sha256": "e2a408d22d7e03d46bf1255f734420787c2afe683a89c84ea6f63f940970d093",
      "english": "What's this about?!",
      "translator_note": null
    },
    {
      "id": "msb_000636C8",
      "source_words_sha256": "eefc4035f32da4cb17dcf54b54a53683780a4ba03f7a34fd24052c6991ec9b91",
      "english": "Quit making accusations!",
      "translator_note": null
    },
    {
      "id": "msb_000636EC",
      "source_words_sha256": "41d2d9ee34089d791d2549b54310b2352619a0c8e7298d9e3c214b45f857f616",
      "english": "What ARE you on about?!",
      "translator_note": null
    },
    {
      "id": "msb_00063708",
      "source_words_sha256": "bd71e06cba548e46bc73c14a9bc568012036ad17f77c4c341c6f139e162fbc90",
      "english": "Confess WHAT?! I've no damn idea!",
      "translator_note": null
    },
    {
      "id": "msb_0006375C",
      "source_words_sha256": "925200d1d30ae40ab38daf9b93dc16480e28bb3d41a9b6a8b6ad1a10a4180d2e",
      "english": "I don't know anything!",
      "translator_note": null
    },
    {
      "id": "msb_00063794",
      "source_words_sha256": "463ad8a7712edc4efe9b01e7856b7e345033d96c60c8d7409063635875c7b984",
      "english": "Lousy attitude... Wait! Maybe it was YOU!",
      "translator_note": null
    },
    {
      "id": "msb_00063824",
      "source_words_sha256": "f44584adbc86a3dd61cad42b1e8cf9431b07828d1bbf84ee4023a8ca8a801ab9",
      "english": "Still denying it? Come by when you're ready to confess.",
      "translator_note": null
    },
    {
      "id": "msb_00063880",
      "source_words_sha256": "69e6e626ac2059d4e4bcb8efc2bae20a988d6589f20724ab0c89dc8f262af6e6",
      "english": "Ready to confess?",
      "translator_note": null
    },
    {
      "id": "msb_0006393C",
      "source_words_sha256": "e85aa2671e1e2ad3f974077cb99dd927495b745a104ebbba143be7ba039be4b5",
      "english": "Hey, lad. Need something? Oh! Want a Beach Samurai T-shirt?",
      "translator_note": null
    },
    {
      "id": "msb_0006399C",
      "source_words_sha256": "a6eb06484113297a5ed460934c273d963413f6068e55674f5535a9f1ec2c336c",
      "english": "Still no taste, huh.",
      "translator_note": null
    },
    {
      "id": "msb_000639BC",
      "source_words_sha256": "870b8b4122986d4fde746bb8ce5a57fd4d6f37b93fc9c14375aac9c1c26343a5",
      "english": "What? I don't know anything! I'm a bit part, anyway...",
      "translator_note": null
    },
    {
      "id": "msb_00063A00",
      "source_words_sha256": "78580f41b1a1739d20799d9fe46ccb5eebdc8578f54b5b10f9990149b101fdf7",
      "english": "No idea what you mean... But yeah, probably.",
      "translator_note": null
    },
    {
      "id": "msb_00063A44",
