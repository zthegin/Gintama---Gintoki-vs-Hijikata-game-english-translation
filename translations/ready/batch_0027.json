      "translator_note": null
    },
    {
      "id": "msb_00064CF0",
      "source_words_sha256": "fda968d941452f6b41b2f74cbcadaf645ff2133a662e4c047e2ecc2c2adf6fe0",
      "english": "Glad you found the culprit!",
      "translator_note": null
    },
    {
      "id": "msb_00064D14",
      "source_words_sha256": "ce961c88170d9c2502759c9d299b04ff0d45745a621716eef7f51fbbf37282b9",
      "english": "Glad you're not hurt!",
      "translator_note": null
    },
    {
      "id": "msb_00064D34",
      "source_words_sha256": "0f4a08fd30c391f44cf701376e4640504005ab8a06ef13422b4fa43dca1d4a09",
      "english": "Yeah. Sorry to worry you.",
      "translator_note": null
    },
    {
      "id": "msb_00064D54",
      "source_words_sha256": "e8fc849e07c20d8ae62c167a4e61ce4f12c1b92f339b68543fa931dc47d9780f",
      "english": "Oh, got a question...",
      "translator_note": null
    },
    {
      "id": "msb_00064D80",
      "source_words_sha256": "f207d0b13f42638f30b89587a300918f9f255ecb941ec7d96dec3dc4cc41f6eb",
      "english": "...Never mind.",
      "translator_note": null
    },
    {
      "id": "msb_00064DFC",
      "source_words_sha256": "1a135a136990219eeb1c9894c721af13b882005ca816628c566bedf4aa3f5def",
      "english": "Counting on you about the Gin Tama. I'll let you know if I remember more.",
      "translator_note": null
    },
    {
      "id": "msb_00064E3C",
      "source_words_sha256": "9908b12ef59ae57eb18e00cc6cf3202c9ec9fb336a257b95f8ac74ccd87e3329",
      "english": "Sorry, not yet. Getting old, I guess...",
      "translator_note": null
    },
    {
      "id": "msb_00064E6C",
      "source_words_sha256": "e96109e66282acf77e9999663af619cb3a6f46c27ec7524548e2580e742169c5",
      "english": "Listen. I'm not some champion of justice, okay?",
      "translator_note": null
    },
    {
      "id": "msb_00064EDC",
      "source_words_sha256": "de111b238d68a06b71adf718ff10c3335452d3161e9e59dcf3affd6b982e86aa",
      "english": "I'm Prince Hata! NOT the idiot prince!",
      "translator_note": null
    },
    {
      "id": "msb_00064F10",
      "source_words_sha256": "4ff0dfec457dadbb6ea6b32bf08fec9b83ebc922ce62a9316b82b40b95aeefcc",
      "english": "Mock me and it's a diplomatic incident! Remember that!",
      "translator_note": null
    },
    {
      "id": "msb_00064F54",
      "source_words_sha256": "f79dfd2a519df745e17ae7273d37cf3828f64ee7501d978fb40d0620810eec82",
      "english": "I love animals! I don't keep pets just for fun!",
      "translator_note": null
    },
    {
      "id": "msb_00064FC4",
      "source_words_sha256": "f28e11059f1a84c757005a0d7b3a1212575fb4fb62b7959d2a14a93b7e8b57cd",
      "english": "I did NOT bring in space cockroaches!",
      "translator_note": null
    },
    {
      "id": "msb_00064FF4",
      "source_words_sha256": "8f04d6ea68d4f6af29cf98d204ad1099b110119b12ed1907708521117ba509d3",
      "english": "Why keep talking to ME?! Out of material here!",
      "translator_note": null
    },
    {
      "id": "msb_00065030",
      "source_words_sha256": "616ba736fb0be5ab3c1a067ab0b6f739655f34a8d2a29ac04ccfd7d44383ac36",
      "english": "You should try Gin Tama battles, old man.",
      "translator_note": null
    },
    {
      "id": "msb_000650A4",
      "source_words_sha256": "406159df66bd15e693df725108a86f505395d74e5ac108bbdf3372c83c9badb6",
      "english": "Ahh... Babysitting an idiot is so boring...",
      "translator_note": null
    },
    {
      "id": "msb_000650D4",
      "source_words_sha256": "5631b9447febcf7afb4207f39bca1a3c6fd9af53e9a12176bcae174cdbb6de35",
      "english": "Didn't know? I'm pretty good at Gin Tama battles. Want a match?",
      "translator_note": null
    },
    {
      "id": "msb_00065128",
      "source_words_sha256": "0662e47e880256519502db4421cf449076ca6b819dfae5ecaf656e440623ccc4",
      "english": "Oh, right... Losing to an old man looks bad. Fine, then.",
      "translator_note": null
    },
    {
      "id": "msb_00065178",
      "source_words_sha256": "f1fe8b0e82b4cc4f38b809ec198259b41fd3386dfcb7072f29ecd5b2d8d03a27",
      "english": "No, no. Don't force yourself... Next time, kid.",
      "translator_note": null
    },
    {
      "id": "msb_000651B4",
      "source_words_sha256": "357ed3522f992e70bca4262454e03dddd640ed9ff16b1bdb816bc8508b19113a",
      "english": "No more trips to Earth...",
      "translator_note": null
    },
    {
      "id": "msb_000651D8",
      "source_words_sha256": "a4c93332abe0b47a8eb0e1cbc29e518d537b6ffe40eec9593db7de86cc758ec5",
      "english": "A thousand practice swings! Then try again!",
      "translator_note": null
    },
    {
      "id": "msb_00065258",
      "source_words_sha256": "41bede5ae04318c681249100c32f064b579126d9e3a0f4f203b9dbfec31cffd2",
      "english": "I'll make figures for a living. Retirement, I guess...",
      "translator_note": null
    },
    {
      "id": "msb_0006529C",
      "source_words_sha256": "d2fa77c3996fac1e914d04f271c6402a6f4777770c6f2dbb6b88241e04e7bcc9",
      "english": "Maybe I'll open a curry shop...",
      "translator_note": null
    },
    {
      "id": "msb_000652FC",
      "source_words_sha256": "985a5dceccd4f4ada2762f1bbdb02be25df0749c7b2c361c8bbb09c87cfb1ec6",
      "english": "This urge to crap won't beat me!",
      "translator_note": null
    },
    {
      "id": "msb_0006534C",
      "source_words_sha256": "ccdefb0f6a4e4047cfa9b90fe66d1f0113d471d50f74e60cbaaa70c2b8334d55",
      "english": "I'm a ninja. Not a certified accountant!",
      "translator_note": null
    },
    {
      "id": "msb_00065380",
      "source_words_sha256": "7669166e05072dd1e4cacf9e228c9a9b0df82456d6450f945fbf298b14868e78",
      "english": "Don't get involved with Ayame. Nothing good EVER comes of it!",
      "translator_note": null
    },
    {
      "id": "msb_00065438",
      "source_words_sha256": "d70d2b7bc796dc40e8e956523872d92a1a430e808f2464969aa8306ec0bab049",
      "english": "Hey, Shinpachi. Come on. Calm down a little.",
      "translator_note": null
    },
    {
      "id": "msb_0006546C",
      "source_words_sha256": "593087d0511698b2e89e164da36b726d9a460a27d10d7ad3ca5027c1bc2cbd2e",
      "english": "...Shinpachi.",
      "translator_note": null
    },
    {
      "id": "msb_00065494",
      "source_words_sha256": "d996f3a54794b600916cf94a80614a569dbc53dac647e98ff58d9f55854cf5e5",
      "english": "Saw Otsu, the idol, earlier. She really IS cute...",
      "translator_note": null
    },
    {
      "id": "msb_000654E8",
      "source_words_sha256": "8f7305f5a265aaf143bc44d4126e8c23cd0cfdbfde24f4eb7ce69c3945af702f",
      "english": "W-where...? Where was it again?",
      "translator_note": null
    },
    {
      "id": "msb_0006560C",
      "source_words_sha256": "4aa5ac67e53755256cc0a5ac4fba32457b88fef0966ab8937e354d4f48e435f2",
      "english": "Found Otsu? Oh, good.\fIdols have it rough. Chased by stalk... I mean, devoted fans like you!\fGlad I'm just an ordinary girl!",
      "translator_note": null
    },
    {
      "id": "msb_000656C8",
      "source_words_sha256": "65447fbc67bf580a7fcd9a6a6be77c958b386f2affc16b1e66e2c9720a206f64",
      "english": "W-what?! Otsu?!\nWhere?!",
      "translator_note": null
    },
    {
      "id": "msb_00065710",
      "source_words_sha256": "7d46fb0256ae8ac4d4357e8044631f73beddd95c745888cb6c236c95bfa23ca8",
      "english": "Hiding it won't help you!",
      "translator_note": null
    },
    {
      "id": "msb_00065730",
      "source_words_sha256": "e498ec5f69513a7214c0e85d76635fbe80720cfd972ff7ba546de6fb918ff650",
      "english": "How am I meant to calm down?!",
      "translator_note": null
    },
    {
      "id": "msb_0006578C",
      "source_words_sha256": "7fe489bfb471c46813e57aac39e37b101d02e2ad601a749f4a37bafea1a9ffb6",
      "english": "Hah, hah... Otsu...",
      "translator_note": null
    },
    {
      "id": "msb_00065814",
      "source_words_sha256": "f3baa523116f5db35ab1160ebc7e783d2cb602973c00fcf592e656201b6760f4",
      "english": "...You really do change.",
      "translator_note": null
    },
    {
      "id": "msb_00065870",
      "source_words_sha256": "259c0407fa501b07094443e70055e5d0da5dec01b770ce4653d6274efaf4e527",
      "english": "Oh! Captain!",
      "translator_note": null
    },
    {
      "id": "msb_00065884",
      "source_words_sha256": "69b83bbd034af6296e52ec215b502542e105b348186772fdbf3d6bd26d204b87",
      "english": "By the way, Captain! Saw Otsu earlier.",
      "translator_note": null
    },
    {
      "id": "msb_00065954",
      "source_words_sha256": "1f870b99735d68fa496671f3bd0ad18f9a91d666ed3618daf065fcb24da6ac82",
      "english": "Captain! You found Otsu, then!",
      "translator_note": null
    },
    {
      "id": "msb_0006599C",
      "source_words_sha256": "f484e7367ddbfb9bcaa09576d554a9c1fbd3bc8f4b9b5b7ee6609959b67f8775",
      "english": "Oh, it's the Otsu fan-club... Good work today.",
      "translator_note": null
    },
    {
      "id": "msb_00065A50",
      "source_words_sha256": "38902215ed03d64a988feb1c91a7422f90c2397aad96f783e8c7ba7784f7d111",
      "english": "I know. Quit worrying about me!",
      "translator_note": null
    }
  ]
}
