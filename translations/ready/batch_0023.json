    {
      "id": "msb_00058BA4",
      "source_words_sha256": "f24bfa0d35e696163ce3b41b43a3a7113d52a1440bd9cfa2185e053b3169a2e5",
      "english": "Aren't you police too?!",
      "translator_note": null
    },
    {
      "id": "msb_00058BCC",
      "source_words_sha256": "bfbdbd2a7c32b538ae2c87dfc915c894b426f061a57e0cbe5bb70e4d252b649f",
      "english": "The famous civil-servant specialty! Passing the buck!",
      "translator_note": null
    },
    {
      "id": "msb_00058BFC",
      "source_words_sha256": "70a4f4932b33f01e38f442dae6951a7ebfbff97b41dbf1768741618514913fd6",
      "english": "Sorry for being an old man! Hmph! I'll find him myself!",
      "translator_note": null
    },
    {
      "id": "msb_00058C34",
      "source_words_sha256": "6ae92c8d6bcdc19a5ba02e621447b87a4ca11f8fc1b6789a33ec422bda54ef4f",
      "english": "Saburo! Where are you?! Come home!",
      "translator_note": null
    },
    {
      "id": "msb_00058C6C",
      "source_words_sha256": "a42487cfbaea75d895c15a751f438b837a21a290cda75dc643eac672b8c8f79b",
      "english": "No sign of him.",
      "translator_note": null
    },
    {
      "id": "msb_00058CA4",
      "source_words_sha256": "d2f5074420451f32981b8793161ff5dd446008cd9b8a091a98784aef9bc68eb2",
      "english": "Hmm... Think I've met him somewhere too.",
      "translator_note": null
    },
    {
      "id": "msb_00058CCC",
      "source_words_sha256": "e2cfe2ba24e7217cdb3302c55b36b453cb1ecb15af8401244ab2aec8d72937ff",
      "english": "Busy finding our commander. Find Saburo yourself.",
      "translator_note": null
    },
    {
      "id": "msb_00058D10",
      "source_words_sha256": "3a28765e73c74539f94ccd0a8a1f693f4bfd2c47a255caf930d90d878aaaaadf",
      "english": "We're police. Different duties.",
      "translator_note": null
    },
    {
      "id": "msb_00058D2C",
      "source_words_sha256": "93fc1e8b628cb58a6ce355a40c29f223c504d6120f70ef0057676cac6c6afa09",
      "english": "Shall I cut him down, Hijikata?",
      "translator_note": null
    },
    {
      "id": "msb_00058D80",
      "source_words_sha256": "1fb00de279072266bb23b45b8f5bf30b27f37d486342ff7dbd990f8378cc6147",
      "english": "What? You lot got game over?",
      "translator_note": null
    },
    {
      "id": "msb_00058DA4",
      "source_words_sha256": "4a2af575ddb0715b9de476dbe94b7f158ef796a863fd69a8ae7a4949147d9fcf",
      "english": "What are you saying?!",
      "translator_note": null
    },
    {
      "id": "msb_00058E30",
      "source_words_sha256": "41f4e4807778a3d4da845e4c37c9c41702f4156efe041ab30e98e493c4240102",
      "english": "What is this? A stalker-training game?",
      "translator_note": null
    },
    {
      "id": "msb_00058E5C",
      "source_words_sha256": "aa09d9645c18604702196883a8104b67e65f4b10b80e7137b24fea1c44c4e058",
      "english": "Yeah, yeah. Clear it before you complain.",
      "translator_note": null
    },
    {
      "id": "msb_00058E90",
      "source_words_sha256": "74871490898cba6d1f900acc48b61510b54128175ae024e1b3361b9ccbe163d8",
      "english": "Yep. Game over.",
      "translator_note": null
    },
    {
      "id": "msb_00058EA8",
      "source_words_sha256": "16a55cca7feadd66874e7cb311954f0029f391595734483ccc8e3348c4956a45",
      "english": "Hey, you. Give it another try. Sort of rooting for you.",
      "translator_note": null
    },
    {
      "id": "msb_00058EE8",
      "source_words_sha256": "da28b8754338d1a4d9f08bab7fa189966e816cde3e5d683efdd6a9474ac25f71",
      "english": "Police! Coming in.",
      "translator_note": null
    },
    {
      "id": "msb_00058EFC",
      "source_words_sha256": "80c0e86c65e743f42f55db4ac24b7c65d04ba051e0536e4739a86816f7ec2832",
      "english": "What?!",
      "translator_note": null
    },
    {
      "id": "msb_00058F0C",
      "source_words_sha256": "e4727a85ac88ff7f2a412e87315e093f85cdaa5ab0f57c8193e0017a7556bb6d",
      "english": "Hey, Kondo! We've been looking!",
      "translator_note": null
    },
    {
      "id": "msb_00058F2C",
      "source_words_sha256": "70e93a4d0b56670febffe8129d8f1ac6d952dbd5f29c059e6f7218f69b9b07f8",
      "english": "Where else?!",
      "translator_note": null
    },
    {
      "id": "msb_00058F40",
      "source_words_sha256": "963ffd71b15a01e398ca764509964bd2139ae30c74c82a36b46fd0a9c00d9a82",
      "english": "Kondo. Don't make so much trouble for us.",
      "translator_note": null
    },
    {
      "id": "msb_00058F70",
      "source_words_sha256": "04a128bba6cac3442f20ca7a9dbe7b7214e9b00cb9b5f6a7f807a701a055e2f9",
      "english": "Can't stand seeing you embarrass yourself any more.",
      "translator_note": null
    },
    {
      "id": "msb_00058FA4",
      "source_words_sha256": "ca3297fa827f71a66f7d15a7a70a61c4e4ebd1fc42dc11eb8a571f3d95c94f3c",
      "english": "Sorry. I'll drag you back if I must.",
      "translator_note": null
    },
    {
      "id": "msb_00058FD0",
      "source_words_sha256": "be3ac3240656762744772c8cb18df190f93971010c60ea5893a772bdbf5bb6a3",
      "english": "Don't tell me... Here? Now?",
      "translator_note": null
    },
    {
      "id": "msb_00059000",
      "source_words_sha256": "d052eea7e2760d93d1dbcbd58db1ced91a88f4e1e3d7911f1232467f3e46b4ee",
      "english": "Don't want to fight you, Kondo. But we'll have to settle this.",
      "translator_note": null
    },
    {
      "id": "msb_00059044",
      "source_words_sha256": "63f389ff2585bda0d42895661aaa1b65071ea0521c3c34d181bdd13f2a463c3f",
      "english": "Just this once, we'll fight!",
      "translator_note": null
    },
    {
      "id": "msb_00059060",
      "source_words_sha256": "8b33ed042198c58a25b02cee642fd623a4def9be1974c39c9a865706dfdb9cbe",
      "english": "Don't stop!",
      "translator_note": null
    },
    {
      "id": "msb_0005907C",
      "source_words_sha256": "49da1b747d3db95f8818884835fbc5a0233d0c5c9efe2cd502587c272dff0589",
      "english": "What?! Loads of them?! Since WHEN?!",
      "translator_note": null
    },
    {
      "id": "msb_000590B4",
      "source_words_sha256": "ac7701f4a995a8a79cd020e204099c0eacd080cd89c507d27e4d8aa616782989",
      "english": "Obviously skipping work...",
      "translator_note": null
    },
    {
      "id": "msb_000590E0",
      "source_words_sha256": "39b17c96d71f330d691e0f5dfc7739161ac20919ad0d99edee82d33690cff05a",
      "english": "What's... this pressure?!",
      "translator_note": null
    },
    {
      "id": "msb_00059110",
      "source_words_sha256": "9ebda7953d51d8e4f40ad4c367d12e6626749cf5c53d233ed33d37c51556f50f",
      "english": "Can't back down either.",
      "translator_note": null
    },
    {
      "id": "msb_00059134",
      "source_words_sha256": "9162e5774e52db1f20e5fef2f458bc053d6f56a680f262188b2dc168785c16c7",
      "english": "Don't need your help!",
      "translator_note": null
    },
    {
      "id": "msb_00059150",
      "source_words_sha256": "253fcc6999e24974edba4344cb808b06c22fb265d1191bcb0b2dc9ce325baa8d",
      "english": "What?",
      "translator_note": null
    },
    {
      "id": "msb_0005915C",
      "source_words_sha256": "b6332cc8fdc9de4e443927eb6993393a8742e2442c1d4b60bc02c1ff91a6db55",
      "english": "Sougo, what are you thinking?",
      "translator_note": null
    },
    {
      "id": "msb_000591A4",
      "source_words_sha256": "11da2192750814ccf13a8d98811e2d2e8f994f2a10023be8c6a15c1aa8525ef5",
      "english": "Hmph. Fine. Do what you want.",
      "translator_note": null
    },
    {
      "id": "msb_000591C4",
      "source_words_sha256": "b78e1a179806acf88607c9106d43ee2d28a8f8f875407b8634ddfb510655d7e1",
      "english": "Fine! I'll take you both on!",
      "translator_note": null
    },
    {
      "id": "msb_000591F4",
      "source_words_sha256": "440baaaf0faf4dc72451ab712f466612a6c8c1fef58a7718fe6894b319a52099",
      "english": "YOU'RE the unreasonable one!",
      "translator_note": null
    },
    {
      "id": "msb_00059214",
      "source_words_sha256": "3c3db43d201771ef1f7ae6b7ece48652d58627dde75b9ba04edaad82dadb4e23",
      "english": "Kondo, it's settled.",
      "translator_note": null
    },
    {
      "id": "msb_00059230",
      "source_words_sha256": "a9ee6784d406cf77d24c27d1e29e9c4f1850a2e050849a695d200186ddc04593",
      "english": "Says the loser!",
      "translator_note": null
    }
  ]
}
