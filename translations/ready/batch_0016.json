    },
    {
      "id": "msb_0003C58C",
      "source_words_sha256": "42b3f9ee58ad775f458b2e168d1b76e53927bf62060d08ca83dbff6a17be6331",
      "english": "Oh. Then that's fine.",
      "translator_note": null
    },
    {
      "id": "msb_0003C5CC",
      "source_words_sha256": "0ac471c0dfcd2e445d2283ec5b7fb0eff5efad9a05042f5c8f622b8c6d70a8e7",
      "english": "Right! I forgot!",
      "translator_note": null
    },
    {
      "id": "msb_0003C5EC",
      "source_words_sha256": "604c005d16ee1234ae3d512e39c5d42c8eb170482a052e65b49e30ffa9869189",
      "english": "See you, Otae!",
      "translator_note": null
    },
    {
      "id": "msb_0003C608",
      "source_words_sha256": "9421fe5a22bf8b59d88f65808c461b4a8e593f4c63fb365d2c314a2accdfd0cf",
      "english": "What's inside?",
      "translator_note": null
    },
    {
      "id": "msb_0003C620",
      "source_words_sha256": "b984f90689ba0d96cf945dfc0f3232a74c17da7d8369de2506fcdb615d0e7720",
      "english": "All kinds of Gin Tama, huh.",
      "translator_note": null
    },
    {
      "id": "msb_0003C644",
      "source_words_sha256": "80400aa79e74720a6b3a1a46820bf861f56f5d7080f0330bfca3f5808031b1bf",
      "english": "Anyway, let's sort this out.",
      "translator_note": null
    },
    {
      "id": "msb_0003C668",
      "source_words_sha256": "de5fcd1249f3727a43dc655040be40c2078169e61077313131620062286e0e47",
      "english": "Agreed. We've got bigger problems now.",
      "translator_note": null
    },
    {
      "id": "msb_0003C698",
      "source_words_sha256": "adb23a93650dfe517e3527d076013ba805c2f16ab15fc0b56c7f26cc0ceae076",
      "english": "Anyway, we need Dragon Tama. Fast.",
      "translator_note": null
    },
    {
      "id": "msb_0003C6D8",
      "source_words_sha256": "f2551888f23b1f6e98d8b87a5be0a0d0fe03a4c7430ccaebf8aff8fcac41795f",
      "english": "Don't touch me, gorilla!",
      "translator_note": null
    },
    {
      "id": "msb_0003C6F8",
      "source_words_sha256": "efc6bb12798403e8264ee7803ef2765ef9dfa99502bfe0455ffdfecb13e142ed",
      "english": "Splendidly fought. Please accept this.",
      "translator_note": null
    },
    {
      "id": "msb_0003C740",
      "source_words_sha256": "fe8e79d6676b4a7665e8d6eed2ef43150fea7e76e995f2f092ebf9ec2ec3acfb",
      "english": "Not YOU!",
      "translator_note": null
    },
    {
      "id": "msb_0003C758",
      "source_words_sha256": "bdf4b50b5f65c71acca6cb6667ff9d965ec6ab89d8c2993f9a427ed99082d921",
      "english": "This Gin Tama will surely protect you from all sorts of misfortune.",
      "translator_note": null
    },
    {
      "id": "msb_0003C79C",
      "source_words_sha256": "b3b7b35a738036e519825e1a1397d7b23b2b5d7c1288b03377f789c7ffa867c3",
      "english": "Isn't the saying, believers get made fools of?",
      "translator_note": null
    },
    {
      "id": "msb_0003C7C8",
      "source_words_sha256": "689d910833060dd3a59093974ed24bb6c659b4fb0462749d80f8bb71222f0462",
      "english": "Yes.",
      "translator_note": null
    },
    {
      "id": "msb_0003C7D4",
      "source_words_sha256": "7e59743e13e4911eb2fec9b71b7c517fc6f248037b37eb0bea22fa4586be2395",
      "english": "Otsu's father.",
      "translator_note": null
    },
    {
      "id": "msb_0003C7EC",
      "source_words_sha256": "424c488ae4a59018b98c3261acf8105a93aa66e34ebf0e6e8b504ee4803d2865",
      "english": "It does NOT add up!",
      "translator_note": null
    },
    {
      "id": "msb_0003C800",
      "source_words_sha256": "ea1724684d7841f5413f173c1fc0486d47d0f26954043953971f38d13c11598f",
      "english": "He collapsed outside the dojo, so I helped him.",
      "translator_note": null
    },
    {
      "id": "msb_0003C834",
      "source_words_sha256": "e2183105fc1fe843764ab342d2cf10cdb5b31359bbf399e1d0bf1f2b1d285f35",
      "english": "Nitpickers get nowhere.",
      "translator_note": null
    },
    {
      "id": "msb_0003C84C",
      "source_words_sha256": "59b9cf25d00e72a8e825c5817e3d3f970cbaded74eefd0f71a6cb01fc8e9c511",
      "english": "Yes, that's right.",
      "translator_note": null
    },
    {
      "id": "msb_0003C864",
      "source_words_sha256": "e61dfe4f554d487f0edc097f823ce4765e8ebb1f4e125078f7b9ab3852ca4ef2",
      "english": "I'm serving time.",
      "translator_note": null
    },
    {
      "id": "msb_0003C8C8",
      "source_words_sha256": "65509061ab03f81fe270162ce9493e4e9c58002008105eb747c38d0158dddb1f",
      "english": "Not arresting him now?",
      "translator_note": null
    },
    {
      "id": "msb_0003C8E0",
      "source_words_sha256": "8fc1a03d761ca5619750686b2ee601d18b76e94238b9b52d5f9ab0f5641f5697",
      "english": "Thank you!",
      "translator_note": null
    },
    {
      "id": "msb_0003C8FC",
      "source_words_sha256": "44d2ae1a8015da917666095ce936bce610b4791e498ba3d5e27dc1141be59979",
      "english": "What a waste of time.",
      "translator_note": null
    },
    {
      "id": "msb_0003C91C",
      "source_words_sha256": "e4a5ccd22fd925e51e0800cb2ca9bcc5dde1f1c9fb61ba54804bcf6a76488d65",
      "english": "Oh, Yamazaki. What's up?",
      "translator_note": null
    },
    {
      "id": "msb_0003C938",
      "source_words_sha256": "6c868754745911849aceda7939fc56841d3d32afcd63832bc7983b14dfb6c214",
      "english": "A murder?!",
      "translator_note": null
    },
    {
      "id": "msb_0003C948",
      "source_words_sha256": "413e44f621dc25877b803c37236984526ded13a60cc8bf212a3a8e211dd660b6",
      "english": "Not sure yet, but it could be related.",
      "translator_note": null
    },
    {
      "id": "msb_0003C970",
      "source_words_sha256": "aed0320561588de6add1101901a58f31ac1de61b9e23327062cf1ef1c6427c67",
      "english": "Right! Let's go!",
      "translator_note": null
    },
    {
      "id": "msb_0003C984",
      "source_words_sha256": "989cc219acf255e4c49808d6dfe6117a0e96250453543c2a870b960e60ed1ca2",
      "english": "Hmm...",
      "translator_note": null
    },
    {
      "id": "msb_0003C99C",
      "source_words_sha256": "23e26111a1312bcf564b1fea30eb0b0fddcac0998cd4b9dc57acd45f723642bf",
      "english": "Found Dragon Tama?",
      "translator_note": null
    },
    {
      "id": "msb_0003C9B8",
      "source_words_sha256": "ad8cc9e8e0b565669d13fe584a514dbed0a25779657854e02625fc74311712e8",
      "english": "Orb murders?! What's that?!",
      "translator_note": null
    },
    {
      "id": "msb_0003C9F4",
      "source_words_sha256": "db5a31fee0cf825102897d256ebe8eee31f371bd5d8566392a8c676de3103084",
      "english": "Yamazaki. Where?",
      "translator_note": null
    },
    {
      "id": "msb_0003CA0C",
      "source_words_sha256": "46d36d77f23f3d5f6b09022ea2876c327333936befa17d3c48707644e1edd5eb",
      "english": "Right. Let's go look.",
      "translator_note": null
    },
    {
      "id": "msb_0003CA28",
      "source_words_sha256": "07cb4dcd50e381e32a7ba1e3f4862ea2e7f489a499bff03c14d204587c23b6cd",
      "english": "Where next?",
      "translator_note": null
    },
    {
      "id": "msb_0003CA40",
      "source_words_sha256": "0a224f7392d9321c33f9fac35a9be9371d6af8af479ab4ecafce7fc2436bc75f",
      "english": "That's a strange case.",
      "translator_note": null
    },
    {
      "id": "msb_0003CA5C",
      "source_words_sha256": "bd8af5f5f987745672daa9a9d6fd55d4da55eb6f2a53aeb3b0251c94c385dd9a",
      "english": "Big trouble!",
      "translator_note": null
    },
    {
      "id": "msb_0003CAC0",
      "source_words_sha256": "91579737a67767b7c14ee27aeceef5db420c954fa8372c75c90a8e86ad68e760",
      "english": "Serial murders. All the victims collect Gin Tama.",
      "translator_note": null
    },
    {
      "id": "msb_0003CB1C",
      "source_words_sha256": "c597531b5aff0a13b450042e67fba62302c40266dd05220dce6c74d7c3fbc5b5",
      "english": "Whose side are you on?!",
      "translator_note": null
    },
    {
      "id": "msb_0003CB3C",
      "source_words_sha256": "59041c454e66b9b4e960b150255f102550287aff675c77e4dd3123a4a71c788a",
      "english": "Unfortunate?",
      "translator_note": null
    },
    {
      "id": "msb_0003CB50",
      "source_words_sha256": "6b49bea5e9451fb4e046bbdef73af0fbc20a4fd75958b61b98cbe99a4a33d376",
      "english": "Then I've got a complaint too!\fHey, player! What the hell are you doing?!",
      "translator_note": null
    },
    {
      "id": "msb_0003CBB4",
      "source_words_sha256": "35348104b9562eecdc67cb15fe6865c032665300ef798107bf408326481d30fa",
      "english": "Thank goodness! Otae wins!",
      "translator_note": null
    },
    {
      "id": "msb_0003CBDC",
      "source_words_sha256": "4d425354a7e4576dd29ddf1f78533dcfa7314cd4271e541434d42ff935873936",
      "english": "What a surprise!",
      "translator_note": null
    },
    {
      "id": "msb_0003CBF4",
      "source_words_sha256": "97254f90a6ce030c8b119f4273e61e63fe39391940d9dffdc9b70cc86934efde",
      "english": "Otaeeee!",
      "translator_note": null
    },
    {
      "id": "msb_0003CC08",
      "source_words_sha256": "f8f34f5e543001c171af851561d799c396fa60708ae1ab11ee0afe74151cfe93",
      "english": "Ahh, what a relief.",
      "translator_note": null
    },
    {
      "id": "msb_0003CC28",
      "source_words_sha256": "4979ca5569fb54cdae249b3fa8676b0d8f1310dbeced730af47fac55d4aabd82",
      "english": "It's your fault, Hijikata.",
      "translator_note": null
    },
    {
      "id": "msb_0003CC44",
      "source_words_sha256": "a91793c80cee16fe155dec17de54177089e2f1d7f6c8a6c15035b75e56feb343",
      "english": "But one thing is unfortunate.",
      "translator_note": null
    },
    {
      "id": "msb_0003CC68",
      "source_words_sha256": "69b94849ede45783a96bcece52ca6202af34e4d5911cd819e2b7dcf811ae7b13",
      "english": "That's game over.",
      "translator_note": null
    },
    {
      "id": "msb_0003CC84",
      "source_words_sha256": "dc030eba1b3782591c2b0eec6cc9fa25cc7d19f480f764ecd19d7972dff9ff8c",
      "english": "What's wrong? All of you here...",
      "translator_note": null
    },
    {
      "id": "msb_0003CCB4",
      "source_words_sha256": "b037c04989a0946c42f0eec11ed115d0d339560dc124f23d8c355c4b10f4cf1e",
      "english": "Shut up, gorilla!",
      "translator_note": null
    },
    {
      "id": "msb_0003CCDC",
      "source_words_sha256": "319e7a2977c4f5000523a6ff3a87beb32a4b20a4a4fd6ce9fcbf0d0ccc69ebd2",
      "english": "Otsu's father already left.",
      "translator_note": null
    },
    {
      "id": "msb_0003CD30",
      "source_words_sha256": "a3bf9ba80a9d6ab951429059a6d4ba4db64dc795455fb1aa475a40ceda818cae",
      "english": "Name?",
      "translator_note": null
    },
    {
      "id": "msb_0003CD3C",
      "source_words_sha256": "3566663b9884e062931c0c088e95baa5bd3c30439adfc4cbb70f5794e6a1f44d",
      "english": "Never mind. Who found the body?",
      "translator_note": null
    },
    {
      "id": "msb_0003CD64",
      "source_words_sha256": "b8815bfc0af661bb9418d4c41f60671e7d1a0a4f0239660fac1f1af34717e3f5",
      "english": "Be honest. Did you kill him?",
      "translator_note": null
    },
    {
      "id": "msb_0003CD88",
      "source_words_sha256": "0b5ca95bbbc85c88f5a6c9f1b043c1e012b66428a306cfc0dff71e000d39c3c8",
      "english": "First finder is the shadiest.",
      "translator_note": null
    },
    {
      "id": "msb_0003CDAC",
      "source_words_sha256": "bc0178230149a9b7479131e576f06b191c4f1a4e4f62632649a955e3832cb6f8",
      "english": "How was it when you found him?",
      "translator_note": null
    },
    {
      "id": "msb_0003CDCC",
      "source_words_sha256": "8254a6d09883407728d5a3ce497c391b3f70ef56cbb80653003452b45501dba8",
      "english": "Know the guy?",
      "translator_note": null
    },
    {
      "id": "msb_0003CDE0",
      "source_words_sha256": "64317ff42f9a3be07beacb8a93c7cd979b4a939a64a7ec8c3e5135718aa892bc",
      "english": "Suspicious. Spit it out, Punch Perm.",
      "translator_note": null
    },
    {
      "id": "msb_0003CE80",
      "source_words_sha256": "96f5f89aabb152a10f69bbb38e593de4ed7cb061418749184ad44917e00e83bc",
      "english": "Shut up! Stay put!",
      "translator_note": null
    },
    {
      "id": "msb_0003CEA0",
      "source_words_sha256": "6cf583855173f346c257937e6fcaaafd98fd77367c36297311b0b11f104928da",
      "english": "Where'd these guys come from?",
      "translator_note": null
    },
    {
      "id": "msb_0003CEC8",
      "source_words_sha256": "37a19af9c0f443eba858209f56405816dbe737eb9afc422d9e80bb83f9704498",
      "english": "Quit screwing around!",
      "translator_note": null
    },
    {
      "id": "msb_0003CEDC",
      "source_words_sha256": "765e80fce866fcda375c22e2f7927caf38d10cee988f9fdd271fb2e2b97e0aac",
      "english": "Hello. Punch Perm Inoue here.",
      "translator_note": null
    },
    {
      "id": "msb_0003CEF8",
      "source_words_sha256": "7d019d0f4d8ab3e50a7deba8fb59eb3e33ae6a3c3bdbf267289e96ba8d758f7d",
      "english": "What?! Wasn't me!",
      "translator_note": null
    },
    {
      "id": "msb_0003CF18",
      "source_words_sha256": "833354bf2b6c6ee5de241ffbd937f5e6033b401c993de463727f797a4493ea3f",
      "english": "Are you idiots?! Too many TV dramas!",
      "translator_note": null
    },
    {
      "id": "msb_0003CF80",
      "source_words_sha256": "c9d28b316d4a0d30889fa5c2073fd56227c4ffe0fc60b29711cfaf9a3ded2da8",
      "english": "Don't know! They all look alike.",
      "translator_note": null
    },
    {
      "id": "msb_0003D000",
      "source_words_sha256": "b28a6aac136f2e8f25effdaf17e6eadcb44656ce85519f96678647cc402562ad",
      "english": "Believe me! Nothing to do with the orb murders!",
      "translator_note": null
    },
    {
      "id": "msb_0003D030",
      "source_words_sha256": "d1a0b693798ab790dbb89be9f2232d3e6b5505df1dc3e913c115d577749525c5",
      "english": "I didn't do anything!",
      "translator_note": null
    },
    {
      "id": "msb_0003D060",
      "source_words_sha256": "f07b072b258f4686fcf8bbd5b9009ca49d91429c60e39f21b6b0c9f4078408bc",
      "english": "You're not taking me! Come on, lackeys!",
      "translator_note": null
    },
    {
      "id": "msb_0003D08C",
      "source_words_sha256": "18a2b65fec35e2837468f31c08f3495dc7e305370c39600793ae4b2d3fe59cdb",
      "english": "Get them, lackeys!",
      "translator_note": null
    },
    {
      "id": "msb_0003D0A8",
      "source_words_sha256": "0bf8f7f51a4cc8763add044f06d682372ee78c8d0645fc88be1d0b539f31e336",
      "english": "Yes?",
      "translator_note": null
    },
    {
      "id": "msb_0003D0B4",
      "source_words_sha256": "a1ad035a93e876fd3c042ffbbb2c6639a2eaa50d6811590598dc784bced2e51a",
      "english": "You called, boss!",
      "translator_note": null
    },
    {
      "id": "msb_0003D0C8",
      "source_words_sha256": "0b060140b568e1c96c1f3d94fa1bd1676e0f0062516bbcadb63fda8e2f0e1fe2",
      "english": "Guilty, then.",
      "translator_note": null
    },
    {
      "id": "msb_0003D0E0",
      "source_words_sha256": "eb06ecbd6729f0b2ee8a872beb94466ef69527c6f4b7d3f5245e9956a548c63c",
      "english": "First to find the body.",
      "translator_note": null
    },
    {
      "id": "msb_0003D0F8",
      "source_words_sha256": "66ec0e6b7f858ac3a83e7f58befd4f38508d8fca3a1fa25e033f9c456052fbf7",
      "english": "Looks like he's not involved.",
      "translator_note": null
    },
    {
      "id": "msb_0003D11C",
      "source_words_sha256": "a31729f955d67c7e2b2f77c03bb0546a2608ed03a1ca0c8e82c8d60bac873c10",
      "english": "One of the Chatoran.",
      "translator_note": null
    },
    {
      "id": "msb_0003D134",
      "source_words_sha256": "7c486d5ba572db515a08f63dc8d989ccc571a49ea93367130bb8016f99275fdc",
      "english": "Um, Tama... No, was it Mike?",
      "translator_note": null
    },
    {
      "id": "msb_0003D158",
      "source_words_sha256": "f316833ffbb77b0e53e116f564abee38c06c24d25ffbf59499f32fe71b132e3f",
      "english": "A customer. I'll bring him.",
      "translator_note": null
    },
    {
      "id": "msb_0003D174",
      "source_words_sha256": "b627930b43ca04306d3fb110e6278d1880ff277cf98920bb3bb6789fdfa8eace",
      "english": "Yes!",
      "translator_note": null
    },
    {
      "id": "msb_0003D1E0",
      "source_words_sha256": "e1f8805448c7ede81e0cc9f50deed63fcb8d09385a04d1725c3c811d9bd63251",
      "english": "Just hand them over!\fThat's all?",
      "translator_note": null
    },
    {
      "id": "msb_0003D204",
      "source_words_sha256": "7a9b8b1ac62a8cbb1d464eaa4eef21eb1306dea5177a216eef9bc2e8bdca9802",
      "english": "Pretty lousy.",
      "translator_note": null
    },
    {
      "id": "msb_0003D214",
      "source_words_sha256": "06f1788fd48cc4eb43d3a0210d089d68ee6c6d37bb1f10fb4da42c005678becb",
      "english": "Gin Tama deals?!",
      "translator_note": null
    },
    {
      "id": "msb_0003D230",
      "source_words_sha256": "cd5822f91733dfbbba08ac7b720dc79d864c78113340fde5faf9a669164ee7cb",
      "english": "You were trading Gin Tama?!",
      "translator_note": null
    },
    {
      "id": "msb_0003D2B0",
      "source_words_sha256": "6c8dd284461f2d079eae3053c187e0cd70f957636deb409b4b2beebe8f0e31fb",
      "english": "This better not be a false lead.",
      "translator_note": null
    },
    {
      "id": "msb_0003D314",
      "source_words_sha256": "8e790c721ef52d6311f26b77e99c39ac0f468dc65a48d7e3b6c2023106f12ec0",
      "english": "Who?!",
      "translator_note": null
    },
    {
      "id": "msb_0003D320",
      "source_words_sha256": "e9b90809467d80683b36ac9312eda95d3accb59b193eeb0012d2144afffcf5dc",
      "english": "To whom?!",
      "translator_note": null
    },
    {
      "id": "msb_0003D32C",
      "source_words_sha256": "492d8aee53215b6180e693fb0ee5ec01ed13cc43c8b57e0f5929f2515457f2ba",
      "english": "Why?!",
      "translator_note": null
    },
    {
      "id": "msb_0003D33C",
      "source_words_sha256": "11027bb99b537160df7d0164e701c42b973724827c831dbba615d2e9b01af37a",
      "english": "Aaah!",
      "translator_note": null
    },
    {
      "id": "msb_0003D390",
      "source_words_sha256": "92ebc8892f4283c75a5a757656a8142c01e0bad1f8541289a577a39859a13935",
      "english": "Ugh! My lackeys lost! Sorry!",
      "translator_note": null
    },
    {
      "id": "msb_0003D3D0",
      "source_words_sha256": "e185956d0583c08e3f3eee3e704f0456193ca16bd2cfb86fdbf3e8bdb714f58d",
      "english": "Give me a break!",
      "translator_note": null
    },
    {
      "id": "msb_0003D3E8",
      "source_words_sha256": "cd7af63a9b3e71bd11aae36c7381579978f1f2f4da7739345827affc6c998046",
      "english": "That's all of them!",
      "translator_note": null
    },
    {
      "id": "msb_0003D400",
      "source_words_sha256": "0be865e0a24ac94f4da00e38b63bfbde454e9e7b449a955826ef04ebc199f362",
      "english": "Rough day. The Gin Tama deal got canceled, too.",
      "translator_note": null
    },
    {
      "id": "msb_0003D43C",
      "source_words_sha256": "a0d92e7ef68c7bd2e6107fbad339f83cb2aa87a835efce30746d7215a63b6180",
      "english": "Oh, damn...!",
      "translator_note": null
    },
    {
      "id": "msb_0003D45C",
      "source_words_sha256": "bcb43c345484d80edf8a79b219707276d0a959558df94d6861984bfb46cf1871",
      "english": "No, not yet! A silver-haired perm-head stopped me.",
      "translator_note": null
    },
    {
      "id": "msb_0003D4CC",
      "source_words_sha256": "8e5e6ae6652453cc972d67db701ceff9545695b1ea1b1cf3a31858f326513f85",
      "english": "No false tip! I swear on my punch perm!",
      "translator_note": null
    },
    {
      "id": "msb_0003D514",
      "source_words_sha256": "344f2c36719bbdafcfc5f57a9dc6727b436b7d14326868aa3cacf375c7b5f6d0",
      "english": "I might get killed!",
      "translator_note": null
    },
    {
      "id": "msb_0003D544",
      "source_words_sha256": "72f475249d2cad250e69a3a34d1db31f99dc746362fc6c40c610a337716a18f0",
      "english": "The orb killer!",
      "translator_note": null
    },
    {
      "id": "msb_0003D554",
      "source_words_sha256": "6ee50d485c7e5490f6b179ba678392e09449cb3c4b6b6a9a7c23d54e3cb11774",
      "english": "I've got loads of Gin Tama!",
      "translator_note": null
    },
    {
      "id": "msb_0003D5A0",
      "source_words_sha256": "9462afc1245a94bbe3f78c994cfd16e2c301348068db324062ab05b2b6100c2d",
      "english": "Right. That's a possibility too.",
      "translator_note": null
    },
    {
      "id": "msb_0003D5D0",
      "source_words_sha256": "c84e1c21ca87e338aab1a42a6a73255b56fe780a9de1c2043cbfab539de7b128",
      "english": "Hold it!",
      "translator_note": null
    },
    {
      "id": "msb_0003D5E4",
      "source_words_sha256": "b60ae9c37b034b2c074596223f992116ae59a55d7d2631283d90752ac58683bf",
      "english": "Broker's the killer? So...?",
      "translator_note": null
    },
    {
      "id": "msb_0003D620",
      "source_words_sha256": "54f41c7e5520a635c948e56836ef5f60b84f5e3c533045c9571e423e7a965d60",
      "english": "Yeah, baby! Good work, lackeys!",
      "translator_note": null
    },
    {
      "id": "msb_0003D650",
      "source_words_sha256": "d0cd356596414807188524d3e18680a6e38fa05b9d78b79298a5705d7d133aa6",
      "english": "Listen up! Don't mess with the punch perm!",
      "translator_note": null
    },
    {
      "id": "msb_0003D680",
      "source_words_sha256": "607ea9589a0e0e9bee80fcb047b9c8b5f2fa54fe4a244a3222c4fdd37a5fb91c",
      "english": "Pathetic. Losing to someone like that...",
      "translator_note": null
    },
    {
      "id": "msb_0003D6CC",
      "source_words_sha256": "fecf6083e1a82b8ddd487db2b93b4e74bafddbaa488e16c52d702036e8ad7b35",
      "english": "Wait. Someone's coming.",
      "translator_note": null
    },
    {
      "id": "msb_0003D6EC",
      "source_words_sha256": "5c5246c3838544a3104028b6349175541a79a816e8120d71df9636a7bb2e47d6",
      "english": "Ah! It's you!",
      "translator_note": null
    },
    {
      "id": "msb_0003D748",
      "source_words_sha256": "1aa190658290e7114c551417f4659d83c1366fd89387d154f6aeedb05fedc6ef",
      "english": "Then we'll look inside.",
      "translator_note": null
    },
    {
      "id": "msb_0003D764",
      "source_words_sha256": "b64c4619c79eccdf50991cbb78767845bfd8a48813bbb91c2b22a3194b7d62da",
      "english": "Hold it! Quit bickering like kids!",
      "translator_note": null
    },
    {
      "id": "msb_0003D7D8",
      "source_words_sha256": "0021229362121e2f55763fc357c31592114e8a93846af6b1abaf34f798ffbf5c",
      "english": "You two fighting would be a disaster!",
      "translator_note": null
    },
    {
      "id": "msb_0003D80C",
      "source_words_sha256": "f78e3455576a8d65e587ab46fefff01325fc2208d8ff4802b635cf640e09a170",
      "english": "I'll fight instead.",
      "translator_note": null
    },
    {
      "id": "msb_0003D860",
      "source_words_sha256": "6d6ad824ad42627bac045610003eac9ab40b3a6c7a4aa87959a411a8cdc5083f",
      "english": "Don't decide for me!",
      "translator_note": null
    },
    {
      "id": "msb_0003D878",
      "source_words_sha256": "3864aafb232a065a7c0eb39bd62aea1af0cce7746b976a8d3d3207045a7dc436",
      "english": "Kelp?",
      "translator_note": null
    },
    {
      "id": "msb_0003D884",
      "source_words_sha256": "1546ffe06740bf5b3d23d511a21cf56a140090bf2d292557502c70d34ef635e3",
      "english": "Where'd Gin go?",
      "translator_note": null
    },
    {
      "id": "msb_0003D8A4",
      "source_words_sha256": "044d20f5c16795db9187f8adc1ff54ea59ce1e6ded7989eede3380afff2b7e0e",
      "english": "What do you want? Get lost!",
      "translator_note": null
    },
    {
      "id": "msb_0003D8D0",
      "source_words_sha256": "ade18d0865647a6b76165347ff47101eb3183743bcd6dfcbb7922ca9743c7ff9",
      "english": "YOU'RE the overbearing one, gorilla.",
      "translator_note": null
    },
    {
      "id": "msb_0003D8F4",
      "source_words_sha256": "9f905f78e500dfbf8dbdf44ea7962ea76d22e5dc128f2698b222b755a414db7c",
      "english": "Hmph! Don't know.",
      "translator_note": null
    },
    {
      "id": "msb_0003D90C",
      "source_words_sha256": "58e7e0e9b323ccb0f605e85289f398f2754d42a9fec58eebd0c51dc3fdbe7ecd",
      "english": "You can't pass!",
      "translator_note": null
    },
    {
      "id": "msb_0003D924",
      "source_words_sha256": "67c94dd528bbcc305263e34902b3a3c2b89217ad92efc03bd3b08f30bc18255a",
      "english": "Want through? Beat me first!",
      "translator_note": null
    },
    {
      "id": "msb_0003D944",
      "source_words_sha256": "071c74964c4ea3d2799ee8a5be123d06d16ad24f9ccb89c830d7e68b181e9d46",
      "english": "Bring it on!",
      "translator_note": null
    },
    {
      "id": "msb_0003D96C",
      "source_words_sha256": "f1f8e2397513c56e5c694309e60a78141d6e9484c1770edca166cb0de471529d",
      "english": "Wanna fight, bastard?!",
      "translator_note": null
    },
    {
      "id": "msb_0003D984",
      "source_words_sha256": "ea210804cbaf25bed230dc0b527de0a027292370c906906c16c27ba289433d8d",
      "english": "Don't wet yourself!",
      "translator_note": null
    },
    {
      "id": "msb_0003D9A8",
      "source_words_sha256": "3d74321805597b8e57a5d1b756f3f0aa1288faa585a9aa8e530ea6ff52d22c36",
      "english": "Fine. But if you lose?",
      "translator_note": null
    }
  ]
}
