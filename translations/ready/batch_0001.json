      "id": "msb_00002748",
      "source_words_sha256": "d410e04bb8c2f0abfef4324eda5dcd22d7742da895fc115e2627a5c8e49e1f02",
      "english": "Why do we Amanto speak Japanese?\fIt's the universe's standard language.",
