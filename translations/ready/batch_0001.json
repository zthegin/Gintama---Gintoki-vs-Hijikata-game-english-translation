      "translator_note": null
    },
    {
      "id": "msb_00002600",
      "source_words_sha256": "9171fb911e8bbfc5394f16e71527db73206315fa510a0eb7d0dfeff5e00cb8c9",
      "english": "I see...",
      "translator_note": null
    },
    {
      "id": "msb_0000261C",
      "source_words_sha256": "a9fa082b7cb8778791a3c2717f5060bd867f24b02d48ef6c71254fb2e304ca9e",
      "english": "Yes...",
      "translator_note": null
    },
    {
      "id": "msb_00002688",
      "source_words_sha256": "2c01d9b212715797e3e1e0904a21685ad994d31f4e1ea7c7d528ac1e811baa22",
      "english": "Something's always struck me as odd.",
      "translator_note": null
    },
    {
      "id": "msb_000026AC",
      "source_words_sha256": "812f7162e65498a8593669e1e5c78d79478b3af61a857400a7c373ef417d1cbc",
      "english": "Why do Amanto speak Japanese?",
      "translator_note": null
    },
    {
      "id": "msb_000026CC",
      "source_words_sha256": "a4330c2d5d0f461821f6393dd747cd83a06de756dee48c575c37878ec4c83fba",
      "english": "Didn't know that...",
      "translator_note": null
    },
    {
      "id": "msb_000026EC",
      "source_words_sha256": "633cd0b5ecb85e41deb8ac5412dbc3dd02247044bdc4a8e70f759d44b1e58bc2",
      "english": "Liar!",
      "translator_note": null
    },
    {
      "id": "msb_000026FC",
      "source_words_sha256": "806d1839770f82dd2eed22d47a1b35bcd1caa7a66a9b33a95bb478d5ad663ece",
      "english": "What?",
      "translator_note": null
    },
