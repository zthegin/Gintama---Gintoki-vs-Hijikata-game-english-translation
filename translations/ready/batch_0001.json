      "english": "Good for you.",
      "translator_note": null
    },
    {
      "id": "msb_000029A4",
      "source_words_sha256": "6576606900081f44a7f78939b7d1e71eef32a16ccb6f84f1430b2f62afa6f15c",
      "english": "Don't say terrifying things so casually!",
      "translator_note": null
    },
    {
      "id": "msb_000029CC",
      "source_words_sha256": "0962d67a8355f442eb7901f48b8820c03be7efb81a26c22252b1d7030c6f871d",
      "english": "Nice planet. Easy living. I like it.",
      "translator_note": null
    },
    {
      "id": "msb_000029FC",
      "source_words_sha256": "ec54069b70d71ac7f96bf7969fd8035fa45b99e34fbe86e43252cf0ee4fc85a5",
      "english": "Maybe I'll invade it.",
      "translator_note": null
    },
    {
      "id": "msb_00002A28",
      "source_words_sha256": "dde0fd7c15a083f2f6975d552d7205b8c5893bcbc8b2410e8e7bc081cc83e219",
      "english": "You'll be bland.",
      "translator_note": null
    },
    {
      "id": "msb_00002A78",
      "source_words_sha256": "84a4d7f967460e68a9a16f401b9626114bfafa1576b6b5d51b543570100d3ea6",
      "english": "What a pain... Maybe get contacts.",
      "translator_note": null
    },
    {
      "id": "msb_00002AAC",
      "source_words_sha256": "4af6b42045ef7d2ef1dd2704a4878b6f0dc9f9abf9e0cc3572384153f16f3441",
      "english": "...Better not.",
      "translator_note": null
    },
    {
      "id": "msb_00002AC8",
      "source_words_sha256": "2a97158ea5b20e439493ecf7017b236fb9920ad07c663582743433161a1a4a93",
      "english": "Can't I just play dead?",
      "translator_note": null
    },
    {
      "id": "msb_00002B10",
      "source_words_sha256": "06924c952013b6d0361dcbd8d01ee71968a402aa9dc426e951a62c79c2ee918b",
      "english": "Quite a shot, aren't you.",
      "translator_note": null
    },
    {
      "id": "msb_00002B28",
      "source_words_sha256": "b475dd17548ebd87123b8b9517fae3e9a645454ea6009b6669d0a523e499a618",
      "english": "You WISH?!",
      "translator_note": null
    },
    {
      "id": "msb_00002B38",
      "source_words_sha256": "bcd73b62545ecc4dbbfc647af19b8e4380176166321d3b1e5b3c81064e8af439",
      "english": "See a bear? Back away slowly. Don't turn your back. Got it?",
      "translator_note": null
    },
    {
      "id": "msb_00002B74",
      "source_words_sha256": "db5640452be141bb4762b8401e9c8f8620ef86a0a3668b2b70e11008c43615f7",
      "english": "It'll eat you.",
      "translator_note": null
    },
    {
      "id": "msb_00002B84",
      "source_words_sha256": "e7940a2b105736c40492691b799361048a90ac14cbeba35d29ab6869643011fd",
      "english": "My gun never misses.",
      "translator_note": null
    },
    {
      "id": "msb_00002B9C",
      "source_words_sha256": "9492b2a3f193192659224f387df0aca3215d71c699f4242ce285636fb5a06b1a",
      "english": "If only...",
      "translator_note": null
    },
    {
      "id": "msb_00002BF8",
      "source_words_sha256": "b831922dfb97d073008553204fe8c579595688149ca8234b668a6bdb437f251b",
      "english": "No... I'll pass...",
      "translator_note": null
    },
    {
      "id": "msb_00002C24",
      "source_words_sha256": "74f630b2109cdc7450e3e58e8bd6790b209888c8aa52452d93936b1bbccd6f3a",
      "english": "An old lady singing a ball-bouncing song? Creepy...",
      "translator_note": null
    },
    {
      "id": "msb_00002C78",
      "source_words_sha256": "d25d9578ae0107d54ac5981833a95b535ca3313d4d9491fbdb0fe88371020ac7",
      "english": "Do NOT sing!",
      "translator_note": null
    },
    {
      "id": "msb_00002CF8",
      "source_words_sha256": "224d337f41dc36636555213f734fa231787373846d1177697638e4e24c097c7c",
      "english": "Shall I sing a ball-bouncing song?",
      "translator_note": null
    },
    {
      "id": "msb_00002D18",
