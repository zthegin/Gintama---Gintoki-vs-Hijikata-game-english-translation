      "translator_note": null
    },
    {
      "id": "msb_00002894",
      "source_words_sha256": "37a1b24770d06e4d45b2f6554f50d1d363b1bcdd4b194cdde4f986f1b4d01918",
      "english": "Fooled again...",
      "translator_note": null
    },
    {
      "id": "msb_000028B0",
      "source_words_sha256": "3e837e00abe11b95daabb0e1bf9dc729860aae5c3b5148d3b283d1912985e9b3",
