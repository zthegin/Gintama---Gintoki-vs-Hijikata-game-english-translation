    },
    {
      "id": "msb_000027D8",
      "source_words_sha256": "5807e6057bc3b29a73f3d4949bd80d1a7dae4ab94cee6ca3a0b2ae5e27b6978d",
      "english": "I've got a card that earns points when I shop on Earth.",
      "translator_note": null
    },
