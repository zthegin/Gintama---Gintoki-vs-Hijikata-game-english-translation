      "source_words_sha256": "71e75580cca9bd84566b259a2b9faf47854cf7bb678227a30602bdc4ad43f2c1",
      "english": "I said, nothing now!",
      "translator_note": null
    },
    {
      "id": "msb_000025A4",
      "source_words_sha256": "84f5a4592bcc0426b9a78c38dcade4104e77d4cd021819c04ddb223a8f52a834",
