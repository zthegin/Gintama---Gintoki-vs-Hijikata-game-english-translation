      "english": "Why?",
      "translator_note": null
    },
    {
      "id": "msb_00002D28",
      "source_words_sha256": "be5b2636f4f54ca8db7a13b5e95a8999614d1a238b135c84c7fb25f3e85de799",
      "english": "Someone might die.",
      "translator_note": null
    },
    {
      "id": "msb_00002D3C",
      "source_words_sha256": "c6fed3e453df143e12050326e419cd2fdba1f7116f15c810495bcddc8ae34ece",
      "english": "Don't build that nuisance.",
      "translator_note": null
    },
    {
      "id": "msb_00002D68",
      "source_words_sha256": "7273ada6335c8de67abdd58102ee7fd41fe503b2495741cfe5ad48ead50ab570",
      "english": "I dunno...",
      "translator_note": null
    },
    {
      "id": "msb_00002D80",
      "source_words_sha256": "9d94836cde18c218f9a46b62dfd52466c57ca1b6f5d225399b6c52da0e0c1f96",
      "english": "Nothing.",
      "translator_note": null
    },
    {
      "id": "msb_00002D98",
      "source_words_sha256": "3e3bcdce14db37e6a63f6a656cb4c680ce7f1c63f3a6a9e2bb1db46ca5d7628a",
      "english": "We need a giant robot to protect world peace.",
      "translator_note": null
    },
    {
      "id": "msb_00002E00",
      "source_words_sha256": "97867e1174b14c249771fe42d2c183e680505988bf7210909dc96a1d3e751f1b",
      "english": "Want an electric fan?",
      "translator_note": null
    },
    {
      "id": "msb_00002E18",
      "source_words_sha256": "ca395250137404e32528d939cbe2397bf0dcd141cdbd48ccb1f4b80e648ea5a8",
      "english": "No ambition, have you...",
      "translator_note": null
    },
    {
      "id": "msb_00002E34",
      "source_words_sha256": "d0fc3c9564e077229c8ba46f5435d166b84ee726bc7db54899540d43ddc33192",
      "english": "What's he like?",
      "translator_note": null
    },
    {
      "id": "msb_00002E44",
      "source_words_sha256": "014b716877141c89cb0252059298747ddbf00faf78583ec91c11b8d7f2f23bea",
      "english": "Do your best to win. That's all I can say.",
      "translator_note": null
    },
    {
      "id": "msb_00002EAC",
      "source_words_sha256": "7e99271027492543b85fc0a476f521819e2fa93f34b728262006597caa9f26dd",
      "english": "Don't know their names... Amanto brothers, apparently.",
      "translator_note": null
    },
    {
      "id": "msb_00002EE4",
      "source_words_sha256": "ecc222795311ef5f2accba3e25408556cbe72b0ae7c4c0969e93dc104efd7413",
      "english": "Right. I'll do my best.",
      "translator_note": null
    },
    {
      "id": "msb_00002EF8",
      "source_words_sha256": "902e45af0c600d11da16e738b26090f69b5615095d039e7bd793d9b747929dea",
      "english": "Riding is my life!",
      "translator_note": null
    },
    {
      "id": "msb_00002F14",
      "source_words_sha256": "0dcb36cf90a13953022594cfebbd881dba63ecefb211d7dcb211df7fc998dfe3",
      "english": "Where should I ride, then?",
      "translator_note": null
    },
    {
      "id": "msb_00002F38",
      "source_words_sha256": "32d7b03b587762053668591370a085f0966fbe7ddcd7162ba4b53267cc5cbc67",
      "english": "I'm not a racer! I'm a biker delinquent!",
      "translator_note": null
    },
    {
      "id": "msb_00002F64",
      "source_words_sha256": "5e87b492c162c9f9a4be611e9b94899fbaac1334751f917deb721aab1ab038b9",
      "english": "...Fine.",
      "translator_note": null
    },
    {
      "id": "msb_00002F80",
      "source_words_sha256": "be448d36b6deda85aaf17b142f0995ce91b37a1df22fb92a4df990437b211f3a",
      "english": "Guess I'll ride on a racetrack instead.",
      "translator_note": null
    },
    {
      "id": "msb_00002FD4",
      "source_words_sha256": "6e22ec6bc2f494ff31edd5a4ee4aab7d990e03d0964fd3d7d5115a6ca1cbd23b",
      "english": "A biker gang track day... Kinda lame, though.",
      "translator_note": null
    },
    {
      "id": "msb_0000300C",
      "source_words_sha256": "d6ea48ecc4ac02a86d103c1fb9f56f554e1940820513aaecd0be3364d68e1eba",
      "english": "No speeding on roads.",
      "translator_note": null
    },
    {
      "id": "msb_00003020",
      "source_words_sha256": "8c89070284024bcff2841bb638ed942ca7d9756e5355188febed7d7c26dc609d",
      "english": "A racetrack, obviously.",
      "translator_note": null
    },
    {
      "id": "msb_0000306C",
      "source_words_sha256": "a8f8d1027a66ff05c0c5381ad957031e6493fee203abcc9a891ec6412e967f73",
      "english": "A track day...?",
      "translator_note": null
    },
    {
      "id": "msb_00003084",
      "source_words_sha256": "3c58866b5f2fe98a587d618a5f3f2585e35625320072b4ceda865e7907a63d37",
      "english": "Work hard and you might have a chance.",
      "translator_note": null
    },
    {
      "id": "msb_000030F8",
      "source_words_sha256": "b8301b13a78c5ee1c15c857815a4713b27ebc4a9b12539643449e7c3a9174fda",
      "english": "That's naive too.",
      "translator_note": null
    },
    {
      "id": "msb_0000310C",
      "source_words_sha256": "a7431361f60d145c0d430b563e8885640b546d26b6bf71b4f34a00fc804452cb",
      "english": "Wish I could marry Otsu...",
      "translator_note": null
    },
    {
      "id": "msb_00003160",
      "source_words_sha256": "70688c595d4b766975a7ee477b89bb2974c0dd4ed4c4a3f5ed8470d89aec8a79",
      "english": "I'll join a TV station so I can marry Otsu!",
      "translator_note": null
    },
    {
      "id": "msb_000031D0",
      "source_words_sha256": "25cc98f301087d01d201fd6c09d33edf1d4c34a2181f4b14b61195b74156c63f",
      "english": "No thanks.",
      "translator_note": null
    },
    {
      "id": "msb_000031DC",
      "source_words_sha256": "d85fc455917121795d3829dd247e5b1038f450ccd80f308798d7537558f9a70f",
      "english": "...I'll think about it.",
      "translator_note": null
    },
    {
      "id": "msb_000031F4",
      "source_words_sha256": "1151f429c5e209fc629e539bdb95c931f3c11f2d5618a70003a635d6ab5abd65",
      "english": "Still not keen!",
      "translator_note": null
    },
    {
      "id": "msb_00003208",
      "source_words_sha256": "fd52c1c8bf87596f8de441a179b89a3fd4ed5a7f2310fb2691bc6ca561aa04f0",
      "english": "Feeling good today! Maybe I'll sing a song!",
      "translator_note": null
    },
    {
      "id": "msb_00003280",
      "source_words_sha256": "1e0afda1b90c89830bd5df8267f423f15730f8483d0f5ac33dfe75b12e08e364",
      "english": "Bouncing around in swimsuits!",
      "translator_note": null
    },
    {
      "id": "msb_0000329C",
      "source_words_sha256": "84f45a3d494b244fd2c113b37103f53b7585689e93b81fa1de77fc7cb50bffd2",
      "english": "Yes!",
      "translator_note": null
    },
    {
      "id": "msb_000032AC",
      "source_words_sha256": "411dba855c5de1fdc7ae134929882a0d794779e6ee4acbf234a2df989c499501",
      "english": "The sea's huge.",
      "translator_note": null
    },
    {
      "id": "msb_0000330C",
      "source_words_sha256": "3e0f3975b256ee823a1058d2905db4aaf9d940abd84ad9b16323174f4906c799",
      "english": "Not on the menu...",
      "translator_note": null
    },
    {
      "id": "msb_00003330",
      "source_words_sha256": "f1bbd4031e2855f6b75f2c3083fb11c776c5d0b1b8ce058a6ae6b16011c1a85d",
      "english": "So?",
      "translator_note": null
    },
    {
      "id": "msb_0000333C",
      "source_words_sha256": "622e41e4bf495a1386d485661cfe0432e1919fe7d9cf22c52fd931d855995d4c",
      "english": "Mayo yakisoba, not sauce? I'd eat that.",
      "translator_note": null
    },
    {
      "id": "msb_00003374",
      "source_words_sha256": "829e0d1f2e4410f4fd0b3819d5a70e068e2f68a8238ac0e0c944622ad93ea450",
      "english": "So what?",
      "translator_note": null
    },
    {
      "id": "msb_00003388",
      "source_words_sha256": "8f7386ad1e8dc63d6c8517e2bf83932cc0902af392f9dc4a26cd49787212c800",
      "english": "Isn't an N brigade a stretch?",
      "translator_note": null
    },
    {
      "id": "msb_000033A8",
      "source_words_sha256": "56c492679d02cf6a2c89b5946510beff30088c3008efbf03d9a1d3af70ae9068",
      "english": "Had a fire the other day. Several brigades put it out.",
      "translator_note": null
    },
    {
      "id": "msb_000033EC",
      "source_words_sha256": "75db45cb4e1e15dd6b6e2161b7f418049f449e7e7082f344925a1b50fe4c085b",
      "english": "Me, N, Ta, I and Ko brigades.\fTogether: MENTAIKO! Cracked me up!",
      "translator_note": null
    },
    {
      "id": "msb_00003454",
      "source_words_sha256": "852ccb78a456c124b573f550ce57c1917324a34e92aa0e4c8c1581d98b1e051a",
      "english": "What a scary scheme!",
      "translator_note": null
    },
    {
      "id": "msb_00003478",
      "source_words_sha256": "6839b78fee09b2c691905acb051bfe7aa670c67bed4804a6c0432d318ed8c594",
      "english": "I'm the obvious choice for beautiful kunoichi.\fBut some weirdos actually like girls with glasses.\fMaybe I should finish Sacchan off, just in case...",
      "translator_note": null
    },
    {
      "id": "msb_00003524",
      "source_words_sha256": "f65631cbca7f47fdc949002824769d70956cb4ca3771592ea0d0848426dd9ee0",
      "english": "Heh... Just kidding.",
      "translator_note": null
    },
    {
      "id": "msb_00003540",
      "source_words_sha256": "1412e56667bfccc4adfa07d5eb05f559c5b8e76450860d75e53c56db30792fab",
      "english": "Not interested...",
      "translator_note": null
    }
  ]
}
