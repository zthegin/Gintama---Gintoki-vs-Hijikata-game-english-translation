      "english": "This is bad...",
      "translator_note": null
    },
    {
      "id": "msb_00002490",
      "source_words_sha256": "4df31e685a5fa6f72b48b0216f334faf8cd293f87a5a62ee9ecd6992cb22db96",
      "english": "...What was bad...? Forgot... That's bad...",
      "translator_note": null
    },
    {
      "id": "msb_00002504",
      "source_words_sha256": "9b2a07b2181991a65adce555ea5e2df811681891c77cb2fc6593d60618b9bbc0",
