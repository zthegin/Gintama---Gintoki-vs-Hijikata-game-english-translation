      "english": "Nothing now.",
      "translator_note": null
    },
    {
      "id": "msb_00002560",
      "source_words_sha256": "bbb36fdae04fbcd9eb6630f6bcb964212ead269aa110785c0799657111c35892",
      "english": "Cheer up. I'll call if I need you.",
      "translator_note": null
    },
    {
