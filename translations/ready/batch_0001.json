      "english": "I've got one too.",
      "translator_note": null
    },
    {
      "id": "msb_000027B0",
      "source_words_sha256": "5978d90499e19172241974d7f628b48853570ef51087c50d5f5ac07c6faf357f",
      "english": "Humans too.",
      "translator_note": null
    },
    {
      "id": "msb_000027C4",
      "source_words_sha256": "fb147c4040549c17d511e6da98c007316b2cd0fe1cbaef5ae8ec85633bd3f834",
      "english": "That's a lie.",
