      "english": "Yes...? What of it?",
      "translator_note": null
    },
    {
      "id": "msb_00002944",
      "source_words_sha256": "276ebd4ffc0987fdfd711231df25be17322be35d3fcdacb19241c32df77281b9",
      "english": "Huh?",
      "translator_note": null
    },
    {
      "id": "msb_00002950",
      "source_words_sha256": "c92ea94a8a28cf4b3a4de1f4cae3bba678ae2285727096b0acc88693c4641447",
      "english": "That face... Born with it?",
      "translator_note": null
    },
    {
      "id": "msb_00002974",
      "source_words_sha256": "b2ee5da774b384f8c175fe16d7aab3765be6104269265cd0087536578e8f9265",
      "english": "Sounds like you've had it rough.",
      "translator_note": null
    },
    {
      "id": "msb_00002990",
