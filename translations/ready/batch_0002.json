    },
    {
      "id": "msb_000040EC",
      "source_words_sha256": "a0d49270e7b5134d787d73f730f4993a7651aba809b2bbc76be56ce8cd14605c",
      "english": "Huh, unusual. No interest in Gin Tama?",
      "translator_note": null
    },
    {
      "id": "msb_00004120",
      "source_words_sha256": "6418f4fa151a8bff2a944e0a7eaa17548e634674753fbc96f0822521351a266b",
      "english": "...You're bursting with interest!",
      "translator_note": null
    },
    {
      "id": "msb_00004150",
      "source_words_sha256": "ba4ce39c07535fe8fbfb23f854d70eddc418323aee9dabdd0d02188baba78068",
      "english": "Right... Good luck.",
      "translator_note": null
    },
    {
      "id": "msb_0000416C",
      "source_words_sha256": "959808bfa8735c811a6ed1d843ac9353d31dfb1ff0fd49dc47f07bf4b03f4b3d",
      "english": "Everyone's Gin Tama this, Gin Tama that.\fAre they really worth grown adults obsessing over...?",
      "translator_note": null
    },
    {
      "id": "msb_000041C8",
      "source_words_sha256": "fa42a9bcc834715e5d987dc828c55c3a2e4bfd2a1a7abcbc2b02c8f07777d726",
      "english": "Of course they are!\fWithout Gin Tama, you can't even keep up with conversations!\fThere's bronze, silver, gold... Different rarities.\fCharacter Tama are REALLY hard to get!",
      "translator_note": null
    },
    {
      "id": "msb_0000427C",
      "source_words_sha256": "ca597a84a6fb7d452aef9a2cf55d1ccb507dcd9cd0c42cd5cf2ef52f726aa04c",
      "english": "I can't STAND anyone else taking an interest in Gin Tama!",
      "translator_note": null
    },
    {
      "id": "msb_000042BC",
      "source_words_sha256": "b5ad194a3bf3e4fbc904c2402f65b51cd1189585a4d1a36d00d897ddf6f0d910",
      "english": "Mr. Sakata.\fMr. Idiot Sakata.\fPay your rent properly. Basic human decency.",
      "translator_note": null
    },
    {
      "id": "msb_00004314",
      "source_words_sha256": "88fb60ff8c5aa402ae7f8a71fe58fba521fc55291dd492fc1e297c1b5e15baf1",
      "english": "Listen...",
      "translator_note": null
    },
    {
      "id": "msb_00004328",
      "source_words_sha256": "f4059dd893e5befa01bb38d145309cf786a62728561835cd0c3572e2e2a3e9e5",
      "english": "No life lessons from someone who tried to run off with the old hag's till!",
      "translator_note": null
    },
    {
      "id": "msb_000043C4",
      "source_words_sha256": "789e3ea0cb3f538d4e5e236bbac745a2236c7ed622780794e77bc9b16f629a32",
      "english": "Thanks for listening!\fCorn and turmeric!",
      "translator_note": null
    },
    {
      "id": "msb_000043F0",
      "source_words_sha256": "df209a508b2a5a298a9ef49a8e4a2f72d9a56f2b0426ef095f806dd662cdb2d5",
      "english": "Listen till the end... Nezumiland!",
      "translator_note": null
    },
    {
      "id": "msb_0000441C",
      "source_words_sha256": "bc26a9c2f55eb586951b8f6e67635cf4bba4ca9d4ba9d359f9322714cda0c065",
      "english": "Necromancer!",
      "translator_note": null
    },
    {
      "id": "msb_00004438",
      "source_words_sha256": "50af4c39638809bd4b08a368490acd459b6eea9713f6925bda19bf42405dc94e",
      "english": "Corn and TURMERIC!",
      "translator_note": null
    },
    {
      "id": "msb_00004454",
