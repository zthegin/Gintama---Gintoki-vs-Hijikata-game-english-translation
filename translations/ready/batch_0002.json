    },
    {
      "id": "msb_000040A8",
      "source_words_sha256": "3bc0497d7573c68a06f5500f7ffbad41babc7874466e59f94d33e60c91e4c9ed",
      "english": "Best thing now is to search everywhere you can reach.",
