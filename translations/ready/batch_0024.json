      "translator_note": null
    },
    {
      "id": "msb_00059978",
      "source_words_sha256": "14b8811a0d061076e7997ddbc9fcb3447d83bcbb93f8d2ee9016099e823d80f7",
      "english": "Then tell me YOUR dream, Otae!",
