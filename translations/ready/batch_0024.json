    },
    {
      "id": "msb_000598E0",
      "source_words_sha256": "4905bd8b10c28931ff749582e45882be8a33e7a50eaba4fc94c73784ff9e51a8",
      "english": "You guys...",
      "translator_note": null
    },
    {
      "id": "msb_000598F8",
      "source_words_sha256": "bab56bf26e68ae562b0b6db2836491b414c0e4d8d9be5bb88fac6b0fc6d7417d",
      "english": "And you?",
      "translator_note": null
    },
    {
      "id": "msb_00059908",
