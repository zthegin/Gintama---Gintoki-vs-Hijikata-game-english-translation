      "source_words_sha256": "d67389889cd02ba37f670ac74f125efda293d2e38192dda9b8710cc78c656c39",
      "english": "What are you saying? Don't get the wrong idea.",
      "translator_note": null
    },
    {
      "id": "msb_00059C5C",
      "source_words_sha256": "ec491273779c79e0c6493d010d36f19601f98fa2ae1c6c477b3b85d20def9952",
