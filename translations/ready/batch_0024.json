    },
    {
      "id": "msb_000597B4",
      "source_words_sha256": "a2caccd3db34dc72a3cab1e407ac625d52ad79e074638fb00803bed68098a4a6",
      "english": "Right. We'll let you off for today.",
      "translator_note": null
    },
    {
      "id": "msb_000597E4",
      "source_words_sha256": "afb63fb490105486f8965e0abfb35703a766b4294082addf1b8c9782624daf26",
      "english": "Heh... Didn't think you'd fight so seriously...",
      "translator_note": null
    },
    {
      "id": "msb_00059828",
