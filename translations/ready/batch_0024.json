    },
    {
      "id": "msb_000595E4",
      "source_words_sha256": "99b2582c0c58fafc3fb663ae8abaf734e623b40faed2ae50dfe3c76e2e48980e",
      "english": "Oh, Toshi and Sougo! How'd you find me?",
      "translator_note": null
    },
    {
      "id": "msb_00059610",
      "source_words_sha256": "52d771f159b4b958905efcb395b7f4a16161de482a8ea90ea2b3248cbfd4cb08",
      "english": "Well, sit down. Have some dango.",
      "translator_note": null
    },
    {
      "id": "msb_00059634",
      "source_words_sha256": "eee9ffd00b9c3031bada5550c0fabd94904e8d27d483c9d8d760c3a0172f4cf0",
      "english": "Fine by me. We can make our new home here.",
      "translator_note": null
    },
    {
      "id": "msb_000596C8",
      "source_words_sha256": "79fe8b81d255c6e3ebfe649839414e24cc15f296950ecab1a1f4c4db29982354",
      "english": "A Gin Tama battle!",
      "translator_note": null
    },
    {
      "id": "msb_000596E0",
      "source_words_sha256": "c5abe48cb5ddd8a21b852ec6d92ac506a54a70489d5f0829e41539cbb5dd11e0",
      "english": "Heh. Collected loads on duty these past few days.",
      "translator_note": null
    },
    {
