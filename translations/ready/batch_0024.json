      "translator_note": null
    },
    {
      "id": "msb_00059A90",
      "source_words_sha256": "7a47d38306b6dc439d8952c78035166286047987368dcb254eded279016a3ae1",
      "english": "Now go home.",
      "translator_note": null
    },
    {
      "id": "msb_00059AA8",
      "source_words_sha256": "a70d8d36ec927e8a77da771c7f13619eb14a2e7c46f244ca7dcdb4e10f88d57e",
      "english": "Ota...",
      "translator_note": null
    },
    {
      "id": "msb_00059AB8",
