      "english": "Shut up... What are you doing here?",
      "translator_note": null
    },
    {
      "id": "msb_00059484",
      "source_words_sha256": "a15a650532ce7f51bff4f1de8195503ca84d38111ee94c8a1e35806771c9ae61",
      "english": "Screw you! This is MY route!\fYou don't need to show up!",
      "translator_note": null
    },
    {
      "id": "msb_000594C8",
      "source_words_sha256": "ecb90fd9bea20b4863a732d5fa228c0fc8002a02b0e3d39e077a7fa78e4a7a86",
      "english": "What kind of game is THAT?!",
      "translator_note": null
    },
    {
