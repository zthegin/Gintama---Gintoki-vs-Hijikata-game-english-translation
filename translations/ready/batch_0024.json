      "english": "Why did it end like this?!",
      "translator_note": null
    },
    {
      "id": "msb_00059B54",
      "source_words_sha256": "f6f303905a3339d2f91af2a203f8d5c9eba3113e11354a9ec9aeb4260b16db21",
      "english": "At it again.",
      "translator_note": null
    },
    {
      "id": "msb_00059B6C",
