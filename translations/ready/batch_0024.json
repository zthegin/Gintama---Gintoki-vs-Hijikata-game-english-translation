      "translator_note": null
    },
    {
      "id": "msb_000599F8",
      "source_words_sha256": "97b4a02dc50e9d3be570644f01f5e2f4e24ab9dc8adf302285513c7a042eec7d",
      "english": "Nonsense! This won't make me give up!",
      "translator_note": null
    },
    {
      "id": "msb_00059A24",
