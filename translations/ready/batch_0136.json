      "english": "Morning shopping?\nEven housewives\ndon't do that! Wrong!",
      "translator_note": null
    },
    {
      "id": "msb_000E5820",
      "source_words_sha256": "62e73addfc9a56a24b44f0e0b8ccf85a5c747928132560831c29f64ed26df0ab",
      "english": "Ugh... I'm so sad...\nTry again, damn it!",
      "translator_note": null
    },
    {
      "id": "msb_000E5940",
      "source_words_sha256": "8ef46d78627831766413ab5ab46a97c95fecd57ba52a06214c3ada82daa90c2f",
      "english": "Wangan Police.",
      "translator_note": null
    },
    {
      "id": "msb_000E5954",
      "source_words_sha256": "35707ed1d430a73d6ab8c283a592634d45b3119c6c44ecf4a1507e4b44472cd8",
      "english": "Lounge? What...?\nThe crime scene.",
      "translator_note": null
    },
    {
      "id": "msb_000E5980",
      "source_words_sha256": "bbe99bfc577c1c1a52f7b06000d9c3fd1bdbc217a6c1236e88ab0e2cfbee41f3",
      "english": "What?! Go seal off\nBay Bridge yourself!\nWrong!!",
      "translator_note": null
    },
    {
      "id": "msb_000E59FC",
      "source_words_sha256": "62e73addfc9a56a24b44f0e0b8ccf85a5c747928132560831c29f64ed26df0ab",
      "english": "Ugh... I'm so sad...\nTry again, damn it!",
      "translator_note": null
    },
    {
      "id": "msb_000E5A50",
      "source_words_sha256": "7754ba3dd432cec7cedbf18c31be029d004712c533d6c5b3735803186b213fe7",
      "english": "Crimes don't happen\nin the lounge, sir.",
      "translator_note": null
    },
    {
      "id": "msb_000E5A80",
      "source_words_sha256": "c4cba04731bbb0d4fcd061c57f9fe1e09317d9e936d87ea84c053c5a0ab94cb0",
      "english": "Kameari Police Box...",
      "translator_note": null
    },
    {
      "id": "msb_000E5AC0",
      "source_words_sha256": "050be873b8ab8150bf2bbddadf59798b3b0ff52f3e378dc80ff756c90f386837",
      "english": "Wrong!!\nKabukicho here!\nNot Kameari!",
      "translator_note": null
    },
    {
      "id": "msb_000E5AF8",
      "source_words_sha256": "c546ef48a5d758fc98489280bb9f864117949c5a0d0c80f7d7d3b5285f6a68ba",
      "english": "We go our own way!\nNothing to do with Kameari!\nOur trust is finished!",
      "translator_note": null
    },
    {
      "id": "msb_000E5B50",
      "source_words_sha256": "62e73addfc9a56a24b44f0e0b8ccf85a5c747928132560831c29f64ed26df0ab",
      "english": "Ugh... I'm so sad...\nTry again, damn it!",
      "translator_note": null
    },
    {
      "id": "msb_000E5BA4",
      "source_words_sha256": "c6d917782bbd708cd107755cc8ad08c80cc8b471e91c536e6e27f6021975caed",
      "english": "Feels like a long-running\nseries. I like it.",
      "translator_note": null
    },
    {
      "id": "msb_000E5CC8",
      "source_words_sha256": "ac2a444ee36399eb1e183cf44e577d0fdf0703797188df1251ffb7a594ea9f42",
      "english": "Ugh... I'm so sad...\nPlease try again!",
      "translator_note": null
    },
    {
      "id": "msb_000E5D78",
      "source_words_sha256": "43d31928b9e39624d3728ccb4b9e1c8cead34a870953dc89bf546f6fd75f9b42",
      "english": "Good at heart. Really.",
      "translator_note": null
    },
    {
      "id": "msb_000E5E84",
      "source_words_sha256": "ac2a444ee36399eb1e183cf44e577d0fdf0703797188df1251ffb7a594ea9f42",
      "english": "Ugh... I'm so sad...\nPlease try again!",
      "translator_note": null
    },
    {
      "id": "msb_000E5F14",
      "source_words_sha256": "1541fb24d097ce6a30078cc22e3c1848ec112c06f9463f3182ec9b430cb3e0cb",
      "english": "Which of these\nis the powerful cannon\non shogunate warships?",
      "translator_note": null
    },
    {
      "id": "msb_000E6058",
      "source_words_sha256": "c5d6f97beb43eb098db037962f5c6f70e65c671adae3754b8c7cd534a886acbb",
      "english": "Ugh...\nI'm so sad...",
      "translator_note": null
    },
    {
      "id": "msb_000E623C",
      "source_words_sha256": "c5d6f97beb43eb098db037962f5c6f70e65c671adae3754b8c7cd534a886acbb",
      "english": "Ugh...\nI'm so sad...",
      "translator_note": null
    },
    {
      "id": "msb_000E6368",
      "source_words_sha256": "921d5387af711a106b84c541ab08b7cdd48ac588a1c114f81f2f306cf04c71a6",
      "english": "Toshi! This Tama\nis proof of our bond!!",
      "translator_note": null
    },
    {
      "id": "msb_000E6458",
      "source_words_sha256": "f3e78d0f94ff24c8609e325a277df97a48a656badb77dabc24c669f8368e4889",
      "english": "Remembered until now.\nFell and forgot...",
      "translator_note": null
    },
    {
      "id": "msb_000E66C0",
      "source_words_sha256": "7b1eb07be41a6d39829a681974fe3c046750f125e7ba98cfd5e7abeed5dcd3fa",
      "english": "Mocking me?!\nMy mind's usually\nsharp as a sword!",
      "translator_note": null
    },
    {
      "id": "msb_000E6768",
      "source_words_sha256": "a439fcacb6d2e3fcfe251c9edd77ee58c98bbac00ef45007f404f5680eade4b1",
      "english": "Fall and forget?\nBad head.\nGet it checked at hospital.",
      "translator_note": null
    },
    {
      "id": "msb_000E67EC",
      "source_words_sha256": "765441aa4b453f74c2993c9a9673a04ae0f51169866d45869950a4702787b9a1",
      "english": "Toshi...\nMaybe I should\nsee a doctor...",
      "translator_note": null
    },
    {
      "id": "msb_000E68F4",
      "source_words_sha256": "67d50ff032a68fddf9eafece2254c7c12434b08d28f77253f1ab15e12789b2f9",
      "english": "Right. [blue]Kodokan Dojo[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_000E6918",
      "source_words_sha256": "ecd460996ff2712346c1553716b32bd9e96988975ee89c3f93f7b9c1c711de0f",
      "english": "Looks like a swordsman.\nMaybe had business\nat [blue]Kodokan Dojo[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_000E6A9C",
      "source_words_sha256": "8f0c65bb6a3dffab40f5363f0d9dda92122e973e80060d87efc760602b2e8851",
      "english": "Can't be...\n[blue]BUJI TV[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_000E6DC8",
      "source_words_sha256": "0b17fdf3431813921ffe2e5abac707ea8956f3539e4b67cb76145369aaf6af61",
      "english": "What an interruption.\nLet's go.",
      "translator_note": null
    },
    {
      "id": "msb_000E6E5C",
      "source_words_sha256": "a23bb6817bda3423f06f6ff285661e04a9f32eb00187acc0b6aa02298a68a055",
      "english": "Not your business.\nWe want Gankeimaru.",
      "translator_note": null
    },
    {
      "id": "msb_000E6FB4",
      "source_words_sha256": "f1474652df22ade6a6b6a6a7ec83743faee3efeeaaac1b724f13f3351d5cc062",
      "english": "Damn... Let you off\nfor today.\nRemember this!",
      "translator_note": null
    },
    {
      "id": "msb_000E7134",
      "source_words_sha256": "c01117002a3a74875c27cf7b70d457f1648355aaf9dc1a5e076f3c031d6f315b",
      "english": "Shinsengumi! Ready?!",
      "translator_note": null
    },
    {
      "id": "msb_000E7174",
      "source_words_sha256": "f4d220489df68b6f31b1be05a51a96d4a17832c7b61a4959ab120a4ac4bd139d",
      "english": "So many interruptions.",
      "translator_note": null
    },
    {
      "id": "msb_000E7248",
      "source_words_sha256": "73e58551ea4a90159b4563b1579298182cb48dc06eff61ae66aab30b2d019f78",
      "english": "Tch... Quick\non his feet...",
      "translator_note": null
    },
    {
      "id": "msb_000E72D0",
      "source_words_sha256": "ad3fa737bafaa4d8541ae840709e193f773fa0476dda6b22914b984a84c80108",
      "english": "Remember this!!",
      "translator_note": null
    },
    {
      "id": "msb_000E7404",
      "source_words_sha256": "c365baaa1a8859f72e7cc69d22bb2aad6f8d347aaa6ac7c0733adc261866dc81",
      "english": "This is [blue]BUJI TV[/color].",
      "translator_note": null
    },
    {
      "id": "msb_000E75C8",
      "source_words_sha256": "2d0e0f66ad717b4b84e8d1209e06f83bb7db38f127ff43f8a4dce030f7449ac8",
      "english": "Hijikata,\n[blue]BUJI TV[/color] isn't\nthat way.",
      "translator_note": null
    },
    {
      "id": "msb_000E760C",
      "source_words_sha256": "1159e253d645d6f9e51deabe98d17eb18f3b4f1ab3044cbf5983657f6592873d",
      "english": "Where are you going,\nHijikata?\n[blue]BUJI TV[/color]'s here.",
      "translator_note": null
    },
    {
      "id": "msb_000E76A8",
      "source_words_sha256": "ec8ccaf683190888caa656a84caf0f8bfc81a2edf5fe96af5f28366b2d20dd46",
      "english": "[blue]Kodokan Dojo[/color]...\nOr [blue]Oedo Mart[/color]... Right?",
      "translator_note": null
    },
    {
      "id": "msb_000E776C",
      "source_words_sha256": "9360115a7ef4ce1b95feeb51531a8cccb7c880ce2fc43a8a4553bf8f7b7e57ec",
      "english": "Don't know...\nMaybe I'll remember\nwhile walking.",
      "translator_note": null
    },
    {
      "id": "msb_000E77B4",
      "source_words_sha256": "6047d6c2d8650d705232183bf3f299d800551334c8e683f6dfa49b5e85951554",
      "english": "You choose.\nTwo options.",
      "translator_note": null
    },
    {
      "id": "msb_000E77D4",
      "source_words_sha256": "371ca4e64de7f6aa762b73ba2d1046515e6d1566b824542fd4bedbd9aac89553",
      "english": "Don't seek a safe path.\fOnly ask if the road\nbefore you leads to hell.\nChoose on that basis.",
      "translator_note": null
    },
    {
      "id": "msb_000E786C",
      "source_words_sha256": "22cf86b0e21cc581fc9baa00ef5b7d7b448ddd2362c032cfc571a46e1c61d674",
      "english": "Then stop\nwandering aimlessly.",
      "translator_note": null
    },
    {
      "id": "msb_000E7898",
      "source_words_sha256": "c5971a1e9a9529588a6c8803fa5cf8d894b783bfc4426a513fd8e76bd622d534",
      "english": "[blue]Kodokan Dojo[/color].",
      "translator_note": null
    },
    {
      "id": "msb_000E7978",
      "source_words_sha256": "64dd416f4a4c87c19f9cfe9599b30eee5e1c200c8254d4e5847a3e6bc2658d3f",
      "english": "More interference?",
      "translator_note": null
    },
    {
      "id": "msb_000E7A08",
      "source_words_sha256": "bb4b7aa8198aafb2547bb363683060ab7bec6b8e92daae5fe3d2fab7f04ea23f",
      "english": "Legendary gambler?\nNot so great.",
      "translator_note": null
    },
    {
      "id": "msb_000E7A2C",
      "source_words_sha256": "8cabe3ac2b4d1f7aba1bb75e5eae7fc6bab22f5abf2b01ee29f1adea03d4e0d0",
      "english": "Just work\nto pay off his debt.",
      "translator_note": null
    },
    {
      "id": "msb_000E7A5C",
      "source_words_sha256": "6e852eb24b8d340c28fac78f8a05b1fcc398c46d503c8bcf804ef6f197712200",
      "english": "Stay out of it, sir.\nHe brought this\non himself.",
      "translator_note": null
    },
    {
      "id": "msb_000E7C44",
      "source_words_sha256": "6dd6aa67344d2f123ef515bec4f2889ae86a12b3464e27ce8c1f6bd279270263",
      "english": "So take him\nto his destination\nand the debt's paid.",
      "translator_note": null
    },
    {
      "id": "msb_000E7E94",
      "source_words_sha256": "2be6aace1daeccd6e99a0b65d73d9b206e7cab69a022dfb2d2cc88f90b5493f7",
      "english": "[blue]Koei Theater[/color].",
      "translator_note": null
    },
    {
      "id": "msb_000E7FDC",
      "source_words_sha256": "751a3dbf0654f0c4ebbba952a0dfd15d18377a87dcdfc7633c03d6d7c45a36a6",
      "english": "Don't remember...",
      "translator_note": null
    },
    {
      "id": "msb_000E8060",
      "source_words_sha256": "753ef04bcc2ab8e28db7f102747b19cdc8f12c3f46b873d5d0a9bc4104997a11",
      "english": "Of course! Dogfights,\ncatching Frisbees\nin my mouth... Anything!",
      "translator_note": null
    },
    {
      "id": "msb_000E818C",
      "source_words_sha256": "b6439005eedd5c44f2c5ed22587f0f38fae0e209fa2a0629bc23ac6f1a40c9b3",
      "english": "Got it. I'll remember.",
      "translator_note": null
    },
    {
      "id": "msb_000E822C",
      "source_words_sha256": "95c30eca9b224cb7456654f633a4ef1dc5e5882adf10f2f02593c6f2a26d6bd3",
      "english": "Damn!\nRemember this!",
      "translator_note": null
    },
    {
      "id": "msb_000E8248",
      "source_words_sha256": "84fd846e4837b4242667b5550cdb32817434bcc97c54ff6f87ba07f77ae22eb6",
      "english": "Kanbei, you're off\nfor today.\nNo mercy next time!",
      "translator_note": null
    },
    {
      "id": "msb_000E82E8",
      "source_words_sha256": "691483a90604d8bff9b1855525841b83079995b2470b8a0c96d1bedf0353cd23",
      "english": "At least\nhouse-train him\nproperly.",
      "translator_note": null
    },
    {
      "id": "msb_000E8390",
      "source_words_sha256": "404d7486fe58a4bd1cd99e772c83c8ad6c65876df351f1f73ae69e6078e914bd",
      "english": "So forgetful,\ndoubt he can\nlearn tricks.",
      "translator_note": null
    },
    {
      "id": "msb_000E84A0",
      "source_words_sha256": "07fe533d2c02e72125574e332ecbbaf1901d8dc4616f06711533e7dc361f627c",
      "english": "Legendary gambler's here.",
      "translator_note": null
    },
    {
      "id": "msb_000E851C",
      "source_words_sha256": "07fe533d2c02e72125574e332ecbbaf1901d8dc4616f06711533e7dc361f627c",
      "english": "Legendary gambler's here.",
      "translator_note": null
    },
    {
      "id": "msb_000E85A0",
      "source_words_sha256": "c4a8b66a69a6094ad093065b0be723f2e20a4a7a1114e5f0e450e22f0e542c91",
      "english": "No idea, Yosakoi Festival!",
      "translator_note": null
    },
    {
      "id": "msb_000E85D0",
      "source_words_sha256": "07fe533d2c02e72125574e332ecbbaf1901d8dc4616f06711533e7dc361f627c",
      "english": "Legendary gambler's here.",
      "translator_note": null
    },
    {
      "id": "msb_000E86B8",
      "source_words_sha256": "a6bc785892d8f8ed09d27f1dec6bfd22b51b980ece769afc8ed757e51a284b3f",
      "english": "Perhaps... But remember,\nyou chose so you\nwouldn't have regrets.",
      "translator_note": null
    },
    {
      "id": "msb_000E8988",
      "source_words_sha256": "ebe64bb90a2b717bef382f7c2fa7bbbc2911d8e31bf9fe577e17fce0d628db2e",
      "english": "So, onto the roof.\nBut why\n[blue]Hokuto Shinken[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_000E8B40",
      "source_words_sha256": "372817b1b9190ca1c00ee44337d1a17f3eb9751501c66ecf8903d5bdf79a6c4f",
      "english": "Come down, Kuriko!\nOr I'll keep shouting!\nCenter of the world, here!",
      "translator_note": null
    },
    {
      "id": "msb_000E8C30",
      "source_words_sha256": "a95804e31d15234879faf5004ebc60b62f63a679a8f13be9a806a4fa5010fef3",
      "english": "Exactly! Her feelings\nfor Mayora 13\naccelerated thanks to that!\fLove over 200 km/h!\nFull boost! Nonstop\naerial action, now showing!",
      "translator_note": null
    },
    {
      "id": "msb_000E8EF8",
      "source_words_sha256": "f371743573d0a238ea7cd6f8e369d471114be6ad03e4203b51cc9422a28c92f2",
      "english": "How do we\nget onto the roof?",
      "translator_note": null
    },
    {
      "id": "msb_000E8F54",
      "source_words_sha256": "069e54e1c6e979c9153864edc63611eb44e897c10ba3219e69fb54e43b1b8ac7",
      "english": "How do we\nget onto the roof?",
      "translator_note": null
    },
    {
      "id": "msb_000E8F94",
      "source_words_sha256": "e98acca2027dc54d174a5ed771b9cdea8385a91fc7bdb33adadf64dc29f19ab8",
      "english": "Stairs somewhere, surely.",
      "translator_note": null
    },
    {
      "id": "msb_000E8FB4",
      "source_words_sha256": "069e54e1c6e979c9153864edc63611eb44e897c10ba3219e69fb54e43b1b8ac7",
      "english": "How do we\nget onto the roof?",
      "translator_note": null
    },
    {
      "id": "msb_000E8FE8",
      "source_words_sha256": "727f97878ab897406e5d439bea76c424a26c3fb0f2f6c96ea89154526a9f4f63",
      "english": "Stairs at the back\nof the shop\nlead to the roof.",
      "translator_note": null
    },
    {
      "id": "msb_000E9018",
      "source_words_sha256": "069e54e1c6e979c9153864edc63611eb44e897c10ba3219e69fb54e43b1b8ac7",
      "english": "How do we\nget onto the roof?",
      "translator_note": null
    },
    {
      "id": "msb_000E9110",
      "source_words_sha256": "0ea37a9fb22272168b1b237212c6d1878eae5577a03b066be9a7b671e11d2902",
      "english": "Climbed all this way.\nWon't come down\nso easily.",
      "translator_note": null
    },
    {
      "id": "msb_000E91D0",
      "source_words_sha256": "f44cdaea6947bf625681a3e49e672ddb389318df8f8736dd34021cbed064c377",
      "english": "Why the roof\nof [blue]Hokuto Shinken[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_000E9234",
      "source_words_sha256": "68526602d70ede13d34151f82e36636cc60fbd364e70a3eeb187430e8e30bde9",
      "english": "No need to die now.\nCome down from the roof.",
      "translator_note": null
    },
    {
      "id": "msb_000E930C",
      "source_words_sha256": "35e9c427b0702db351c75972209014d93aea6d99412508f5a2bec24d916e26fb",
      "english": "Kuriko is happy!\nMay we be together\nforever!",
      "translator_note": null
    },
    {
      "id": "msb_000E944C",
      "source_words_sha256": "39e00b7c859a87124676760d64af0b46424954beb3e656445442e71cb7cdafec",
      "english": "Well... First,\nlet's get off\nthe roof.",
      "translator_note": null
    },
    {
      "id": "msb_000E95B8",
      "source_words_sha256": "5a4e27db25a92374fdf298602d52a08dab71265ceaf1304215a928075972a8d4",
      "english": "Coming down\nfrom the roof now.",
      "translator_note": null
    },
    {
      "id": "msb_000E9734",
      "source_words_sha256": "0273ee126cc55e860ac81e6570b9fa61585c83f62866a16963c760e227c45938",
      "english": "Stop being stubborn.\nGet off the roof.",
      "translator_note": null
    },
    {
      "id": "msb_000E98FC",
      "source_words_sha256": "640d0d0325e35a41c5a97f2670578451dd45cd6fbb4ecb329b571b3a0f883278",
      "english": "Thanks for Mayora 13.\nGive him this\nif you see him.",
      "translator_note": null
    },
    {
      "id": "msb_000E9A98",
      "source_words_sha256": "468e79ffc659b6a19849abb2060a5b9dc51e11cdff7a6d7c063ad764398f81f4",
      "english": "Fights? Leave those\nto the local police.",
      "translator_note": null
    },
    {
      "id": "msb_000E9ACC",
      "source_words_sha256": "28b062ca2a11fc4585adc35f40f87bb3b1ee8732baebb7b141fbfdb0c693fc40",
      "english": "Road Safety Month?\nJust chasing\nyour quotas...",
      "translator_note": null
    },
    {
      "id": "msb_000E9B70",
      "source_words_sha256": "9c961e58b1e826a3ff2cc08465f99178b7a3964ac9bf8c2b8bde48615cf74d1a",
      "english": "Don't be stupid...\fShinsengumi took the job.\nFinish ALL of it\nor we'll be disgraced.",
      "translator_note": null
    },
    {
      "id": "msb_000E9BD8",
      "source_words_sha256": "489f878a9390f0625b6133741875e2c3157a46de93290bbedb9b4fc850262db3",
      "english": "What if I settle\nthem all?",
      "translator_note": null
    },
    {
      "id": "msb_000E9C40",
      "source_words_sha256": "4daaeb961e7b037ee3e7871850b793d78f04cff6030bada4a18c5eed386a8239",
      "english": "Don't say that.\nLocal police have\ntheir own problems.",
      "translator_note": null
    },
    {
      "id": "msb_000E9D18",
      "source_words_sha256": "efcdf96bfd62ee445e0aef9e381d5c5f5d2b15d20d30faf628f7e809da711705",
      "english": "Local police are busy.\nRoad Safety Month\nor something.",
      "translator_note": null
    },
    {
      "id": "msb_000E9D54",
      "source_words_sha256": "dac4798713f7daf5eb02435d84f3da4f62bc1d2c47ca345bdc742829d7f661d3",
      "english": "Four places.",
      "translator_note": null
    },
    {
      "id": "msb_000E9D88",
      "source_words_sha256": "ec1827091cccaac05a0e69b2b89dd7f50d7abd0cad9ade1dba596724432295b9",
      "english": "That's right.\nCan't settle\nall of them, I think.",
      "translator_note": null
    },
    {
      "id": "msb_000E9DCC",
      "source_words_sha256": "3ccb80e6afcca86a61a66011255a92e7927f2c49d9424e41ed57f35ebd11cc48",
      "english": "Even you, Hijikata,\ncan't settle\nall four disputes.",
      "translator_note": null
    },
    {
      "id": "msb_000E9E48",
      "source_words_sha256": "934af61b8fceb9af64803008ed4ad04fd293fd3695581d0836b4946682f8678f",
      "english": "These four spots.\nWhere first?",
      "translator_note": null
    },
    {
      "id": "msb_000E9EB8",
      "source_words_sha256": "2f28aad08ec8e49b2af8634874acb7bd2c16d790336147b3857c4b250899c3a5",
      "english": "Outside [blue]BUJI TV[/color].",
      "translator_note": null
    },
    {
      "id": "msb_000E9EF4",
      "source_words_sha256": "dbdabef912f6bd7b4470016a7cb56c48ec806dddb71a2b949392e43e0bcdb355",
      "english": "[blue]S. Golden St.[/color]",
      "translator_note": null
    },
    {
      "id": "msb_000EA220",
      "source_words_sha256": "48bef906133578e8dd412e609ab3ca8bf192f9635f85b3c6b8c62068e5bd23ae",
      "english": "Not in-law\nbickering, okay?!",
      "translator_note": null
    },
    {
      "id": "msb_000EA2D0",
      "source_words_sha256": "2bfc1805786282c25e8f8c6b6f92d0064e7f91de913bb103bb765a7c72a08aaa",
      "english": "Not Shinsengumi business.\nGo home.",
      "translator_note": null
    },
    {
      "id": "msb_000EA34C",
      "source_words_sha256": "a619ee305433acf6082b3aeb27fef09ca7dc0b2173b9aa77d098076f357bdbdb",
      "english": "My late husband...",
      "translator_note": null
    },
    {
      "id": "msb_000EA50C",
      "source_words_sha256": "ac677f9fe0a7ea64db98747ef6f49b2f2be3162e638a4c631faa229f2b7868ff",
      "english": "Tiny, filthy shop.\nJust more hardship.\fI'd sell it\nto someone soon.\fNice lump sum\nthat way.",
      "translator_note": null
    },
    {
      "id": "msb_000EA614",
      "source_words_sha256": "e10e3a5b7b904539c03bbd158b8387044e3659adacc1375f7ea6bcbed97dee3b",
      "english": "How could you?!\fSir! Give my husband's\nbrother the shop\nand it's finished...!",
      "translator_note": null
    },
    {
      "id": "msb_000EA7A8",
      "source_words_sha256": "204779b09ae55cd0db2423c7fe69d48092274337e44112460c4bb9cffc2b09df",
      "english": "Already finished!\nSo few customers.\nThere's your proof!",
      "translator_note": null
    },
    {
      "id": "msb_000EA9A0",
      "source_words_sha256": "995585dac7a3a23a0c80fb1febf234f432ed701285a305d9905aa20e2d0dfe32",
      "english": "Kept asking for money.\nShe still defended you...\fCan't see your\nsister-in-law's kindness,\nyou idiot?!",
      "translator_note": null
    },
    {
      "id": "msb_000EAAD8",
      "source_words_sha256": "d14bd42db69d35fec4d600064244d60b0b48621e68164526f93f9d63c45fd2c0",
      "english": "Wait!! Why?!\fDemanded money, yes.\nBut no threats\nor violence!",
      "translator_note": null
    },
    {
      "id": "msb_000EACB8",
      "source_words_sha256": "5f8517596d751aafe28a13d5b1d712c775595bf838b725a613d435f4f87a2108",
      "english": "Not arresting\nmy brother-in-law?",
      "translator_note": null
    },
    {
      "id": "msb_000EAD10",
      "source_words_sha256": "e420090b368a6046b1bbfac3d2be70e7588fcfbca9ea8c7a74b6f5e5937f7212",
      "english": "Shinsengumi, sorry\nfor all the trouble.\fUm... Please take this.",
      "translator_note": null
    },
    {
      "id": "msb_000EAD64",
      "source_words_sha256": "07fbf7ba79543edb46347e7c96f6a2e1d24dbc593bc89cc3f60237460c0c8671",
      "english": "He may turn over\na new leaf, at least.\nThis is my thanks.",
      "translator_note": null
    },
    {
      "id": "msb_000EADC0",
      "source_words_sha256": "777e663977e5c463e9244420e50014c5327da05c7f9b49e0d774cf2e091bad9b",
      "english": "Question the woman\nwho protected him too.",
      "translator_note": null
    },
    {
      "id": "msb_000EAE00",
      "source_words_sha256": "58f71c8c49456fc2d7f1634f62a37e3a2cab9bcdedbf58c565554e67a5f5579e",
      "english": "Really a Joi rebel?\nArrest him.",
      "translator_note": null
    },
    {
      "id": "msb_000EAEA4",
      "source_words_sha256": "2f28aad08ec8e49b2af8634874acb7bd2c16d790336147b3857c4b250899c3a5",
      "english": "Outside [blue]BUJI TV[/color].",
      "translator_note": null
    },
    {
      "id": "msb_000EAEE0",
      "source_words_sha256": "27303089fd7074c3fe56eeb12ca74759967015222b957f7c9ced6f4682158549",
      "english": "[blue]S. Golden St.[/color]",
      "translator_note": null
    },
    {
      "id": "msb_000EAF48",
      "source_words_sha256": "2ef62c7fae06f98064a94d528aba640976e8336d565d1aeb4038a62d2675c005",
      "english": "Told you.\nI'd settle them all.",
      "translator_note": null
    },
    {
      "id": "msb_000EAFD8",
      "source_words_sha256": "6f706d8bb2afa68214b874785d78c261219a6f6e1cf8b8df7c6a9c35494772af",
      "english": "Hey, that's all\nfour fights\nsettled, right?",
      "translator_note": null
    },
    {
      "id": "msb_000EB140",
      "source_words_sha256": "8512a034f198fe6d0d3b1e06e251df0516c0c9220074186c009952062729fbcc",
      "english": "Married or not?\nWhich is it?",
      "translator_note": null
    },
    {
      "id": "msb_000EB1DC",
      "source_words_sha256": "db9a784133bcc45de9e7866ac5a4a8a708bd1080054d37855891eade7c1e9f17",
      "english": "Don't lie. Prisoners\ncan't just take a stroll.",
      "translator_note": null
    },
    {
      "id": "msb_000EB27C",
      "source_words_sha256": "8c365c9e8120985ce1d8b205e730567d234a643e9afecfa6e7237e009df4f327",
      "english": "Couples quarrel.\nThat's how it goes\nin Wataru Seken too.",
      "translator_note": null
    },
    {
      "id": "msb_000EB2EC",
      "source_words_sha256": "d3e6d225f0c3599d4bcddbbe5bf4861f054ab954bb2e496e101f685480ebf0fc",
      "english": "Arrest you now!\nYou'll never\nbreak out again!",
      "translator_note": null
    },
    {
      "id": "msb_000EB34C",
      "source_words_sha256": "6e64869b12e1086f04f63731e495b7172e6e3c52389a88c4df4297206ebb9a59",
      "english": "A proper couple\nwouldn't fight\non the street.",
      "translator_note": null
    },
    {
      "id": "msb_000EB420",
      "source_words_sha256": "c35b7294f0841435597314fd307b24e36cefaee575955b3df4a0e57abac12c93",
      "english": "Hey! Don't interrupt!",
      "translator_note": null
    },
    {
      "id": "msb_000EB490",
      "source_words_sha256": "266cecd61fc18d00f3a6c319d4d250b7770056e77579d5821214b3b71fc4f62b",
      "english": "This man's the cause.\nArrest him\nand take him away.",
      "translator_note": null
    },
    {
      "id": "msb_000EB5C4",
      "source_words_sha256": "0d973519a32872f048b64c5578af1df3869c8efae7b7855c4b14d1fd5ce5ecf4",
      "english": "Married.",
      "translator_note": null
    },
    {
      "id": "msb_000EB600",
      "source_words_sha256": "0d05072f5a34b5a027aa7f4ddcd3c99f88f539fa8b075ac5569ea5677d451a07",
      "english": "Well, technically...\nWe're married\non paper...",
      "translator_note": null
    },
    {
      "id": "msb_000EB640",
      "source_words_sha256": "ea7d621e73433787cf64e7e5f6b514b467396ed93f26f9aab2f2ef35ec07da1b",
      "english": "Properly wed.",
      "translator_note": null
    },
    {
      "id": "msb_000EB654",
      "source_words_sha256": "988c016d6642062af1077b511bbe9e76c3b5bf1f36a93c121513d4dba1297be9",
      "english": "Exactly.\nA marital matter.",
      "translator_note": null
    },
    {
      "id": "msb_000EB6C4",
      "source_words_sha256": "a41f96d74f96e82d8d55b884835c89ceb63fcd5ad3974b62df70a408db4a5a92",
      "english": "No... Just a walk...",
      "translator_note": null
    },
    {
      "id": "msb_000EB724",
      "source_words_sha256": "057e2a563f3aa6d9b9d90eac43ad3ddd61ed72c95ac6adc130f3e951e4fb4a5e",
      "english": "Back in jail...\nA prisoner said\nsomething outrageous.",
      "translator_note": null
    },
    {
      "id": "msb_000EB8EC",
      "source_words_sha256": "f4694ae4782218c6412a41ca44d67a3ef6a7138449c040ee65af54625d3e2029",
      "english": "That's not mediation.",
      "translator_note": null
    },
    {
      "id": "msb_000EBBB8",
      "source_words_sha256": "f225b0add92cc08d429870768e69ddab180800778c586ee75e7557d7bde36460",
      "english": "That's not mediation.",
      "translator_note": null
    },
    {
      "id": "msb_000EBC1C",
      "source_words_sha256": "c025dc538817f650672acf5b7a27ef1050378381c5d163acf24f0213a5da3053",
      "english": "Celebrity rumors\nare natural!\nA popularity gauge!",
      "translator_note": null
    },
    {
      "id": "msb_000EBD48",
      "source_words_sha256": "d229cef4c4281ff0c7262973b9a6f80311a947e4ca46004a99191e828c311f3a",
      "english": "Can't leave it to you!\nI manage.\nYOU go to jail instead!",
      "translator_note": null
    },
    {
      "id": "msb_000EBDA0",
      "source_words_sha256": "3fbdefda87fd033e8e695f78b3bd642525c90ee5802fdff5762ccbf7f7e48a2f",
      "english": "Exile!",
      "translator_note": null
    },
    {
      "id": "msb_000EBDAC",
      "source_words_sha256": "09a39a47f0aaae29d9b3cfc5d71d21ea1bdd24cc022534e8d557e25d83a80aa2",
      "english": "I'll exile YOU.",
      "translator_note": null
    }
  ]
}
