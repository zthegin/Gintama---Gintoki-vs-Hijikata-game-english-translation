{
  "format": "gintama-community-translation-v1",
  "batch_id": "batch_0128",
  "records": [
    {
      "id": "msb_000749D8",
      "source_words_sha256": "753c860ed429d7d2631981581ecb541a9ef536b9e949a088273bda5afdfcfe4e",
      "english": "...Careless. No, stupid.",
      "translator_note": null
    },
    {
      "id": "msb_00074A5C",
      "source_words_sha256": "f786ff677a06663c068cc8548d5be69764c1095517047bfef0dcd6b66a9606be",
      "english": "Felt good, of course.\nMy craftsman's blood\nstirred. I accepted.",
      "translator_note": null
    },
    {
      "id": "msb_00074AB8",
      "source_words_sha256": "b82f6739f725f71f7911db15848b88576e2702bd3c6b6b70661a27499897d985",
      "english": "...And after all\nthat hard work,\nwhat I finally made...",
      "translator_note": null
    },
    {
      "id": "msb_00074E84",
      "source_words_sha256": "1b9ec0311693f7282907a845edaaa4536820b63ef80185a5ab13090eed610578",
      "english": "Um... Right!\n'Banbanji Toys'\nor something.",
      "translator_note": null
    },
    {
      "id": "msb_00074F80",
      "source_words_sha256": "991ede9ddd5f39028f36baee875c2a14248d49d77761fb7b0be36a24f3ef69a5",
      "english": "Well, you know...\nI'm a wanted man\nafter all... Right?",
      "translator_note": null
    },
    {
      "id": "msb_00075020",
      "source_words_sha256": "ca052c48e6d3a33f3df22e6a31221a176d53c31a895aa198af5dafd9dc68c6bd",
      "english": "Heavenly punishment!",
      "translator_note": null
    },
    {
      "id": "msb_0007503C",
      "source_words_sha256": "2217314808cfacb012d60603cbb08b6aecdd6807081994c7a22aba30572e5ba3",
      "english": "Beaten for nothing.\nBad luck squared.",
      "translator_note": null
    },
    {
      "id": "msb_00075094",
      "source_words_sha256": "5178d40c60b98f66673b45c101f826f1e21400b1259c818797eb2f9545dd50ad",
      "english": "Catch him, threaten him...",
      "translator_note": null
    },
    {
      "id": "msb_0007515C",
      "source_words_sha256": "13430dff2521be2548d4bc45cc62a2ef7d1591ac71966ba687709e8c019e048d",
      "english": "Told him\nto go to a hat shop!",
      "translator_note": null
    },
    {
      "id": "msb_0007518C",
      "source_words_sha256": "e379df9308c3ae417fe9f0485a67dca573740d8423d5c7cbd75e85016367a524",
      "english": "Different aims, same means!\nHat shops should\nsell them too!",
      "translator_note": null
    },
    {
      "id": "msb_00075290",
      "source_words_sha256": "55f31320826d15cb7b58d0f592d29a6a3f7d3e072c17e726495c13a2b06def53",
      "english": "Good idea!\nOld man buys us dinner!",
      "translator_note": null
    },
    {
      "id": "msb_000752CC",
      "source_words_sha256": "7db12f9103d954c03733591660b41cccbda02fdd2ec16284141c3784b1b447ba",
      "english": "Dinner DOES work here.",
      "translator_note": null
    },
    {
      "id": "msb_000753AC",
      "source_words_sha256": "4bd54fcc39071dff6f9aed7877c5693ad116b4f97713974d3d8a07056dfb70c4",
      "english": "And you?\nLooking for victims?",
      "translator_note": null
    },
    {
      "id": "msb_00075414",
      "source_words_sha256": "9c9f0013157d7be8fed15adb0e24f224917b596ede012cac80a6ce104715e6e4",
      "english": "Still talks like\nher brain's boiling.",
      "translator_note": null
    },
    {
      "id": "msb_0007544C",
      "source_words_sha256": "820d077de68ac034092cd4886ca2a99058325a13c0979ed765ed34f4faae9702",
      "english": "Shinpachi, you caught it!",
      "translator_note": null
    },
    {
      "id": "msb_0007559C",
      "source_words_sha256": "7623e4aa669e8cdfd9c4db7fc7d4a87c9c7f3b05266a4fc3fe7d0315d32c3dab",
      "english": "No, he's always like that.\nNo drive, spirit or energy!\nSo no work either!",
      "translator_note": null
    },
    {
      "id": "msb_00075694",
      "source_words_sha256": "66687c420c95ce3f7cabbde8af3ffb778247732949ba4cbccef6e8d84fefa70e",
      "english": "I know! Built for\nthe switch to\ndigital TV!",
      "translator_note": null
    },
    {
      "id": "msb_000756E4",
      "source_words_sha256": "1e7cdada3e265cefd8dc9f1c2d30ad0d50cac618d8ac1df404cc531c9ae12ec9",
      "english": "Zzz...",
      "translator_note": null
    },
    {
      "id": "msb_00075794",
      "source_words_sha256": "be8aea06320552246c5a27395f50560fd046bfa8f45217614e219b5a13b7b844",
      "english": "Gin's not the boss.\nRookie detective 'Perm'.",
      "translator_note": null
    },
    {
      "id": "msb_00075818",
      "source_words_sha256": "e8a4a9ea02bfc0895912b9e87b7a2067aff36a2e4dd030aee155bb9e4a449d5b",
      "english": "Yes. I'm in hiding.\nBe careful.",
      "translator_note": null
    },
    {
      "id": "msb_00075B00",
      "source_words_sha256": "c1d4709e039f4c127a82110f5712a299cb18a9f68b62f06a4a8162f926b4093f",
      "english": "Shut up! No time\nfor petty cases\nlike that now!",
      "translator_note": null
    },
    {
      "id": "msb_00075C38",
      "source_words_sha256": "1bca3a596b15ca4600d1d542cd5236e2ccb6f4177fcab03f0d8a385d0c218ad1",
      "english": "Stop spacing out!\nWake up, Sougo!\nYou're battling too!!",
      "translator_note": null
    },
    {
      "id": "msb_00075DB8",
      "source_words_sha256": "9a626bdef8bd11c50c1e122451e38c253683439e8b5b067eb62156a80755aa71",
      "english": "Game over, then.\nTime to quit, right?\nTurn off the DS. Do homework.",
      "translator_note": null
    },
    {
      "id": "msb_00075E78",
      "source_words_sha256": "7eae5820bd52b86e460e045ff13449d998a3c5fb3bdb0b3e551195d9349aab5e",
      "english": "Only thing you've\ngot on your hands\nis the laundry.",
      "translator_note": null
    },
    {
      "id": "msb_00076114",
      "source_words_sha256": "f53c6586a4b55858e4b30021154220ce399adbe8e52d168f4e56ea903e88c69d",
      "english": "Well? Ready for this?",
      "translator_note": null
    },
    {
      "id": "msb_00076178",
      "source_words_sha256": "8f3978571d4a53cd6800fc36eec4d1c8c6a002485dcdba4221ce259d88924109",
      "english": "Come to my bar!\nI'll work that rotten\nattitude out of you!",
      "translator_note": null
    },
    {
      "id": "msb_00076310",
      "source_words_sha256": "ddc22c84531211b3412a9030d2a2074636f1dcb69a6bc94abd6a05ca428383c2",
      "english": "Playing dumb, Yorozuya.\nWe say Katsura,\nwe mean Kotaro Katsura.",
      "translator_note": null
    },
    {
      "id": "msb_00076410",
      "source_words_sha256": "ed75d97d2d0ffbf3cd9fa38d95342c8f0a452602fd432c48917cebeea829439a",
      "english": "About that Zura\nyou claim not to know...",
      "translator_note": null
    },
    {
      "id": "msb_00076450",
      "source_words_sha256": "b22cd215e51110b8a709cf69e85205aa6915a2e5dfb96d66a5e33f6e5b23dbdf",
      "english": "Could be mixed up\nin something very nasty.\n...You be careful too.",
      "translator_note": null
    },
    {
      "id": "msb_00076510",
      "source_words_sha256": "2838dabecc425718010ac8e7a2b3a820d8de6366e55a26313b6ee86f3f0a6237",
      "english": "Lots to ask you, sir.\nCome to HQ with us?",
      "translator_note": null
    },
    {
      "id": "msb_00076564",
      "source_words_sha256": "91d53a400c689e44a677d192570261aa80b0de2b94e61f72ac1df5d415602c10",
      "english": "Good timing.\nReport that incident\nat HQ too.",
      "translator_note": null
    },
    {
      "id": "msb_000765CC",
      "source_words_sha256": "ae2ae68ac70140d881df1d3db37394268484f1b997763c02a2b36c9fab49289d",
      "english": "Coming all the way back?\nYou're a sly one, Yorozuya.",
      "translator_note": null
    },
    {
      "id": "msb_0007660C",
      "source_words_sha256": "67361af920790c32505f6abdccc376df60256ccc41bfae93ac3746cfc5ad867d",
      "english": "Shinsengumi need\nYOU to teach us police work?\nWe're finished.",
      "translator_note": null
    },
    {
      "id": "msb_00076650",
      "source_words_sha256": "1a6787618ba971dc64cb87c92aff183985dc09741e5a4285b82654486331c8e0",
      "english": "Oh, Shin... Walking\non your feet? So lively...",
      "translator_note": null
    },
    {
      "id": "msb_00076948",
      "source_words_sha256": "08fab75664dbb91d4a7110602efce4e9b3eea2e25eab1ad3b712773dbae68a76",
      "english": "A silver lining...\nCan we call it that?",
      "translator_note": null
    },
    {
      "id": "msb_000769AC",
      "source_words_sha256": "72ddc8c4a8adf35271b182be9dd4696178b9e3e3b0c80b2efa02525d1466ce1a",
      "english": "Otose went out.\nThat earthquake earlier?\nWent to check outside.",
      "translator_note": null
    },
    {
      "id": "msb_00076A24",
      "source_words_sha256": "7595c4c59a15614fdcdf1f227fb44f9ca25434040db4edfd1942623bb45f8ef3",
      "english": "Hit on the head.\nLet him rest a little more.",
      "translator_note": null
    },
    {
      "id": "msb_00076C34",
      "source_words_sha256": "c9cf28cc6b6e8f0d09bd1eed5ba029e1e3510b455b9243131f413744b084a8fa",
      "english": "Want it? Come and take it,\nacid indigestion!",
      "translator_note": null
    },
    {
      "id": "msb_0007712C",
      "source_words_sha256": "8b5266ee131f68d3c497bca1afc487bdfcef9133f7c72b6bc6603b9025932369",
      "english": "Left most here,\nso didn't lose much.",
      "translator_note": null
    },
    {
      "id": "msb_000771C8",
      "source_words_sha256": "75fc969dbed169d69a4eab74963d625b204bad335c0f706ef986b338179e818b",
      "english": "A grudge? Ridiculous!\nI haven't given anyone\na reason to hate me!",
      "translator_note": null
    },
    {
      "id": "msb_000773EC",
      "source_words_sha256": "b413603306d230584e1c0b565b82429c6f80040455727e528dfa37c876d7a47f",
      "english": "Ran into Hijikata\nnear [blue]Health Spa[/color]\nearlier...",
      "translator_note": null
    },
    {
      "id": "msb_0007745C",
      "source_words_sha256": "4182579bb442b2cbfc81ebe8fc0ce120212798cde401f265fe0e0f8c8bac82e2",
      "english": "Kagura...\nA wig isn't a hat.",
      "translator_note": null
    },
    {
      "id": "msb_00077558",
      "source_words_sha256": "b97b831fbe8d197ccfb5d6da07229131f4cdf60e6204db558a080a89f0736c52",
      "english": "Just wondering...\nDo you actually pay?",
      "translator_note": null
    },
    {
      "id": "msb_00077594",
      "source_words_sha256": "7b26449e59fc472f1bfbc5d16763fdc5e16ac1a30e7a408d41668c676e0c7c3d",
      "english": "Clearly dodging it.",
      "translator_note": null
    },
    {
      "id": "msb_000776B8",
      "source_words_sha256": "67357316b96be8f17d0dea4f032cfd2734a59d980bdcd5882fb0fa2a2039014d",
      "english": "No, the saying's\n'good deeds,'\nnot 'good eats'...",
      "translator_note": null
    },
    {
      "id": "msb_000777D4",
      "source_words_sha256": "070b3348f2bd438a6838731bd091d18706c5734f2deeb5985956a2b6a24d4d82",
      "english": "Serves you right!\n...Why do I feel sad\nsaying that...?!",
      "translator_note": null
    },
    {
      "id": "msb_00077888",
      "source_words_sha256": "2f72283d012c915dad12c2ae16efc20ca382f0396345faeda4f2ffdd5c79a063",
      "english": "Enough, surely.\nHe's probably sorry now.",
      "translator_note": null
    },
    {
      "id": "msb_00077BD0",
      "source_words_sha256": "e3150aa1df5624005b6cb1234e1b48f0de898e5f2aa42a0d0313587ed94da650",
      "english": "I mean, VERY shady!",
      "translator_note": null
    },
    {
      "id": "msb_00077C14",
      "source_words_sha256": "dde196f8e5ae5dcce73fc7a0bfa39185af33ed9ba13d0b1a4fdd3d65b02a5ddb",
      "english": "Mr. Katsura warned us,\nremember? Stay out\nof Gin Tama or something.",
      "translator_note": null
    },
    {
      "id": "msb_000780F0",
      "source_words_sha256": "0fede0342dbb800928deca53c72081fb99264a77396716fce2afe17006c453d4",
      "english": "Yes. This alone won't\ncrack the case, moxibustion!",
      "translator_note": null
    },
    {
      "id": "msb_000782D8",
      "source_words_sha256": "c0032a4de7abdd3a420149ef05da1c22d7e8b5638dbedcff140636bc39a8fc83",
      "english": "Not sure why...\nLacks his usual spirit.\nListless, maybe?",
      "translator_note": null
    },
    {
      "id": "msb_0007836C",
      "source_words_sha256": "90f5093f347e6f187bbe22e1acbf2002fef0cc868dc79c40a72993e4afd68ff3",
      "english": "Just as I thought!\nNo drive, no spirit,\nno energy at all!",
      "translator_note": null
    },
    {
      "id": "msb_000783FC",
      "source_words_sha256": "5d3907e0e13671fc73f23fbfb9789f398a788eb7dc174ada53212996adbf51b3",
      "english": "...This...\n...'Temporarily closed'?!",
      "translator_note": null
    },
    {
      "id": "msb_000784CC",
      "source_words_sha256": "7cd50e272dcc80a9bf764e0588ce57940e40f954fbc56d1cc450a2c0c59d7474",
      "english": "What are you saying?!\nThis [blue]Kodokan Dojo[/color]\nwas Father's...",
      "translator_note": null
    },
    {
      "id": "msb_00078644",
      "source_words_sha256": "a44761d7ad90853d6a9e1e5182ff6f27cc2f62f26235605ad70c4400af318ce0",
      "english": "Business-minded Saigo\nclosing for no reason?",
      "translator_note": null
    },
    {
      "id": "msb_000786C4",
      "source_words_sha256": "813b8b1995d09d39c57043f83213d633935f41fc8f786e12af2c085947a7ba89",
      "english": "Harsh... But watching\nfrom here won't\ntell us much.",
      "translator_note": null
    },
    {
      "id": "msb_000787B0",
      "source_words_sha256": "d5f408f1c1aa923bc48993b50cd1602bc9ba64fb95fcb7bbe7ef3581d06bd3f5",
      "english": "A grown man!\nDon't wet yourself!!",
      "translator_note": null
    },
    {
      "id": "msb_00078804",
      "source_words_sha256": "0aef1762fdebe9861415f7a54f4347259a5644a193896c6375191afc84f08310",
      "english": "Lightning toward\nthe [blue]New Tower[/color]...?",
      "translator_note": null
    },
    {
      "id": "msb_00078834",
      "source_words_sha256": "2c9095391bc63a050f2253cba23622799bbdf1ed773dc49611c951f0eb8fe1a1",
      "english": "That's what people say.\nBut nobody seems to\nknow the truth.",
      "translator_note": null
    },
    {
      "id": "msb_00078884",
      "source_words_sha256": "da2edb1b6351aeb62224b96d3c407c1384cd5afe0a51026fa0330c0c8c38ccd7",
      "english": "Who built the tower\nand why...\nNothing officially known.",
      "translator_note": null
    },
    {
      "id": "msb_000789F0",
      "source_words_sha256": "f8e570801b4fb143e4875ba05ba5eed5b1d18837a3e0a3e8364a5f4e85d978fd",
      "english": "N-no! Even Hedoro's\nlost all motivation!",
      "translator_note": null
    },
    {
      "id": "msb_00078A28",
      "source_words_sha256": "19d0932142be069895eb2121754cb2b1e8585f8523093dfb94d97b7ab94f8965",
      "english": "...Wait! What's this?!\n'Property for sale'?!!",
      "translator_note": null
    },
    {
      "id": "msb_00078EAC",
      "source_words_sha256": "35bad5cb620c447cba98947b931ab6d3eae31b347e954e55b4693ca93bf4f8c7",
      "english": "Hmph! Listen well.\fThose rebel apes\nare a nuisance\nto us Amanto.\fCrack down on them\nharder than ever,\nShinsengumi.",
      "translator_note": null
    },
    {
      "id": "msb_00078F34",
      "source_words_sha256": "ddea472c854d63c9bbd421a68a23f6d80bf2666a8cee72eb91d81d11adb888bb",
      "english": "Oh, I've heard\nthese Gin Tama\nare all the rage.\fFun symbolizes peace.\nNo investigating\nGin Tama. Understood?",
      "translator_note": null
    },
    {
      "id": "msb_00078FC8",
      "source_words_sha256": "1da965f42f4bfe70201a1453e00effe82a995df9af8275b41602ee9e9624bd35",
      "english": "Toshi, Sougo.\nAs you've heard,\na VIP's inspecting us today.",
      "translator_note": null
    },
    {
      "id": "msb_00079094",
      "source_words_sha256": "c10f975bc775f05b1502d844b89a2c27daa6c989a70c383a6ebbfbc4b0142f34",
      "english": "Yes! Understood.",
      "translator_note": null
    },
    {
      "id": "msb_000791FC",
      "source_words_sha256": "6dcc8d83aeb9169a5ee794af48fe0bd67739e17f3fc07bddbd0461137c8a36e6",
      "english": "But the Yorozuya\ninterfered, right?",
      "translator_note": null
    },
    {
      "id": "msb_000795BC",
      "source_words_sha256": "7a77c2614db079fb380d71649cd0f6b383086ae7f78317649e5ac2835df36644",
      "english": "Collective blame?\nI'll get fired too!",
      "translator_note": null
    },
    {
      "id": "msb_00079688",
      "source_words_sha256": "4602b0be228096476c166f27ca6de67b6eb2a4fc8097ed3374f49316dc5a6faf",
      "english": "Ah, well...\nOn Channel 12\nand its affiliates...",
      "translator_note": null
    },
    {
      "id": "msb_000796C8",
      "source_words_sha256": "fbf3a9ee7029ec93da95a23f14cd68adce0c0ec1c5ffbbcbf9b1349067dc0cac",
      "english": "Went to the hospital.\nOvertrained my muscles.\nNow they're sore.",
      "translator_note": null
    },
    {
      "id": "msb_00079874",
      "source_words_sha256": "28a04bd110b646b85a176b4a6cc820affc7869b8f8b7e6bffa17d65189bdbc5a",
      "english": "[blue]Hokuto Shinken[/color].\nRamen so good,\nyou forget you're dead.",
      "translator_note": null
    },
    {
      "id": "msb_000799EC",
      "source_words_sha256": "00024c024aa69803170d570dcf9d7f228c2ea8cfc63ec363d4ba01ea746e94ea",
      "english": "Delivering an order\nin this area.\fThen I got hungry...\nHeard the ramen's famous.\nWanted to try it.",
      "translator_note": null
    },
    {
      "id": "msb_00079AF4",
      "source_words_sha256": "4ee0cf25891792de5580efad54cdf5f65b8d0de37dcf7209cda1742a63a0f84d",
      "english": "Ahh, thank goodness.\nWasn't trampled.",
      "translator_note": null
    },
    {
      "id": "msb_00079C44",
      "source_words_sha256": "d24f2c995ce45a74a83df97b8efbc5a4e9ee86d3632fd71eb132cdb0c26730b4",
      "english": "Coming in.",
      "translator_note": null
    },
    {
      "id": "msb_00079D10",
      "source_words_sha256": "30cad6177249cbc9b15a2527a5ffa756f83c798563f5bd42c72c3b39bebc2d23",
      "english": "Delivery? Suspicious...\nWhat are you delivering?",
      "translator_note": null
    },
    {
      "id": "msb_00079E80",
      "source_words_sha256": "1304063483c0ebc49f8a9b5cfd9b8cf5723821d81441a37ff5aa6496cf4c6f24",
      "english": "Wasted our time.\fSorry to bother you.",
      "translator_note": null
    },
    {
      "id": "msb_00079ED0",
      "source_words_sha256": "ff45971ad654aa2e5eac833cd82d15f6dcc6176c61da7e100da87c4b035b983d",
      "english": "Hm? Those guys\nover by [blue]Health Spa[/color]...\nLet's go look...",
      "translator_note": null
    },
    {
      "id": "msb_00079F9C",
      "source_words_sha256": "abe77c41c522c93476fec8e700837a5d4c8f18501de2f4a8d0fdff9c5e17b03d",
      "english": "Like thieves...\nUse the front door.",
      "translator_note": null
    },
    {
      "id": "msb_0007A018",
      "source_words_sha256": "5af6b5e8fd727d266a218dc17787b6433e2ad742730d9b0d0fd735b2d5239223",
      "english": "Need good food out\nonce in a while.\nDelivering flowers?",
      "translator_note": null
    },
    {
      "id": "msb_0007A25C",
      "source_words_sha256": "83cf8d57157f98c7a899ca7847773569a238a4b0e8015a79d6bc51a11faf4fdb",
      "english": "Joi rebels aren't\na single united group.\fMany factions inside.",
      "translator_note": null
    },
    {
      "id": "msb_0007A440",
      "source_words_sha256": "690801f0988e321642201a1759d368ee98d7bb378ff9c173935d112d2ad648e4",
      "english": "One yellow wire.\nCut it and we're safe.",
      "translator_note": null
    },
    {
      "id": "msb_0007A4DC",
      "source_words_sha256": "d04c4c2a9ca317c865c97fbaf424aaf2cc4b96cc8265c1cd4e489909ebf379b4",
      "english": "Unfriendly customer.\nNothing else\nthat stood out.",
      "translator_note": null
    },
    {
      "id": "msb_0007A590",
      "source_words_sha256": "a0915858a9b9ae6b63eaf35e795178e81e18623d14ce7835b5f0839591594db6",
      "english": "Oh, no!\nAlready handed out?!",
      "translator_note": null
    },
    {
      "id": "msb_0007A60C",
      "source_words_sha256": "d24f2c995ce45a74a83df97b8efbc5a4e9ee86d3632fd71eb132cdb0c26730b4",
      "english": "Coming in.",
      "translator_note": null
    },
    {
      "id": "msb_0007A77C",
      "source_words_sha256": "be2d24198cce372eb3c3fdcfe4291fdc160cbab2c804efdb0a9889fa787fcc05",
      "english": "I know. Moderates\nto extremists.\nAll kinds of groups.",
      "translator_note": null
    },
    {
      "id": "msb_0007A9E0",
      "source_words_sha256": "e9e8064214f1b0734c903fa16ec4116b973a42e74416296af478cd56777d99f7",
      "english": "The florist said so!\nSold flowers to people\ngiving out strange dolls!",
      "translator_note": null
    },
    {
      "id": "msb_0007AAF4",
      "source_words_sha256": "d0f45d8ff8a25631dfa720fbb1a11aaec84a8b8835741b27b4c2c213f8554ef7",
      "english": "Find their hideout\nbefore it's too late!\fSorry to bother you!",
      "translator_note": null
    },
    {
      "id": "msb_0007AB3C",
      "source_words_sha256": "f717e3985a9a1e115afe3f686a684382337cd5b8c4269e605bbe3012bfa28150",
      "english": "Welcome.\nTake any free seat.",
      "translator_note": null
    },
    {
      "id": "msb_0007AC94",
      "source_words_sha256": "6e1815868430f94bbdae6a2190880a2b44b63195cdfaa636d8af94ddb7323d30",
      "english": "I see. Bye.",
      "translator_note": null
    },
    {
      "id": "msb_0007B2A8",
      "source_words_sha256": "c99eb88e1b85dbbda2f0093ddb4c2fb1b1508000dec47f1517cad690818650cb",
      "english": "Dangerous times...\nWell, excuse me.",
      "translator_note": null
    },
    {
      "id": "msb_0007B360",
      "source_words_sha256": "1b0532b27ba3ed8e2f369cfdc716a51d32d79d846d55bf25b126c083aacf33ff",
      "english": "Already distributed\nin Kabukicho.",
      "translator_note": null
    },
    {
      "id": "msb_0007B4C8",
      "source_words_sha256": "007e5cd26a27b94449731febf2d505062b3750aa946faa429f4d8f11ab2e4a23",
      "english": "Worse than that!\nThese have been\nhanded out in Kabukicho!",
      "translator_note": null
    },
    {
      "id": "msb_0007B574",
      "source_words_sha256": "35a7db6ab76ab576ad5fed8659f4750b2f3da5be957312384f3bb37c794a2ac2",
      "english": "Kondo had lost\nhis memory then!",
      "translator_note": null
    },
    {
      "id": "msb_0007B5C4",
      "source_words_sha256": "cc40a299f430137cf85e004e88069c12ed4639c33ed90cba28346cc09345496b",
      "english": "Order Yamazaki's men\nto find the distributed\nJustaways! Immediately!",
      "translator_note": null
    },
    {
      "id": "msb_0007B630",
      "source_words_sha256": "051ca5ad1870c92a0e579550c0f45da23cb5bec8e3ccaf2dd74a871cf94b06ce",
      "english": "Find the hideout\nof the bomb distributors!",
      "translator_note": null
    },
    {
      "id": "msb_0007B684",
      "source_words_sha256": "1b91c2b72c5a0c3d98d544d0726b4180c6a49a2f18f26b5e5d38db4c5796f00d",
      "english": "Hey, Toshi.\nWhat's the hurry?",
      "translator_note": null
    },
    {
      "id": "msb_0007B794",
      "source_words_sha256": "85764ed4a8216e3348ea40b505ad9a94c9756f2da1943e71f5d776672b6fb79e",
      "english": "So they handed\nthose things out.\nWhat's the big deal?",
      "translator_note": null
    },
    {
      "id": "msb_0007B904",
      "source_words_sha256": "9d8ee243ed2fef46e220b13414e1bc06dac4421350f03c3760457ec4846eadc0",
      "english": "Calm down!\nPass it here gently.",
      "translator_note": null
    },
    {
      "id": "msb_0007BA20",
      "source_words_sha256": "f8c3dcb53a07f9de72427689086e7c841b423a5663c8097f6c58d83457c7d960",
      "english": "Ah, Shinsengumi!\nNeed something?",
      "translator_note": null
    },
    {
      "id": "msb_0007BB64",
      "source_words_sha256": "d7e9470fe35168a4e8c4c153d9c67bb7ef353ffc50f9db2030c0984eb87c6547",
      "english": "Let's do that.\nWell, excuse us!",
      "translator_note": null
    },
    {
      "id": "msb_0007BE98",
      "source_words_sha256": "f720124460898536f30f973fe08b321e9260c5bf1b0ea6c724d8a26376e2ffa0",
      "english": "Don't get that feeling.",
      "translator_note": null
    },
    {
      "id": "msb_0007C038",
      "source_words_sha256": "a5636598e2feeda4456be6643460f5e0f27c362637a51d99f9e188b8a0ef6c7b",
      "english": "A cursed doll.\nCries at night.",
      "translator_note": null
    },
    {
      "id": "msb_0007C2A0",
      "source_words_sha256": "c65b139da480e384271f39113dce1e60d17457b52ee0641b8c8e507da9b0c12a",
      "english": "That doll...\nA cursed doll...",
      "translator_note": null
    },
    {
      "id": "msb_0007C484",
      "source_words_sha256": "464930f46544a253d97a13481a8fa03b76917bcb7fd0e37e551491a97a749a0f",
      "english": "Made it back, bastard!",
      "translator_note": null
    },
    {
      "id": "msb_0007C6A8",
      "source_words_sha256": "a58138752d3dd6227d149e6663fef9a810a42b18d8e13208a4bd0dde4240953e",
      "english": "Don't be so angry.\nDefused that huge bomb\nand returned safely, right?",
      "translator_note": null
    },
    {
      "id": "msb_0007C7D0",
      "source_words_sha256": "28bff9c8ef4b80ccaeffe8f1259ee62b25ebea6d0af20a01a364b82d84b7563d",
      "english": "You handed\nthem all out,\nright?",
      "translator_note": null
    },
    {
      "id": "msb_0007C818",
      "source_words_sha256": "4328a89a198e023d533031d01a7e0ec5ceb781ab89a274e1f46ae271cd7f35e3",
      "english": "Leave it.\nWon't affect the plan.",
      "translator_note": null
    },
    {
      "id": "msb_0007C860",
      "source_words_sha256": "30ada15826e217d7797aae83b1dd4eee5c52902c26b8315c17cf02dd333eff68",
      "english": "Hehe... Too bad.\fJustaways are already\nall over Kabukicho.",
      "translator_note": null
    },
    {
      "id": "msb_0007C8F8",
      "source_words_sha256": "a8949f1b206beed5929bfafc1460716a87fb257a92f887408346adb16571bad9",
      "english": "Impossible!\nWe handed out so many!",
      "translator_note": null
    },
    {
      "id": "msb_0007C924",
      "source_words_sha256": "3db2f9e29b6ffd877ca174923d9a08d0ccc5358e8cde327385b6dfb7ee06e5ba",
      "english": "Can't collect\nthem all!\fYou weak samurai\nwho bow to the times\ncould never do it!",
      "translator_note": null
    },
    {
      "id": "msb_0007CA7C",
      "source_words_sha256": "eaef6ab0e9a007fc4f06ec1de957c289d0960ca3eb4d72f77ffa9f682d0bfff8",
      "english": "Obviously! That's why\nwe attacked the weak\nglasses boy for Gin Tama!",
      "translator_note": null
    },
    {
      "id": "msb_0007CAF8",
      "source_words_sha256": "b28b8c0fe68253f7c28370f3de78703b0912e484c23f65d6963f4f657f7967bd",
      "english": "Hmph! Soon, Justaways\nwill explode\nall over town!\fThis is my victory.",
      "translator_note": null
    },
    {
      "id": "msb_0007CC1C",
      "source_words_sha256": "a20ccb9b3f77bfe2e7f47cf3944a871aff5e70a3e90aaee30158c6f540a55670",
      "english": "Been a while.",
      "translator_note": null
    },
    {
      "id": "msb_0007CC94",
      "source_words_sha256": "1511c2b46fe96215fdfb375a34bad49b51a6edcdbf84208112e69023e156bce1",
      "english": "No one can stop me now!\nPrepare the salute!!",
      "translator_note": null
    },
    {
      "id": "msb_0007CD60",
      "source_words_sha256": "a158c538733d47bf536a2554a71869b9500808c0cf050193b0c88252561b33c2",
      "english": "Best drinking snack!",
      "translator_note": null
    },
    {
      "id": "msb_0007CEB8",
      "source_words_sha256": "db0e56cf0ce6f7b1efd8d1abf3938a14b29ddd8e33a0d3f628602970be5ae2d1",
      "english": "No use resisting now.",
      "translator_note": null
    },
    {
      "id": "msb_0007CFA4",
      "source_words_sha256": "88ac36cd757f712baf3e22d3fd17d26d0d99948a7eabb171656a23f6e44d2484",
      "english": "Safe, Kondo.\nCaught the ringleader too.",
      "translator_note": null
    },
    {
      "id": "msb_0007CFF4",
      "source_words_sha256": "9f23f6131850d4a74bc3358ae00eaac9373c15e1c6468ddf6837659aed697108",
      "english": "And the Justaways\nhanded out?",
      "translator_note": null
    },
    {
      "id": "msb_0007D078",
      "source_words_sha256": "ef3a7487428779d8009b109cf9edb0853bc0366a8233618dec6be0fa6c7e8f87",
      "english": "Salute? Don't tell me...",
      "translator_note": null
    },
    {
      "id": "msb_0007D0F4",
      "source_words_sha256": "adf6da3ef369b41e6438612ec690c055b4b539cbfba407208fa0c919de2c666e",
      "english": "The ringleader?\fAh! Factory boss?!",
      "translator_note": null
    },
    {
      "id": "msb_0007D15C",
      "source_words_sha256": "ac05010d75b052663afe47293aebc8e03d023c1ac4a8eeaf811f256daf1c4a3c",
      "english": "Well... I'd lost\nmy memory then...",
      "translator_note": null
    },
    {
      "id": "msb_0007D278",
      "source_words_sha256": "1b0e4777cd60cfe9e658c34d3211f4bb1bdf442e5d4824434f8d90f01e133476",
      "english": "Already onto us?!",
      "translator_note": null
    },
    {
      "id": "msb_0007D2C0",
      "source_words_sha256": "8d72123911f35da34b01118cc40781856e2cf7db9ac84e2547be13f04f610c18",
      "english": "Did it, Boss Mamushi!",
      "translator_note": null
    },
    {
      "id": "msb_0007D2E0",
      "source_words_sha256": "ec252b6b9ed7ad71bdfe5e613dabf2128e30b430cdc9b1b1d4f3d7921ae87452",
      "english": "Still playing with fire.\nYou never learn.",
      "translator_note": null
    },
    {
      "id": "msb_0007D480",
      "source_words_sha256": "25572d790c12656b2fc1cde316bd1345f15ed337fadd27caff7a3bf659375428",
      "english": "A trader? Why here?",
      "translator_note": null
    },
    {
      "id": "msb_0007D64C",
      "source_words_sha256": "cc00144bd2d6f6b01be4305633bb4b5fc79c56a42853354b6bf89d0e09e9ad79",
      "english": "Wait. Gin Tama\ncompress Japanese\nwords, don't they?",
      "translator_note": null
    },
    {
      "id": "msb_0007D784",
      "source_words_sha256": "a655641da086769e22887e203f68233d7b397fc6cdf1c2e65a01fd888543c4ef",
      "english": "Seppuku for breaking rules\nor die fighting\nspace pirates?",
      "translator_note": null
    },
    {
      "id": "msb_0007D814",
      "source_words_sha256": "1f20dc12901e462862e3353dee7dbab8195491bc316838d4868cc71efec611b6",
      "english": "Come, Sougo!\nBeat that frog\nand make him confess!",
      "translator_note": null
    },
    {
      "id": "msb_0007DA54",
      "source_words_sha256": "c9b12915c7bc4738f702706d602e74dc4a59e0576f978cd762a6958035d086e5",
      "english": "Glad to hear you\nsay that, but...",
      "translator_note": null
    },
    {
      "id": "msb_0007DB2C",
      "source_words_sha256": "0c0bcf5bf859a7d6323e24e1c17403fc9b9d733c3b6c75d1376910de32b7ef4a",
      "english": "Kinya's staying\nat [blue]IKEDAYA[/color].",
      "translator_note": null
    },
    {
      "id": "msb_0007DB58",
      "source_words_sha256": "2c3c5b671bbe508e3e39f5c4cb3dab64a0703b46b689c72d8c065dd79b13d0ac",
      "english": "Had a man\npatrolling near\n[blue]IKEDAYA[/color], you see.",
      "translator_note": null
    },
    {
      "id": "msb_0007DCA8",
      "source_words_sha256": "d6ebea85b353be75a7eee8ceea9caf48934837feeb15f154697aaca73bf2c08d",
      "english": "True. No major damage.",
      "translator_note": null
    },
    {
      "id": "msb_0007DD78",
      "source_words_sha256": "29772133b4b7726c2050f45cb31049de91fc69e00bc777ba54d12efb46d7ade9",
      "english": "I'm [red]Tatsuma Sakamoto[/color].\nA trader in space.",
      "translator_note": null
    },
    {
      "id": "msb_0007DE70",
      "source_words_sha256": "3940d0da695de4a1528a552d3eda506e6671f9c0eba9d54e7815e0503b613107",
      "english": "Mysterious toys.\nNobody knows who\nmade them popular...\fYou don't believe that,\ndo you?",
      "translator_note": null
    },
    {
      "id": "msb_0007E03C",
      "source_words_sha256": "ab25b5706007d001b677c6fe304546fb0122a5d2fe25653b9d183c7533064a20",
      "english": "A rising force\namong space pirates.\fSmaller than Harusame,\nbut high-tech pirates\nwith cutting-edge science.",
      "translator_note": null
    },
    {
      "id": "msb_0007E0D4",
      "source_words_sha256": "a61880989234fc7cab9b45a595b881db7221b1441ec168234006e28daf09c3f8",
      "english": "Strange Tama made\nby compressing words'\nenergy and various materials.",
      "translator_note": null
    },
    {
      "id": "msb_0007E150",
      "source_words_sha256": "418f947646ce54ae20cee9214563f8245357cce05c08727174bba0d4714fac71",
      "english": "Words and culture\nvary by planet.\fTo compress word energy\ninto a weapon...\fThe target planet's\nlanguage and culture\nare essential.",
      "translator_note": null
    },
    {
      "id": "msb_0007E2F8",
      "source_words_sha256": "293bd344dc3dfb59d92438bfd5712bafcb89630c761ebcd4efb6a63e40b0bfc5",
      "english": "Then [red]natural disasters[/color]\nstruck. The people\nwere easily conquered.",
      "translator_note": null
    },
    {
      "id": "msb_0007E578",
      "source_words_sha256": "487b90bcf22026ecfaf32aa7aba256c0e6f598cea9c7d4639400118c54c18137",
      "english": "Know that one.\nHotel [blue]IKEDAYA[/color].",
      "translator_note": null
    },
    {
      "id": "msb_0007E5AC",
      "source_words_sha256": "fb0f6f1a910c616390e4c3734198065018f99435dede9a500c350379dfe20d06",
      "english": "My business is done.\nI'll be going, then.",
      "translator_note": null
    },
    {
      "id": "msb_0007E668",
      "source_words_sha256": "d24f2c995ce45a74a83df97b8efbc5a4e9ee86d3632fd71eb132cdb0c26730b4",
      "english": "Coming in.",
      "translator_note": null
    },
    {
      "id": "msb_0007E6F4",
      "source_words_sha256": "b9a77d31f287d2916b8b0348bbb683301bfb6fc0f471412d9cafab65138a43b8",
      "english": "I'm ready.",
      "translator_note": null
    },
    {
      "id": "msb_0007E724",
      "source_words_sha256": "fb5bd9e5a3e4d7d9213216ae3e01e5b7cc6b6ef1ab7a18e857b8233cefd92f11",
      "english": "Tail between legs! Run!",
      "translator_note": null
    },
    {
      "id": "msb_0007E7FC",
      "source_words_sha256": "a9098be952baa18842dd4483bf6d47e028a6fa7c166eee4d34398cc9a82ecf21",
      "english": "Fine. Deal struck.",
      "translator_note": null
    },
    {
      "id": "msb_0007EC1C",
      "source_words_sha256": "5d60e820407988a1ea9aaf9911f87083a2fbbebd1155258e49578b3100e60468",
      "english": "Somehow, he knew\nmy ties to Harusame...\fThreatened to expose me\nunless I helped\nthe Banbanji.",
      "translator_note": null
    },
    {
      "id": "msb_0007ECF4",
      "source_words_sha256": "a70a5d7d017e44fa340caeeb2b9d87fc3d9e8c77260d1e76b352117ae60344dd",
      "english": "Pathetic!\nSo entertaining!",
      "translator_note": null
    },
    {
      "id": "msb_0007ED94",
      "source_words_sha256": "ac64f65b2d95b2a8a49401569ee8339ef5e513838e4d185248bc798b5ab74007",
      "english": "You dare, knowing\nLord Kinya's\nstaying here?!",
      "translator_note": null
    },
    {
      "id": "msb_0007EE5C",
      "source_words_sha256": "5265968f904318b047e1bebb53f2ba80ab6d4204ce1a96d279aa98fc354d059a",
      "english": "E-excuse... me...",
      "translator_note": null
    },
    {
      "id": "msb_0007F42C",
      "source_words_sha256": "6571530df1daaf2fb8083147d2ba17949e999047986d29857e887ccbce2e4e4a",
      "english": "I see...\nWhy not ask\nthe Yorozuya?",
      "translator_note": null
    },
    {
      "id": "msb_0007F564",
      "source_words_sha256": "ca0ebb65a2a2c7ee8e1fe9a72d778849665e6c49e721b498f317f282c55eb899",
      "english": "[red]Another Daraku[/color]\nbroke the detained\nDaraku out of jail.",
      "translator_note": null
    },
    {
      "id": "msb_0007F87C",
      "source_words_sha256": "2f8d2c724d1062507d3a5789397b787dc9c94e56fef0760637904038539ec115",
      "english": "Awfully quiet\ninside [blue]HQ[/color]...",
      "translator_note": null
    },
    {
      "id": "msb_0007F9F4",
      "source_words_sha256": "f633ff5c4c1e237548d662e0fc432641fd7c76d3cacf8de097855e891850279b",
      "english": "Ground shook,\nthen lightning\nran across the sky...",
      "translator_note": null
    },
    {
      "id": "msb_0007FA2C",
      "source_words_sha256": "1a636443023512d3153a29a8a4cf28b058ffb0c5868304898189a6f9b63e7564",
      "english": "So much lightning...\nBeautiful...",
      "translator_note": null
    },
    {
      "id": "msb_0007FC24",
      "source_words_sha256": "c1d43482eed49a045941f4a73fb703be6bb10baa7f46fa51ebee8872ac4f1304",
      "english": "[blue]New Tower[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_0007FD5C",
      "source_words_sha256": "e15069020d03070c91ad3de0cac93e0e079205368306206330cda8ee30e936e8",
      "english": "'Easily conquered'...?",
      "translator_note": null
    },
    {
      "id": "msb_0007FD88",
      "source_words_sha256": "9391623b71b35f110d08f0bf40b96397f6b569e0a2748eea4fb65a06c5307cc8",
      "english": "Easy to rule\nlistless people.",
      "translator_note": null
    },
    {
      "id": "msb_0007FF50",
      "source_words_sha256": "244422406209db006ef84de5e9c1442bb97184e5ccdad79dd268b00314a7a2dc",
      "english": "Lightning flashed\nlike crazy toward\nthe [blue]New Tower[/color]...",
      "translator_note": null
    },
    {
      "id": "msb_0008009C",
      "source_words_sha256": "8461f42d9672ab00ab9af8fa52a6b85dfb0d47ad1c99e8fb258b8c6ea46cfef7",
      "english": "No spirit...\nMore like\nutterly useless.",
      "translator_note": null
    },
    {
      "id": "msb_000802B0",
      "source_words_sha256": "942af639e29a9b83cb36580debab024645048530f2b8721ec43dd9ac7a6f6061",
      "english": "Don't know...\nBut Gin Tama seem linked\nto that [red]quake and lightning[/color].",
      "translator_note": null
    },
    {
      "id": "msb_00080300",
      "source_words_sha256": "c1d43482eed49a045941f4a73fb703be6bb10baa7f46fa51ebee8872ac4f1304",
      "english": "[blue]New Tower[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_00080330",
      "source_words_sha256": "0eb2f0072eb92f890359701e37feefa31dcf58830c0d054ce51fe2734943caf7",
      "english": "Tch... Someone else\nquit driving\nand crashed again...",
      "translator_note": null
    },
    {
      "id": "msb_000803D4",
      "source_words_sha256": "c246e966b63aa5ce837438b3b3f663bc29c019358c7e3b4151d0005511ab5fb5",
      "english": "Trains derail.\nPlanes crash too...",
      "translator_note": null
    },
    {
      "id": "msb_00080418",
      "source_words_sha256": "c142fad281814526a85bb7e0de92bfe81311368ba9af817822e9027012c33242",
      "english": "Damn...! Why does\nHIS face come to mind\nat a time like this?",
      "translator_note": null
    },
    {
      "id": "msb_0008053C",
      "source_words_sha256": "f814857dc39c1e77748106dea7c15f56d8ff3f5a7399418b199a38687be34726",
      "english": "Ah, that digital TV\ntower, was it...?",
      "translator_note": null
    },
    {
      "id": "msb_000805A0",
      "source_words_sha256": "04461bf2012c0b2e625fb3d6f95b34db997fd9e54fc8abde18881f158c75b510",
      "english": "Hurry! Damage's spreading!",
      "translator_note": null
    },
    {
      "id": "msb_000806B8",
      "source_words_sha256": "325b06ab03caff9d3b50f0d2d95fa38c0782bb49ec427f446408fe5272415f05",
      "english": "Someone saw lightning\nflashing toward\nthe [blue]New Tower[/color], right?",
      "translator_note": null
    },
    {
      "id": "msb_000806FC",
      "source_words_sha256": "c2b30e6302a11c3471e1fabbc7110ef3103e49330c2110afff1b748b504c2f68",
      "english": "Don't know it?\nThe [red]recently built tower[/color].",
      "translator_note": null
    },
    {
      "id": "msb_000807A4",
      "source_words_sha256": "c69ef9107220bf53172bc5a622a16f00f5de4f081a0a77029c3e44705a2f9699",
      "english": "People neglect duties,\nmajor accidents follow.\nOf course.",
      "translator_note": null
    },
    {
      "id": "msb_00080840",
      "source_words_sha256": "ab375638ef60555151b2b07998fe44994383e5a28a3cd17eeaa796c9da29f0d2",
      "english": "Mean the Yorozuya?",
      "translator_note": null
    },
    {
      "id": "msb_00080860",
      "source_words_sha256": "f62917ac69b3b93a8eaef89deca50606054a88b30dc616de10e42ee53fd1c477",
      "english": "Why not\nlook for him?",
      "translator_note": null
    },
    {
      "id": "msb_0008088C",
      "source_words_sha256": "bf0f34bb09bc61feeac5363c5bcb92fa74db689dc95776173d0e64e7fa98041d",
      "english": "Always listless, that man.\nProbably no different\neven in this mess.",
      "translator_note": null
    },
    {
      "id": "msb_00080AA4",
      "source_words_sha256": "d6efa7df8e63f1bddb6d9ea74fe3882e98a1ade3b56ec4b79afa583d3e833374",
      "english": "Helping him made\nme late too! Damn it!",
      "translator_note": null
    },
    {
      "id": "msb_00080BA4",
      "source_words_sha256": "aa37935d955b177ec6a6ee67bbc411689d70aa3feae424c24819ab2093dc7c2c",
      "english": "[blue]Hokuto Shinken[/color].\nRamen shop. Great soba.",
      "translator_note": null
    },
    {
      "id": "msb_00080CA0",
      "source_words_sha256": "0c0bcf5bf859a7d6323e24e1c17403fc9b9d733c3b6c75d1376910de32b7ef4a",
      "english": "Kinya's staying\nat [blue]IKEDAYA[/color].",
      "translator_note": null
    },
    {
      "id": "msb_00080CCC",
      "source_words_sha256": "2c3c5b671bbe508e3e39f5c4cb3dab64a0703b46b689c72d8c065dd79b13d0ac",
      "english": "Had a man\npatrolling near\n[blue]IKEDAYA[/color], you see.",
      "translator_note": null
    },
    {
      "id": "msb_000810C4",
      "source_words_sha256": "5c4413f2cdf24cdbc6da703537eb2fd2c4e0a72d58847addb12224a377337c5c",
      "english": "Knew it! Hehehe.\nLet's go redeem it\nright away!",
      "translator_note": null
    },
    {
      "id": "msb_0008127C",
      "source_words_sha256": "b9e145040298dff5692d1a8fa2b4fc01b9e19e68f7e6c84bcfc5fe859ada63d1",
      "english": "Coming in.",
      "translator_note": null
    },
    {
      "id": "msb_0008128C",
      "source_words_sha256": "bfea05bda26bc6b679cd6ab898205cd962370117977b21ae1f130ab7ff1ae57f",
      "english": "Right, got this here.\n...Can use it, right?",
      "translator_note": null
    },
    {
      "id": "msb_000814C8",
      "source_words_sha256": "e5ec72b074604b1087bad1c156fc1a954fc0c286cba55413839f757205180fd7",
      "english": "Gin Tama's all the rage.\nWe don't want to miss out,\nso we're running this offer...",
      "translator_note": null
    },
    {
      "id": "msb_00081698",
      "source_words_sha256": "beeb02718ad2cef8380ef9fd911861053b8492d714957242b78cde34ca4db53e",
      "english": "I know, I know!\nStop shouting!",
      "translator_note": null
    },
    {
      "id": "msb_00081768",
      "source_words_sha256": "2fc8b0070f27c8b70ed9e9e34f5dbf8ea0550323e1657627362a1b675c1e6354",
      "english": "Remember the tip\nI gave you?\fThat shifty-eyed samurai\nnear the [blue]TV station[/color]...",
      "translator_note": null
    },
    {
      "id": "msb_00081FB0",
      "source_words_sha256": "08a7c7013b244cf5e1ef22a3b2eb4341465b154fae93a8433debec81af71a7a3",
      "english": "...Tired of walking alone.\nTime to rejoin\nShinpachi and Kagura.",
      "translator_note": null
    },
    {
      "id": "msb_00082108",
      "source_words_sha256": "d5d8f32f90e5a5eead098b615effcefa06d2032d74dd605f97e03d33b86b9e1d",
      "english": "I know.\nGo to [blue]Gengai's[/color], right?",
      "translator_note": null
    },
    {
      "id": "msb_0008217C",
      "source_words_sha256": "7d7f0cd6adf41df4348c20481d9cbcfa2c672d800db919387ec72964b587eead",
      "english": "I KNOW!\nGo to [blue]Gengai's[/color].\nLeave it to me.",
      "translator_note": null
    },
    {
      "id": "msb_00082764",
      "source_words_sha256": "a9aa2a29146d2fbbda7fd0705293cecc1b0c0d5cfe63085dc9a73b682a785dd5",
      "english": "Sorry! Um...\nOh, right!\n[blue]North Golden St.[/color]!",
      "translator_note": null
    },
    {
      "id": "msb_00082820",
      "source_words_sha256": "d48a3eb9e9105ea4de2515f5f510a917fbdb4293ae8640bb49d5b64dc9e97ce3",
      "english": "Glad I reported it.",
      "translator_note": null
    },
    {
      "id": "msb_0008305C",
      "source_words_sha256": "6dd22a611d72fcf1b2fc79cfd6ed8d837e88be8fb40d14b9cf6babd6ab9b1936",
      "english": "N-no, not at all!\nOnly did what I should!\nExcuse me!!",
      "translator_note": null
    },
    {
      "id": "msb_00083150",
      "source_words_sha256": "020730f20b8f6749610e0e6bdb4fee34bd8a8b355b2404097732afa6ecf062f2",
      "english": "Oh, comrade. Not yet...\nDamn! Shameful for\nthe Fan Club Captain!",
      "translator_note": null
    },
    {
      "id": "msb_000831A0",
      "source_words_sha256": "a80bc41ca4df322f2dbb6e26acd1153418dbe3264dd326637e66198302013911",
      "english": "Yes, somehow.\nThanks for the tip.",
      "translator_note": null
    },
    {
      "id": "msb_000838F8",
      "source_words_sha256": "01f964638eb2d31ebdf388311d779bfe5d065d13172bbb79f9b5c1530d50e0d2",
      "english": "Oh, Yorozuya!",
      "translator_note": null
    },
    {
      "id": "msb_00083910",
      "source_words_sha256": "0b3bb473559d0b4f32186e551618c258a83abc8cd5976b79be316d4d15dc666b",
      "english": "Good timing...\nHave you seen\nthat bastard Katsura?",
      "translator_note": null
    },
    {
      "id": "msb_00083964",
      "source_words_sha256": "8b85dd0e1a00245cd2a4552cd8764f5ca0207d489ed5088e0b7a9f3da9b696a6",
      "english": "I see...\nSightings of a Katsura\nlookalike near [blue]Saguri Bridge[/color].\fNot seen him? Fine.\nSorry to bother you.",
      "translator_note": null
    },
    {
      "id": "msb_000839E8",
      "source_words_sha256": "6a0df3f19967acf0fc290be602b9118858c02ecd6ebff3c8c911f2e0f7dc7567",
      "english": "Ah, Yorozuya!",
      "translator_note": null
    },
    {
      "id": "msb_00083A04",
      "source_words_sha256": "7302dd1891485eae94523808a6078f0f7e2f0ac42395c68ef9b5f38d65796fd1",
      "english": "I'm searching this area.\nDoesn't seem\nto be nearby...\fTell us if you see him.\nKatsura was sighted\naround [blue]Saguri Bridge[/color].",
      "translator_note": null
    },
    {
      "id": "msb_00084180",
      "source_words_sha256": "544a60a4acff3a41dd2e979db42273d20eff1ef0d2034331391210f48fbe9d51",
      "english": "Mr. Katsura's a worry.\nRoams wherever\nhe pleases...\fWorried something might\nhappen to our leader.\nTell him to stop that.",
      "translator_note": null
    },
    {
      "id": "msb_0008446C",
      "source_words_sha256": "924072c9cea506148546975a38cc1ad82f77ed04654a017862ba67fb68ed36ac",
      "english": "Me too, come to think...\nBeen walking\nall day today.",
      "translator_note": null
    },
    {
      "id": "msb_00084514",
      "source_words_sha256": "d6f8e799e844f389f3866771650ddac6520186afc19fa355f3b7323fd6968638",
      "english": "Got a horrible\nfeeling about this...",
      "translator_note": null
    },
    {
      "id": "msb_0008462C",
      "source_words_sha256": "f188a7495e5492dbae6ed4771aafca82c0d61f36d2843148e8c0ec2419f07888",
      "english": "Gone soft after all.",
      "translator_note": null
    },
    {
      "id": "msb_0008464C",
      "source_words_sha256": "8174426688b1b5b4ca61a594bff83f0413913306784ee95e42cc4c3ebb908cea",
      "english": "Gone soft!",
      "translator_note": null
    },
    {
      "id": "msb_00084924",
      "source_words_sha256": "92e720ecd581b621bde7e999f5e92be6c2105b865caa67f82321af4a1d90cf84",
      "english": "So tired...\nEven tired of being tired.",
      "translator_note": null
    }
  ]
}
