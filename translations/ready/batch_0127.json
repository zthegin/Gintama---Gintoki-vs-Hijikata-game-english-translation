    {
      "id": "msb_0006D074",
      "source_words_sha256": "71b49e95535ed082ee2212ae3d6f3d2ab54d4a726dc616b53d56c362b437c4b7",
      "english": "Hey! We're filming!\nMove out of the way!",
      "translator_note": null
    },
    {
      "id": "msb_0006D0CC",
      "source_words_sha256": "22ffb0c6fe9945628a671403af7c1fc03fa7399e65fbfd5ba23e8b23c0cd6cc1",
      "english": "Where's the AD?!!\fHonestly... ADs\nare useless lately...",
      "translator_note": null
    },
    {
      "id": "msb_0006D19C",
      "source_words_sha256": "2c2e3b8fddf65d9ccd2f0a3cfdd65880fc6c847486e50082c73c6ac2b5bb795c",
      "english": "Odd way to show love.",
      "translator_note": null
    },
    {
      "id": "msb_0006D1DC",
      "source_words_sha256": "3c903075398d30806d6ecc3e8f1afa6b04af4ff84c0343f628de2f2351b960ed",
      "english": "You're in the way. Move.",
      "translator_note": null
    },
    {
      "id": "msb_0006D458",
      "source_words_sha256": "2110690781fe6d43ef6fc07e48bdd1b56b08d57a9269ceb37803dff5c44e1910",
      "english": "Missed out...",
      "translator_note": null
    },
    {
      "id": "msb_0006D478",
      "source_words_sha256": "6422826bc95b174a635070657d8e07ccac03dea168f17c08495d662b27c930dd",
      "english": "Missed the free doll\nthey handed out here.",
      "translator_note": null
    },
    {
      "id": "msb_0006D4E0",
      "source_words_sha256": "80d08ce8c5c7defdf028f7eae0861d6b6a188a85c369d46a8c252dd7c172c0a3",
      "english": "Ride again tonight?",
      "translator_note": null
    },
    {
      "id": "msb_0006D61C",
      "source_words_sha256": "65fb9d0050032d070c1b1f6214cd7111fc1a12945e80ec8a7a930e54237c345f",
      "english": "Biker gang...?\nCause trouble\nand I'll arrest you.",
      "translator_note": null
    },
    {
      "id": "msb_0006D6BC",
      "source_words_sha256": "abaeae9f156cc369896102f22eba5644dcdba6d404fe675641aaf4d19baec62e",
      "english": "Got it. Thanks\nfor the information.",
      "translator_note": null
    },
    {
      "id": "msb_0006D964",
      "source_words_sha256": "689fb74d2d9a7da86c9db9ce29b7f41234d4136add5bc01bf5ad4672f6071331",
      "english": "Mayo pals! Let's do our best!",
      "translator_note": null
    },
    {
      "id": "msb_0006DA40",
      "source_words_sha256": "23338bd37ca4518fd571323d5397668a6ca38fb59f9073943d2d8a981c9848ab",
      "english": "Then I won't ask.\nWant to retire\nwithout incident.",
      "translator_note": null
    },
    {
      "id": "msb_0006DAE8",
      "source_words_sha256": "a8d71c7a96231f4dc67934ed6b1d9dcd463eafd9157c9be79ab2002351359078",
      "english": "Hotel [blue]IKEDAYA[/color].\nSome bigwig's\nstaying there, apparently.\fSo they turned me away.",
      "translator_note": null
    },
    {
      "id": "msb_0006DB4C",
      "source_words_sha256": "485a36992b5ab4cd1d1b278282b7c19d75c2a43cbeb3a274e60eda50f30c4c78",
      "english": "Booked every room\nin the hotel.",
      "translator_note": null
    },
    {
      "id": "msb_0006DB74",
      "source_words_sha256": "893a6622c2a44f04bbf7d1c8e0ceda8aeafe10bbf2417ab86988352393e22b56",
      "english": "Nowhere to stay tonight...\fSleep on a bench\nat the [blue]Terminal[/color], I guess...\nUgh...",
      "translator_note": null
    },
    {
      "id": "msb_0006DBE8",
      "source_words_sha256": "3672aa84ae8a427e4abc582979a611e66952cdbfe74640d99fd6a996f90d5745",
      "english": "Business at [blue]IKEDAYA[/color].",
      "translator_note": null
    },
    {
      "id": "msb_0006DC98",
      "source_words_sha256": "169aa65f36494ed0d2d34d9463f338c08bcc483b3da863cb1b72605911e922c1",
      "english": "[blue]IKEDAYA[/color], huh...\nSomething odd there.",
      "translator_note": null
    },
    {
      "id": "msb_0006DF94",
      "source_words_sha256": "6d407fbc6d2fe306185e0adc2c53a87f11a18a453f6425dc2717563b98535c5c",
      "english": "A walk. Problem?",
      "translator_note": null
    },
    {
      "id": "msb_0006E1E0",
      "source_words_sha256": "8f5f292998411ec4e4d3e98e2b4f822afbf5f5316e42a936ff1495b66767d1b1",
      "english": "Matsudaira comes\nevery night.",
      "translator_note": null
    },
    {
      "id": "msb_0006E458",
      "source_words_sha256": "857378634ad510a96b979d6185489c0d3b04302752d3eb14e5c57836ea414424",
      "english": "That stings...\nDoing all I can.",
      "translator_note": null
    },
    {
      "id": "msb_0006E4C4",
      "source_words_sha256": "42f7701fc0cb35cdf096233eb571a96a3a553d905fb15e16d4143e2e1cbd7d3e",
      "english": "When will you arrest\nALL the Joi rebels?",
      "translator_note": null
    },
    {
      "id": "msb_0006E5AC",
      "source_words_sha256": "f65a8cdab70b54d3407fb8f29a9e8a937617aeb0e525ab7ba9e7f9a0a20521cf",
      "english": "Can't be bothered\nwith all that work.\nIt's exhausting...",
      "translator_note": null
    },
    {
      "id": "msb_0006E6A4",
      "source_words_sha256": "a7be909957e5556d24a3a73b65468db3d50c65abd422ccf58765b24648e4bb1f",
      "english": "The world-conquest guy.",
      "translator_note": null
    },
    {
      "id": "msb_0006E7F0",
      "source_words_sha256": "db356d3c8e5c978eb6a96e2979c7febbbe40c5758152135520230669cddfff17",
      "english": "A kid. What are you doing\nout at this hour?\nIt's dangerous.",
      "translator_note": null
    },
    {
      "id": "msb_0006E938",
      "source_words_sha256": "14eaee3f9b623b1218ac4e763b220d60e4caaede6d9e5f10025c00cb24ada374",
      "english": "For now, just breathing...\nIn... Out... In... Out...\fI'll quit when I get bored.",
      "translator_note": null
    },
    {
      "id": "msb_0006EA78",
      "source_words_sha256": "468fc7c1951dc36bfb97a9c125ae44596928217487f639535a9c981e0fd26d75",
      "english": "Hey! No roof?!\fWithout a roof,\nit's not a house!",
      "translator_note": null
    },
    {
      "id": "msb_0006EAF4",
      "source_words_sha256": "8b9d18b260d3a490da7787090595471707d115e3497c516c38d6b3963ce12fa4",
      "english": "No pillars?!",
      "translator_note": null
    },
    {
      "id": "msb_0006EB48",
      "source_words_sha256": "d265d5e3410f944ecb0722232173761b94c622a626eb3e3c9d47054762b5cdbc",
      "english": "I was putting a roof\non that house.\nToo much work. I quit.",
      "translator_note": null
    },
    {
      "id": "msb_0006EBC8",
      "source_words_sha256": "92f3d792e9260b036d3bd3b6cf5a6c5146f3791f38a00f8fbf533c076dd38868",
      "english": "Forget the roof...\nMaybe no walls either.\nToo much work...",
      "translator_note": null
    },
    {
      "id": "msb_0006EC10",
      "source_words_sha256": "9e9d4b0b669f27b1f37b2e180db3e16e9d31c87da95cb0730f396b9d7ec5399d",
      "english": "Actually...\nPillars sound like work too.",
      "translator_note": null
    },
    {
      "id": "msb_0006ECB0",
      "source_words_sha256": "285d3fd7919a9740e29e2e3bc044074d364c6c5ea10977ea82f7f96014c4df2f",
      "english": "So weary...\nLiving's tiring...\nMaybe I'll just pass on...",
      "translator_note": null
    },
    {
      "id": "msb_0006EE28",
      "source_words_sha256": "1b7537e8fac28451c1a7833e8254a8a5fe191f6a7dc4f1470257991dfe58c67f",
      "english": "Gambling's a pain.\nDrinking's a hassle.\n...Now what?",
      "translator_note": null
    },
    {
      "id": "msb_0006EF38",
      "source_words_sha256": "20a6eda7db2a7517afaff50958d4cf5ea7c5197b9f20ec3abb9f664fe2583c10",
      "english": "Oh... Shinsengumi...",
      "translator_note": null
    },
    {
      "id": "msb_0006F028",
      "source_words_sha256": "f439f0f1e78701b1fd2a615af9c9c8b2635eb2272acac96d62990851e50ff028",
      "english": "But stealing...\nIt's so tiring...",
      "translator_note": null
    },
    {
      "id": "msb_0006F1E0",
      "source_words_sha256": "69466464d34e8b692d8360429e5a2b1de34d8d01a4ba7694b2ee4f905247d926",
      "english": "A hundred million\nTamo fans would cry\nif they heard that...",
      "translator_note": null
    },
    {
      "id": "msb_0006F220",
      "source_words_sha256": "d5d2c964b668ce6943b472af4e537e86f73319fd73fc83bfb3bd5d0dd74e79d2",
      "english": "Even Tamo's\ngone soft!",
      "translator_note": null
    },
    {
      "id": "msb_0006F248",
      "source_words_sha256": "df532574f4b22d3acd5e4078c3a10e2a92020e039b022bf645216ad7379333a3",
      "english": "Meant to have a drink.\nCan't be bothered now...",
      "translator_note": null
    },
    {
      "id": "msb_0006F328",
      "source_words_sha256": "ccc6c2cdf61b3d271d28abdd6fae6266e0d27190ddb93a1e4406dd8be6eacea5",
      "english": "No more shaving\nor makeup!\nToo much work!",
      "translator_note": null
    },
    {
      "id": "msb_0006F460",
      "source_words_sha256": "147fb9df06edad71c1e0ef0cdd0d9994d9177f2e5da280b7c7e6fcbaa3667fa5",
      "english": "Plan to starve...?",
      "translator_note": null
    },
    {
      "id": "msb_0006F4A4",
      "source_words_sha256": "f86f9779894b948c9812082fe83609b0a2f2043d1c064204f81e99ee2e060a4d",
      "english": "Sleep out here\nand you'll catch cold!",
      "translator_note": null
    },
    {
      "id": "msb_0006F52C",
      "source_words_sha256": "c57317d38e7a6c21bfd16870638558e9de7521a04290ee68e7c3fb5e7d23d920",
      "english": "Mumble... It's fine...\nCatching cold is too much\nwork. Won't bother...",
      "translator_note": null
    },
    {
      "id": "msb_0006F5FC",
      "source_words_sha256": "92e720ecd581b621bde7e999f5e92be6c2105b865caa67f82321af4a1d90cf84",
      "english": "So tired...\nEven tired of being tired.",
      "translator_note": null
    },
    {
      "id": "msb_0006F630",
      "source_words_sha256": "a975762ed287a2adc5d324b621c901f57914624995388c5adf26f2968ec2b870",
      "english": "Tired of living.\nDying's too much work...\nWhat should I do?",
      "translator_note": null
    },
    {
      "id": "msb_0006F9DC",
      "source_words_sha256": "73e9244ae121ccb799819ed5c20df369a2fcb2da5b6eb986bc4003d908643291",
      "english": "Yakuza here...\nTired...\nClosed for tonight...",
      "translator_note": null
    },
    {
      "id": "msb_0006FAAC",
      "source_words_sha256": "bd9060ca5202f32b8506d45faec456a47095d15fd0b8e890fa384235f2978fc2",
      "english": "Sorry... Too tired\nto deal with you...",
      "translator_note": null
    },
    {
      "id": "msb_0006FB5C",
      "source_words_sha256": "e31b88d58f7e8b3c8d4181f3a6bd9f12e7299e1245c2b9720fbfdd7acfecfde0",
      "english": "You're walking?\nAmazing... So much energy...",
      "translator_note": null
    },
    {
      "id": "msb_0006FB94",
      "source_words_sha256": "58c89d8348d89ef962e585f8332a9b71169b0357f242f5859f9bb3a69f13ef9f",
      "english": "Yes... Shrine duties\non hold... Forever...",
      "translator_note": null
    },
    {
      "id": "msb_0006FD5C",
      "source_words_sha256": "4828ab68df03cecd695c53bd240d0ed136e97fe3ad6039b43892cca353aed485",
      "english": "Stop talking\nin that lazy tone!",
      "translator_note": null
    },
    {
      "id": "msb_0006FE18",
      "source_words_sha256": "8d092e6ea317ba9b7a233bc403670efacf37de170d18a796679afcf55257631b",
      "english": "Beep, beep, beep...\nOdd... Haven't done\nanything at all...\fDoing nothing\nstill uses energy...\nHahaha...",
      "translator_note": null
    },
    {
      "id": "msb_0006FEEC",
      "source_words_sha256": "f76e6af52806228c6a377647d8d9e6aec36005cfac9127b6b01aa48291f49b52",
      "english": "So tired...\nShouldn't gamble\non a day like this...\fThat's life...",
      "translator_note": null
    },
    {
      "id": "msb_0006FF48",
      "source_words_sha256": "c218db2aee04e8743cc7ff26e73f187c3ae4b91bc0801f8a45fe5ff26f6b594c",
      "english": "I quit...\nGambling and life.\nToo much work...",
      "translator_note": null
    },
    {
      "id": "msb_0006FF7C",
      "source_words_sha256": "5cc81453d2e2aa0317fb7e5f3c1081dd24796e9aa24b4e084a23014a1da60966",
      "english": "Celebrities are human.\nSometimes too tired\nto do anything...\f...So, good night...",
      "translator_note": null
    },
    {
      "id": "msb_000700DC",
      "source_words_sha256": "0cf931f74f3bc5b8623d258e1250ea5294b36effd4ae01cd0ca71266743a88ac",
      "english": "Said I don't care\nbecause I don't care...\nToo much work...\fAh, I quit...\nShutting the agency...\nDecided...",
      "translator_note": null
    },
    {
      "id": "msb_0007021C",
      "source_words_sha256": "0db6133715bf60cf93115273504a448176aa55d187fe0fc5119d1aa1e62eb64f",
      "english": "Hey, Mama...\nLet's just close up\nforever...",
      "translator_note": null
    },
    {
      "id": "msb_00070268",
      "source_words_sha256": "38d8e186924f19ba4ebd7bf212ae4dee00e5e11b300f0d19ad027251f4eb72a9",
      "english": "Closed forever...",
      "translator_note": null
    },
    {
      "id": "msb_00070360",
      "source_words_sha256": "e7b63dded18f72aaa7623b8d4eb3556f03cf0e191deed6c3b1b3e2103216356d",
      "english": "Bored of work\nin this lousy bar.\nMaybe back to stealing...",
      "translator_note": null
    },
    {
      "id": "msb_00070660",
      "source_words_sha256": "78506e49728cb2057549fb411968ad7e4aa9aa2b994888b494525468ae9eecfe",
      "english": "Not robbery?\nThen only one motive!\n...A grudge! Must be!",
      "translator_note": null
    },
    {
      "id": "msb_00070708",
      "source_words_sha256": "2a5a214b9f678f837f95ea1d6791482dbc8dfe8344095e78b23d211988a16138",
      "english": "Or maybe someone\nwith a grudge against me\nwent after Shinpachi...",
      "translator_note": null
    },
    {
      "id": "msb_000707B0",
      "source_words_sha256": "11b8de902a3cee495d42ca6f9c6f284b8de872f886f163e6240781110b5f560b",
      "english": "Avenge you, obviously.\nLet's find\nShinpachi's attacker!",
      "translator_note": null
    },
    {
      "id": "msb_000708F0",
      "source_words_sha256": "d174e6fc97d0f1b5a12e7a5fb20800a1a61736fe75a7e5caea3513196d6fe853",
      "english": "Cheer up, Shinpachi!\nLet's go!",
      "translator_note": null
    },
    {
      "id": "msb_00070914",
      "source_words_sha256": "e5ef138c187d737bbe9eddaacee786572ec93089c5b495dddb3632d73b5644d5",
      "english": "No point all going\ntogether. Split up?",
      "translator_note": null
    },
    {
      "id": "msb_000709AC",
      "source_words_sha256": "6152022ae23d156c8007ee1d5a14baac79ca084a1875d17d3a6040671cc5a17a",
      "english": "I'll head south.\fHave a look round,\nthen come back here.",
      "translator_note": null
    },
    {
      "id": "msb_00070A20",
      "source_words_sha256": "3ac5fc32954a00685d530b66b85663e3e8435ba0382e4501a175def94c557b06",
      "english": "Who's moping over there?\nHasegawa, isn't it?\nOh, eating dango...",
      "translator_note": null
    },
    {
      "id": "msb_00070AC8",
      "source_words_sha256": "74b2c17cf32ee61e28fc4ea562702ff52a157c6234dc31733e923f4bc8fb12ca",
      "english": "Good timing!\nBuy me some dango.",
      "translator_note": null
    },
    {
      "id": "msb_00070D44",
      "source_words_sha256": "62dd66e7e866250d06decdbc3dc3d6e5e3267be09e9f6352ebb7f3656598ebad",
      "english": "Never thought\nfinding the culprit\nwould be this easy...!",
      "translator_note": null
    },
    {
      "id": "msb_00070DC8",
      "source_words_sha256": "fa4f86ac169fae7555dc485ef2ff74016694613b15e74d67a0d1832ec707205d",
      "english": "Don't play dumb!\nMedical bills, damages\nand lost wages. Pay up!",
      "translator_note": null
    },
    {
      "id": "msb_00070E08",
      "source_words_sha256": "cd4063ba922b4f9f544c590f4c8abc240adf32e57b08f477b7d9cf30f7438bd3",
      "english": "Just 100,000 yen.\nSpecial discount.",
      "translator_note": null
    },
    {
      "id": "msb_00070E68",
      "source_words_sha256": "1e6db744507d085a481f8010c607b6cc622bb5cc996d4aaf781a3e7d76dffdf1",
      "english": "Oh, that attitude?\nLike a defiant robber.\nDisappointed, Hasegawa!",
      "translator_note": null
    },
    {
      "id": "msb_00070EBC",
      "source_words_sha256": "6c7aa5654ec01dab97dae8f3f4eef17029e6a883bebd36d898964a3c6d5e9b8b",
      "english": "Fine. No choice, then.\nWanted to settle\nthis peacefully...",
      "translator_note": null
    },
    {
      "id": "msb_00070F44",
      "source_words_sha256": "52686cfbc7ac4e5764dec5faff1e8cc183ec159234f4333871a50104bd7ef403",
      "english": "Right. As promised,\nbills, damages, lost wages.\n200,000 yen. Pay in full.",
      "translator_note": null
    },
    {
      "id": "msb_00071010",
      "source_words_sha256": "7194be1565d13de1734e70621e117eaff53403d0b3eb7bc16810ab38f7c57097",
      "english": "Damn! Not the culprit?\nCan't squeeze money out!\nStop being misleading!",
      "translator_note": null
    },
    {
      "id": "msb_000711B4",
      "source_words_sha256": "69df40395d45024726ca4a14d830ba8d8b4b07e56f2fed8392405e4ed782b80a",
      "english": "Hm? What is it?\nBuying me dango?",
      "translator_note": null
    },
    {
      "id": "msb_000711E0",
      "source_words_sha256": "bb72045b1692040d81e0d076732b965fe5ec07d7c0d1c115962b5623f2889907",
      "english": "Huh? Well...\nAn unfortunate accident...",
      "translator_note": null
    },
    {
      "id": "msb_00071220",
      "source_words_sha256": "f211e82563542e17b1bea16e2f4444dbcf26cc62d67fafdcc8e714e9995b2221",
      "english": "But I'm looking for\nShinpachi's attacker...",
      "translator_note": null
    },
    {
      "id": "msb_000713B0",
      "source_words_sha256": "c430b7358d3338b0dfd1713b841ada7e197020c4af94b086fa02a26b26adfe2b",
      "english": "A full-grown man,\neven a weak glasses boy,\nknocked out in one blow...",
      "translator_note": null
    },
    {
      "id": "msb_000716C8",
      "source_words_sha256": "5c0dde59a4b4a1e3f8c112da59fd56098bb0887f65053b5bfab7e5fbac4a2e4f",
      "english": "Huh? Ready for what?\nNo one mentioned that.",
      "translator_note": null
    },
    {
      "id": "msb_000717F8",
      "source_words_sha256": "0bac861e0c194ec9a90f3ef64f918aa1522b7e7cab1c64e7a80af2327886e001",
      "english": "Where's the trainer?\nThis gorilla's\npoorly trained.",
      "translator_note": null
    },
    {
      "id": "msb_00071978",
      "source_words_sha256": "e207600e175f2050e3a9a8791d5730fe22dc6f5e1ae7c96f6a67822b9a594af1",
      "english": "So inflexible.\nTypical bureaucracy.",
      "translator_note": null
    },
    {
      "id": "msb_000719AC",
      "source_words_sha256": "750721e7d4f15c1095b471482d4553bbb337c6a4b9eaa0ef7eae551d8cb6c2b1",
      "english": "A decent citizen\nhas been victimized...\f'Petty'? 'Trash'?\nSome things to say!",
      "translator_note": null
    },
    {
      "id": "msb_00071C5C",
      "source_words_sha256": "a271c49a0b5e83b8e2b14eaa10b04a6ad9870a91614cdc0e8e04b36d2e532a38",
      "english": "What?! Lost to a gorilla!\nAshamed as a human.",
      "translator_note": null
    },
    {
      "id": "msb_00071D60",
      "source_words_sha256": "c813793588486448ba19063548c4aa90f27aba0c5e796b1f97a0538ec4fecd4d",
      "english": "Don't click your tongue\nso evilly with that cool face!\nHow'd YOU get on?",
      "translator_note": null
    },
    {
      "id": "msb_00071E54",
      "source_words_sha256": "d02f8d9d98342804a3f0f6045c7d5031bbc83852764d963472cc21f9673e2e59",
      "english": "Sorry to interrupt\nthe hatter talk...\nBack to the subject?",
      "translator_note": null
    },
    {
      "id": "msb_00071F80",
      "source_words_sha256": "498411ce315005a3981a64e6337f0862ae92d3ebd297188eae54e53c7897fae7",
      "english": "I pay high taxes\nfor times like these.",
      "translator_note": null
    },
    {
      "id": "msb_00072078",
      "source_words_sha256": "ede13532c58a5d78eaba83443c5849899c5782fa08360c96f926e59bdaed524c",
      "english": "From the old man?\nLet's see...",
      "translator_note": null
    },
    {
      "id": "msb_000720AC",
      "source_words_sha256": "41404fb9e7ac852ef6383d7ead202cb3254763bcef2d4d38d8115cac1498dc2d",
      "english": "Huh? For some reason,\nsays come to [blue]Gengai's[/color].\fWhat now? Go?",
      "translator_note": null
    },
    {
      "id": "msb_00072140",
      "source_words_sha256": "6eed2903977ce25197d5dd876c1599c6a798d029d379e20285a07e5b03fe3911",
      "english": "Yes, Kagura!\nDinner can't wait!\nGo, Shinpachi!",
      "translator_note": null
    },
    {
      "id": "msb_000722A4",
      "source_words_sha256": "a271e9f9cd60cd9103c57589299e7594d93379e5dca9cf92f6552353e92285ac",
      "english": "Heard that, Shinpachi?\nHe said torture.\nTORTURE...!",
      "translator_note": null
    },
    {
      "id": "msb_000722EC",
      "source_words_sha256": "04d2e64eba940b640530493288eb8736cb3212174b2773694f76d7e75c02d21d",
      "english": "Yeah. Looks too broke\nto squeeze money out.",
      "translator_note": null
    },
    {
      "id": "msb_00072320",
      "source_words_sha256": "59f23fd6e9c3cd76faeeccb4774a55fbe99adf5159d04935d7c8ab0249710751",
      "english": "What's wrong, old man?\nYou look pale.",
      "translator_note": null
    },
    {
      "id": "msb_000723BC",
      "source_words_sha256": "23d8337c4f6c053b4b3558ca7accacf062f66c1da6f9774bb73610805a271a3c",
      "english": "What?! The old man\nmade those Gin Tama?!",
      "translator_note": null
    },
    {
      "id": "msb_00072410",
      "source_words_sha256": "b441e3f0597f6f0cf073927ba2074175e8a13d924e83e1b27d4787741d4cb1bc",
      "english": "Quiet, Kagura.\nI'll get the old man\nto feed you afterward.",
      "translator_note": null
    },
    {
      "id": "msb_000724E8",
      "source_words_sha256": "c4519bbb92d00253518554009da0a8203b4212befc016fb9c8b4dca3995129ff",
      "english": "Oh, I get it!\nBoasting, old man?\nWant us to say 'amazing'?",
      "translator_note": null
    },
    {
      "id": "msb_00072558",
      "source_words_sha256": "5d48b63d8f7b2676f2e133d29748935fb2738eb527820d4cc62b4336925d8f9c",
      "english": "...So, old man.\nThat Amanto\nwho hired you...?",
      "translator_note": null
    },
    {
      "id": "msb_000726F8",
      "source_words_sha256": "fa24cdfe27ed917b021fc4196d938ef07e2648ac34d62e60431c8dd7eb8c2827",
      "english": "Zura and you, old man...\nWe're all stuck\nwith each other.",
      "translator_note": null
    },
    {
      "id": "msb_00072740",
      "source_words_sha256": "11ad4b691a28bc2ce9ce929c2e136f272a44fcb381870e7a999f78036f7ad3f4",
      "english": "Damn it!\nWhat a pain!!",
      "translator_note": null
    },
    {
      "id": "msb_00072D2C",
      "source_words_sha256": "0e0897b09fef6aef5cea2ad29596e4d374d63a5042232fc6a92fd60ccd5365bb",
      "english": "Idiot! It WASN'T\njust a toy! That's why\nwe got dragged in.",
      "translator_note": null
    },
    {
      "id": "msb_00072D84",
      "source_words_sha256": "1563b609671cdc8f0e204ec5150d34929d7e6de53a2b1c76e8ad305c9fd89f86",
      "english": "Gah! Another\ntroublesome guy.",
      "translator_note": null
    },
    {
      "id": "msb_00072DE8",
      "source_words_sha256": "ad0a6d4c7c77b3e067618355cae093fa3004ddf3819baa26e182ee7f8b6f9b23",
      "english": "Yeah. Hard to tell\nwith so few expressions.\nDefinitely not normal...",
      "translator_note": null
    },
    {
      "id": "msb_00072EFC",
      "source_words_sha256": "a4bea9f340b0843000f9f17c372eb58144e87ca7f6f88cb91c346a0a8e69e126",
      "english": "Yeah. An empty shell.",
      "translator_note": null
    },
    {
      "id": "msb_00072F14",
      "source_words_sha256": "1b6ab28e2e5868634524507d696ecb2e67ae0a9f884025a8886ceb320e00d481",
      "english": "Otae, of all people...\nShinpachi, something's\nseriously wrong!",
      "translator_note": null
    },
    {
      "id": "msb_00072F78",
      "source_words_sha256": "2bb0f4d85390a2eb50320036198d474299d8c0ca5f12986ed20ce2fbf41134b9",
      "english": "Gah! Them too!\nNo spirit at all!",
      "translator_note": null
    },
    {
      "id": "msb_00072FAC",
      "source_words_sha256": "73b8a5822647dceba6957fa9378a9f36ee5227184f7214737dfea7c88c60b004",
      "english": "Yeah. A listless\ndrag queen's even\nscarier, in a way...!",
      "translator_note": null
    },
    {
      "id": "msb_00073200",
      "source_words_sha256": "219f830f8e8521743dd4698ca4e29d8df4806a245cd4a0b1e1813b54e8bf6854",
      "english": "Shinpachi, what's\nthis [blue]New Tower[/color]?",
      "translator_note": null
    },
    {
      "id": "msb_00073280",
      "source_words_sha256": "226fbae4220692e3cf3e35bc1cc4799815c639c105c3d5da0fad4c28dd71ed1b",
      "english": "Wasteful public works!",
      "translator_note": null
    },
    {
      "id": "msb_000732FC",
      "source_words_sha256": "a5a579207b8934da6df5c81a446d1920435c309d37ce95930eb7f40a3694e6e6",
      "english": "What's wrong?!\nDidn't you dream of being\na small, lovely flower?!",
      "translator_note": null
    },
    {
      "id": "msb_000733AC",
      "source_words_sha256": "fa15b09c8cf995860e65de8fbfcadac13e70952a3c5b8e41165a41e2d3c19365",
      "english": "You weakling!!",
      "translator_note": null
    },
    {
      "id": "msb_00073410",
      "source_words_sha256": "61c7ff20e3536cec40b085583d278a318b28e106f6861609895d13c062968d23",
      "english": "Hey! A boss just\nlooks out the window\nbeside his desk! Squinting!",
      "translator_note": null
    },
    {
      "id": "msb_00073590",
      "source_words_sha256": "e0e7ce5be23344aa0d4c3f7edca4ab9b94babdb5dc85ee0fb1988a923ac0d9c5",
      "english": "Damn... Without that\ntrio of jinxes, I'd be\nrunning a second branch...",
      "translator_note": null
    },
    {
      "id": "msb_000735F4",
      "source_words_sha256": "73e51fe84e0aeafa5f63cfb536ee409e279b3402e0e355971c2ee9bc9b56937d",
      "english": "Hm? Gah!\nChief of the jinxes!",
      "translator_note": null
    },
    {
      "id": "msb_00073620",
      "source_words_sha256": "8753c3ce6f4fa071f3a069a797a3ae42031ad314fa8692efde7eda9914cff11f",
      "english": "No way I'm paying!!\nWhy'd you pop up\nhere, anyway?!",
      "translator_note": null
    },
    {
      "id": "msb_00073890",
      "source_words_sha256": "dfd6e6ab0f349d135d7a82df2810c97405004b826e1c6e0abbeab2f4008cd33d",
      "english": "Said I don't know!\nDon't play dumb\nand raise the price!",
      "translator_note": null
    },
    {
      "id": "msb_00073A38",
      "source_words_sha256": "91fbaa6adeda32137c592cc322bac60b6edc2b302be5f55359bace5dd7ed4635",
      "english": "Not done yet!\nTake responsibility\nfor [blue]Nabeya[/color]!",
      "translator_note": null
    },
    {
      "id": "msb_00073B08",
      "source_words_sha256": "a1c8fdd3ef90d7f64d1afa5e157391da1646aee417a351cb21c0b53101e4f1d0",
      "english": "No arguments!\nSearch ends here!",
      "translator_note": null
    },
    {
      "id": "msb_00073CA8",
      "source_words_sha256": "550e101902e5897a142541a8e37b646248a6620c235088b805503b9c0ddd96e2",
      "english": "Ah... Got lost\nand wet myself...",
      "translator_note": null
    },
    {
      "id": "msb_00073CD8",
      "source_words_sha256": "fd023480e52026ebebb10018557c32aa1a01f3d16bd270fb9e9af91f2990e207",
      "english": "Ugh... Feels awful...\nOh, well.\nIt'll dry eventually...",
      "translator_note": null
    },
    {
      "id": "msb_00073D4C",
      "source_words_sha256": "23c4933f36f8e8bc4dfcad6a2ff51493da055c5b662eab454584006be133d212",
      "english": "Oh, right. Lightning\nflashed toward\nthe [blue]New Tower[/color] earlier...",
      "translator_note": null
    },
    {
      "id": "msb_00073DF4",
      "source_words_sha256": "783e72288cef0da47ac9d58871bbc6a35cd6410b5b0922da0ac8e13e480cac24",
      "english": "Oh, Yorozuya.\nAll out for a walk?",
      "translator_note": null
    },
    {
      "id": "msb_00073E28",
      "source_words_sha256": "866e5e18122f5767b69b031f804c65effd6b9eef447c69fcf50a8759aa3d072d",
      "english": "Huh? Say something?\nJust walking off\nthe ramen I ate.",
      "translator_note": null
    },
    {
      "id": "msb_00074228",
      "source_words_sha256": "73e0e9e9a25e1b894c1a884f7c5fe9872c0f0372fb9bbab9abdfc22ad7c0f30e",
      "english": "Happened to be walking\nnearby when\nyou were attacked.",
      "translator_note": null
    },
    {
      "id": "msb_00074264",
      "source_words_sha256": "ab748efca8315726e3c1d3a05d5bbc53902cf91cd57386d99218f33ffbfdd7be",
      "english": "Luckily, injuries\nlooked minor.\nChased and caught him.",
      "translator_note": null
    },
    {
      "id": "msb_000742E8",
      "source_words_sha256": "e3da80824b8bac9d7a0c16fc94ead75dc9f858294801bf8c41ee8a14d19ea308",
      "english": "A little torture...\nI mean, polite questioning.",
      "translator_note": null
    },
    {
      "id": "msb_000745A4",
      "source_words_sha256": "2213300b52cbfa7f9590fd011dd23c39351225ece623e5bc283c5c64e2b2de89",
      "english": "More precisely...\nHe flattered me\ninto making them.",
      "translator_note": null
    },
    {
      "id": "msb_00074654",
      "source_words_sha256": "26784b6110264e7d0a366d08824fe4877b64e9363c3f63c70dcac0da2f4e5003",
      "english": "Said he ran\na toy company\ntrading across space.",
      "translator_note": null
    },
    {
      "id": "msb_000747A4",
      "source_words_sha256": "7391e5b8dc28e58e0716d0d2a31636bd43b8354f4496a6407a9dd58f71721168",
      "english": "Those Tama contain\ncompressed word energy.\nIt's called Kotodama.",
      "translator_note": null
    },
    {
      "id": "msb_00074918",
      "source_words_sha256": "425e6380edeb59ef2ec24c7e1fa2ddb9fc36a4a69af18dbfc561fc18f584ec26",
      "english": "Skilled in mechanical dolls\nand our country's culture,\nlanguage and customs...",
      "translator_note": null
    }
  ]
}
