    },
    {
      "id": "msb_0006BA20",
      "source_words_sha256": "c81bc06da4e36d8166ff28a9004828f8bb8c4f3f3450391aff42a81b8c437b3e",
      "english": "Oh, no...\nThat man again...",
      "translator_note": null
    },
    {
      "id": "msb_0006BBD4",
      "source_words_sha256": "4b01debdf0b9ecec5e8b94b032aa551217407acfd117a8571d38ac2a84b69b0b",
      "english": "Not into that...\nWhat're you making me say?!",
      "translator_note": null
    },
    {
