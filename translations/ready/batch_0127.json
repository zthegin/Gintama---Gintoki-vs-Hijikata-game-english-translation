  "records": [
    {
      "id": "msb_000690DC",
      "source_words_sha256": "c57317d38e7a6c21bfd16870638558e9de7521a04290ee68e7c3fb5e7d23d920",
      "english": "Mumble... It's fine...\nCatching cold is too much\nwork. Won't bother...",
      "translator_note": null
    },
    {
      "id": "msb_00069130",
      "source_words_sha256": "9c2f9d89e0667b6e8a3c0d74bece176594c76b9097c8823f156f4569dce7459e",
      "english": "Sleep out here\nand you'll catch cold!",
      "translator_note": null
    },
    {
      "id": "msb_000692BC",
      "source_words_sha256": "3d4ac8058b2b1d18f805569fe241994efa732e754965331fe1a22460d911c921",
      "english": "Like Sukonbu\nwithout the vinegar!",
      "translator_note": null
    },
    {
      "id": "msb_00069378",
      "source_words_sha256": "73e9244ae121ccb799819ed5c20df369a2fcb2da5b6eb986bc4003d908643291",
      "english": "Yakuza here...\nTired...\nClosed for tonight...",
      "translator_note": null
    },
    {
      "id": "msb_0006948C",
      "source_words_sha256": "bd9060ca5202f32b8506d45faec456a47095d15fd0b8e890fa384235f2978fc2",
      "english": "Sorry... Too tired\nto deal with you...",
      "translator_note": null
    },
    {
      "id": "msb_00069514",
      "source_words_sha256": "e31b88d58f7e8b3c8d4181f3a6bd9f12e7299e1245c2b9720fbfdd7acfecfde0",
      "english": "You're walking?\nAmazing... So much energy...",
      "translator_note": null
    },
    {
      "id": "msb_0006954C",
      "source_words_sha256": "58c89d8348d89ef962e585f8332a9b71169b0357f242f5859f9bb3a69f13ef9f",
      "english": "Yes... Shrine duties\non hold... Forever...",
      "translator_note": null
    },
    {
      "id": "msb_000696DC",
      "source_words_sha256": "f10b12d1eb6a9d356398649779ff9509c84097399b0072654c9513eccfca8da4",
      "english": "Hey! Mokichi would cry\nif he saw you like this!",
      "translator_note": null
    },
    {
      "id": "msb_00069824",
      "source_words_sha256": "d20684e8a916d8a0aabfbdd97b321c5a32100f62d892627f1dbfeb4b9b1ad7f8",
      "english": "Hey! Don't destroy\nthe dreams of kids\nall over the country!",
      "translator_note": null
    },
    {
      "id": "msb_00069864",
      "source_words_sha256": "f69022106d3b6dd5a9d29274784e821cf1ab57aebec6d702234ac80e2bc30738",
      "english": "Don't make sense\nin that lazy tone!",
      "translator_note": null
    },
    {
      "id": "msb_000698F4",
      "source_words_sha256": "15a9f04a9fc4d7b631d94276cc97df3c2a7604c019f4111f7a29e3abee29b77b",
      "english": "Earth's worth defending\nwith Earth's own hands.\n...Someone said that...",
      "translator_note": null
    },
    {
      "id": "msb_00069954",
      "source_words_sha256": "8d092e6ea317ba9b7a233bc403670efacf37de170d18a796679afcf55257631b",
      "english": "Beep, beep, beep...\nOdd... Haven't done\nanything at all...\fDoing nothing\nstill uses energy...\nHahaha...",
      "translator_note": null
    },
    {
      "id": "msb_00069A58",
      "source_words_sha256": "0a4fffe3d2cf1b644fbf068ddfdabe4c10874250d0926e736c05c13e624fb2ea",
      "english": "So tired...\nShouldn't gamble\non a day like this...",
      "translator_note": null
    },
    {
      "id": "msb_00069A98",
      "source_words_sha256": "c218db2aee04e8743cc7ff26e73f187c3ae4b91bc0801f8a45fe5ff26f6b594c",
      "english": "I quit...\nGambling and life.\nToo much work...",
      "translator_note": null
    },
    {
      "id": "msb_00069ACC",
      "source_words_sha256": "5cc81453d2e2aa0317fb7e5f3c1081dd24796e9aa24b4e084a23014a1da60966",
      "english": "Celebrities are human.\nSometimes too tired\nto do anything...\f...So, good night...",
      "translator_note": null
    },
    {
      "id": "msb_00069BB4",
      "source_words_sha256": "fb007e7877b6741d329548e41332d5a66a07274e15f760008c933f98c83fcdf4",
      "english": "Calm down, Shinpachi!\nPanicking won't\nget us anywhere!",
      "translator_note": null
    },
    {
      "id": "msb_00069C7C",
      "source_words_sha256": "0cf931f74f3bc5b8623d258e1250ea5294b36effd4ae01cd0ca71266743a88ac",
      "english": "Said I don't care\nbecause I don't care...\nToo much work...\fAh, I quit...\nShutting the agency...\nDecided...",
      "translator_note": null
    },
    {
      "id": "msb_0006A080",
      "source_words_sha256": "343bc7e948b7fe1056dbe381c4437a1ce25b1850f660288bef3fffb3457c755c",
      "english": "Don't worry.\nI'm healthy.",
      "translator_note": null
    },
    {
      "id": "msb_0006A0BC",
      "source_words_sha256": "7d8cfccf29c3804702062dea4537494aed1caced5f5900899cde06ef4f6d9b7e",
      "english": "Every year, properly.",
      "translator_note": null
    },
    {
      "id": "msb_0006A180",
      "source_words_sha256": "d4a9d327082d30ba9fbc5d3f29c6e4b3bd139f8607c925fca2ac576960969fef",
      "english": "Colds going around\nthis year, apparently.\nBe careful.",
      "translator_note": null
    },
    {
      "id": "msb_0006A1EC",
      "source_words_sha256": "f4438db95cbed9368b9b39fd22c2672471a50d5d20568d2b64e65c7f63592146",
      "english": "Getting your checkups?",
      "translator_note": null
    },
    {
      "id": "msb_0006A338",
      "source_words_sha256": "e0bfd772d58c1f99297e41306089c1192b5506cc111727391cfc1adb46ef2c04",
      "english": "Ah, Shinsengumi!\nOn patrol?",
      "translator_note": null
    },
    {
      "id": "msb_0006A3CC",
      "source_words_sha256": "c39f03b65a94b2bb70e7817326eeb6cea98df8093e48b9218563d10d6f5b2055",
      "english": "I love ramen.\fNoodles have a punch perm!\nThat's the best part.\fSomen? No good!\nLike a straight perm.\fPunch perms for men!",
      "translator_note": null
    },
    {
      "id": "msb_0006A478",
      "source_words_sha256": "e67840d63155a879866e70335c46b2b380d4e652785513ae366cb9f3faa1ab73",
      "english": "Punch perms have\na bad image lately.\fSome can't tell one\nfrom an afro!\fForget dyed hair\nand shaved lines!\nGet a punch perm, bastard!",
      "translator_note": null
    },
    {
      "id": "msb_0006A5D8",
      "source_words_sha256": "521bb8665127ae746d3022dcaa582cc535688d8449389fb396e3fea3bdf8c78c",
      "english": "Oh, Shinsengumi!",
      "translator_note": null
    },
    {
      "id": "msb_0006A638",
      "source_words_sha256": "18296d5b8cde03623545236bc9a87ea5c6825e79c4b9b55a24f2af0764623ec6",
      "english": "Honestly, sir...\nI hate punch perms.",
      "translator_note": null
    },
    {
      "id": "msb_0006A6B4",
      "source_words_sha256": "06a28cec2a15c88a2a023df2d787b9b71ac6fc571700f9d2d5084fb1289436d4",
      "english": "Oh, no... Saw the boss\ntake off his wig...\fSince that Chinese girl\nshaved him, he's\nbeen wearing a wig...\fIf he finds out, we'll\nbe in punch-perm wigs too!\fKeep it secret, please!",
      "translator_note": null
    },
    {
      "id": "msb_0006A814",
      "source_words_sha256": "20f9173349666cea10a1eaf37761b0353b9efcd07e1f02a1ce664ea048ad8355",
      "english": "Thought of a new business.",
      "translator_note": null
    },
    {
      "id": "msb_0006A8BC",
      "source_words_sha256": "3b25013a204612c14ad4f87f7a02836c971aa4ed80eb888df259431bb3e69791",
      "english": "What business?",
      "translator_note": null
    },
    {
      "id": "msb_0006A8D0",
      "source_words_sha256": "b44c714e7c2df7b7e2aa3bf2fb90a418848e45816c4e38015da3c7885b43b230",
      "english": "Too many victims.\nDon't do it...",
      "translator_note": null
    },
    {
      "id": "msb_0006A99C",
      "source_words_sha256": "2d9c1697379de0cc29244bfdc4642dbffb53a7c01f0f1764770dc6aae6411da1",
      "english": "Move! Out of the way!",
      "translator_note": null
    },
    {
      "id": "msb_0006AAA8",
      "source_words_sha256": "75b675e5c09b879af56d1ef69862fedd7f3344284ad88c27ce3060ab5dd23236",
      "english": "Then take over\nthe business.",
      "translator_note": null
    },
    {
      "id": "msb_0006AB34",
      "source_words_sha256": "3be3e69fa6d0dd205500347a1e044408832db580819b4e86fcb7b2169c893d47",
      "english": "Right. Study hard.",
      "translator_note": null
    },
    {
      "id": "msb_0006AC34",
      "source_words_sha256": "600d9dc30e3368f3f68cd0657650f99f9e11138da3e2b6522f480de9a215b885",
      "english": "Honestly...\nAdults always say\n'Study hard.'",
      "translator_note": null
    },
    {
      "id": "msb_0006B014",
      "source_words_sha256": "a2c929d612f9f408f20d8c44bb68110c236c7c791da325e2a74fa112c8800a97",
      "english": "Gah! Shinsengumi!",
      "translator_note": null
    },
    {
      "id": "msb_0006B0BC",
      "source_words_sha256": "a2c929d612f9f408f20d8c44bb68110c236c7c791da325e2a74fa112c8800a97",
      "english": "Gah! Shinsengumi!",
      "translator_note": null
    },
    {
      "id": "msb_0006B4A0",
      "source_words_sha256": "deaa20d1b88829b186c9a20dbdb759be8213fba05d7ab9e303d2f93bd652c256",
      "english": "Buy our CD!\nNot just one!\nTwo, three, or more!",
      "translator_note": null
    },
    {
      "id": "msb_0006B4EC",
      "source_words_sha256": "1961628f870eeecd7038d8a62db8cacad1827354fcb7e769ad92a017737f1aa6",
      "english": "Anti-Samurai!\nNew album! Coming soon!!\fFirst pressing bonus:\na GOEMON art plate,\n45 cm across!",
      "translator_note": null
    },
    {
