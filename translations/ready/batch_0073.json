      "source_words_sha256": "893a65f907e0b9755ab72eac461e662b4d6fb81ca45171e36a326cc95bd91068",
      "english": "...",
      "translator_note": null
    },
    {
      "id": "msb_00024AB0",
      "source_words_sha256": "867ce8bd99a291de9a5956efe490d849fd020a8160f479a4f5530dffb43516cb",
      "english": "What?",
      "translator_note": null
    },
    {
      "id": "msb_00024B04",
      "source_words_sha256": "75e12e9aa128a364a70b9ce74ac9536a04914af52a2d11671a5d196598d4bbb7",
      "english": "Listen, Sogo.\fThis case\nis now closed.\fStop thinking about it.\nAnd no extra details\nin your report!",
      "translator_note": null
    },
    {
      "id": "msb_00024BD0",
      "source_words_sha256": "893a65f907e0b9755ab72eac461e662b4d6fb81ca45171e36a326cc95bd91068",
      "english": "...",
      "translator_note": null
    },
    {
      "id": "msb_00025650",
      "source_words_sha256": "893a65f907e0b9755ab72eac461e662b4d6fb81ca45171e36a326cc95bd91068",
      "english": "...",
      "translator_note": null
    },
    {
      "id": "msb_000256CC",
      "source_words_sha256": "34bc3c8ea6c382aa7964f0d976c7b1d16e51af97b9f5ae73aae6c7bb1883bf55",
      "english": "...Come on. Get up.\nTo [blue]HQ[/color].\nYou're coming to [blue]HQ[/color].",
      "translator_note": null
    },
    {
      "id": "msb_00025714",
      "source_words_sha256": "4f34e434d849cd677bd3491621daf568067961d673418c4f8fb27ac77be7f817",
      "english": "Yes?",
      "translator_note": null
    },
    {
      "id": "msb_000257D0",
      "source_words_sha256": "1457ab3ba77657663c134e5ac6c36f2aa62c034f6bc9143cde9bea172b52b5c8",
      "english": "Huh?",
      "translator_note": null
    },
    {
