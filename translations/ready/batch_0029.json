      "english": "I LOVE THE SEA!",
      "translator_note": null
    },
    {
      "id": "msb_0006A894",
      "source_words_sha256": "11f9b620382f56f07292c6af6f6f99b0d56b0c36c9f10e5cfcf52051234826e7",
      "english": "I'll take a look when I'm free.",
      "translator_note": null
    },
