      "source_words_sha256": "f942be7a0d9430186db5ed7ded8e6f606f6e3bca936c6beb245d206988d5d010",
      "english": "Mayo fans die young.",
      "translator_note": null
    },
    {
      "id": "msb_0006A2E8",
      "source_words_sha256": "505584b64b87cb8698d7322a7b4f7e4e42403bbbf20a1184af8b03c88c0e077c",
      "english": "Something like that.",
      "translator_note": null
    },
