      "english": "No customers at my beach hut lately. It's a problem.",
      "translator_note": null
    },
    {
      "id": "msb_0006A7CC",
      "source_words_sha256": "b3e75309889f28b576068bdbe9c872f91cf984261bcd863b8e6d4266641e1574",
      "english": "Space monsters keep coming and attacking people.",
      "translator_note": null
    },
    {
      "id": "msb_0006A800",
      "source_words_sha256": "9153d81256628942bf85c7f4dade45ed363b78f233c932763dc233249cddceae",
      "english": "Counting on you.",
      "translator_note": null
    },
    {
      "id": "msb_0006A834",
      "source_words_sha256": "e8e9d963cf929ad0d6e408275439da157799970353a514e3dc16facc8dfd99ba",
      "english": "Giant sea-creature watching!",
      "translator_note": null
    },
    {
      "id": "msb_0006A854",
