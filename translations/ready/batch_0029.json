    },
    {
      "id": "msb_0006A0A4",
      "source_words_sha256": "0b643f084457dac3c6407c73a9181eda10c84e2caae8ee2bbde9082ac9aabf7f",
      "english": "Mind your business!",
      "translator_note": null
    },
    {
      "id": "msb_0006A0D4",
