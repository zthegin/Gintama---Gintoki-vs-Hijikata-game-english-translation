      "translator_note": null
    },
    {
      "id": "msb_00069FFC",
      "source_words_sha256": "ef42c58466ae3faee1d6b0ca40830d117aed80451810be6ab0c339b38a806ca5",
      "english": "I see... Not him, then.",
      "translator_note": null
    },
    {
      "id": "msb_0006A028",
      "source_words_sha256": "cdb8c3052fff0610a8c56bc75e3414092a9dda180e1643b3aae7b8ca8f590f7d",
      "english": "God... Please let my love get sick or hurt and come to our hospital soon...",
