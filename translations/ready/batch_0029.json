    },
    {
      "id": "msb_00069E30",
      "source_words_sha256": "c79f8cb945b9d021808351f88152450d3c3ef2d7bd476d32a1dc519eec8d815b",
      "english": "Heard that name somewhere...",
      "translator_note": null
    },
    {
      "id": "msb_00069E64",
