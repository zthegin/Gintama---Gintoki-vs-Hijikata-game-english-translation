      "translator_note": null
    },
    {
      "id": "msb_0006A9CC",
      "source_words_sha256": "cdab0698b8cf65c02e5ee07b2290923509d23ccc6d6afb78e30ff672d00c28bc",
      "english": "I defend the universe too.",
      "translator_note": null
    },
    {
      "id": "msb_0006A9EC",
      "source_words_sha256": "c6f0ddc97175c244ca525b86c94444021dc1abef2ce36f7bacd7a8a928e7b2c5",
      "english": "Shuwah!",
      "translator_note": null
    },
    {
      "id": "msb_0006A9FC",
      "source_words_sha256": "f6751b5ca55d511bf8db295af4b2dfef7a993e66c4a24dd1f372cd845d1d4216",
      "english": "Earth's saunas are the best.",
      "translator_note": null
    },
    {
      "id": "msb_0006AA18",
      "source_words_sha256": "d8ee44536a12631c4c14394ab205861ab18a1904876c820bc943c97a6b4add76",
      "english": "Got fired. Bored out of my mind.",
      "translator_note": null
    },
    {
      "id": "msb_0006AA50",
      "source_words_sha256": "d9fd4e4c93a115d42100498875c2c64c199544b0d5c372b83752c84f33b4df3b",
      "english": "Duwah!",
      "translator_note": null
    },
    {
      "id": "msb_0006AA6C",
      "source_words_sha256": "5196a3a136c74a416da4d5878b22ef6673bcdb34e13abb127646cc718cda0699",
      "english": "Why ask that?",
      "translator_note": null
    },
    {
      "id": "msb_0006AA8C",
      "source_words_sha256": "bfbaf57798285714e9f9bae9051c9546d0f0d063c3156a6f005510071beac27a",
      "english": "What's your dad do?",
      "translator_note": null
    },
    {
      "id": "msb_0006AAD0",
      "source_words_sha256": "e60c39cd703b4636e8f03dd4bff360a77e1d5ad59f358130775639354c97a454",
      "english": "Kids shouldn't worry about the future. Study hard, play hard, right?",
      "translator_note": null
    },
    {
      "id": "msb_0006AB68",
      "source_words_sha256": "7b48a670fa4c80b72391e5e8f112b83e914f8dbedcbd62e88e70517d9c5dfe49",
      "english": "Oh, cops. What are you doing?",
      "translator_note": null
    },
    {
      "id": "msb_0006AB88",
      "source_words_sha256": "1e6a74a02c1638fbba2d3ae2e792fab5fa263232d389d2b6557ed7847ad844f2",
      "english": "Shinsengumi pay well?",
      "translator_note": null
    },
    {
      "id": "msb_0006ABA4",
      "source_words_sha256": "297f9e3c3d782aa42e48d378f1a761ac3de3b7fd2b0004015de4ed4381099a1e",
      "english": "Gotta think about my future.",
      "translator_note": null
    },
    {
      "id": "msb_0006ABC0",
      "source_words_sha256": "c2dec0989132d9524a5c3939acaa4e8aa99ee036aae47bbdf2ec1f77deaa0bbc",
      "english": "...Self-employed.",
      "translator_note": null
    },
    {
      "id": "msb_0006ABD8",
      "source_words_sha256": "062a4a425f656f7f2af3a942c5833780a8d9e2323664622c7a8d3baacce2ee9b",
      "english": "Lots of problems, you know...",
      "translator_note": null
    },
    {
      "id": "msb_0006AC00",
      "source_words_sha256": "eec829e635b7d5b51ca4aefa7d34e1d81e0d212c09828aeeb50f46ef360ebffc",
      "english": "Adults have it so easy.",
      "translator_note": null
    },
    {
      "id": "msb_0006AC1C",
      "source_words_sha256": "b5a679380826e0ab549ee690a43a2291faf734dc3fa274316f1bad26e68bf7fe",
      "english": "Good work on patrol.",
      "translator_note": null
    },
    {
      "id": "msb_0006AC7C",
      "source_words_sha256": "c29ac900c7b7c6b8d71323d7dfad2575e6b00b5cd999b72890498ef22337f6a3",
      "english": "Work, idiot!",
      "translator_note": null
    },
    {
      "id": "msb_0006AC94",
      "source_words_sha256": "63f1e56305d23b065c1183fb9ef7d2e91bf2a6446fce45aee05afac043b7e91f",
      "english": "I'm WORKING!",
      "translator_note": null
    },
    {
      "id": "msb_0006ACAC",
      "source_words_sha256": "de739a6463620f3c856f4dc8b62ee6076914893e870d54221b852ce348e682f9",
      "english": "Tch... Annoying brat...",
      "translator_note": null
    },
    {
      "id": "msb_0006ACE0",
      "source_words_sha256": "b0f8d36c3c0bcdd70908e05cdb10145730b3d0c3a7172a4fb0a68f104ae816b4",
      "english": "Shinsengumi! What brings you?",
      "translator_note": null
    },
    {
      "id": "msb_0006AD00",
      "source_words_sha256": "d19dfa4f6ab875acf082356f8c08f1c4a0f53a616f091096d926492387e77385",
      "english": "What, just wandering around?",
      "translator_note": null
    },
    {
      "id": "msb_0006AD20",
      "source_words_sha256": "07d6b8f81f2415d8e9cf9d10d9bf56653c02e8abaf9d0a696087f7923517f312",
      "english": "Quit wandering! Get to work!",
      "translator_note": null
    },
    {
      "id": "msb_0006AD48",
      "source_words_sha256": "758d63b069f6481fc2d2e01ca7a9d1011ec86779507695897d38f35fe7eea06f",
      "english": "Looking for a fight?",
      "translator_note": null
    },
    {
      "id": "msb_0006AD60",
      "source_words_sha256": "698ad5aa182a920df975703667f8329228c2efa1fa56c5febf669f95d83d3265",
      "english": "Pachinko?",
      "translator_note": null
    },
    {
      "id": "msb_0006AD70",
      "source_words_sha256": "84aa6fdc11c0bd1ac9b27d454413ef072e82bced90b07e700371564920c23fb7",
      "english": "Living large? How old is THAT phrase?",
      "translator_note": null
    },
    {
      "id": "msb_0006ADAC",
      "source_words_sha256": "3af33fb39560de84ec45ab7c3ad9ec08b25014e72e409ae49e0cc413fd2048ed",
      "english": "Weren't you gonna win big and live large?",
      "translator_note": null
    },
    {
      "id": "msb_0006ADE0",
      "source_words_sha256": "998ccf4d4606d83d9778a9e3bade65219b54092c78a5a41041f8d8160bdd6a9e",
      "english": "Too bad.",
      "translator_note": null
    },
    {
      "id": "msb_0006ADF0",
      "source_words_sha256": "b7df11967a0d135daa31608f94a025d2a1d339898fd9929ced8c350d2014629c",
      "english": "How should I know, idiot?!",
      "translator_note": null
    },
    {
      "id": "msb_0006AE0C",
      "source_words_sha256": "2481ad152f598ab953a66d3c41773b6c949775f13810ee8165036023b7cd4938",
      "english": "Feel like I can win today.",
      "translator_note": null
    },
    {
      "id": "msb_0006AE2C",
      "source_words_sha256": "3b0a5aeacea7916da2212798f488998045e1e6bd0b62c4e51240d4de4b817455",
      "english": "Don't be stupid. Pachinko, obviously!",
      "translator_note": null
    },
    {
      "id": "msb_0006AE5C",
      "source_words_sha256": "5485ca019d8a9f6b5dfa58dcec3dc70989606f4d5fc0dea078eb89f90c91b11e",
      "english": "Gonna win big and live large!",
      "translator_note": null
    },
    {
      "id": "msb_0006AE90",
      "source_words_sha256": "a3ecb08e2f1d9edeea9e8e197e1c25a99f4420d1e58d0a9703f1b35daef83baf",
      "english": "Lost...",
      "translator_note": null
    },
    {
      "id": "msb_0006AEAC",
      "source_words_sha256": "190adf4870a8e6d04e502331cb8f06a666683d4b04d0cc0e8b15c51f5fe77251",
      "english": "No... Lost every penny...",
      "translator_note": null
    },
    {
      "id": "msb_0006AEE4",
      "source_words_sha256": "12c6829f4303fa55bb23fd45e20b3b17de130248c4263431cac204fb693d0a1f",
      "english": "Heh... That's life...",
      "translator_note": null
    },
    {
      "id": "msb_0006AF10",
      "source_words_sha256": "ba4706c3ea4d7c09c6c2e5d11affe6480f6a8956c7807b73789aac89f3cdda76",
      "english": "Please! Lend me money!\fOne more game! I'll win it back!",
      "translator_note": null
    },
    {
      "id": "msb_0006AF58",
      "source_words_sha256": "f0a47d5b42e3339f03aba4d9009e3c93429eda1d015a799dc0a266b23d8c0b82",
      "english": "Why so shocked?",
      "translator_note": null
    },
    {
      "id": "msb_0006AF6C",
      "source_words_sha256": "214d817792f0e863e314be1762369c2ac83439f84396cea5f9b0b9e435fe4de1",
      "english": "You... A Joi ronin after all?",
      "translator_note": null
    },
    {
      "id": "msb_0006AF9C",
      "source_words_sha256": "2118d23777a75b65c46206b3aecaf035b287a2ec242c5c08236502923b1bdecb",
      "english": "Fine, then. Don't commit any crimes.",
      "translator_note": null
    },
    {
      "id": "msb_0006AFD8",
      "source_words_sha256": "b7e71b648c4548abeb2cb82143fc5849d587d6ef635a72f7c96bd3aa0711db1b",
      "english": "Quit jumping every time!",
      "translator_note": null
    },
    {
      "id": "msb_0006AFF4",
      "source_words_sha256": "e1bc76d6512b1b421259e8b994dd5e7b8e51b835651289bac321bb63926cf0e7",
      "english": "No problem, then.",
      "translator_note": null
    },
    {
      "id": "msb_0006B030",
      "source_words_sha256": "a160a9d7deda8736acf647241fc43c64ebf50b7b54f39a738225652e8b97d18e",
      "english": "N-no... Nothing...",
      "translator_note": null
    },
    {
      "id": "msb_0006B060",
      "source_words_sha256": "3d3f6123d392f1d32a5275f5202ad08a3f620a4fc0145518b3fd0b2724bb425f",
      "english": "No... Never even played at being a Joi rebel...",
      "translator_note": null
    },
    {
      "id": "msb_0006B0A4",
      "source_words_sha256": "7483915e6d7c4272eb83bf0134040a5d778637d7e8f4e2f58d69b2d01a45a5bd",
      "english": "I KNOW!",
      "translator_note": null
    },
    {
      "id": "msb_0006B0D8",
      "source_words_sha256": "8411c975208db814f887a4060293b9f7b4e1454e6beae88f23eea3a29afc28f3",
      "english": "I'm not a Joi rebel!",
      "translator_note": null
    },
    {
      "id": "msb_0006B0F8",
      "source_words_sha256": "4fe95bccafe23e53ffa2923e7371a7f834933ee933c8fdb81b988e595436dd9a",
      "english": "Right... Haha...",
      "translator_note": null
    },
    {
      "id": "msb_0006B144",
      "source_words_sha256": "739c0baf6ec93ad44bc369ad763e03104eb99f2a8f4eefcd8e9deb8a9911463c",
      "english": "Do you work?",
      "translator_note": null
    },
    {
      "id": "msb_0006B160",
      "source_words_sha256": "f5d4626f2b4d5f19050cd9ad68d5bc4e6146521def7bfa9c2eac1e791dd5c222",
      "english": "Then text her that.",
      "translator_note": null
    },
    {
      "id": "msb_0006B18C",
      "source_words_sha256": "b6f92d20d0f44c6052f0c90834c4d0d50a2bf8fbe4fc4944cb75e5ff5d6efc29",
      "english": "What now?",
      "translator_note": null
    },
    {
      "id": "msb_0006B1AC",
      "source_words_sha256": "5eb0aef1df8857586da48d7238f394bebfcbf10ae02110abc59afcf31a05eb7a",
      "english": "Society calls that unemployed.",
      "translator_note": null
    },
    {
      "id": "msb_0006B1D4",
      "source_words_sha256": "a2010d0e0a4c9feb39180e543c55ddb8ce2772106f379024ce4b9fbc8bece44d",
      "english": "Well, get an honest job.",
      "translator_note": null
    },
    {
      "id": "msb_0006B210",
      "source_words_sha256": "d7877a7995ced069cf29ec56329726583755615f8fc7ef23f546b7d2ee4e9050",
      "english": "This is bad...",
      "translator_note": null
    },
    {
      "id": "msb_0006B228",
      "source_words_sha256": "2501a5af25df7cdd0f94d172b3cdcbfe35a36d47a9e07804cd31056ef094c316",
      "english": "Kimiko texted my phone.",
      "translator_note": null
    },
    {
      "id": "msb_0006B248",
      "source_words_sha256": "d5f1cad9925cd9f60a51a48553c387e9dfce51d04d5ed6149bfe0a84138f729b",
      "english": "Checking if I'm working properly.",
      "translator_note": null
    },
    {
      "id": "msb_0006B274",
      "source_words_sha256": "728359762ac17731c248fa601b570a0bcf3092ed4fca79c05d83c70902e35f28",
      "english": "Still an apprentice...",
      "translator_note": null
    },
    {
      "id": "msb_0006B294",
      "source_words_sha256": "6e843ff6c9776e188b8fbcd0a13b9c93f351ae57fbcaeb536dab1e3cfe0a2a8d",
      "english": "Yeah... I'll text back.",
      "translator_note": null
    },
    {
      "id": "msb_0006B2CC",
      "source_words_sha256": "7863ddab46f71e62fd0c22c5e67657e978532db9936bd1c1c8b832a5a3a364c6",
      "english": "Angry text from Kimiko.",
      "translator_note": null
    },
    {
      "id": "msb_0006B2EC",
      "source_words_sha256": "7ee387d833f2505b8a565389279c2ef8df9a9fe188dd8f982549c7ff3c8a28d5",
      "english": "Told her I'm apprenticed to a pro pachinko player.",
      "translator_note": null
    },
    {
      "id": "msb_0006B320",
      "source_words_sha256": "f03afd710c385a1b576a72f0b76e33b08221720fb0501db6f3b1d63ef198727d",
      "english": "Bad! How bad? REALLY bad!",
      "translator_note": null
    },
    {
      "id": "msb_0006B358",
      "source_words_sha256": "00c73eab8427f90edb9f4536f935371d7cc61a005242905fa5bd69ed76463d6a",
      "english": "This is bad...\fBad! How bad? REALLY bad!",
      "translator_note": null
    },
    {
      "id": "msb_0006B3A8",
      "source_words_sha256": "51a7d8e59cd650dd2b95af4c0630c67658e177a3585f1d8a2a1a819a5dda4761",
      "english": "Day off work today.",
      "translator_note": null
    },
    {
      "id": "msb_0006B3C4",
      "source_words_sha256": "4b70ba46ae68bf30c9f1fd458338437d9c6a42dcfd5ba88b7c5ae95022ca1798",
      "english": "A lot of days off lately.",
      "translator_note": null
    },
    {
      "id": "msb_0006B3E8",
      "source_words_sha256": "6223984873d67f28d374155a12fdeaec72c8acefd4e5d12b498ab51612001950",
      "english": "Wha...?!",
      "translator_note": null
    },
    {
      "id": "msb_0006B400",
      "source_words_sha256": "09f43cae10e95501fc7cc2f4fc97abfa1036b3c553aae491e60651ba262051dc",
      "english": "What a shock...",
      "translator_note": null
    },
    {
      "id": "msb_0006B424",
      "source_words_sha256": "59240cb30a961f187cb86c02e89cd5e6f5600480d561065cf0cf881a059318d0",
      "english": "I'm not washed up yet!",
      "translator_note": null
    },
    {
      "id": "msb_0006B448",
      "source_words_sha256": "61539506fccd8a9f32e93e114e659e80feea05ab0738585918b0221bf89c525e",
      "english": "Hehe... New album's out soon.\fPopularity's gonna skyrocket!",
      "translator_note": null
    },
    {
      "id": "msb_0006B57C",
      "source_words_sha256": "bd05267b561725ddd21099442eec33ef0dc1d39ebeda2b0cad715bcf9cd420f9",
      "english": "Well, good luck.",
      "translator_note": null
    },
    {
      "id": "msb_0006B58C",
      "source_words_sha256": "97e702c1188e4e7b3533e4fb940c64594a51ed85c866c457cecc61b2e3812c83",
      "english": "Quick recovery...",
      "translator_note": null
    },
    {
      "id": "msb_0006B5DC",
      "source_words_sha256": "595994e8f837e5fd660ab5aec3c9bb45706f673606fba9aeec502f414cd47a99",
      "english": "Where would I put it?! No useless wedding favors with it, thanks!",
      "translator_note": null
    },
    {
      "id": "msb_0006B630",
      "source_words_sha256": "5ece234967d76c87f12560666f3a66411bf8f3fb74eecde1b6e74fb7926150ad",
      "english": "We do sometimes cut our bellies...",
      "translator_note": null
    },
    {
      "id": "msb_0006B654",
      "source_words_sha256": "04ead754f59d4b27e3324bfa85d8ecb8d5a0da62e460a432d6b0b5cefa27e4b7",
      "english": "No time for ordinary folks' complaints...",
      "translator_note": null
    },
    {
      "id": "msb_0006B688",
      "source_words_sha256": "dba1dc35efefc316cbda909b409002bc805e915ae7468f14409936f2348aaf7f",
      "english": "They say things are livelier, but I don't feel it.",
      "translator_note": null
    },
    {
      "id": "msb_0006B6E8",
      "source_words_sha256": "c0ec31de572fa68242a2abc5a5b8109037c753294b97c2445559deacfe4ce35e",
      "english": "Tough being Shinsengumi.",
      "translator_note": null
    },
    {
      "id": "msb_0006B738",
      "source_words_sha256": "f49ef2198cfffc00788e047725fadd1c5a196eedd50de1e31839a074503dcd3c",
      "english": "Sort of.",
      "translator_note": null
    },
    {
      "id": "msb_0006B74C",
      "source_words_sha256": "7be59ff185acc469967b0849153a4aceff206aece69a6816b98a3ad70abae422",
      "english": "Nothing.",
      "translator_note": null
    },
    {
      "id": "msb_0006B75C",
      "source_words_sha256": "286b31756342bdeaca6dc92582b0e3a20695bf858de8e7a7f239bb3908096bb6",
      "english": "Looks that way.",
      "translator_note": null
    },
    {
      "id": "msb_0006B784",
      "source_words_sha256": "3570e40756b84c95550f1f11e02344d811c8ba29ccb8ae34b7549ee7491bf03b",
      "english": "I said, nothing...",
      "translator_note": null
    },
    {
      "id": "msb_0006B7A8",
      "source_words_sha256": "d8cca289a886d6ac4324910de08822c67f7a92a9b0fb77e62d6b7244c280f1f7",
      "english": "I said, nothing...",
      "translator_note": null
    },
    {
      "id": "msb_0006B7F0",
      "source_words_sha256": "cfcf0f8303e3857513e9bb279f96e315055c20c476378c95943bb5ead06f3a46",
      "english": "Need carpentry? I'm your man.",
      "translator_note": null
    },
    {
      "id": "msb_0006B810",
      "source_words_sha256": "68dcc4e74f082b989aa7ae70489c17bfc4d833428ddf7da8c2ae35c32bcf342c",
      "english": "Lots of shady remodeling firms lately, right?",
      "translator_note": null
    },
    {
      "id": "msb_0006B894",
      "source_words_sha256": "35a25e0fe67be706f6f32f4d1a279cf738f9ec4758f84a0c958ab7c1b644be6a",
      "english": "On duty.",
      "translator_note": null
    },
    {
      "id": "msb_0006B8CC",
      "source_words_sha256": "92a2599b26aca3301c18e5cb18aac8383902de42f1f98a80978d1d16f5e66bbd",
      "english": "Then load it with mayo.",
      "translator_note": null
    },
    {
      "id": "msb_0006B8F0",
      "source_words_sha256": "03216579bd0d580ecd49e953aa87ab1d90ccbe1d9b4b865245672f08a0233d8f",
      "english": "What, bastard?!",
      "translator_note": null
    },
    {
      "id": "msb_0006B94C",
      "source_words_sha256": "c841451fb46e6d2101edaac813711d0b1235550efccb63168882c0a336763ddc",
      "english": "Always the same...",
      "translator_note": null
    },
