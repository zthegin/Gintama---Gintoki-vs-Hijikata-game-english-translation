      "english": "Tell that idiot...",
      "translator_note": null
    },
    {
      "id": "msb_0006A110",
      "source_words_sha256": "764fb2f8a1ce4cc998b2374d92f259cb789fb5cdb8054f180a9f50e869d75fe5",
      "english": "It's our job. What do you expect?",
      "translator_note": null
    },
    {
      "id": "msb_0006A13C",
      "source_words_sha256": "e4c9b5c1dfe7d72ed9abee1c913ea525474f29e52ac9bd173d008601a4c5f206",
      "english": "Not a kid. Find a better way to say it.",
      "translator_note": null
    },
    {
      "id": "msb_0006A1B8",
      "source_words_sha256": "e68a3f38bea8ab2e377ec0a4bedc0336b712d4c7080cecbca8671d9982456a98",
      "english": "And no overdoing the mayonnaise.",
      "translator_note": null
    },
    {
      "id": "msb_0006A210",
      "source_words_sha256": "edd2c992f6a68161633ac89b1ca31ab4ab0f79ebaa96bd616db5af29a66dffd2",
      "english": "Don't eat too many sweets.",
      "translator_note": null
    },
    {
      "id": "msb_0006A230",
      "source_words_sha256": "79e5b88bb476fcdd198865c43197fe7bd0837af0942d8a8343dbf6aece7957da",
      "english": "Don't cause trouble near the hospital.",
      "translator_note": null
    },
    {
      "id": "msb_0006A260",
