      "source_words_sha256": "197f702470fb56c8a5b04737de1f2f718d06a1ba5e536f6b16063451d354cbfa",
      "english": "Wonder how he's doing...",
      "translator_note": null
    },
    {
      "id": "msb_00069F14",
      "source_words_sha256": "ad4e8ac552cc39abadd1fc2b1a515b911896e31c0698931bdc406345b6632b5c",
      "english": "The one I fell for... A person... Or some mysterious creature...",
      "translator_note": null
    },
