      "translator_note": null
    },
    {
      "id": "msb_00069DC4",
      "source_words_sha256": "262b3d0465df88bee7b3c678073ed88486c28e76175eec944fac0a7046530752",
      "english": "Who do you mean?",
      "translator_note": null
    },
    {
      "id": "msb_00069DE0",
      "source_words_sha256": "9a4383d45a4e0230c7c0be0eca877bef745ec26c5b6623f8ac7af7a282850e3d",
      "english": "What's that...?",
      "translator_note": null
    },
    {
      "id": "msb_00069DFC",
      "source_words_sha256": "46cdde523adba28fa0b2a4fd3f31a00fe2a3cc96a0d9d7b82eaba68737aefd46",
