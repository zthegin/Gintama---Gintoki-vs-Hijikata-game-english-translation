      "english": "We can't go drinking!",
      "translator_note": null
    },
    {
      "id": "msb_00043534",
      "source_words_sha256": "081a385f94b1242f3a55db73634330f4dd4b615972c916daa9ac557cfa5c16be",
      "english": "Sorry. We open at night.",
      "translator_note": null
    },
    {
      "id": "msb_0004355C",
      "source_words_sha256": "5009cbc6ac7fa822cc36f4d1ee99e8de3ea361e4eac37019c641a4902f70f494",
      "english": "My, you're an early customer.",
      "translator_note": null
    },
    {
      "id": "msb_00043584",
      "source_words_sha256": "73c306790e8f91f0781dc2feb91fbc0e012b5338c5d3fef3bce94f7403d4daa8",
