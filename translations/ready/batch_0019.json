      "english": "Um...",
      "translator_note": null
    },
    {
      "id": "msb_00043408",
      "source_words_sha256": "e05d434dfd8c77a05d73e048a358bffdbbc11c843ee1abb4fc427b8e713094d5",
      "english": "No! Absolutely not! Lose any blood now and I'll DIE!",
