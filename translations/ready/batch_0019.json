    },
    {
      "id": "msb_00043A74",
      "source_words_sha256": "6dbdb007febc32937562e1081fa2492e1bf2ebc0567ab78b9758023b87dc4ca3",
      "english": "Are you an idiot?! No! Don't go near him!",
      "translator_note": null
    },
    {
