      "english": "Wanna see a movie!",
      "translator_note": null
    },
    {
      "id": "msb_00043EE0",
      "source_words_sha256": "0bac5c9f8edb84639eb826c566546ba166cda30ee56a83002c383042c8df49a4",
      "english": "Gin! Let's see a movie after all!",
      "translator_note": null
    },
    {
      "id": "msb_00043F10",
      "source_words_sha256": "c54ad2e180a98c97ed5bfb98fb0176c25ec4f3545fe3a10c68bdedcff38bb251",
      "english": "Gin, wrong way.",
      "translator_note": null
    },
    {
      "id": "msb_00043F6C",
