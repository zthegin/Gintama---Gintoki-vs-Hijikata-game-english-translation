    },
    {
      "id": "msb_00043458",
      "source_words_sha256": "72caaa49481d105b3ffdd4647f2417590050cf1dd0fb5d3ed754e6781e0f0d09",
      "english": "No blood!",
      "translator_note": null
    },
    {
      "id": "msb_00043498",
      "source_words_sha256": "7235b72c3fcd21e02c4836b28c3d020b0875f69abd0318cbae62c3df2746d03c",
      "english": "Hi, Gin! Come see us at the club again!",
      "translator_note": null
    },
    {
