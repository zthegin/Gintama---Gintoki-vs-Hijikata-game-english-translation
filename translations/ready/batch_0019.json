      "source_words_sha256": "6bc806a25034d7f18675473a4a66b4b12b25089a2812b93842fb072ad572be74",
      "english": "Joking! Just a little African joke.",
      "translator_note": null
    },
    {
      "id": "msb_00043ECC",
