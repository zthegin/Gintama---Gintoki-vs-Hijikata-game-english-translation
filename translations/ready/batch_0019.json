      "source_words_sha256": "ea3233a7c6166453171f412d7e16333e6bdcfa1900fc79140a2c21d4d3589e2b",
      "english": "YOU don't worry enough!",
      "translator_note": null
    },
    {
      "id": "msb_00043B4C",
      "source_words_sha256": "295d1c81b2465b0b1ef5daac9326540c0256e73c90078ec9acb1b14498a18f9f",
      "english": "How many times?! Hasegawa's here! Don't go this way!",
      "translator_note": null
    },
    {
      "id": "msb_00043B98",
      "source_words_sha256": "5de1592a314224aeb6a6fa16308ba62e9c40d809212ccbe94cd1556d4d471934",
