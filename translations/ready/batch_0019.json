      "english": "Ah! Taro Kappa?!",
      "translator_note": null
    },
    {
      "id": "msb_00042F60",
      "source_words_sha256": "0e48c1c2f6ebfc9b56ed699eadc67d0524653831a19b84a9faef7db69e1b68a6",
      "english": "Come round back sometime. I'll share some food.",
      "translator_note": null
    },
    {
