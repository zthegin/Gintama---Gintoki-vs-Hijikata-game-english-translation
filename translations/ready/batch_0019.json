      "translator_note": null
    },
    {
      "id": "msb_00043BB0",
      "source_words_sha256": "d9e38edbdc594551453a995f2ca55032f0741bcc288c4e973ef93c53b362bdae",
      "english": "What, Shinpachi? Keep it down!",
      "translator_note": null
    },
    {
      "id": "msb_00043BF8",
      "source_words_sha256": "5d384c230ca8afc6668b9a7598c32ea0d5c4982447fe2052ce19e3381f272a9f",
      "english": "Huh? Was it?",
      "translator_note": null
    },
    {
      "id": "msb_00043C10",
      "source_words_sha256": "2d5b958c9b2edf8ac4a64d5c4f1fcd82cefed9f13f3d9f018941f6cfbb84fa13",
      "english": "Really?",
      "translator_note": null
    },
    {
      "id": "msb_00043C20",
      "source_words_sha256": "044e69e502037c81f3c73042089e9adc1b91284e5fc5ce657db3e8a29eb8f2ce",
      "english": "Listen, Kagura. All roads meet somewhere.",
      "translator_note": null
    },
    {
      "id": "msb_00043C6C",
      "source_words_sha256": "604f664715d31b5cfea44b58ec81a41294e934fe5c0724864e37603701ddd6c6",
      "english": "Yes. Just like life.",
      "translator_note": null
    },
    {
      "id": "msb_00043CA8",
      "source_words_sha256": "ba36b9d332e7dc463c0fdb525d9279ecb48818b4aaa718d937c854d184963eb7",
      "english": "Was it?",
      "translator_note": null
    },
    {
      "id": "msb_00043CB8",
      "source_words_sha256": "334394a64b7cedb455a562a80d390ef64c597dea79a2a798b7e9111e8408b78c",
