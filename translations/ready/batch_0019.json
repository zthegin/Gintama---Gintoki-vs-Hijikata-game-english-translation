    },
    {
      "id": "msb_00043E04",
      "source_words_sha256": "52ba7a9a7052a6b922c828baf8c1ada39a9994c9ab6dabcd43478776313bd115",
      "english": "Oh, good idea too.",
      "translator_note": null
    },
