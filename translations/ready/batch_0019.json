      "source_words_sha256": "2806ad680eb6c187e2f495989c2147e489cfb2baf467ad6462181376149f9b9c",
      "english": "No. More urgent.",
      "translator_note": null
    },
    {
      "id": "msb_000437B4",
      "source_words_sha256": "e8d8f45374b6e1f0e29b01da503a9f8c8a39dd3873aa88c45aaad6f245ca53d8",
      "english": "N-nothing!",
      "translator_note": null
    },
    {
      "id": "msb_00043824",
