      "source_words_sha256": "7766c5fcf00010daa624849374d559ef48aebd1016904a887614ebfd041882eb",
      "english": "No! Just want to ask a few things.",
      "translator_note": null
    },
    {
      "id": "msb_0003B1D8",
      "source_words_sha256": "dfd5e5c1b9fb92eb0dc4c8b0b9eabcfa93fffcde3050bf9f6b7c1f4b98f7446e",
      "english": "YOU'RE the gorilla!",
      "translator_note": null
    },
    {
      "id": "msb_0003B1F8",
      "source_words_sha256": "bb85aa539cc4cf57194c290c02995f5f9a87cc04b96c924f5a8f63e80f92d423",
      "english": "Where is it?",
      "translator_note": null
    },
    {
      "id": "msb_0003B208",
      "source_words_sha256": "0d7144ca0dc7287d9b8548f7d9d281e2f9279efc0e5ee24eaa3f84537a9a7571",
      "english": "Right! Let's go!",
      "translator_note": null
    },
    {
      "id": "msb_0003B238",
      "source_words_sha256": "7a0cae4694ef8634b07d3457df75659f418cc12731dcbb052394e26879ff2ac8",
      "english": "Not interested in zoos.",
      "translator_note": null
    },
    {
      "id": "msb_0003B27C",
      "source_words_sha256": "71d804fc9bb9a4f50bc7f2070ec07659cef9addd8cf09f4f5231eb5bd75e6f4b",
      "english": "Stake out this place?",
      "translator_note": null
    },
    {
      "id": "msb_0003B29C",
      "source_words_sha256": "49243d5c1cf05e131dc3be20f1e1e0cd1d29ccc478fea91af25b3010cf40492d",
      "english": "Shall we go?",
      "translator_note": null
    },
    {
      "id": "msb_0003B2B4",
      "source_words_sha256": "dc62bb7a7c7a0806015d539614bc815c3571b108bf47a52eb417e99bfe7cdbb4",
      "english": "Shinsengumi? What for?",
      "translator_note": null
    },
    {
      "id": "msb_0003B2CC",
      "source_words_sha256": "4768ea988acbe2527c03ea24f6623512f44dbef7eb79129cc1709be411feb34e",
      "english": "Shut up, gorilla!",
      "translator_note": null
    },
    {
      "id": "msb_0003B2E0",
      "source_words_sha256": "c450964eb544bc2e463a9e0adca1077657843465c33fe43d6cf8fde7caec8b72",
      "english": "What?! Don't mess with a queen!\fI'll pluck your ass hairs, you caveman!",
      "translator_note": null
    },
    {
      "id": "msb_0003B3E0",
      "source_words_sha256": "8fa83b79b38ce6a2bc0295df6cff4324386f0f3c42673b331bb872bfed53d45c",
      "english": "N-no. No idea.",
      "translator_note": null
    },
    {
      "id": "msb_0003B3FC",
      "source_words_sha256": "d64cedb1b045cc59f7103c27f697a998d062c93b343a7067c6cc51b38db3e9cb",
      "english": "Don't be ridiculous!",
      "translator_note": null
    },
    {
      "id": "msb_0003B420",
      "source_words_sha256": "0ce7ddda742713f3a8919632b8cba9b6e327de7fc0ec5fb221094ae54318f0bc",
      "english": "Who knows...?",
      "translator_note": null
    },
    {
      "id": "msb_0003B444",
      "source_words_sha256": "7a39c402d9d7a534dc5f5b86df53fa8f2771a9a307d481cc855566dcb4aaa33c",
      "english": "Some accusation! Trading Gin Tama isn't illegal, is it?",
      "translator_note": null
    },
    {
      "id": "msb_0003B4E4",
      "source_words_sha256": "ae508a09203f4d99c0099bdeef370ebd4c947c2146ba3c80b0aece949c210ce0",
      "english": "They posed as customers to make deals.",
      "translator_note": null
    },
    {
      "id": "msb_0003B510",
      "source_words_sha256": "1160f66206ce7a5cdd13ffb62bd7b4f336d237870cf702549effab254c893b7c",
      "english": "No.",
      "translator_note": null
    },
    {
      "id": "msb_0003B51C",
      "source_words_sha256": "90e42e16a8ebdae9736e4c30996f0af485232ba2f0a36d8ccfd8db28247eb9f3",
      "english": "Nobody told me. We're victims too.",
      "translator_note": null
    },
    {
      "id": "msb_0003B548",
      "source_words_sha256": "1ab13e8e4cb8d85d472ab58f8a89e772c8a021e8f04d0a0b66b2580495fdd09d",
      "english": "Wait! You'll scare off the customers!",
      "translator_note": null
    },
    {
      "id": "msb_0003B5B8",
      "source_words_sha256": "fcc6c7e31dae80c25e91058e8bdfb4cd2ac4ab667018d047d8965f55003fb329",
      "english": "Heard some shady types are about.",
      "translator_note": null
    },
    {
      "id": "msb_0003B5DC",
      "source_words_sha256": "da0dace3faf9ce59e22b003945cf7ad2fb85e3da6251c307ac018c794d25cd0f",
      "english": "No money coming in, but plenty of rumors.",
      "translator_note": null
    },
    {
      "id": "msb_0003B650",
      "source_words_sha256": "a9ab412cff9a7c92309afab4492ede30b8f17e601a48e99a97e433192869448c",
      "english": "Saw a constable outside. He should know where it is.",
      "translator_note": null
    },
    {
      "id": "msb_0003B6EC",
      "source_words_sha256": "18cb553f53ba151dc8b3827d83a575dab346f4e3a19d81c6028e2510c30618bc",
      "english": "No way... Really...?",
      "translator_note": null
    },
    {
      "id": "msb_0003B718",
      "source_words_sha256": "9cf655d6ea55a0adbd8d397eccce992779312bf33961a258096149878a264fcb",
      "english": "W-what are you saying? It's not that I can't handle it...",
      "translator_note": null
    },
    {
      "id": "msb_0003B750",
      "source_words_sha256": "d2d023f25123d8d49e919fd9eac588ee4e88219ba97bf41493f6ee374cbd5987",
      "english": "W-what now, Kondo?",
      "translator_note": null
    },
    {
      "id": "msb_0003B774",
      "source_words_sha256": "4222ebe497025cfd0ff2878f2cdf20e5dc3356dd609c48da9fe51edbae5983f9",
      "english": "R-right... We've got to go...",
      "translator_note": null
    },
    {
      "id": "msb_0003B7B0",
      "source_words_sha256": "5824a9324c7f2eafef8b220412060ad388f21d3fcef9f1cc0cc373e46ecc8b4d",
      "english": "Couples?!",
      "translator_note": null
    },
    {
      "id": "msb_0003B7C4",
      "source_words_sha256": "22b5a3c46f38b11bd17a7a25e51cc1b64625023dbd14aaac77b3a9a6cc447312",
      "english": "Why didn't you say so?!",
      "translator_note": null
    },
    {
      "id": "msb_0003B80C",
      "source_words_sha256": "9ce0422e139f9b092791b064d2d707a49b5390a71c9c3b21e93880f8de24d3e6",
      "english": "Any indecent lovebirds there, I'll clobber them!",
      "translator_note": null
    },
    {
      "id": "msb_0003B83C",
      "source_words_sha256": "d30fb27996c83dddfa7043b125b4ce4c2e0c63c9b47bb3d8ee0ac9ffa4162f4d",
      "english": "Shut up!",
      "translator_note": null
    },
    {
      "id": "msb_0003B84C",
      "source_words_sha256": "7101b29a3f3eaf149e68ce38d89a034fc93221495fd8aaa2951ec20a9f518853",
      "english": "A place with a pond... Here...?",
      "translator_note": null
    },
    {
      "id": "msb_0003B87C",
      "source_words_sha256": "b7d538e116cd0495be6309e1880ae23955413391df5535fe30954a1a1b07af1f",
      "english": "Why?",
      "translator_note": null
    },
    {
      "id": "msb_0003B8A4",
      "source_words_sha256": "f58ff43d40c4b1844f35f1455d11d0ddae25f89ac2fe8912ea2143930d126c5c",
      "english": "Urgh...",
      "translator_note": null
    },
    {
      "id": "msb_0003B8B8",
      "source_words_sha256": "62a8184a7d61b6f26fe22d786348b82e3d0340d2b2130989e724d119c32301c6",
      "english": "A strange voice...?!",
      "translator_note": null
    },
    {
      "id": "msb_0003B8D4",
      "source_words_sha256": "ab8441adb1edb51edcc95ca42d43d8fcf91c2abfaa348282e112fff5dfb9c317",
      "english": "We have to go.",
      "translator_note": null
    },
    {
      "id": "msb_0003B8E8",
      "source_words_sha256": "357fbdfbe665dac0aad257150364061cf821b94ca63af3d79f26ae152be0fced",
      "english": "What did he look like?",
      "translator_note": null
    },
    {
      "id": "msb_0003B900",
      "source_words_sha256": "7c6b292f1a336d2bb7f931658d85288814113b98748578927025bbf2d54b7110",
      "english": "Oh... Knew it all along.",
      "translator_note": null
    },
    {
      "id": "msb_0003B948",
      "source_words_sha256": "f8ed009c0442283b46fffb41d7a7d21964f3b8989f98b89767b956d0732e8c4e",
