  "records": [
    {
      "id": "msb_00039748",
      "source_words_sha256": "eb3a79c93772fe2f82ed493219df255a90dd1cebe64e3a69fcdb74f0557272fb",
      "english": "I'm after Dragon Tama. Know anything?",
      "translator_note": null
    },
    {
      "id": "msb_0003976C",
      "source_words_sha256": "99846efcfa7273291787af807e9ba112adc673cb681deb5853e9bdb98b79bcd6",
      "english": "Right. Golden Street, was it?",
      "translator_note": null
    },
    {
      "id": "msb_0003978C",
      "source_words_sha256": "daad6a09b83f4ffa5908855c7f7d7761542a7708067a01087ae5d9885d3dc57f",
      "english": "Playing with fire?",
      "translator_note": null
    },
    {
      "id": "msb_000397F8",
      "source_words_sha256": "ea39b2c7d3154216f251c122445dd90ec08a60ac376874489987db67120fe764",
      "english": "It's quite a way. Let's hurry.",
      "translator_note": null
    },
    {
      "id": "msb_00039814",
      "source_words_sha256": "fb631c79abcba7dc45798952f1c611a418b9eeb3f47f46270d02e055ec279096",
      "english": "Let's check around here.",
      "translator_note": null
    },
    {
      "id": "msb_00039830",
      "source_words_sha256": "dfcb4e833067fd5bb3a45b3626558a560cc2d49d8136adc5214b2c19b95bf193",
      "english": "No use. Let's try elsewhere.",
      "translator_note": null
    },
    {
      "id": "msb_00039854",
      "source_words_sha256": "3f32429ab8af3ad19bd54530720363c1e698921f07b2c1b34a55073b6228e598",
      "english": "Old man, you frequent places like that?",
      "translator_note": null
    },
    {
      "id": "msb_00039880",
      "source_words_sha256": "04b87fe51353bdb3762ed7bd330a0c3fcf61b98f41c367fc8f42c74612b824a5",
      "english": "Where's Golden Street, anyway?",
      "translator_note": null
    },
    {
      "id": "msb_000398A4",
      "source_words_sha256": "48fe2ad38cb30a788e206646c1b20291ff2affa2fef1a1d0c02d718821bce094",
      "english": "Need me?",
      "translator_note": null
    },
    {
      "id": "msb_000398B4",
      "source_words_sha256": "30f6d7377a501dc83f6e604c2259ec8e12795fa6719706aa425f533d1ffce41b",
      "english": "Looking for Joi ronin?",
      "translator_note": null
    },
    {
      "id": "msb_000398D8",
      "source_words_sha256": "66f178980f2e45902868f573ab01a39fdd8db2db6af3eed73ae260607ab1e421",
      "english": "Got a problem? People's lives depend on me!\fShinsengumi or whatever, you've no right to judge!",
      "translator_note": null
    },
    {
      "id": "msb_00039944",
      "source_words_sha256": "4e475171a16ff4b5451d23a5305545d6f90457c3c99720ab368d2522a92333cd",
      "english": "No idea. Don't care about that flashy junk.",
      "translator_note": null
    },
    {
      "id": "msb_000399D4",
      "source_words_sha256": "05f7a7dc9df4f222ed780a216d10b455b08cd3721c4a024d1ca474d2304f6605",
      "english": "Sacchan used to be Oniwabanshu.\fShe should know Edo's secrets.",
      "translator_note": null
    },
    {
      "id": "msb_00039A1C",
      "source_words_sha256": "bab3b7b607e250b18f4ff64f22311545e59d4fdee331c1c0f83c5a4dc039ebd4",
      "english": "Mind your business.",
      "translator_note": null
    },
    {
      "id": "msb_00039A30",
      "source_words_sha256": "4e74df7cccd2b05d5502e75b3a5e82676dc3102c84a7cbcab184413df0944ca6",
      "english": "I'm not a town guide.",
      "translator_note": null
    },
    {
      "id": "msb_00039A50",
      "source_words_sha256": "80dce1ee28cc5d4038d91817d2a993add8924b02a43b32f38e9f881f3b0ad9ba",
      "english": "Looks closed at night.",
      "translator_note": null
    },
    {
      "id": "msb_00039A70",
      "source_words_sha256": "1b7ca5395a6221488cb950e74745694a6eb77b6b482e02ed8bd72b6df12ac002",
      "english": "Don't care. We're going in.",
      "translator_note": null
    },
    {
      "id": "msb_00039AA8",
      "source_words_sha256": "0cdb5cca586e555a0167992ffdd89bbf3e8f9656433ccff2649969b3666a20e6",
      "english": "Here we are.",
      "translator_note": null
    },
    {
      "id": "msb_00039AB8",
      "source_words_sha256": "cb80c01a1a6518f3fa7a7de27c9cbff8d76b979fea3758e9c50de7cc6894836c",
      "english": "Dried squid on rice?",
      "translator_note": null
    },
    {
      "id": "msb_00039ACC",
      "source_words_sha256": "8c658ce272705451574125f1d982cb394c0eecb0259c7086be4777fadb5bfbdf",
      "english": "Natto on rice.",
      "translator_note": null
    },
    {
      "id": "msb_00039AE0",
      "source_words_sha256": "3a3aa5ef9a03e6d60db36aa1d86b4fd8dd2ddd0ef0b26ceac178d9cef319bab9",
      "english": "My, what fine dried squid.",
      "translator_note": null
    },
    {
      "id": "msb_00039B00",
      "source_words_sha256": "09101d70c1335e6739f8a9fe93f7ad0082b7b9b541d1a1f2f2dc74ea8d9f95cb",
      "english": "Oh, sorry.\fThe Shinsengumi are here.",
      "translator_note": null
    },
    {
      "id": "msb_00039B2C",
      "source_words_sha256": "5fd660794117b30093c0b3b05a80131ab973f4cef74d6e6dae51ac843e59c926",
      "english": "Need something at this hour?",
      "translator_note": null
    },
    {
      "id": "msb_00039B58",
      "source_words_sha256": "2245b5689e130022cf0ce6a703825d1451c99d54688f604496cb99a5da654972",
      "english": "I was just going home.",
      "translator_note": null
    },
    {
      "id": "msb_00039B70",
      "source_words_sha256": "155b16ca770625ae92382af5b8805db6421fa960400b254a842b0a9cfdb5d00f",
      "english": "It's a secret, but yes.",
      "translator_note": null
    },
    {
      "id": "msb_00039B88",
      "source_words_sha256": "56fddd3de0690626263ec6b2f3cc514dbfdfcbeddd1b4dd8f65276a9fe7837b2",
      "english": "D.T?",
      "translator_note": null
    },
    {
      "id": "msb_00039B94",
      "source_words_sha256": "e27aa0328a5591122fdf8dc016adea3c2150493072af16f904b2cb934c292d62",
      "english": "I like Gin.",
      "translator_note": null
    },
    {
      "id": "msb_00039BA4",
      "source_words_sha256": "9ebdbec30170f88c63bd16798f03ade170681f0c19b3233fa6b49fa57e5f3a9d",
      "english": "Gin... Such a lovely sound.",
      "translator_note": null
    },
    {
      "id": "msb_00039C5C",
      "source_words_sha256": "2b264e72541dc55ceab2ece8a338e575573bbb1a2efe0b7935295b231f48460d",
      "english": "Yes! We're dating!",
      "translator_note": null
    },
    {
      "id": "msb_00039C84",
      "source_words_sha256": "1198703a7969609d01bf2b30e622a0ae7503c96484bf7736c08e638a10ab9485",
      "english": "It's a secret. But you can tell everyone.",
      "translator_note": null
    },
    {
      "id": "msb_00039CB0",
      "source_words_sha256": "e2952821168567e9770dc5d107ee1835b42bb32c548963b43cd93c4d5d882c29",
      "english": "Tell everyone!",
      "translator_note": null
    },
    {
      "id": "msb_00039CC8",
      "source_words_sha256": "441083145ab160bb01c3e3a4884c445b8284ac6be6e6efdb954ab4d96cd9002e",
      "english": "How much?",
      "translator_note": null
    },
    {
      "id": "msb_00039CD8",
      "source_words_sha256": "4a7fa1c3cb873c77ef409e36581b2076e14d52c1a29f5e557082e9f9c73e60de",
      "english": "Info costs money now.",
      "translator_note": null
    },
    {
      "id": "msb_00039D18",
      "source_words_sha256": "5315ac7b8d81ca97fa9db90b08df61d4428904bd023dc4b90b4ca629f3c9cfbe",
      "english": "Shopping too?",
      "translator_note": null
    },
    {
      "id": "msb_00039D30",
      "source_words_sha256": "a792e51d01fa62b00f4e2e4bb70683807729f3fb511d748fe2f1a1b01369da49",
      "english": "How mean! I was kind enough to offer it for sale.",
      "translator_note": null
    },
    {
      "id": "msb_00039D6C",
      "source_words_sha256": "39b0cdcfcf4f26e81bfec62171626cb6907101b809d16d76698300b8a84faaad",
      "english": "You won't listen!",
      "translator_note": null
    },
    {
      "id": "msb_00039D88",
      "source_words_sha256": "b41d3f6ec31a9d374f9710202e3b7ea8c71a2afd275faad3aba2dd65a573d7e5",
      "english": "Want it free? Then fight me!",
      "translator_note": null
    },
    {
      "id": "msb_00039DB4",
      "source_words_sha256": "834341253457af050c27f195e371ff7c12dd5b242b25d6829cc27bfeb36414ba",
      "english": "Shinsengumi! Inspection!",
      "translator_note": null
    },
    {
      "id": "msb_00039DD4",
      "source_words_sha256": "4e7707b57ad98f3e80a91aa11826ede21a056d2b188f851933b39d724d59173c",
      "english": "NO!",
      "translator_note": null
    },
    {
      "id": "msb_00039DE8",
      "source_words_sha256": "225a3fb8db81971b45fa0f7422fff8f806ad6ef4caaa22ec6e8eb47e364cfa23",
      "english": "Either way!",
      "translator_note": null
    },
    {
      "id": "msb_00039E04",
      "source_words_sha256": "eba4a9a1d3b6ac23b64c35d2ef7dcfa3aef2769ea4ae280b6f94ce9522370cb5",
      "english": "Kondo, just shut up!",
      "translator_note": null
    },
    {
      "id": "msb_00039E2C",
      "source_words_sha256": "f8ebac688980144317a8e537f61b9cd33a5cdaa8d2e6a2560748c74810892eb9",
      "english": "I'm human!",
      "translator_note": null
    },
    {
      "id": "msb_00039E44",
      "source_words_sha256": "21d7cf2eadd1d5996fca405434569e351b35e6e7070b3015d672dd826ed3ead6",
      "english": "I said that first!",
      "translator_note": null
    },
    {
      "id": "msb_00039E5C",
      "source_words_sha256": "512a1711164c8a14f06d012f76c9bb7cbbfb86ac701594958f94c69212189c20",
      "english": "Got a few questions.",
      "translator_note": null
    },
    {
      "id": "msb_00039E7C",
      "source_words_sha256": "0b2994c5f1aee675b30b7684e46f4460a8ab146c74ebe84279c400f2c05ec9de",
      "english": "Be quick.",
      "translator_note": null
    },
    {
      "id": "msb_00039E8C",
      "source_words_sha256": "32ad2ab890a63722391d022d124d175e210529383ad37b8171f5075261b1d015",
      "english": "About Dragon Tama.",
      "translator_note": null
    },
    {
      "id": "msb_00039EA4",
      "source_words_sha256": "a3a37b82e77819c6ca262a081f8e88e7f7a1918d8586b83514d38b302d8940d5",
      "english": "Rare Gin Tama.",
      "translator_note": null
    },
    {
      "id": "msb_00039EBC",
      "source_words_sha256": "ffa61797fa1ed63e3fdc1312abe4b3b26415aaeaa9256a9a21f16092277823b7",
      "english": "Didn't ask what you like.",
      "translator_note": null
    },
    {
      "id": "msb_00039EE0",
      "source_words_sha256": "849fcc8de074bde5b349d622cea81474112199ca6b85068bc93797e9aa55d42c",
      "english": "Hey! Listen!",
      "translator_note": null
    },
    {
      "id": "msb_00039EF4",
      "source_words_sha256": "4366d583fcd8dcb3949c203b4c27c93269dc98ccc88ac68c8c03617866f2d1c9",
      "english": "Who are you talking about?!",
      "translator_note": null
    },
    {
      "id": "msb_00039F10",
      "source_words_sha256": "73dceaf8e113106407b140d4d422496781c13ec0a44e73ab584b22dab6def648",
      "english": "Ugh. Reminded me of someone I hate.",
      "translator_note": null
    },
    {
      "id": "msb_00039F34",
      "source_words_sha256": "653f67892ae01bb462be6e8faa2bb5620282a68ca9aa489b0507724db5e7c2f1",
      "english": "Don't really care.",
      "translator_note": null
    },
    {
      "id": "msb_00039F50",
      "source_words_sha256": "dad11886d23ef59843d44840068f2cb461c3b8c5fdb2644bd829cf724c68c235",
      "english": "Forget that! Tell me about Dragon Tama!",
      "translator_note": null
    },
    {
      "id": "msb_00039F78",
      "source_words_sha256": "978085ac5bf129e53ff3c23a9478db3315fc3317148a82e60df8cfeddc78d514",
      "english": "What the hell?!",
      "translator_note": null
    },
    {
      "id": "msb_00039F8C",
      "source_words_sha256": "fc1eeec2a587291e5b864b54d702b076464c3389f9215bbf0ae71de0c473f3d2",
      "english": "Mocking the Shinsengumi?!",
      "translator_note": null
    },
    {
      "id": "msb_00039FA8",
      "source_words_sha256": "0011cf2f5ec9f923221fc20c15e01efbcaa0722a92517c698d43484229101185",
      "english": "I could haul you in!",
      "translator_note": null
    },
    {
      "id": "msb_00039FD0",
      "source_words_sha256": "5e112633603d49b2389ae775d524d024228e4afe5b8fcb9184abd96fd4f8d6d5",
      "english": "No! You idiot!",
      "translator_note": null
    },
    {
      "id": "msb_00039FEC",
      "source_words_sha256": "e8ef35d4ff2aeabc09b1e6853d726c170221a9fca9bc5e62bbcf39cb1c9762a0",
      "english": "I said I'm not buying!\fJust spill everything you know!",
      "translator_note": null
    },
    {
      "id": "msb_0003A038",
      "source_words_sha256": "e8039b3eb9510455c0906f26f05533bc101d3fabc9c421fb53a0830527745882",
      "english": "YOU'RE the one who won't listen!",
      "translator_note": null
    },
    {
      "id": "msb_0003A05C",
      "source_words_sha256": "7afa4ce719466ad3f6a7f163935888975acffbccc3ff0733aae3f0e6795bf68d",
      "english": "Fine! Bring it on!",
      "translator_note": null
    },
    {
      "id": "msb_0003A07C",
      "source_words_sha256": "f94a2bb19e0bd3830aeee10122e0c1cedf884a9a8ae5d8cf8e4276dcdaa16da5",
      "english": "Toshi, dried squid doesn't go on rice.",
      "translator_note": null
    },
    {
      "id": "msb_0003A0A0",
      "source_words_sha256": "ebd42dd4e56eabd70d89096ffb3d4e4fd305228980deb82b8faead34ffb2c260",
      "english": "What a surprise.",
      "translator_note": null
    },
    {
      "id": "msb_0003A0B4",
      "source_words_sha256": "153876da62538e4e32be701ec30b1e515cdf62838abae1bcdb15075337bcf9f6",
      "english": "Glasses on the floor.",
      "translator_note": null
    },
    {
      "id": "msb_0003A0D0",
      "source_words_sha256": "c395d0ddd565e3277e6591ad7a5332fed8e70db220b6188c47af8374e03c6caa",
      "english": "Former Oniwabanshu?",
      "translator_note": null
    },
    {
      "id": "msb_0003A0EC",
      "source_words_sha256": "e02cc7df7cd7d2ee32e790478b7f48dcec4b9a5c5a51bef7d9c47078d2c5f67f",
      "english": "Someone comes to mind.",
      "translator_note": null
    },
    {
      "id": "msb_0003A128",
      "source_words_sha256": "4ece0340b2018cee4d3fd7ede19d5e8826f98ee7b7e235acf8c0629e1068e920",
      "english": "Ah! How could I lose?!",
      "translator_note": null
    },
    {
      "id": "msb_0003A208",
      "source_words_sha256": "e13dbbaf801c24298be2ede7d6bc1233cdb46cfe7550a8335463a839822aa421",
      "english": "I know. Here, Gin Tama.",
      "translator_note": null
    },
    {
      "id": "msb_0003A228",
      "source_words_sha256": "2a0a540e43f86cf60b460dc89f08aade601984c64a24eab9105d2b43b47a1b9d",
      "english": "Winner gets Gin Tama from the loser.",
      "translator_note": null
    },
    {
      "id": "msb_0003A254",
      "source_words_sha256": "b3cb4883689fec8517c45cb8e62824a90e1d5c7136cf36eb9408c1379066ae1e",
      "english": "I don't want it either.",
      "translator_note": null
    },
    {
      "id": "msb_0003A26C",
      "source_words_sha256": "8f0161c117a899963d7e0bf33d6ffa82a7dc6f13167ee532cdd577d1816f2815",
      "english": "Then it's yours.",
      "translator_note": null
    },
    {
      "id": "msb_0003A2BC",
      "source_words_sha256": "d88a1f12908ad57783bdaac1ce36b55086e1559a7d9450e63dbf36efab51bfa3",
      "english": "Buys cheap Gin Tama. Sells high on the sly.",
      "translator_note": null
    },
    {
      "id": "msb_0003A2EC",
      "source_words_sha256": "350967d7ac88f1eaa0d0aa811f9b0e0fb589ea4f8c29a56636846660ee4c3853",
      "english": "No idea. A mystery.",
      "translator_note": null
    },
    {
      "id": "msb_0003A308",
      "source_words_sha256": "4870b46cc830d11b87ef1491f17b1cbf4828886a0e78fbcad89db0ebcc483f96",
      "english": "Don't know that either.",
      "translator_note": null
    },
    {
      "id": "msb_0003A320",
      "source_words_sha256": "04abc18236bd4dc14b0f116d2a4d18725576c987eb8af2a592444d5fbfaadd3c",
      "english": "I know a man planning a deal.",
      "translator_note": null
    },
    {
      "id": "msb_0003A34C",
      "source_words_sha256": "4933785bc7071a05938f8af849b9386a9e865568ceab4fba0c4de4139e1bfd4d",
      "english": "A Chatoran. Don't know his name.",
      "translator_note": null
    },
    {
      "id": "msb_0003A3B0",
      "source_words_sha256": "eb086eb4788ad589594740a1a8193c47b776ee7acf0b8de344279a10f809e9d9",
      "english": "Well, good luck.",
      "translator_note": null
    },
    {
      "id": "msb_0003A3D4",
      "source_words_sha256": "adfe776bdebf2986d47a4a48d8a2199d4603ab98c91ae675f688eaa4ade6fe6f",
      "english": "No surprise. That's the Shinsengumi Vice-Chief's strength.",
      "translator_note": null
    },
    {
      "id": "msb_0003A40C",
      "source_words_sha256": "0a5aeedd94f1371a242adebae1af68c0f97ea7d728095b8bb1d243bb6c7149ea",
      "english": "Huh?!",
      "translator_note": null
    },
    {
      "id": "msb_0003A41C",
      "source_words_sha256": "a46c3b2fc92e9a217ec94742e1abc6ab2a953e17cdeef502ee3b583c454a2a5f",
      "english": "What are you talking about?!",
      "translator_note": null
    },
    {
      "id": "msb_0003A43C",
      "source_words_sha256": "bc823207922f74c1c04de240315416a049dad0ac933aab5b1bf405f5a57a25b5",
      "english": "Enough! Hey, ninja. You know what comes next?",
      "translator_note": null
    },
    {
      "id": "msb_0003A474",
      "source_words_sha256": "85cfa02c24f498d7c77ef857665de31dadee722a05b5c3985010596d0125300e",
      "english": "Yeah, thanks...\fWhat the hell is THIS?!",
      "translator_note": null
    },
    {
      "id": "msb_0003A4AC",
