      "translator_note": null
    },
    {
      "id": "msb_000E3484",
      "source_words_sha256": "362e7c0102eb5b2dc58b1d8bdd0300f8e70b73c498b91165ed964a0d5cffeebd",
      "english": "Nice in summer, maybe.",
      "translator_note": null
    },
    {
      "id": "msb_000E34C8",
      "source_words_sha256": "bdcdfa551470287b053d29972c0d65a0e01f1c1f33a5b09ed0c71a1c3959948b",
      "english": "About Yamazaki!\fWhat sausages did he eat?",
      "translator_note": null
    },
    {
      "id": "msb_000E351C",
      "source_words_sha256": "2d7f560496c7350cc4510c34f1fa3fdd100aec3de7429ff7a2536e030764b793",
      "english": "Shinsengumi.",
      "translator_note": null
    },
    {
      "id": "msb_000E358C",
      "source_words_sha256": "dfe871e119aada77b34822592d92005139e28d8f7c5ee6bc2ec17497694a2f20",
      "english": "Not dodgy meat, is it?\nI eat it sometimes too...",
      "translator_note": null
    },
    {
      "id": "msb_000E35C8",
      "source_words_sha256": "b595c00756f0e2a0decc5d7b4e8407e801a5ae9de3299ac17b1b4fba3ef1b249",
      "english": "Probably...?!",
      "translator_note": null
    },
    {
      "id": "msb_000E35E4",
      "source_words_sha256": "d2921b64263abe3880a6e9b6b08f77c55beb592555788271dccc8fff6c1e03ef",
      "english": "Why do you think so?",
      "translator_note": null
    },
    {
      "id": "msb_000E363C",
      "source_words_sha256": "72618439052fdf43ee006805f98ddaf9849e0e8e57e411a3957c883c66f0a8a4",
      "english": "Because... You know...\nThat... thing...",
      "translator_note": null
    },
    {
      "id": "msb_000E3674",
      "source_words_sha256": "5c4105486f3c673be109c447e6a702ee038e21eb8b9c961abd94811dd54d7943",
      "english": "Probably safe.",
      "translator_note": null
    },
    {
      "id": "msb_000E3688",
      "source_words_sha256": "e35d5e1cbaaa3cacf9253d0d8f2536e3e90bae71a8b13e661f0e66a6a2a65e90",
      "english": "Goninja Sausage.",
      "translator_note": null
    },
    {
      "id": "msb_000E36A8",
      "source_words_sha256": "05b40296ec4a2fef1744b176aee5922d849402f43f7b67fa86654e52d2053302",
      "english": "Because it doesn't exist?",
      "translator_note": null
    },
    {
      "id": "msb_000E36C8",
      "source_words_sha256": "c1bfbfbca4377bba991e62f21c7fc9e8c82f72b4aab75559290d047373552fff",
      "english": "Not much to do\nwith Yamazaki anyway...",
      "translator_note": null
    },
    {
      "id": "msb_000E36F4",
      "source_words_sha256": "53a4f7ccb28ba3c50e2db4be24be8d0ef0807b70e1940d3d4a7317fdf1a8ba9c",
      "english": "Eat this and become\na Goninja!\fSorry!!\nNo, you can't!",
      "translator_note": null
    },
    {
      "id": "msb_000E3750",
      "source_words_sha256": "0d4d7bd0d51bda0696742c0b24cc2777d4154970d13e91d55b57bea0edc9be2a",
      "english": "Correct!\nBut wrong quiz answer!!\nSo much for trust!",
      "translator_note": null
    },
    {
      "id": "msb_000E37EC",
      "source_words_sha256": "41c6b7ad855897e928b34b8a9c7508492b48a0b6199361693ce7d7e435e476d0",
      "english": "Minton Sausage.",
      "translator_note": null
    },
    {
      "id": "msb_000E3804",
      "source_words_sha256": "c04e0ce3040a86af1a1788d755d75d193c960a90b09dc0196b2f90d50cc45b2e",
      "english": "No?",
      "translator_note": null
    },
    {
      "id": "msb_000E3814",
      "source_words_sha256": "90a4a1b5d0bf8bc190f5b55ee9a787aeeb1affefbdffc09edd6fa15917a0c9ae",
      "english": "Yamazaki...\nI'll have a word\nwith him later...!",
      "translator_note": null
    },
    {
      "id": "msb_000E3854",
      "source_words_sha256": "a91c5270d6fc5b2140c6bc580e18770b285de70826e391706f48bc8b38e60dff",
      "english": "Ask some sensible questions.",
      "translator_note": null
    },
    {
      "id": "msb_000E3878",
      "source_words_sha256": "3e694bfe4b098acfd1f58895790304df4f0da8f164007ec7e4568f1abeb23bd9",
      "english": "Yamazaki, so badminton?\nToo obvious.",
      "translator_note": null
    },
    {
      "id": "msb_000E38A4",
      "source_words_sha256": "ec039b3658265b3329542807d8ee63ecf2c52f0ca528290d5554b2c07583985a",
      "english": "Nope! Sorry! Wrong!!",
      "translator_note": null
    },
    {
      "id": "msb_000E38C4",
      "source_words_sha256": "b9a5e8bb528ebcd27c72aaf852bc149a8b96620c0ea5df054856019f110e5a5a",
      "english": "Don't take it out on him!\nSo much for trust!",
      "translator_note": null
    },
    {
      "id": "msb_000E3948",
      "source_words_sha256": "829830d9464208f2cd0b465005fbde62ffaa3af172619d24694544d7124ccdc5",
      "english": "A question about Yamazaki.\fWhen he infiltrated\nViper Banzo's factory,\nwhat was he called?",
      "translator_note": null
    },
    {
      "id": "msb_000E39AC",
      "source_words_sha256": "6b2a1a8a01acc275d292ab518afdbc8086eca904d4f1699e87628f0536e9807a",
      "english": "Jimmy. What else?",
      "translator_note": null
    },
    {
      "id": "msb_000E39C8",
      "source_words_sha256": "8d22f8f0c957f383b6ae011dd1b2917867a1cbeae06dfdb2b3ea8355602c91ad",
      "english": "Call him Yamazaki.",
      "translator_note": null
    },
    {
      "id": "msb_000E39EC",
      "source_words_sha256": "36cb95be1ecfe0ea72b8cd16d32d401ac281fa94f9257252094ac84a028f3553",
      "english": "Somehow...\nI feel sorry for Jimmy...",
      "translator_note": null
    },
    {
      "id": "msb_000E3A24",
      "source_words_sha256": "ccebe9647b2c7674d334d8c1aac40bcb2b90c425cd51508edbf4f91289325d85",
      "english": "All the plain ones\nget called that.",
      "translator_note": null
    },
    {
      "id": "msb_000E3A54",
      "source_words_sha256": "ac1a949109be8b44b6fe6683ccf7540b6195978a5023e988974fbda52b9bb0ba",
      "english": "Tony.",
      "translator_note": null
    },
    {
      "id": "msb_000E3A64",
      "source_words_sha256": "affa1d49699f42a98ef8d28210b6e47e3ccfda0d02b8e4597d0ff7e97794d837",
      "english": "Who cares who\nsings what?!",
      "translator_note": null
    },
    {
      "id": "msb_000E3A8C",
      "source_words_sha256": "662b2fb4f13cd1726bcb9a527b43fa2a7f0b92fd38d3bdf6a7083496ca5ad001",
      "english": "Why...?",
      "translator_note": null
    },
    {
      "id": "msb_000E3B0C",
      "source_words_sha256": "4842307ec6ce91b12c9dec831ad4c4d85f0999e1b49b1b5d51324000fae71a36",
      "english": "Still that?!\nNothing else?",
      "translator_note": null
    },
    {
      "id": "msb_000E3BC0",
      "source_words_sha256": "0892185e9c8e6b609ebecb8d8f47f5999dae69072611bfe90cd7c1619d931700",
      "english": "That's Tommy.",
      "translator_note": null
    },
    {
      "id": "msb_000E3BD0",
      "source_words_sha256": "2bad63c11932dc4f444b1679996a3b49f509848029fa55449ec5b43e0b91e8e3",
      "english": "Memory of Love.",
      "translator_note": null
    },
    {
      "id": "msb_000E3BE0",
      "source_words_sha256": "7c8cfc826d50326041746502070969f8336c17a7d2d557d85b405820fe36cced",
      "english": "Yama-chan...",
      "translator_note": null
    },
    {
      "id": "msb_000E3BF8",
      "source_words_sha256": "057909236189ad5e5d7045a9920764e7564690e7548f20934860be141e99bf1e",
      "english": "Mr. Yama, then...",
      "translator_note": null
    },
    {
      "id": "msb_000E3C14",
      "source_words_sha256": "66668f9d074e6a1c4583e9de6942ade628fc5ed20dbdb2b3697a19862e27ff2b",
      "english": "Mr. Yamashiro, then...",
      "translator_note": null
    },
    {
      "id": "msb_000E3C34",
      "source_words_sha256": "81d118283ba95d2b939718dd1c3b9f725945c543ac8b856ba4d921af4dc87346",
      "english": "Wrong!!\nO-ha doesn't suit him!",
      "translator_note": null
    },
    {
      "id": "msb_000E3D20",
      "source_words_sha256": "034928f12ec368f015ae64f10229c43a5f6d335caa3785feeca953f37c1819ed",
      "english": "About Yamazaki.\fWhat is his full name?",
      "translator_note": null
    },
    {
      "id": "msb_000E3D64",
      "source_words_sha256": "fbbf43054df308a7b7768ee1674ee5b505d79d87549b3058f757390c80dddd3f",
      "english": "Tsutomu.",
      "translator_note": null
    },
    {
      "id": "msb_000E3D84",
      "source_words_sha256": "f53eac5500e75b6c5884831007ac33b0969b1fcfbb0f1140327f890c4a167475",
      "english": "Wrong!!\nWho's Tsutomu?!",
      "translator_note": null
    },
    {
      "id": "msb_000E3E40",
      "source_words_sha256": "be5077eb0062ad8b122645672e21cd28b659fbc66b915d8fc4c7ede5932ba673",
      "english": "Sagaru Yamazaki.\nSagaru = retreat.",
      "translator_note": null
    }
  ]
}
