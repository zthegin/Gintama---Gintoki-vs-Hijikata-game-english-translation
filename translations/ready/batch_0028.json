    },
    {
      "id": "msb_00066848",
      "source_words_sha256": "4d29fba48c8a9a18404563f8f73015fdeefe4c7cb1647ae79be111cf192e5ec2",
      "english": "Quit the nonsense! I'll knock you flat!",
      "translator_note": null
    },
    {
      "id": "msb_00066884",
