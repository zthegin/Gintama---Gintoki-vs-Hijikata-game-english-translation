      "english": "Don't say Otsu's name so casually!",
      "translator_note": null
    },
    {
      "id": "msb_00065D0C",
      "source_words_sha256": "46c766f2827f0c1fd65adedb344b3e1bfe6f63cefb1f011aa3251bd188dc38aa",
      "english": "Don't make me repeat myself! The likes of YOU...!",
      "translator_note": null
    },
    {
