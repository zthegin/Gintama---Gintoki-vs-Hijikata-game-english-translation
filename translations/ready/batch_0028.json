      "source_words_sha256": "ed8316781f539e56c74e67002724abe746c8cf785ce1962deac1458ad0bb948b",
      "english": "Idiot! Don't recruit just ANYONE!",
      "translator_note": null
    },
    {
      "id": "msb_00065EA8",
      "source_words_sha256": "b755597657ebe79370853b6f8757e5267a683d9c9f8f311dbdc304c337416249",
      "english": "...That dog Amanto... Scared of Shinpachi...!",
      "translator_note": null
    },
    {
      "id": "msb_00065EF4",
      "source_words_sha256": "828bf14e7231aada424b42ce2154c6c2a46e2cfd97c5ac5364d1fea344db854a",
      "english": "...Yep. Definitely scared.",
      "translator_note": null
    },
    {
      "id": "msb_00065F24",
      "source_words_sha256": "9e28a80b649330488bc860ec24b772e86908158424559105249cbda3130cfafb",
      "english": "Shinpachi's fearsome!",
      "translator_note": null
    },
    {
      "id": "msb_00065F80",
      "source_words_sha256": "9d8707c4ef16d447ff908bf0f46d1cfd9ab13c424bb174f419c882a5bc8d8fd3",
      "english": "Cute girls are universal treasures. Alien or human, same thing.",
      "translator_note": null
    },
    {
      "id": "msb_00065FB8",
      "source_words_sha256": "385168ebd675ca2d85a62d45df6d05bf5f67d85212d99e3de2d01ee9d76b7942",
      "english": "W-what an outburst...",
      "translator_note": null
    },
    {
      "id": "msb_00065FDC",
      "source_words_sha256": "4c6d18ec06b9adf6a805f265c5eb72f17a35ce8f05ee1b88cd52bc4557d64238",
      "english": "...I'll think about it.",
      "translator_note": null
    },
    {
      "id": "msb_00065FFC",
      "source_words_sha256": "e418b805070e8efa68439ba1503a56432ae6e02bbe4c337525d42e1f6c8e83b3",
      "english": "Ugh! You... Um, d-did you find Otsu...?",
      "translator_note": null
    },
    {
      "id": "msb_000660B0",
      "source_words_sha256": "1b0b53bcf259a00028d20409087df760f837e7ccb598f82ca84cb34ff150e899",
      "english": "Oh, h-hello... Looks like you found Otsu...",
      "translator_note": null
    },
    {
