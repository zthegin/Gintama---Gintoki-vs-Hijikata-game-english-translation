      "source_words_sha256": "d1bf6b781d0d9998d75bc64dcecd192399bb84a5b9d295673868b2d92d8c2326",
      "english": "Hmm. If I feel like it.",
      "translator_note": null
    },
    {
      "id": "msb_00066DE8",
