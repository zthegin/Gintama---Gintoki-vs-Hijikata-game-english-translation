      "id": "msb_00067104",
      "source_words_sha256": "5245a4374359d481497b7e6ebcd07f6b9dc28356656eefae68fb2c2468f1a653",
      "english": "Yes, we met.",
      "translator_note": null
    },
    {
      "id": "msb_0006711C",
