      "id": "msb_0006680C",
      "source_words_sha256": "cbf15acd054f99ee8d2347095987f846fdf53d46e6d675c59f38161bb1e9fe1d",
      "english": "Gorilla and Hijikata's goon.",
      "translator_note": null
    },
    {
