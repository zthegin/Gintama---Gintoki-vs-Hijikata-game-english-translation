      "source_words_sha256": "96cb9bc732611feaeca2ebe411c225ee2c524676f8c1de920041c12e0a1143cb",
      "english": "Better leave. Fast.",
      "translator_note": null
    },
    {
      "id": "msb_00065C78",
      "source_words_sha256": "89ebfd1fd949c751cc47b671405e99eacf3327500d77ced2b8b3c967afd19833",
      "english": "Want to be smashed to bits, bastard?! Look in a mirror first!",
      "translator_note": null
    },
    {
