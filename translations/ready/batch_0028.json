      "source_words_sha256": "4bfd94f87b462654c399283fff0f803640e45ac816dd6c94b5f4a4e75f03fdcc",
      "english": "Then go check! Hurry!",
      "translator_note": null
    },
    {
      "id": "msb_00066598",
