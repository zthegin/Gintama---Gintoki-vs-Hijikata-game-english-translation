      "english": "I said I don't KNOW! See ya!",
      "translator_note": null
    },
    {
      "id": "msb_0006690C",
      "source_words_sha256": "2218c5b5d2ac8768cc5c3ceced237517e0b28429cb629c66ce44c81f85d09bb7",
      "english": "N-not like that! Just don't want to get dragged into trouble!",
      "translator_note": null
    },
    {
      "id": "msb_00066958",
