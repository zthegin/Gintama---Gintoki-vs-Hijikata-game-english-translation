      "source_words_sha256": "71c9360bd92a61f3c26a8614f0971fb952f39703b1930649cebe6b930d2afdb8",
      "english": "That's Ebina, an Amanto.",
      "translator_note": null
    },
    {
      "id": "msb_00031CEC",
      "source_words_sha256": "cf1e3eab0f89cb3cd42a5bebab7ab8be11d0958d15d623b9eb6c19bb3b11b8f8",
      "english": "Hey, mayo freak. Your face is twitching.",
      "translator_note": null
    },
    {
      "id": "msb_00031D14",
      "source_words_sha256": "536a532f6ff72f947cbf15ab6b7f6d36e19af8697a376396cbab9baf0dce22c7",
      "english": "Oh, scared of kappa and ghosts?",
      "translator_note": null
    },
    {
      "id": "msb_00031D54",
      "source_words_sha256": "0a48f0cd157a066e876b9566fc2ced6f55ef62f5a8e0b38bc5e70ec819614363",
      "english": "Who knows?",
      "translator_note": null
    },
    {
      "id": "msb_00031D98",
      "source_words_sha256": "b2a9195d040e429530cf2c30bed6a1f99bda8b568e3fab7a5a6075723920be8b",
      "english": "Gee, thanks.\fBut I've never been good at doing as I'm told.",
      "translator_note": null
    },
    {
      "id": "msb_00031DD4",
      "source_words_sha256": "0b75f7ca3ebdee6c3b30d2c3ed2fc9d6d13b52c8ee8fe4ae00e9b0fd68bc2c26",
      "english": "Anyway, let that kappa go.",
      "translator_note": null
    },
    {
      "id": "msb_00031E18",
      "source_words_sha256": "d690561b4bbb68f1d2e2bf02ef587a00120f17e5ec0e1cd52bc7194a360cf6be",
      "english": "You insist?",
      "translator_note": null
    },
    {
      "id": "msb_00031E2C",
      "source_words_sha256": "16879f330aed2dc4874716e6cc2a3d8be249d599622db9db462aa421d527f380",
      "english": "Um, sorry to interrupt...\fCan I go home now?",
      "translator_note": null
    },
    {
      "id": "msb_00031EA0",
      "source_words_sha256": "7bef24574565c6c04cc268c164d0688ad813dc68701f47f2b434fcddf84b53ba",
      "english": "Fine! I'll do it!",
      "translator_note": null
    },
    {
      "id": "msb_00031EB4",
      "source_words_sha256": "0fe984ec466f30f56a5b2c49de2d1acacd3028e028462ccffc8741651dbedcc6",
      "english": "Gin Tama battle, start!",
      "translator_note": null
    },
    {
      "id": "msb_00031ED0",
      "source_words_sha256": "6439d30be8c53b1a18b7fa7970fd906b866105afc358ae4f00d096c71c2e562c",
      "english": "Huh? Why are YOU here?",
      "translator_note": null
    },
    {
      "id": "msb_00031EF8",
      "source_words_sha256": "83f41916673b70ac3e9291f868270124604eb25bebe7fc72c5f79826acf68752",
      "english": "Just found a suspicious kappa.",
      "translator_note": null
    },
    {
      "id": "msb_00031F18",
      "source_words_sha256": "4eb7fe070aab069a55959b9cbc389eb8a2334a1d679646b03c94570ec48a772e",
      "english": "Don't be stupid. That's a kappa, plain as day.",
      "translator_note": null
    },
    {
      "id": "msb_00031F44",
      "source_words_sha256": "3f4953182d5dc574cdc2e9d5433d544092180f18cea9b5e577a3c97e78ca5a83",
      "english": "Really an Amanto?",
      "translator_note": null
    },
    {
      "id": "msb_00031F5C",
      "source_words_sha256": "9991d3f7a7892a2ce736ef8069f99fcd05c4ab6568af66c441833e4691168b14",
      "english": "What...?",
      "translator_note": null
    },
    {
      "id": "msb_00031F74",
      "source_words_sha256": "00ef587bf64c8f79c887fa85dffc9bd82fe702402871afe4d8acb1854e157289",
      "english": "D-don't be stupid! I'm not scared of that stuff!",
      "translator_note": null
    },
    {
      "id": "msb_00031FA0",
      "source_words_sha256": "cfe3fcc563cc32f25a60f3c6964304d16c862bee17c8a862d0e722fce23ed947",
      "english": "Anyway, why are you here?",
      "translator_note": null
    },
    {
      "id": "msb_00032030",
      "source_words_sha256": "78d06521a8dd7effe76f57a7e34649097e7a16b78d9f14af3826479afed20d29",
      "english": "Nobody here except this kappa.",
      "translator_note": null
    },
    {
      "id": "msb_00032094",
      "source_words_sha256": "cae165770de2a2d5bb96048df39d9054755baae3b4aa709847d6c005f7a5b536",
      "english": "Figures.\fOtherwise, you'd have grown into a better adult.",
      "translator_note": null
    },
    {
      "id": "msb_000320D0",
      "source_words_sha256": "60d7e89024bf5f89dcc87b30a7c10970392e14c46b1c57b1756ffdf0f726a8ae",
      "english": "I'll take you on, if you want.",
      "translator_note": null
    },
    {
      "id": "msb_000320EC",
      "source_words_sha256": "a1931de172ce8af7610703b48aad3cf005ec784d2401b244079202a728f79855",
      "english": "Hey! What the hell, Sougo?!",
      "translator_note": null
    },
    {
      "id": "msb_00032134",
      "source_words_sha256": "359ce366ea976f44ac69a8cfff16af7ee728b0768996ceaff1afab9ee34daa75",
      "english": "Hold it, bastard! Fight me!",
      "translator_note": null
    },
    {
      "id": "msb_00032164",
      "source_words_sha256": "e1b37ba7a579638b3903c826ecd91a2553afdda99bde5d01e8d5eee47b55da7c",
      "english": "Bring it on! Are we doing this or not?!",
      "translator_note": null
    },
    {
      "id": "msb_000321B0",
      "source_words_sha256": "24e51101c11881c995d0e32cbdaaa691b4d68404dca332c12ef58b67048020af",
      "english": "Definitely a kappa.\fJust like Grandma said.",
      "translator_note": null
    },
    {
      "id": "msb_0003220C",
      "source_words_sha256": "f53f46a0e9e6a61bb3eac51baefde0bdf121daefc19833cae57be15ce2c2ae5e",
      "english": "Too vicious to let loose, I'm afraid.",
      "translator_note": null
    },
    {
      "id": "msb_00032284",
      "source_words_sha256": "1ded7fb68a9075e2107025f42044b58d6c4adfc980ce7257ace3943297615279",
      "english": "Tch! He dodged...",
      "translator_note": null
    },
    {
      "id": "msb_000322C8",
      "source_words_sha256": "c1a48f64c78b76137394e62d9631635af2f78b55a339563b95f6a1ebf616f536",
      "english": "I said I'm not a kappa!",
      "translator_note": null
    },
    {
      "id": "msb_000322E4",
      "source_words_sha256": "cefb214bf5b69314f208c07c83b5e6c649852f5da38930c6703e797b843f53ae",
      "english": "You saved me.\fYou're a good guy after all.",
      "translator_note": null
    },
    {
      "id": "msb_00032328",
      "source_words_sha256": "531465eca8b6373682b19fc9c8f1fed9a9b90dbaedbd6ae483b6279e12ba249a",
      "english": "Here. Have this ball.",
      "translator_note": null
    },
    {
      "id": "msb_00032344",
      "source_words_sha256": "55b2a4c65ce9264c856ae1e23e5b9dd192cc22ac8295eed5ebc7819c105a85da",
      "english": "That was a Gin Tama too?",
      "translator_note": null
    },
    {
      "id": "msb_00032390",
      "source_words_sha256": "d77adae5ca52756ad7a8608e6c0be8751f6ced09bd3be88eb4170717e57c0d99",
      "english": "Huh...?",
      "translator_note": null
    },
    {
      "id": "msb_000323A8",
      "source_words_sha256": "b05d78e2fa62e121c5cdcb1b397fb45f299f8ead77b56b17c643d8f3ec10a4b3",
      "english": "What do you mean?",
      "translator_note": null
    },
    {
      "id": "msb_000323BC",
      "source_words_sha256": "76530de1c86ce459d4b63da7b17e0a4ccf4ef6c688657dc71209f61b8eb78471",
      "english": "Shady types...?\fOh, yeah. Saw some sneaky guys.",
      "translator_note": null
    },
    {
      "id": "msb_00032404",
      "source_words_sha256": "f86287ed170ae7a7a418cb2aca4348c16335c9a9fc0e1f51f74a4db928450df9",
      "english": "Looked dangerous, so I hid.",
      "translator_note": null
    },
    {
      "id": "msb_00032430",
      "source_words_sha256": "02aa413dd91727f4f24c001774c9a46ee111f2d9195652f1ecdecd9e76d04e54",
      "english": "Said something about a deal.",
      "translator_note": null
    },
    {
      "id": "msb_00032450",
      "source_words_sha256": "a831740101a4ce26b828faa7a1c2e9fb6d18d470bbcc6c7cd24ac2e40915c245",
      "english": "My hearing's been going lately...",
      "translator_note": null
    },
    {
      "id": "msb_000324B0",
      "source_words_sha256": "9d6639ea3e0338b0d4004c71cab1403968904518ee92245c8c9cb156afb70aca",
      "english": "Think so. That's all.",
      "translator_note": null
    },
    {
      "id": "msb_000324D4",
      "source_words_sha256": "1748acf67ab5424c01bc26423a5e159fa36b6c5adbfec480c4cc4a6cce30eda2",
      "english": "Any use to you?",
      "translator_note": null
    },
    {
      "id": "msb_000324E8",
      "source_words_sha256": "ee7224206976934645137bd6c57e14d2fd693afb8a6f8479d133afc3c6d278a5",
      "english": "Right. I'll head home, then.",
      "translator_note": null
    }
  ]
}
